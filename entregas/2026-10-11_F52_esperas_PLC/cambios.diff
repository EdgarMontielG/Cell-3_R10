 DECL GLOBAL INT nCtWaitSum=564
 DECL GLOBAL INT nCtCycle=276828
+;PLC WAITS (CT_PLC_START / CT_PLC_END IN GUN_OPEN_CHECK.SRC) - 2026-10-11, MS, LAST PART:
+;  nCtHomeWait   : ROBOT AT HOME AFTER THE CYCLE UNTIL THE PLC STARTS THE NEXT ONE (CELL.SRC)
+;  nCtPlcWait[k] : ROBOT STOPPED WAITING FOR A PLC PERMISSION: 1 PICKUP, 2 APPLICATION 1
+;                  (NUT CHECK, style1app2opt1), 3 DROP-OFF (style1drop1opt1). USES $TIMER[24]
+DECL GLOBAL INT nCtHomeWait=0
+DECL GLOBAL INT nCtPlcWait[3]
+nCtPlcWait[1]=0
+nCtPlcWait[2]=0
+nCtPlcWait[3]=0
 ;PEDESTAL STATES FOR INTERRUPTS 23/24 OF THE WELD APPS, SET BY SPS.SUB EVERY CYCLE
 DECL GLOBAL BOOL CL_ClampOpen=FALSE
--- a/KRC/R1/Program/Centerline/gun_open_check.src
+++ b/KRC/R1/Program/Centerline/gun_open_check.src
@@ -513,2 +513,36 @@
 
 END
+
+GLOBAL DEF CT_PLC_START( )
+;FOLD ROUTINE INFO
+;**********************************************************
+;* CYCLE TIME MEASUREMENT (2026-10-11): THE ROBOT STARTS TO
+;* WAIT FOR THE PLC - AT HOME AFTER THE CYCLE (CELL.SRC) OR
+;* BEFORE AN AUTOMATIONCORE PERMISSION CHECK. WAIT SEC 0 =
+;* THE SAME ADVANCE RUN STOP THE CHECK MAKES: THE ROBOT IS
+;* ALREADY STOPPED THERE, THE PATH DOES NOT CHANGE.
+;**********************************************************
+;ENDFOLD
+   WAIT SEC 0
+   $TIMER[24]=0
+   $TIMER_STOP[24]=FALSE
+END
+
+GLOBAL DEF CT_PLC_END(nWhich:IN)
+;FOLD ROUTINE INFO
+;**********************************************************
+;* CYCLE TIME MEASUREMENT (2026-10-11): END OF THE PLC WAIT
+;* STARTED BY CT_PLC_START, MS.
+;* nWhich 0 = HOME, CYCLE START (nCtHomeWait)
+;*        1 = PICKUP, 2 = APPLICATION 1 (NUT CHECK),
+;*        3 = DROP-OFF (nCtPlcWait[nWhich])
+;**********************************************************
+;ENDFOLD
+DECL INT nWhich
+   IF nWhich==0 THEN
+      nCtHomeWait=$TIMER[24]
+   ENDIF
+   IF (nWhich>=1) AND (nWhich<=3) THEN
+      nCtPlcWait[nWhich]=$TIMER[24]
+   ENDIF
+END
