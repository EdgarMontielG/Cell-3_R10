&ACCESS RVO2
&REL 21
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app2opt1( )
;FOLD PROGRAM INFO
;**********************************************************
;* Customer : Gestamp
;* Cell     : BMW-03-10 / Robot R1
;* Part     : GE4-002
;* Program  : style1app2opt1
;* Function : Nut presence check (sensor) on PN1-PN3.
;*            Production (nOption 1,2,7,8): sets bScrapGE4
;*            if a nut is missing. Red Rabbit (nOption 12):
;*            sets PASSED/FAILED.
;* Rev.     : 2026-10-05 - GOTO jumps replaced with
;*            structured IF logic
;*            2026-10-05 - Scrap evaluation for nOption
;*            1,2,7,8 and Red Rabbit for nOption 12
;**********************************************************
;ENDFOLD
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
	;FOLD NutWeld
	;ENDFOLD (NutWeld)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)


;FOLD PTP P22 Vel=100 % PDAT16 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P22, 3:, 5:100, 7:PDAT16
$BWDSTART=FALSE
PDAT_ACT=PPDAT16
FDAT_ACT=FP22
BAS(#PTP_PARAMS,100)
PTP XP22 
;ENDFOLD

   CT_PLC_START()   ; Cycle time measurement: wait for the PLC application 1 permission (GUN_OPEN_CHECK.src, 2026-10-11)
   ;FOLD Application[1] Request
      ;FOLD ;%{h}
         ;Params IlfProvider=ac_zoneilf; AC_CmdZones=Application; AC_CmdParam=1; AC_ZoneRepo=False; AC_Blending=False
      ;ENDFOLD
      AC_ApplicationCheck (1)
   ;ENDFOLD
   CT_PLC_END(2)
;--- Nut check PN1 ---
;FOLD LIN P28 Vel=2 m/s CPDAT15 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P28, 3:, 5:2, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP28
BAS(#CP_PARAMS,2)
LIN XP28 
;ENDFOLD
;FOLD NUT CHECK1

IF di004UseDryCycle==FALSE THEN ; Dry cycle: skip nut check

IF ($IN[227]==TRUE) THEN
         PARTPRESENT1=TRUE 
         ENDIF
         WAIT SEC 0.2 
       
         ENDIF

 ;ENDFOLD      
;FOLD PTP P31 Vel=100 % PDAT35 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P31, 3:, 5:100, 7:PDAT35
$BWDSTART=FALSE
PDAT_ACT=PPDAT35
FDAT_ACT=FP31
BAS(#PTP_PARAMS,100)
PTP XP31 
;ENDFOLD

;--- Nut check PN2 ---
;FOLD LIN P32 Vel=2 m/s CPDAT16 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P32, 3:, 5:2, 7:CPDAT16
$BWDSTART=FALSE
LDAT_ACT=LCPDAT16
FDAT_ACT=FP32
BAS(#CP_PARAMS,2)
LIN XP32 
;ENDFOLD
;FOLD NUT CHECK2

IF di004UseDryCycle==FALSE THEN ; Dry cycle: skip nut check

IF ($IN[227]==TRUE) THEN
         PARTPRESENT2=TRUE 
         ENDIF
         WAIT SEC 0.2 
       
         ENDIF

 ;ENDFOLD 
;FOLD PTP P38 Vel=100 % PDAT36 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P38, 3:, 5:100, 7:PDAT36
$BWDSTART=FALSE
PDAT_ACT=PPDAT36
FDAT_ACT=FP38
BAS(#PTP_PARAMS,100)
PTP XP38 
;ENDFOLD

;--- Nut check PN3 ---
;FOLD LIN P36 Vel=2 m/s CPDAT17 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P36, 3:, 5:2, 7:CPDAT17
$BWDSTART=FALSE
LDAT_ACT=LCPDAT17
FDAT_ACT=FP36
BAS(#CP_PARAMS,2)
LIN XP36 
;ENDFOLD
;FOLD NUT CHECK3

IF di004UseDryCycle==FALSE THEN ; Dry cycle: skip nut check

IF ($IN[227]==TRUE) THEN
         PARTPRESENT3=TRUE 
         ENDIF
         WAIT SEC 0.2 
       
         ENDIF

 ;ENDFOLD 
;FOLD PTP P37 Vel=100 % PDAT37 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P37, 3:, 5:100, 7:PDAT37
$BWDSTART=FALSE
PDAT_ACT=PPDAT37
FDAT_ACT=FP37
BAS(#PTP_PARAMS,100)
PTP XP37 
;ENDFOLD
;FOLD NUT CHECK
IF di004UseDryCycle==FALSE THEN ; Dry cycle: skip nut check


WAIT SEC 0.2
     SWITCH nOption
          CASE 1,2,7,8   ; Production: scrap part if any nut is missing
         IF (PARTPRESENT1==TRUE ) AND (PARTPRESENT2==TRUE) AND (PARTPRESENT3==TRUE) THEN
            bscrapGE4 = FALSE
         ELSE
            bscrapGE4=TRUE
         ENDIF
          CASE 12  ; Red Rabbit: all nuts found = FAILED, none found = PASSED
            IF (PARTPRESENT1==TRUE ) AND (PARTPRESENT2==TRUE) AND (PARTPRESENT3==TRUE) THEN
do141RedRabbitFailed=TRUE
ENDIF

IF (PARTPRESENT1==FALSE ) AND (PARTPRESENT2==FALSE) AND (PARTPRESENT3==FALSE) THEN 

do142RedRabbitPassed=TRUE
ENDIF
     ENDSWITCH 

ENDIF


;ENDFOLD


END
