+GLOBAL DEF CT_NUT_WAIT(nNut:IN)
+;FOLD ROUTINE INFO
+;**********************************************************
+;* Cycle time measurement (2026-10-11, same as CT_NUT_WAIT
+;* of 20R1). Replaces the nut wait in style1app1opt1A - 3B:
+;* the same wait (NUT_READY for nut 1, NEXT_NUT_READY for
+;* nuts 2 and 3), plus the time the robot stood at the
+;* approach point waiting for the nut -> nCtNutWait[nNut]
+;* (ms). WAIT SEC 0 = the same advance run stop the
+;* WAIT FOR made.
+;**********************************************************
+;ENDFOLD
+DECL INT nNut
+   WAIT SEC 0
+   nCtNut=nNut
+   $TIMER[21]=0
+   $TIMER_STOP[21]=FALSE
+   IF nNut==1 THEN
+      WAIT FOR NUT_READY==TRUE
+   ELSE
+      WAIT FOR NEXT_NUT_READY==TRUE
+   ENDIF
+   IF (nNut>=1) AND (nNut<=3) THEN
+      nCtNutWait[nNut]=$TIMER[21]
+   ENDIF
+END
+
+GLOBAL DEF CT_WELD_START( )
+;FOLD ROUTINE INFO
+;**********************************************************
+;* Cycle time measurement (2026-10-11), first line of
+;* CENTERLINE_WELD: the robot is at the weld position
+;* (WAIT SEC 0 in the style program before the call).
+;**********************************************************
+;ENDFOLD
+   IF (nCtNut>=1) AND (nCtNut<=3) THEN
+      nCtNutToNut[nCtNut]=$TIMER[20]
+   ENDIF
+   $TIMER[20]=0
+   $TIMER_STOP[20]=FALSE
+   IF nCtNut==1 THEN
+      nCtCycle=$TIMER[23]
+      $TIMER[23]=0
+      $TIMER_STOP[23]=FALSE
+   ENDIF
+   $TIMER[22]=0
+   $TIMER_STOP[22]=FALSE
+END
+
+GLOBAL DEF CT_WELD_END( )
+;FOLD ROUTINE INFO
+;**********************************************************
+;* Cycle time measurement (2026-10-11), last line of
+;* CENTERLINE_WELD. After nut 3: part time and total wait.
+;**********************************************************
+;ENDFOLD
+DECL INT i
+   IF (nCtNut>=1) AND (nCtNut<=3) THEN
+      nCtInWelder[nCtNut]=$TIMER[22]
+   ENDIF
+   IF nCtNut==3 THEN
+      nCtPart=nCtInWelder[3]
+      nCtWaitSum=nCtNutWait[1]
+      FOR i=2 TO 3
+         nCtPart=nCtPart+nCtNutToNut[i]
+         nCtWaitSum=nCtWaitSum+nCtNutWait[i]
+      ENDFOR
+   ENDIF
+END
+
+GLOBAL DEF CT_PLC_START( )
+;FOLD ROUTINE INFO
+;**********************************************************
+;* Cycle time measurement (2026-10-11): the robot starts to
+;* wait for the PLC (at HOME after the cycle, or before an
+;* AutomationCore permission check). WAIT SEC 0 = the same
+;* advance run stop the check makes: the robot is already
+;* stopped there, the path does not change.
+;**********************************************************
+;ENDFOLD
+   WAIT SEC 0
+   $TIMER[24]=0
+   $TIMER_STOP[24]=FALSE
+END
+
+GLOBAL DEF CT_PLC_END(nWhich:IN)
+;FOLD ROUTINE INFO
+;**********************************************************
+;* Cycle time measurement (2026-10-11): end of the PLC wait
+;* started by CT_PLC_START (ms).
+;* nWhich 0 = HOME, cycle start (nCtHomeWait)
+;*        1 = pickup permission, 2 = application 1 (nut
+;*        check), 3 = drop-off (nCtPlcWait[nWhich])
+;**********************************************************
+;ENDFOLD
+DECL INT nWhich
+   IF nWhich==0 THEN
+      nCtHomeWait=$TIMER[24]
+   ENDIF
+   IF (nWhich>=1) AND (nWhich<=3) THEN
+      nCtPlcWait[nWhich]=$TIMER[24]
+   ENDIF
+END
