&ACCESS RVP
&REL 20
&COMMENT 03-10-R1 AUTO EXTERNAL MAIN
DEF  CELL ( )
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - AUTOMATIC EXTERNAL MAIN PROGRAM (AUTOMATIONCORE CELL)
;********************************
;FOLD Initialize System
  DECL CHAR DMY[3]
  DMY[]="---"
  ;START-UP, THEN HOME
  InitializeSystem()
  HOME()
  ;ENDFOLD (Initialize System)
  LOOP
    ;FOLD Maintain System
    ;RESET CYCLE OUTPUTS, WAIT HERE WHILE STOP AT END OF CYCLE IS ON
    MaintainSystem()
    ;ENDFOLD (Maintain System)
    ;FOLD Check Style
    ;STYLE NUMBER FROM THE PLC
    nStyle=gdiStyle
    gdoStyleAckn=nStyle
    ;OPTION NUMBER FROM THE PLC
    nOption=gdiOption
    gdoOptionAckn=nOption
    ;OPTION BITS
    GetOptions( )
    ;LAST CYCLE TIME
    GetCycTime( )
    ;FOLD State Message - Waiting for Cycle Start or Style Selection.
    IF (Exists_KrlMsg(nCycleStart_Handle)==FALSE) THEN
    	nCycleStart_Handle = Set_Krlmsg (#STATE, AutomationCore_Msg[24], AutoCore_MsgPar[], AutoCore_MsgOpt_NoStop)
    ENDIF
    ;ENDFOLD (State Message - Waiting for Cycle Start or Style Selection.)
    ;ENDFOLD (Check Style)
    ;CYCLE START
    IF ((di005InitiateCycle==TRUE) AND (nStyle>0) AND (nOption>0)) THEN
	    ;FOLD Start Cycle
	    ;CHECK ROBOT AT HOME
	    AC_Erase( )
	    HomeCheck( )
	    ;ROBOT IN CYCLE
	    do005RobotInCycle = TRUE
	    ;START CYCLE TIMER
	    StartCycTime( )
	    ;ENDFOLD (Start Cycle)
	    ;STYLE PROGRAM
	    SWITCH  nStyle
		    CASE 1
             ;STYLE 1
             Style_1( )
		    DEFAULT
	    ENDSWITCH
	    ;FOLD Finish Cycle
       IF ((nStyle>0) AND (nOption>0)) THEN
		    ;END OF CYCLE
		    EndOfCycle( )
		    ;STOP CYCLE TIMER
		    StopCycTime( )
        ENDIF
	  	;ENDFOLD (Finish Cycle)
  	ELSE
		  ;NO CYCLE START: SERVICE REQUESTS FROM THE PLC
		  ;GO TO REPAIR
		  IF (di009GoToRepair==TRUE) THEN
		  	HomeCheck( )
		  	HomeToRepair( )
;WAIT RETURN FROM REPAIR
;FOLD WAIT FOR ( IN 8 'di008ReturnFromRepair' );%{PE}%R 8.3.43,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:8, 7:di008ReturnFromRepair, 9:
WAIT FOR  ( di008ReturnFromRepair )
;ENDFOLD
		  		RepairToHome( )
		  ENDIF
		  ;MASTERING REFERENCE TEST
		  IF (di022MstrRefRequest==TRUE) THEN
           HomeCheck( )
           masref_main( )
;FOLD WAIT Time=5 sec;%{PE}%R 8.3.43,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:5
WAIT SEC 5
;ENDFOLD
		  ENDIF
          ;BRAKE TEST
          IF (di021BrakeTestRequest==TRUE) THEN
             HomeCheck( )
           BrakeTestReq( )
;FOLD WAIT Time=5 sec;%{PE}%R 8.3.43,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:5
WAIT SEC 5
;ENDFOLD
        ENDIF
		  ;ELECTRODE CHANGE
		  IF (do111Gun1ElectrodeChange==TRUE) OR (do112Gun2ElectrodeChange==TRUE) OR (do113Gun3ElectrodeChange==TRUE) THEN
         GunElectrodeChange()
		  ENDIF
     ENDIF
  ENDLOOP
END
