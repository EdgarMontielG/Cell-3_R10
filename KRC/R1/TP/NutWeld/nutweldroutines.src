DEFFCT INT Get_FaultResetNr(nGunNr :IN )
   ;FOLD Details
      ;FOLD Declaration
         DECL INT nGunNr
         DECL SIGINF SignalIOInfo
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         SWITCH nGunNr
            CASE 1
               SignalIOInfo=GET_SIG_INF("dopw1_FaultReset")
               RETURN(SignalIOInfo.IDX)
            CASE 2
               SignalIOInfo=GET_SIG_INF("dopw2_FaultReset")
               RETURN(SignalIOInfo.IDX)
            CASE 3
               SignalIOInfo=GET_SIG_INF("dopw3_FaultReset")
               RETURN(SignalIOInfo.IDX)
         ENDSWITCH	
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
ENDFCT ; (Get_FaultResetNr)

