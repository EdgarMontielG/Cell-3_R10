&ACCESS RVO3
&REL 3482
&PARAM DISKPATH = KRC:\R1\TP\NutWeld
DEF NutWeldRoutines( )
   ;*********************************
   ;* Package:     NutWeldRoutines  *
   ;* Release      V1.0.4           *
   ;* Date:        01.2016          *
   ;* GUI Version: > = V8.3         *
   ;*********************************
   ; Declare in NutWeldData.dat Line 460:
   ;DECL REAL rSetUpperLVDT_CLS_W_NUT[3]
   ;rSetUpperLVDT_CLS_W_NUT[1] = 0.0
   ;rSetUpperLVDT_CLS_W_NUT[2] = 0.0
   ;rSetUpperLVDT_CLS_W_NUT[3] = 0.0
   ;DECL REAL rSetLowerLVDT_CLS_W_NUT[3]
   ;rSetLowerLVDT_CLS_W_NUT[1]  = 0.0   
   ;rSetLowerLVDT_CLS_W_NUT[2]  = 0.0  
   ;rSetLowerLVDT_CLS_W_NUT[3]  = 0.0 
   ;DECL BOOL bSaveCurrentValue1=FALSE
   ;DECL BOOL bSaveCurrentValue2=FALSE
   ;DECL BOOL bSaveCurrentValue3=FALSE 
END

GLOBAL DEF NutWeld_Bkg( )
   ;FOLD Details
      ;FOLD Declaration
         DECL REAL rPrimaryValue, rSecondaryValue, rSensorSample
         DECL INT nStepCnt
         DECL BOOL bSensorRetry
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         dopw1_Hidraulyc_Valve = ($PERI_RDY==TRUE)
         dopw2_Hidraulyc_Valve = (($PERI_RDY==TRUE) AND (nMaxGunNr>=2))
         dopw3_Hidraulyc_Valve = (($PERI_RDY==TRUE) AND (nMaxGunNr>=3))
         IF (($EXT==TRUE) AND (bNutWeld_InhibitWeld==TRUE)) THEN
            bNutWeld_InhibitWeld=FALSE ; Weld Inhibit not allowed in Auto
            nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[60], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
         ENDIF
         ;FOLD Program Reset/Cancel
            IF ((($PRO_STATE1==#P_FREE) OR ($PRO_STATE1==#P_RESET)) AND (bNutWeldProcessReset==FALSE)) THEN
               bNutWeldProcessReset=TRUE
               NutWeld_ProcessReset( )
            ELSE
               IF (($PRO_STATE1<>#P_FREE) AND ($PRO_STATE1<>#P_RESET)) THEN
                  bNutWeldProcessReset=FALSE
               ENDIF
            ENDIF
         ;ENDFOLD (Program Reset/Cancel)
         ;FOLD Status Key Control
            ;FOLD USKB1 - Process Control
               bNutWeldWOJoining = ((($MODE_OP==#EX) AND (di004UseDryCycle==TRUE)) OR ((($MODE_OP==#T1) OR ($MODE_OP==#T2)) AND (bNutWeldWOJoinSTK==TRUE)))
               IF (($MODE_OP==#T1) OR ($MODE_OP==#T2)) THEN
                  IF ((bNutWeldResetSTK==TRUE) AND ($OUT[Get_FaultResetNr(nNutWeldGunNrSTK)]==FALSE)) THEN
                     bNutWeldResetSTK=FALSE
                     PULSE($OUT[Get_FaultResetNr(nNutWeldGunNrSTK)],TRUE,0.25)
                  ENDIF
               ENDIF
            ;ENDFOLD (USKB1 - Process Control)
            ;FOLD USKB2 - Manual Control
               IF (bNutWeldOpnGunSTK==TRUE) THEN
                  dopw_GunWork(nNutWeldGunNrSTK,FALSE)
                  bNutWeldOpnGunSTK=FALSE
               ENDIF
               IF (bNutWeldClsGunSTK==TRUE) THEN
                  dopw_GunWork(nNutWeldGunNrSTK,TRUE)
                  bNutWeldClsGunSTK=FALSE
               ENDIF
               IF (bNutWeldAdvRetPinSTK==TRUE) THEN
                  dopw_PinAdv(nNutWeldGunNrSTK,dipw_PinReturn(nNutWeldGunNrSTK))
                  bNutWeldAdvRetPinSTK=FALSE
               ENDIF
            ;ENDFOLD (USKB2 - Manual Control)
            ;FOLD USKB3-4 Manual NutWeld
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[20]==TRUE)) THEN
                  bNutWeld_ManWeld_Active=FALSE
                  bNutWeldManWeldSTK=FALSE
                  dopw_GunWork(nNutWeldGunNrSTK,FALSE)
                  dopw_WeldInit(nNutWeldGunNrSTK,FALSE)
                  dopw_NutIntensify(nNutWeldGunNrSTK,FALSE)
                  dopw_StartFeed(nNutWeldGunNrSTK,FALSE)
                  dopw_SetPrgNr(nNutWeldGunNrSTK, 0 )
                  $TIMER_STOP[nNutWeldManWeldTmr]=TRUE
                  FOR nStepCnt=1 to 20
                     bNutWeld_ManWeld_Step[nStepCnt]=FALSE
                  ENDFOR
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[11]==TRUE) AND (bNutWeld_ManWeld_Step[12]==FALSE)) THEN
                  ; Open Gun
                  dopw_GunWork(nNutWeldGunNrSTK,FALSE)
                  bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[10]==TRUE) AND (bNutWeld_ManWeld_Step[11]==FALSE)) THEN
                  ; Check for Weld Complete
                  IF ($TIMER_FLAG[nNutWeldManWeldTmr]==TRUE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[19], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ELSE
                     IF (dipw_WeldComplete(nNutWeldGunNrSTK)==TRUE) THEN
                        dopw_WeldInit(nNutWeldGunNrSTK,FALSE)
                        dopw_NutIntensify(nNutWeldGunNrSTK,FALSE)
                        bNutWeld_ManWeld_Step[11]=TRUE
                     ENDIF
                  ENDIF
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[9]==TRUE) AND (bNutWeld_ManWeld_Step[10]==FALSE)) THEN
                  ; Weld Initiate
                  dopw_WeldInit(nNutWeldGunNrSTK,TRUE)
                  bNutWeld_ManWeld_Step[10]=TRUE
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[8]==TRUE) AND (bNutWeld_ManWeld_Step[9]==FALSE)) THEN
                  ; Intensify Gun
                  dopw_NutIntensify(nNutWeldGunNrSTK,TRUE)
                  ; Check for Gun intensified
                  IF ($TIMER_FLAG[nNutWeldManWeldTmr]==TRUE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[18], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ELSE
                     IF (dipw_IntensfPresOk(nNutWeldGunNrSTK)==TRUE) THEN
                        bNutWeld_ManWeld_Step[9]=TRUE
                     ENDIF
                  ENDIF
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[7]==TRUE) AND (bNutWeld_ManWeld_Step[8]==FALSE)) THEN
                  ; Check for Nut Present
                  bSensorRetry=FALSE
                  IF (bByPassSmartelec==TRUE) THEN
                     bNutWeld_ManWeld_Step[8]=TRUE
                  ELSE
                     IF ($TIMER_FLAG[nNutWeldManWeldTmr]==TRUE) THEN
                        bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                        nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[nManWeldFault], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                     ELSE
                        rPrimaryValue = ABS(aiNutSensor(nNutWeldGunNrSTK));
                        WAIT SEC rSensorSettleTime;
                        rSecondaryValue = ABS(aiNutSensor(nNutWeldGunNrSTK));
                        IF (ABS(rPrimaryValue - rSecondaryValue) <= 2) THEN
                           rSensorSample=ABS(aiNutSensor(nNutWeldGunNrSTK))
                           IF ((rSensorSample <= (rNutInvertedValueInUse + rNutSensorTolInUse)) AND (rSensorSample >= (rNutInvertedValueInUse - rNutSensorTolInUse))) THEN
                              nManWeldFault=55
                              bSensorRetry=TRUE
                           ENDIF
                           IF ((rSensorSample <= (rNoNutValueInUse + rNutSensorTolInUse)) AND (rSensorSample >= (rNoNutValueInUse - rNutSensorTolInUse)) AND (bSensorRetry == FALSE)) THEN
                              nManWeldFault=54
                              bSensorRetry=TRUE
                           ENDIF
                           IF ((rSensorSample <= (rNutPresentValueInUse - rNutSensorTol2InUse)) AND (bSensorRetry == FALSE)) THEN
                              nManWeldFault=56
                              bSensorRetry=TRUE
                           ENDIF
                           IF (bSensorRetry==FALSE) THEN
                              nManWeldFault=0
                              bNutWeld_ManWeld_Step[8]=TRUE
                           ENDIF
                        ENDIF
                     ENDIF
                  ENDIF
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[6]==TRUE) AND (bNutWeld_ManWeld_Step[7]==FALSE)) THEN
                  ; Check for Gun Closed
                  IF ($TIMER_FLAG[nNutWeldManWeldTmr]==TRUE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[35], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ELSE
                     IF (bpw_GunAtWork(nNutWeldGunNrSTK)==TRUE) THEN
                        bNutWeld_ManWeld_Step[7]=TRUE
                     ENDIF
                  ENDIF
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[5]==TRUE) AND (bNutWeld_ManWeld_Step[6]==FALSE)) THEN
                  ; Check for Nut Fed
                  IF ($TIMER_FLAG[nNutWeldManWeldTmr]==TRUE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[49], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                     dopw_StartFeed(nNutWeldGunNrSTK,FALSE)
                  ELSE
                     IF (dipw_FeedComplt(nNutWeldGunNrSTK)==TRUE) THEN
                        bNutWeld_ManWeld_Step[6]=TRUE
                        ; Close the gun
                        dopw_StartFeed(nNutWeldGunNrSTK,FALSE)
                        dopw_NutIntensify(nNutWeldGunNrSTK,FALSE)
                        dopw_GunWork(nNutWeldGunNrSTK,TRUE)
                     ENDIF
                  ENDIF
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[4]==TRUE) AND (bNutWeld_ManWeld_Step[5]==FALSE)) THEN
                  ; Feed a Nut
                  dopw_StartFeed(nNutWeldGunNrSTK,TRUE)
                  bNutWeld_ManWeld_Step[5]=TRUE
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[3]==TRUE) AND (bNutWeld_ManWeld_Step[4]==FALSE)) THEN
                  ; Check for start conditions
                  IF (dipw_XtfmrTempOk(nNutWeldGunNrSTK)==FALSE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[50], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  IF (dipw_WaterOk(nNutWeldGunNrSTK)==FALSE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[5], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  IF (dipw_IntensfPresOk(nNutWeldGunNrSTK)==TRUE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[7], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  IF (dipw_Ready(nNutWeldGunNrSTK)==FALSE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[8], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  IF (dipw_Fault(nNutWeldGunNrSTK)==TRUE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[9], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  IF (dipw_SpearHome(nNutWeldGunNrSTK)==FALSE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[47], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  IF (dipw_PinReturn(nNutWeldGunNrSTK)==FALSE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[15], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  IF (bpw_GunAtHome(nNutWeldGunNrSTK)==FALSE) THEN
                     bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[51], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  bNutWeld_ManWeld_Step[4]=TRUE
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[2]==TRUE) AND (bNutWeld_ManWeld_Step[3]==FALSE)) THEN
                  IF (Exists_KrlDlg(nNutWeld_MWHandle, nNutWeld_MWKey)==FALSE) THEN
                     IF (nNutWeld_MWKey==1) THEN
                        bNutWeld_ManWeld_Step[3]=TRUE
                        dopw_SetPrgNr(nNutWeldGunNrSTK, nNutWeldSpotNrSTK )
                     ELSE
                        bNutWeld_ManWeld_Step[20]=TRUE ; Reset Process
                     ENDIF
                  ENDIF
                  nNutWeld_MWKey=0
               ENDIF
               IF ((bNutWeld_ManWeld_Active==TRUE) AND (bNutWeld_ManWeld_Step[1]==TRUE) AND (bNutWeld_ManWeld_Step[2]==FALSE)) THEN
                  bNutWeld_ManWeld_Step[2]=TRUE
                  NutWeld_MsgPar[1]={par_type #value, par_int 0}
                  NutWeld_MsgPar[1].par_int=nNutWeldGunNrSTK
                  NutWeld_MsgPar[2]={par_type #value, par_int 0}
                  NutWeld_MsgPar[2].par_int=nNutWeldSpotNrSTK
                  nNutWeld_MWHandle = Set_KrlDlg (NutWeld_Msg[34], NutWeld_MsgPar[], NutWeld_SK_OKCancel[], NutWeld_MsgOpt_NoStop)
               ENDIF
               IF ((bNutWeldManWeldSTK==TRUE) AND (bNutWeld_ManWeld_Step[1]==FALSE)) THEN
                  IF (bNutWeldWOJoining==FALSE) THEN
                     bNutWeld_ManWeld_Active=TRUE
                     bNutWeld_ManWeld_Step[1]=TRUE
                     dopw_GunWork(nNutWeldGunNrSTK,FALSE)
                     dopw_StartFeed(nNutWeldGunNrSTK,FALSE)
                     dopw_WeldInit(nNutWeldGunNrSTK,FALSE)
                     dopw_NutIntensify(nNutWeldGunNrSTK,FALSE)
                     NutWeldManual.GunNr=nNutWeldGunNrSTK
                     NutWeldManual.SpotNr=nNutWeldSpotNrSTK
                     PWInitUserIO(NutWeldManual)
                     $TIMER_STOP[nNutWeldManWeldTmr]=TRUE
                     $TIMER[nNutWeldManWeldTmr]=(nNutWeld_ManWeld_Timeout*(-1000))
                     $TIMER_STOP[nNutWeldManWeldTmr]=FALSE
                  ELSE
                     nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[33], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                     bNutWeldManWeldSTK=FALSE
                  ENDIF
               ENDIF
            ;ENDFOLD (USKB3-4 Manual NutWeld)
            ;FOLD USKB4 - Gun Maintenance Actions
               ;FOLD USKB4-2 Test Gun Force
                  IF ((bNutWeld_TstFrce_Active==TRUE) AND (bNutWeld_TstFrce_Step[10]==TRUE)) THEN
                     bNutWeld_TstFrce_Active=FALSE
                     bNutWeldTstFrceSTK=FALSE
                     dopw_GunWork(nNutWeldGunNrSTK,FALSE)
                     dopw_WeldInit(nNutWeldGunNrSTK,FALSE)
                     dopw_NutIntensify(nNutWeldGunNrSTK,FALSE)
                     dopw_SetPrgNr(nNutWeldGunNrSTK, 0)
                     $TIMER_STOP[nNutWeldManWeldTmr]=TRUE
                     $TIMER_STOP[nNutWeldSignalTmr]=TRUE
                     $TIMER[nNutWeldManWeldTmr]=-1000
                     $TIMER[nNutWeldSignalTmr]=-750
                     FOR nStepCnt=1 to 10
                        bNutWeld_TstFrce_Step[nStepCnt]=FALSE
                     ENDFOR
                  ENDIF
                  IF ((bNutWeld_TstFrce_Active==TRUE) AND (bNutWeld_TstFrce_Step[6]==TRUE) AND (bNutWeld_TstFrce_Step[7]==FALSE)) THEN
                     ; Wait Intensify Time
                     IF ($TIMER_FLAG[nNutWeldSignalTmr]==TRUE) THEN
                        $TIMER_STOP[nNutWeldSignalTmr]=TRUE
                        $TIMER[nNutWeldSignalTmr]=(-2000)
                        dopw_NutIntensify(nNutWeldGunNrSTK,FALSE)
                        dopw_GunWork(nNutWeldGunNrSTK,FALSE)
                        bNutWeld_TstFrce_Step[10]=TRUE
                        NutWeld_MsgPar[1]={par_type #value, par_int 0}
                        NutWeld_MsgPar[1].par_int=nNutWeldGunNrSTK
                        nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[44], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                     ENDIF
                  ENDIF
                  IF ((bNutWeld_TstFrce_Active==TRUE) AND (bNutWeld_TstFrce_Step[5]==TRUE) AND (bNutWeld_TstFrce_Step[6]==FALSE)) THEN
                     ; Check for Gun Closed
                     IF (($TIMER_FLAG[nNutWeldManWeldTmr]==TRUE) AND (bpw_GunAtHome(nNutWeldGunNrSTK)==TRUE)) THEN
                        bNutWeld_TstFrce_Step[10]=TRUE ; Reset Process
                        nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[35], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                     ELSE
                        IF (($TIMER_FLAG[nNutWeldSignalTmr]==TRUE) AND (bpw_GunAtHome(nNutWeldGunNrSTK)==FALSE)) THEN
                           ; Intensify Gun
                           dopw_NutIntensify(nNutWeldGunNrSTK,TRUE)
                           $TIMER_STOP[nNutWeldSignalTmr]=TRUE
                           $TIMER[nNutWeldSignalTmr]=(-2000)
                           $TIMER_STOP[nNutWeldSignalTmr]=FALSE
                           bNutWeld_TstFrce_Step[6]=TRUE
                        ENDIF
                     ENDIF
                  ENDIF
                  IF ((bNutWeld_TstFrce_Active==TRUE) AND (bNutWeld_TstFrce_Step[4]==TRUE) AND (bNutWeld_TstFrce_Step[5]==FALSE)) THEN
                     IF (Exists_KrlDlg(nNutWeld_TFHandle, nNutWeld_TFKey)==FALSE) THEN
                        IF (nNutWeld_TFKey==1) THEN
                           $TIMER_STOP[nNutWeldManWeldTmr]=FALSE
                           dopw_NutIntensify(nNutWeldGunNrSTK,FALSE)
                           dopw_GunWork(nNutWeldGunNrSTK,TRUE)
                           $TIMER_STOP[nNutWeldSignalTmr]=TRUE
                           $TIMER[nNutWeldSignalTmr]=(-2000)
                           $TIMER_STOP[nNutWeldSignalTmr]=FALSE
                           bNutWeld_TstFrce_Step[5]=TRUE
                        ELSE
                           bNutWeld_TstFrce_Step[10]=TRUE ; Reset Process
                        ENDIF
                     ENDIF
                     nNutWeld_TFKey=0
                  ENDIF
                  IF ((bNutWeldTstFrceSTK==TRUE) AND (bNutWeld_TstFrce_Step[3]==TRUE) AND (bNutWeld_TstFrce_Step[4]==FALSE)) THEN
                     bNutWeld_TstFrce_Active=TRUE
                     bNutWeld_TstFrce_Step[4]=TRUE
                     $TIMER_STOP[nNutWeldManWeldTmr]=TRUE
                     $TIMER[nNutWeldManWeldTmr]=(nNutWeld_ManWeld_Timeout*(-1000))
                     nNutWeld_TFKey=0
                     NutWeld_MsgPar[1]={par_type #value, par_int 0}
                     NutWeld_MsgPar[1].par_int=nNutWeldGunNrSTK
                     nNutWeld_TFHandle = Set_KrlDlg (NutWeld_Msg[38], NutWeld_MsgPar[], NutWeld_SK_TstCncl[], NutWeld_MsgOpt_NoStop)
                  ENDIF
                  IF ((bNutWeld_TstFrce_Active==TRUE) AND (bNutWeld_TstFrce_Step[2]==TRUE) AND (bNutWeld_TstFrce_Step[3]==FALSE)) THEN
                     ; Check for Gun Home
                     IF ($TIMER_FLAG[nNutWeldManWeldTmr]==TRUE) THEN
                        bNutWeld_TstFrce_Step[10]=TRUE ; Reset Process
                        nNutWeld_Handle_SPS=Set_Krlmsg (#NOTIFY, NutWeld_Msg[32], NutWeld_MsgPar[], NutWeld_MsgOpt_NoStop)
                     ELSE
                        IF (($TIMER_FLAG[nNutWeldSignalTmr]==FALSE) AND (bpw_GunAtHome(nNutWeldGunNrSTK)==TRUE)) THEN
                           ; Intensify Gun
                           $TIMER_STOP[nNutWeldSignalTmr]=TRUE
                           $TIMER[nNutWeldSignalTmr]=(-2000)
                           bNutWeld_TstFrce_Step[3]=TRUE
                        ENDIF
                     ENDIF
                  ENDIF
                  IF ((bNutWeld_TstFrce_Active==TRUE) AND (bNutWeld_TstFrce_Step[1]==TRUE) AND (bNutWeld_TstFrce_Step[2]==FALSE)) THEN
                     IF (Exists_KrlDlg(nNutWeld_TFHandle, nNutWeld_TFKey)==FALSE) THEN
                        IF (nNutWeld_TFKey==1) THEN
                           dopw_NutIntensify(nNutWeldGunNrSTK,FALSE)
                           dopw_GunWork(nNutWeldGunNrSTK,FALSE)
                           $TIMER_STOP[nNutWeldSignalTmr]=TRUE
                           $TIMER[nNutWeldSignalTmr]=(-3000)
                           $TIMER_STOP[nNutWeldSignalTmr]=FALSE
                           bNutWeld_TstFrce_Step[2]=TRUE
                        ELSE
                           bNutWeld_TstFrce_Step[10]=TRUE ; Reset Process
                        ENDIF
                     ENDIF
                     nNutWeld_TFKey=0
                  ENDIF
                  IF ((bNutWeldTstFrceSTK==TRUE) AND (bNutWeld_TstFrce_Step[1]==FALSE) AND (bpw_GunAtHome(nNutWeldGunNrSTK )==TRUE)) THEN
                     bNutWeld_TstFrce_Active=TRUE
                     bNutWeld_TstFrce_Step[1]=TRUE
                     bNutWeld_TstFrce_Step[2]=TRUE
                     bNutWeld_TstFrce_Step[3]=TRUE
                     nNutWeld_TFKey=0
                  ELSE
                     IF ((bNutWeldTstFrceSTK==TRUE) AND (bNutWeld_TstFrce_Step[1]==FALSE) AND (bpw_GunAtHome(nNutWeldGunNrSTK )==FALSE)) THEN
                        bNutWeld_TstFrce_Active=TRUE
                        bNutWeld_TstFrce_Step[1]=TRUE
                        nNutWeld_TFKey=0
                        NutWeld_MsgPar[1]={par_type #value, par_int 0}
                        NutWeld_MsgPar[1].par_int=nNutWeldGunNrSTK
                        nNutWeld_TFHandle = Set_KrlDlg (NutWeld_Msg[51], NutWeld_MsgPar[], NutWeld_SK_HomeGun[], NutWeld_MsgOpt_NoStop)
                        $TIMER_STOP[nNutWeldManWeldTmr]=TRUE
                        $TIMER[nNutWeldManWeldTmr]=(nNutWeld_ManWeld_Timeout*(-1000))
                     ENDIF
                  ENDIF
               ;ENDFOLD (USKB4-2 Test Gun Force)
               ;FOLD USKB4-3 Teach Analog
                  ;FOLD USKB4-2.4 Check
                     IF ((bNutWeld_AlgCheck_Active==TRUE) AND (bNutWeld_AlgCheck_Step[10]==TRUE)) THEN
                        bNutWeld_AlgCheck_Active=FALSE
                        bNutWeldAlgCheckReq=FALSE
                        FOR nStepCnt=1 to 10
