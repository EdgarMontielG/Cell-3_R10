         SWITCH nGunNr
            CASE 1
               dopw1_AdvancePin=bState
               dopw1_ReturnPin=NOT (bState)
            CASE 2
               dopw2_AdvancePin=bState
               dopw2_ReturnPin=NOT (bState)
            CASE 3
               dopw3_AdvancePin=bState
               dopw3_ReturnPin=NOT (bState)
