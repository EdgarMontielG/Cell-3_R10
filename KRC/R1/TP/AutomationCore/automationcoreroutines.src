END ; (GetCycTime)

DEFFCT REAL AC_POW(rBase:IN, iExponent:IN)
   
   DECL REAL rBase, rResult
   DECL INT iExponent, i
   
   IF iExponent == 0 THEN
      rResult = 1.0
   ELSE
      IF iExponent < 0 THEN
         IF rBase == 0 THEN
            ; Ungueltige Eingabe, da Division durch 0
            WAIT FOR FALSE
            ; error, division by 0
         ENDIF
         iExponent = iExponent * (-1)
         rResult = rBase
         FOR i = 1 TO (iExponent - 1)
            rResult = rResult * rBase
         ENDFOR
         rResult = 1 / rResult
      ELSE
         rResult = rBase
         FOR i = 1 TO (iExponent - 1)
            rResult = rResult * rBase
         ENDFOR
      ENDIF
   ENDIF
   
   RETURN rResult
   
ENDFCT

GLOBAL DEFFCT BOOL AC_CheckSphWZ (pCenter: IN, nRadius: IN )
   ;FOLD Details
      ;FOLD Declaration
         E6POS pCenter
         INT nRadius
         BOOL bResult
         REAL pdx, pdy, pdz
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         IF ((VARSTATE("pCenter") == #INITIALIZED) AND (VARSTATE("nRadius") == #INITIALIZED))THEN
            pdx = PosCheck.x - pCenter.x;		// vector from pt1 to test point.
            pdy = PosCheck.y - pCenter.y;
            pdz = PosCheck.z - pCenter.z;
            
            bResult = (((pdx*pdx) + (pdy*pdy) + (pdz*pdz)) <= (nRadius*nRadius))
            RETURN (bResult)
         ELSE
            RETURN (FALSE)
         ENDIF
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
ENDFCT ; (AC_CheckSphWZ)

GLOBAL DEF AC_DeleteLine(nMsg :IN, nOpt1 :IN, nOpt2 :IN, nOpt3 :IN )
   ;FOLD Details
      ;FOLD Declaration
         DECL INT nMsg
         DECL INT nOpt1
         DECL INT nOpt2
         DECL INT nOpt3
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         LOOP
            IF (VARSTATE("nMsg")<>#INITIALIZED) THEN
               nMsg=1
            ENDIF
            IF (VARSTATE("nOpt1")==#INITIALIZED) THEN
               AutoCore_MsgPar[1]={par_type #value, par_int 0}
               AutoCore_MsgPar[1].par_int=nOpt1
            ENDIF
            IF (VARSTATE("nOpt2")==#INITIALIZED) THEN
               AutoCore_MsgPar[2]={par_type #value, par_int 0}
               AutoCore_MsgPar[2].par_int=nOpt2
            ENDIF
            IF (VARSTATE("nOpt3")==#INITIALIZED) THEN
               AutoCore_MsgPar[3]={par_type #value, par_int 0}
               AutoCore_MsgPar[3].par_int=nOpt3
            ENDIF
            nAutoCore_Handle = Set_Krlmsg (#QUIT, AutomationCore_Msg[nMsg], AutoCore_MsgPar[], AutoCore_MsgOpt_Stop)
            WHILE (Exists_KrlMsg(nAutoCore_Handle))
               WAIT SEC 0.024
            ENDWHILE
         ENDLOOP
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (AC_DeleteLine)

