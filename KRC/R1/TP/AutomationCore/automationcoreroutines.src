DEF SetWaitingMessage(KrlmsgDisplay :IN, bCondition :OUT, bState :IN )
   ;FOLD Details
      ;FOLD Declaration
         DECL KRLMSG_T KrlmsgDisplay
         DECL BOOL bCondition
         DECL BOOL bState
         DECL BOOL bMsgExt
         DECL BOOL bMsgSimulate
         DECL BOOL bMsgClear
         DECL KRLMSG_T SimulateMsg
         DECL INT nMsgLength
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         bMsgSimulate = FALSE
         bAutoCoreSubmit_Clear=FALSE
         IF ($MODE_OP==#EX) THEN
            nWaitMsg_Handle = Set_Krlmsg (#STATE, KrlmsgDisplay, AutoCore_MsgPar[], AutoCore_MsgOpt_NoStop)
            bMsgExt=TRUE
         ELSE
            nWaitMsg_Handle = Set_Krlmsg (#WAITING, KrlmsgDisplay, AutoCore_MsgPar[], AutoCore_MsgOpt_NoStop)
            bMsgExt=FALSE
         ENDIF
         WHILE ((bCondition <> bState) AND (bMsgSimulate==FALSE))
            IF (nWaitMsg_Handle > 0) THEN
               IF ($ERR.Int_Prio>0) THEN
                  BRAKE
               ENDIF
               WAIT SEC 0.012
               IF ((Exists_KrlMsg(nWaitMsg_Handle)==FALSE) AND (bAutoCoreSubmit_Clear==FALSE)) THEN
                  nWaitMsg_Handle = 0
                  bMsgSimulate=TRUE
                  bMsgClear = StrClear(SimulateMsg.Msg_Txt[])
                  nMsgLength = StrAdd(SimulateMsg.Msg_Txt[],"{")
                  nMsgLength = StrAdd(SimulateMsg.Msg_Txt[],KrlmsgDisplay.Msg_Txt[])
                  nMsgLength = StrAdd(SimulateMsg.Msg_Txt[],"}")
                  nMsgLength = StrAdd(SimulateMsg.Msg_Txt[]," has been simulated.")
                  bMsgClear = StrCopy(SimulateMsg.Modul[],KrlmsgDisplay.Modul[])
                  SimulateMsg.Nr = 1001
                  IF (nMsgLength==0) THEN
                     bMsgClear = StrClear(SimulateMsg.Msg_Txt[])
                     SimulateMsg.Msg_Txt[] = "Signal wait condition has been simulated"
                  ENDIF
                  nLogOnlyMsg_Handle = Set_Krlmsg (#STATE, SimulateMsg, AutoCore_MsgPar[], AutoCore_MsgOpt_NoStop)
                  IF (Exists_KrlMsg(nLogOnlyMsg_Handle)==TRUE) THEN
                     bMsgClear=Clear_KRLMsg(nLogOnlyMsg_Handle)
                  ENDIF
               ELSE
                  IF (($MODE_OP<>#EX) AND ((bMsgExt==TRUE) OR (Exists_KrlMsg(nWaitMsg_Handle)==FALSE))) THEN
                     bAutoCoreSubmit_Clear=FALSE
                     bMsgClear=Clear_KRLMsg(nWaitMsg_Handle)
                     bMsgExt=FALSE
                     nWaitMsg_Handle = Set_Krlmsg (#WAITING, KrlmsgDisplay, AutoCore_MsgPar[], AutoCore_MsgOpt_NoLog)
                  ENDIF
                  IF (($MODE_OP==#EX) AND ((bMsgExt==FALSE) OR (Exists_KrlMsg(nWaitMsg_Handle)==FALSE))) THEN
                     bAutoCoreSubmit_Clear=FALSE
                     bMsgClear=Clear_KRLMsg(nWaitMsg_Handle)
                     bMsgExt=TRUE
                     nWaitMsg_Handle = Set_Krlmsg (#STATE, KrlmsgDisplay, AutoCore_MsgPar[], AutoCore_MsgOpt_NoLog)
                  ENDIF
               ENDIF
            ENDIF
         ENDWHILE
         bMsgSimulate=FALSE
         IF (Exists_KrlMsg(nWaitMsg_Handle)==TRUE) THEN
            bMsgClear=Clear_KRLMsg(nWaitMsg_Handle)
            nWaitMsg_Handle = 0
         ENDIF
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (SetWaitingMessage)

;FOLD Check ToolID
   GLOBAL DEFFCT BOOL ToolID (iToolNo:IN)
      
      INT iToolNo
      INT maxToolNo
      maxToolNo = 2
      IF (NOT (VARSTATE("iToolNo")==#INITIALIZED)) THEN
         RETURN(FALSE)
      ENDIF
      IF (NOT ((iToolNo>=0) AND (iToolNo<=maxToolNo))) THEN
         RETURN(FALSE)
      ENDIF
      IF (iToolNo==go123ToolID) THEN
         RETURN(TRUE)
      ELSE
         RETURN(FALSE)
      ENDIF
      
   ENDFCT
   
;ENDFOLD (Check ToolID)

GLOBAL DEF AC_Request_to_enter( )
   ;FOLD Details
      ;FOLD Declaration
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         
         IF di006RequestToEnter AND NOT (dipw1_GunAtWork OR dipw2_GunAtWork OR dipw3_GunAtWork OR do932GripperInProcess OR do931BrakeTestInProcess OR do930MasterRefInProcess) THEN     ;NUT / GRIPPER / BRAKETEST / MASTERREF  
            doCriticalWZ = FALSE     ; request to enter allowed!            
            WAIT FOR (di006RequestToEnter)==FALSE
         ELSE
            doCriticalWZ = TRUE     ; request to enter not allowed!          
         ENDIF
         
         IF (doCriticalWZ AND NOT $MOVE_ENABLE) THEN
            $LOOP_MSG[] = " Critical Process interrupted by General Motion enable                                                                          "
         ENDIF
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (AC_Request_to_enter)

GLOBAL DEF AC_Process_Count(eProcessCount:IN)
   ;FOLD Details
   ; INIT: Reset the current Process Counter
   ; Count1up: add 1 after a successful weld, clinch or rivet
   ; Check: verify all process points are done, otherwise set do047QualityFault
      ;FOLD Declaration
         DECL MyCountCmd eProcessCount
         INT ResetStyle, ResetOption 
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
      geProcessCount=eProcessCount
         SWITCH eProcessCount
            CASE #INIT
               do047QualityFault = FALSE
               IF bResetProcessCount THEN
                  FOR ResetStyle = 1 TO 31
                     FOR ResetOption = 1 TO 255
                        WeldCount[ResetStyle,ResetOption] = 0 
                     ENDFOR
                  ENDFOR
                  bResetProcessCount=FALSE
               ENDIF
            CASE #Count1up
               SWITCH  nStyle 
                  CASE 1   ; select with nStyle
                     SWITCH  nOption 
                        CASE 1,2,3,4,5,6,7,8,9   ; select with nOption
                           WeldCount[nStyle,nOption] = WeldCount[nStyle,nOption] + 1 
                        DEFAULT
                           ; wrong option selected
                           do047QualityFault = TRUE
                     ENDSWITCH
                  DEFAULT
                     ; wrong style selected
                     do047QualityFault = TRUE
               ENDSWITCH
            CASE #Check
               WAIT FOR TRUE
               IF ((nStyle>0) AND (nOption>0)) THEN
                  do047QualityFault = (WeldCount[nStyle,nOption]<>WeldNoRequired[nStyle,nOption]) 
               ELSE
                  ; nStyle or nOption invalid
                  do047QualityFault =TRUE
               ENDIF         
               IF do047QualityFault THEN
                  WAIT SEC 5
               ENDIF
               bResetProcessCount=TRUE
         ENDSWITCH
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (AC_Process_Count)

