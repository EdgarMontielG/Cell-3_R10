&ACCESS RO3
&REL 11
DEF AutomationCoreRoutines( )
   
END

GLOBAL DEF AutomationCore_Bkg( )
   ;FOLD Details
      ;FOLD Declaration
         DECL INT nAC_MsgQty
         DECL MSGBUF_T gAC_MsgLog[100]
         DECL INT nAC_MsgCtr
         DECL BOOL bTDVlvMan
         DECL BOOL bSRWTD
         DECL BOOL bEOATIn
         DECL BOOL bWeldCtrl1
         DECL BOOL bRPWSealrDArc1
         DECL BOOL bPSE
         DECL BOOL bMigRmr
         DECL BOOL bEOATVlvMan
         DECL BOOL bVlvMan
         DECL BOOL bRPWWeldCtrl
         DECL BOOL bRPWSealrDArc2
         DECL BOOL bVlvMan2
         DECL BOOL bWeldCtrl2
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         IF (di004UseDryCycle==TRUE) THEN
            dopw1_WeldContactEnable=FALSE
            dopw1_WeldOnExternal=FALSE
            dopw2_WeldContactEnable=FALSE
            dopw2_WeldOnExternal=FALSE
            dopw3_WeldContactEnable=FALSE
            dopw3_WeldOnExternal=FALSE
         ELSE
            dopw1_WeldContactEnable=TRUE
            dopw1_WeldOnExternal=TRUE
            dopw2_WeldContactEnable=TRUE
            dopw2_WeldOnExternal=TRUE
            dopw3_WeldContactEnable=TRUE
            dopw3_WeldOnExternal=TRUE
         ENDIF
         ; TOOL ID TO PLC
         ; see go123ToolID
         do123ToolIDBit0 = di823ToolIDBit0
         do124ToolIDBit1 = di825ToolIDBit1
         AC_Request_to_enter( )
         ;FOLD Mainline Auto Select
            IF (($PRO_STATE1==#P_FREE) AND ($MODE_OP==#EX) AND (bACMainLine==FALSE)) THEN
               bACMainLine=TRUE
               CWRITE($CMD,AC_STAT,AC_MODE,"RUN /R1/CELL ()")
            ELSE
               IF ($MODE_OP==#T1) OR ($MODE_OP==#T2) THEN
                  bACMainLine=FALSE
               ENDIF
            ENDIF
            IF (($MODE_OP==#EX) AND (bACMainLineReset==TRUE)) THEN
               IF (($PRO_STATE1==#P_RESET) OR ($PRO_STATE1==#P_ACTIVE) OR ($PRO_STATE1==#P_STOP) OR ($PRO_STATE1==#P_END)) THEN
                  CWRITE($CMD,AC_STAT,AC_MODE,"STOP 1")
                  WAIT SEC 0.100
                  CWRITE($CMD,AC_STAT,AC_MODE,"CANCEL 1")
                  bACMainLineReset=FALSE
                  bACMainLine=FALSE
               ENDIF
            ENDIF
         ;ENDFOLD (Program Reset/Cancel)
         ;FOLD Program Reset/Cancel
            IF ((($PRO_STATE1==#P_FREE) OR ($PRO_STATE1==#P_RESET)) AND (bACProcessReset==FALSE)) THEN
               bACProcessReset=TRUE
               AC_ProcessReset( )
            ELSE
               IF (($PRO_STATE1<>#P_FREE) AND ($PRO_STATE1<>#P_RESET)) THEN
                  bACProcessReset=FALSE
               ENDIF
            ENDIF
         ;ENDFOLD (Program Reset/Cancel)
         ;FOLD Automation Core Cyclical Monitoring
            ;FOLD Battery Monitoring
               SWITCH $ACCU_STATE
                  CASE #CHARGE_OK
                     do006RobotBatteryAlarm=FALSE
                  CASE #CHARGE_OK_LOW
                     do006RobotBatteryAlarm=TRUE
                  CASE #CHARGE_UNKNOWN
                     do006RobotBatteryAlarm=TRUE
                  CASE #CHARGE_TEST_NOK
                     do006RobotBatteryAlarm=TRUE
                  CASE #CHARGE_NOK
                     do006RobotBatteryAlarm=TRUE
                  CASE #CHARGE_OFF
                     do006RobotBatteryAlarm=TRUE
               ENDSWITCH
            ;ENDFOLD (Battery Monitoring)
            do046WeldMode = (NOT di004UseDryCycle)
            do021BrakeTestReqd = (($BRAKETEST_MONTIME==TRUE) OR ($BRAKETEST_REQ_EX==TRUE) OR ($BRAKETEST_REQ_INT==TRUE))
            do022MstrRefRequired = ($MasteringTest_Req_Int==TRUE)
            gdoAxis1Posn=$AXIS_ACT.A1 + nA1Offset
            do094AirOK= (dipw1_AirOK AND dipw2_AirOK AND dipw3_AirOK)
            do013WaterIsOn = ((di472WaterTempOK AND di474WaterOk) AND (di520WaterTempOK AND di522WaterOk) AND (di568WaterTempOK AND di570WaterOk))
            do107Hopper1LowLevel= NOT dipw1_HopperLowLevel
            do108Hopper2LowLevel= NOT dipw2_HopperLowLevel
            do110Hopper3LowLevel= NOT dipw3_HopperLowLevel
            do111Gun1ElectrodeChange= dipw1_EndofStepper
            do112Gun2ElectrodeChange= dipw2_EndofStepper
            do113Gun3ElectrodeChange= dipw3_EndofStepper
            do118Nut1Ready= (dipw1_Ready AND NOT dipw1_Fault)
            do119Nut2Ready= (dipw2_Ready AND NOT dipw2_Fault)
            do120Nut3Ready= (dipw3_Ready AND NOT dipw3_Fault)
            do134Nut1Fault= (dipw1_Fault OR NOT dipw1_Ready)
            do135Nut2Fault= (dipw2_Fault OR NOT dipw2_Ready)
            do136Nut3Fault= (dipw3_Fault OR NOT dipw3_Ready)
            
            IF di013WaterEnable==TRUE THEN
               do475StartWater=TRUE
               do523StartWater=TRUE
               do571StartWater=TRUE
               ELSE
            ENDIF
            
            do464WaterBeacon = (di472WaterTempOK AND di474WaterOk)
            do512WaterBeacon = (di520WaterTempOK AND di522WaterOk)
            do560WaterBeacon = (di568WaterTempOK AND di570WaterOk)
            
            ; sends to PLC when the robot isn`t in 100%
            IF (($MODE_OP==#EX) AND NOT ($OV_PRO==100)) THEN
               do146SpeedNot100=TRUE
            ELSE 
               do146SpeedNot100=FALSE
            ENDIF
            
            ;FOLD Positional Monitoring
               IF (VARSTATE("$POS_ACT")==#INITIALIZED) THEN
                  ON_ERROR_PROCEED
                  PosCheck = $POS_ACT
                  IF ($ERR.NUMBER<>1419) THEN
                     do007RobotAtPounce=AC_CheckSphWZ(xPounce,$Pounce_POS_TOL)
                     do009RobotAtRepair=AC_CheckSphWZ(xRepair,$Repair_POS_TOL)
                     do010RobotAtTipDress=AC_CheckSphWZ(xTipDress,$TipDress_POS_TOL)
                     do051RbtAtMstrRefSwitch=AC_CheckSphWZ(xRefSwitch,$RefSwitch_POS_TOL)
                     IF ((($WORKSPACE[1].X<>0.0) OR ($WORKSPACE[1].Y<>0.0) OR ($WORKSPACE[1].Z<>00)) AND ($WORKSPACE[1].MODE==#OFF)) THEN
                        $WORKSPACE[1].MODE=#OUTSIDE
                     ENDIF
                     IF ((($WORKSPACE[2].X<>0.0) OR ($WORKSPACE[2].Y<>0.0) OR ($WORKSPACE[2].Z<>00)) AND ($WORKSPACE[2].MODE==#OFF)) THEN
                        $WORKSPACE[2].MODE=#OUTSIDE
                     ENDIF
                  ELSE
                     IF ($WORKSPACE[1].MODE<>#OFF) THEN
                        $WORKSPACE[1].MODE=#OFF
                     ENDIF
                     IF ($WORKSPACE[2].MODE<>#OFF) THEN
                        $WORKSPACE[2].MODE=#OFF
                     ENDIF
                  ENDIF
               ENDIF
            ;ENDFOLD (Positional Monitoring)
         ;ENDFOLD (Automation Core Cyclical Monitoring)
         ;FOLD Bus Status IO
            ;FOLD Initialize boolean variables
               bTDVlvMan = FALSE
               bSRWTD = FALSE
               bEOATIn = FALSE
               bWeldCtrl1 = FALSE
               bRPWSealrDArc1 = FALSE
               bPSE = FALSE
               bMigRmr = FALSE
               bEOATVlvMan = FALSE
               bVlvMan = FALSE
               bRPWWeldCtrl = FALSE
               bRPWSealrDArc2 = FALSE
               bVlvMan2 = FALSE
               bWeldCtrl2 = FALSE
            ;ENDFOLD (Initialize boolean variables)
            ;FOLD Check IO Status
               IF ((IsMessageSet(10043)==TRUE) OR (IsMessageSet(10045)==TRUE)) THEN
                  nAC_MsgQty = GET_MSGBUFFER(gAC_MsgLog[])
                  IF (nAC_MsgQty > 0) THEN
                     FOR nAC_MsgCtr = 1 TO nAC_MsgQty
                        IF ((gAC_MsgLog[nAC_MsgCtr].NR==10043) OR (gAC_MsgLog[nAC_MsgCtr].NR==10045)) THEN
                           bRPWWeldCtrl = bRPWWeldCtrl OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"RPW_WELD_CONTROLLER",#NOT_CASE_SENS)
                           bTDVlvMan = bTDVlvMan OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"TD_VLV_MANIFOLD",#NOT_CASE_SENS)
                           bEOATVlvMan = bEOATVlvMan OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"EOAT_VLV_MANIFOLD",#NOT_CASE_SENS)
                           bMigRmr = bMigRmr OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"MIG_REAMER",#NOT_CASE_SENS)
                           bSRWTD = bSRWTD OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"SRW_TD",#NOT_CASE_SENS)
                           bEOATIn = bEOATIn OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"EOAT_INPUTS",#NOT_CASE_SENS)
                           bWeldCtrl1 = bWeldCtrl1 OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"WELD_CONTROLLER",#NOT_CASE_SENS)
                           bRPWSealrDArc1 = bRPWSealrDArc1 OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"RPW_SEALER_DRAWN_ARC",#NOT_CASE_SENS)
                           bPSE = bPSE OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"PSE",#NOT_CASE_SENS)
                           bRPWSealrDArc2 = bRPWSealrDArc2 OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"RPW_SEALER_DRAWN_ARC_2",#NOT_CASE_SENS)
                           bVlvMan = bVlvMan OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"VLV_MANIFOLD",#NOT_CASE_SENS)
                           bVlvMan2 = bVlvMan2 OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"VLV_MANIFOLD_2",#NOT_CASE_SENS)
                           bWeldCtrl2 = bWeldCtrl2 OR STRCOMP(gAC_MsgLog[nAC_MsgCtr].PAR_TXT1[],"WELD_CONTROLLER_2",#NOT_CASE_SENS)
                        ENDIF
                     ENDFOR
                  ENDIF
               ENDIF
            ;ENDFOLD (Check IO Status)
            ;FOLD Set IO Bits
               do048RPWCtrlrEnetOK = ((bRPWWeldCtrl==FALSE) AND (bRPWWeldCtrl_Enable==TRUE))
               do050TDVlvManifold = ((bTDVlvMan==FALSE) AND (bTDVlvMan_Enable==TRUE))
               do052EOATVlvMnfldEnetOK =true; ((bEOATVlvMan==FALSE) AND (bEOATVlvMan_Enable==TRUE))
               do053MigReamerEnetOK = ((bMigRmr==FALSE) AND (bMigRmr_Enable==TRUE))
               do054SRWTipDressIOEnetOK = ((bSRWTD==FALSE) AND (bSRWTD_Enable==TRUE))
               do055EndEffectorIOEnetOK = ((bEOATIn==FALSE) AND (bEOATIn_Enable==TRUE))
               do056WeldCntl1EnetOK = ((bWeldCtrl1==FALSE) AND (bWeldCtrl1_Enable==TRUE))
               do057RPWSlrDArc1EnetOK = ((bRPWSealrDArc1==FALSE) AND (bRPWSealrDArc1_Enable==TRUE))
               do058PinScribeCntlrIOOK = ((bPSE==FALSE) AND (bPSE_Enable==TRUE))
               do059RPWSlrDArc2EnetOK = ((bRPWSealrDArc2==FALSE) AND (bRPWSealrDArc2_Enable==TRUE))
               do060VlvManifoldEnetOK = ((bVlvMan==FALSE) AND (bVlvMan_Enable==TRUE))
            ;ENDFOLD (Set IO Bits)
         ;ENDFOLD (Bus Status IO)
         ;FOLD Wait Message Reset
            IF ((Exists_KrlMsg(nWaitMsg_Handle)==TRUE) AND ($PRO_STATE1<>#P_ACTIVE) AND (bAutoCoreSubmit_Clear==FALSE)) THEN
               bAutoCoreSubmit_Clear = Clear_KRLMsg(nWaitMsg_Handle)
            ENDIF
         ;ENDFOLD (Wait Message Reset)
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (AutomationCore_Bkg)

GLOBAL DEF InitializeSystem( )
   ;FOLD Details
      ;FOLD Declaration
         DECL CHAR DMY[3]
         DMY[]="---"
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         ;FOLD BASISTECH INI
            GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
            INTERRUPT ON 3 
            BAS (#INITMOV,0 )
         ;ENDFOLD (BASISTECH INI)
         ;FOLD HomeCheck
            HomeCheck()
            Stop_at_End_of_Cycle = FALSE
         ;ENDFOLD (HomeCheck)
         ;FOLD Process Reset
            AC_ProcessReset( )
         ;ENDFOLD (Process Reset)
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (InitializeSystem)

GLOBAL DEF MaintainSystem( )
   ;FOLD Details
      ;FOLD Declaration
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         bOption1=FALSE
         bOption2=FALSE
         bOption3=FALSE
         bOption4=FALSE
         bOption5=FALSE
         bOption6=FALSE
         bOption7=FALSE
         bOption8=FALSE
         nStyle=0  
         nOption=0
         nPickUp=0 
         nApps=0   
         nDropOff=0
         gdoStyleAckn=0
         gdoPickupClear=31
         gdoApplicationClear=31
         gdoDropOffClear=31
         gdoRepositionTooling=0
         gdoRobotClearZone=127
         do023PickClearTooling=TRUE
         do024ApplClrTooling=TRUE
         do025DropClearTooling=TRUE
         do004ProcessFault=FALSE
         do005RobotInCycle = FALSE
         do015WorkComplete=FALSE
         do047QualityFault = FALSE
         AC_Process_Count(#INIT)
         do091RobotReadyCapChange=FALSE
         gdoOptionAckn=0
         gdoProcessSync=0
         do141RedRabbitFailed=FALSE
         do142RedRabbitPassed=FALSE
         
         ; add to stop robot in Maintain system
         Stop_at_End_of_Cycle = Stop_at_End_of_Cycle OR di147SEOC   ;Operator or PLC request stop at end of cycle
         WHILE Stop_at_End_of_Cycle
            $LOOP_MSG[] = "                                                                                                                                " 
            IF di147SEOC THEN
               $LOOP_MSG[] = " Stop_at_End_of_Cycle is selected by PLC ( Robot Input 147, di147SEOC )                                                         "
            ELSE
               $LOOP_MSG[] = " Stop_at_End_of_Cycle is selected by User                                                                                       "
            ENDIF
            WAIT SEC 1
         ENDWHILE
         $LOOP_MSG[] = "                                                                                                                                " 
         
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (MaintainSystem)

GLOBAL DEF HomeCheck( )
   ;FOLD Details
      ;FOLD Declaration
         DECL BOOL bMsgRelease
         GLOBAL INTERRUPT DECL IR_HOME WHEN $T1==FALSE DO IR_HOME_T1 ( )
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         bMsgRelease=FALSE
         WHILE ($IN_HOME==FALSE)
            IF (($MODE_OP==#EX) AND (do007RobotAtPounce==TRUE)) THEN
               PounceToHome()
            ELSE
               do004ProcessFault=TRUE
               ;FOLD Dialog "Robot is not home.  To Allow Robot To Move Home Select Continue"
                  REPEAT
                     nAutoCore_Handle = Set_KrlDlg (AutomationCore_Msg[3], AutoCore_MsgPar[], AC_SK_ContNav[], AutoCore_MsgOpt_Stop)
                     IF (nAutoCore_Handle > 0) THEN
                        WHILE (Exists_KrlDlg(nAutoCore_Handle, nAutoCore_Key))
                           do004ProcessFault=TRUE
                           WAIT SEC 0.024
                        ENDWHILE
                        do004ProcessFault=FALSE
                        SWITCH nAutoCore_Key
                           CASE 1 ; Diagnostic
                              nAutoCore_Handle = Set_Krlmsg (#QUIT, AutomationCore_Msg[2], AutoCore_MsgPar[], AutoCore_MsgOpt_Stop)
                              WHILE (Exists_KrlMsg(nAutoCore_Handle))
                                 WAIT SEC 0.024
                              ENDWHILE
                           CASE 2 ; Continue
                              REPEAT
                                 WAIT FOR TRUE
                                 $OV_PRO=0
                                 WAIT FOR $T1
                                 INTERRUPT ON IR_HOME
                              UNTIL $T1					
                              ;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
                                 $H_POS=XHOME
                                 PDAT_ACT=PDEFAULT
                                 BAS (#PTP_DAT )
                                 FDAT_ACT=FHOME
                                 BAS (#FRAMES )
                                 BAS (#VEL_PTP,100 )
                                 PTP  XHOME
                              ;ENDFOLD
                              WAIT FOR TRUE
                              INTERRUPT OFF IR_HOME					  
                              do004ProcessFault=FALSE
                              bMsgRelease = TRUE
                        ENDSWITCH
                     ENDIF
                  UNTIL (bMsgRelease==TRUE)
                  bMsgRelease=FALSE
               ;ENDFOLD (Dialog)
            ENDIF
         ENDWHILE
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (HomeCheck)

GLOBAL DEF IR_HOME_T1( )
   ;FOLD Details
      ;FOLD Declaration
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         INTERRUPT OFF IR_HOME
         $OV_PRO=0
         WAIT FOR $T1
         WAIT FOR TRUE
         INTERRUPT ON IR_HOME
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (IR_HOME_T1)

GLOBAL DEF GetOptions( )
   ;FOLD Details
      ;FOLD Declaration
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         bOption1=((nOption B_AND 1) > 0)
         do038OptionAckn1=bOption1
         bOption2=((nOption B_AND 2) > 0)
         do039OptionAckn2=bOption2
         bOption3=((nOption B_AND 4) > 0)
         do040OptionAckn3=bOption3
         bOption4=((nOption B_AND 8) > 0)
         do041OptionAckn4=bOption4
         bOption5=((nOption B_AND 16) > 0)
         do042OptionAckn5=bOption5
         bOption6=((nOption B_AND 32) > 0)
         do043OptionAckn6=bOption6
         bOption7=((nOption B_AND 64) > 0)
         do044OptionAckn7=bOption7
         bOption8=((nOption B_AND 128) > 0)
         do045OptionAckn8=bOption8
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (GetOptions)

GLOBAL DEF EndOfCycle( )
   ;FOLD Details
      ;FOLD Declaration
      ;ENDFOLD (Declaration)
      INT S,O
      ;FOLD Implementation
         ;AC_Process_Count(#CHECK)
         ;======SL====do015WorkComplete=TRUE
         ;WHILE (di015WorkCompleteAckn==FALSE)
            ;FOLD Status Waiting for Work Complete Ackn.
               ;IF (Exists_KrlMsg(nWorkComplete_Handle)==FALSE) THEN
                  ;nWorkComplete_Handle=Set_Krlmsg (#STATE, AutomationCore_Msg[4], AutoCore_MsgPar[], AutoCore_MsgOpt_NoStop)
               ;ENDIF
            ;ENDFOLD (Status)
         ;ENDWHILE
         ;======SL====do005RobotInCycle = FALSE
         bAutoCore_Clear=Clear_KRLMsg(nWorkComplete_Handle)
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (EndOfCycle)

GLOBAL DEF CriticalWZ(bState :IN )
   ;FOLD Details
      ;FOLD Declaration
         DECL BOOL bState
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         TRIGGER WHEN DISTANCE=0 DELAY=0 DO doCriticalWZ=bState
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (CriticalWZ)

GLOBAL DEF AC_ProcessSync(nProcess :IN )
   ;FOLD Details
      ;FOLD Declaration
         DECL INT nProcess
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         gdoProcessSync = AC_POW(2,(nProcess-1))
         WHILE (gdoProcessSync <> gdiProcessSync)
            ;FOLD Dialog "Waiting for Process %1 Synchronization(DI-%2)."
               AutoCore_MsgPar[1]={par_type #value, par_int 0}
               AutoCore_MsgPar[1].par_int=nProcess
               AutoCore_MsgPar[2]={par_type #value, par_int 0}
               AutoCore_MsgPar[2].par_int=nProcess + 60
               nProcRequest_Handle = Set_Krlmsg (#STATE, AutomationCore_Msg[18], AutoCore_MsgPar[], AutoCore_MsgOpt_NoStop)
               IF (nProcRequest_Handle > 0) THEN
                  WHILE (Exists_KrlMsg(nProcRequest_Handle))
                     WAIT SEC 0.012
                     IF (gdoProcessSync == gdiProcessSync) THEN
                        bAutoCore_Clear=Clear_KRLMsg(nProcRequest_Handle)
                     ENDIF
                  ENDWHILE
               ENDIF
            ;ENDFOLD (Dialog)
         ENDWHILE
         gdoProcessSync=0
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (AC_ProcessSync)

GLOBAL DEF AC_Application(nApplication :IN, bState :IN )
   ;FOLD Details
      ;FOLD Declaration
         DECL INT nApplication
         DECL BOOL bState
         DECL BOOL bMsgRelease
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         bMsgRelease=FALSE
         SWITCH nApplication
            CASE 1
               do070ApplicationClear1 = bState
            CASE 2
               do071ApplicationClear2 = bState
            CASE 3
               do072ApplicationClear3 = bState
            CASE 4
               do073ApplicationClear4 = bState
            CASE 5
               do074ApplicationClear5 = bState
            DEFAULT
               do004ProcessFault=TRUE
               ;FOLD Dialog "Application %1 is invalid.  Reprogram with application 1 - 5."
                  REPEAT
                     AutoCore_MsgPar[1]={par_type #value, par_int 0}
                     AutoCore_MsgPar[1].par_int=nApplication
                     nAutoCore_Handle = Set_KrlDlg (AutomationCore_Msg[8], AutoCore_MsgPar[], AC_SK_DIAG[], AutoCore_MsgOpt_Stop)
                     IF (nAutoCore_Handle > 0) THEN
                        WHILE (Exists_KrlDlg(nAutoCore_Handle, nAutoCore_Key))
                           do004ProcessFault=TRUE
                           IF ($ERR.Int_Prio>0) THEN
                              BRAKE
                           ENDIF
                           WAIT SEC 0.024
                        ENDWHILE
                        do004ProcessFault=FALSE
                        SWITCH nAutoCore_Key
                           CASE 1 ; Diagnostic
                              do004ProcessFault=FALSE
                              nAutoCore_Handle = Set_Krlmsg (#QUIT, AutomationCore_Msg[2], AutoCore_MsgPar[], AutoCore_MsgOpt_Stop)
                              WHILE (Exists_KrlMsg(nAutoCore_Handle))
                                 WAIT SEC 0.024
                              ENDWHILE
                        ENDSWITCH
                     ENDIF
                  UNTIL (bMsgRelease==TRUE)
                  bMsgRelease=FALSE
               ;ENDFOLD (Dialog)
         ENDSWITCH
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (AC_Application)

GLOBAL DEF AC_ApplicationCheck(nApplication :IN )
   ;FOLD Details
      ;FOLD Declaration
         DECL INT nApplication
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         SWITCH nApplication
            CASE 1
               ;FOLD Dialog "Waiting for Application %1 permission to enter (DI-%2)."
                  AutoCore_MsgPar[1]={par_type #value, par_int 0}
                  AutoCore_MsgPar[1].par_int=nApplication
                  AutoCore_MsgPar[2]={par_type #value, par_int 0}
                  AutoCore_MsgPar[2].par_int=nApplication + 69
                  SetWaitingMessage(AutomationCore_Msg[17], di070ApplicationMachine1, TRUE )
               ;ENDFOLD (Dialog)
               do070ApplicationClear1 = FALSE
               do024ApplClrTooling = FALSE
            CASE 2
               ;FOLD Dialog "Waiting for Application %1 permission to enter (DI-%2)."
                  AutoCore_MsgPar[1]={par_type #value, par_int 0}
                  AutoCore_MsgPar[1].par_int=nApplication
                  AutoCore_MsgPar[2]={par_type #value, par_int 0}
                  AutoCore_MsgPar[2].par_int=nApplication + 69
                  SetWaitingMessage(AutomationCore_Msg[17], di071ApplicationMachine2, TRUE )
               ;ENDFOLD (Dialog)
               do071ApplicationClear2 = FALSE
               do024ApplClrTooling = FALSE
            CASE 3
               ;FOLD Dialog "Waiting for Application %1 permission to enter (DI-%2)."
                  AutoCore_MsgPar[1]={par_type #value, par_int 0}
                  AutoCore_MsgPar[1].par_int=nApplication
                  AutoCore_MsgPar[2]={par_type #value, par_int 0}
                  AutoCore_MsgPar[2].par_int=nApplication + 69
                  SetWaitingMessage(AutomationCore_Msg[17], di072ApplicationMachine3, TRUE )
               ;ENDFOLD (Dialog)
               di072ApplicationMachine3 = FALSE
               do024ApplClrTooling = FALSE
            CASE 4
               ;FOLD Dialog "Waiting for Application %1 permission to enter (DI-%2)."
                  AutoCore_MsgPar[1]={par_type #value, par_int 0}
                  AutoCore_MsgPar[1].par_int=nApplication
                  AutoCore_MsgPar[2]={par_type #value, par_int 0}
                  AutoCore_MsgPar[2].par_int=nApplication + 69
                  SetWaitingMessage(AutomationCore_Msg[17], di073ApplicationMachine4, TRUE )
               ;ENDFOLD (Dialog)
               di073ApplicationMachine4 = FALSE
               do024ApplClrTooling = FALSE
            CASE 5
               ;FOLD Dialog "Waiting for Application %1 permission to enter (DI-%2)."
                  AutoCore_MsgPar[1]={par_type #value, par_int 0}
                  AutoCore_MsgPar[1].par_int=nApplication
                  AutoCore_MsgPar[2]={par_type #value, par_int 0}
                  AutoCore_MsgPar[2].par_int=nApplication + 69
                  SetWaitingMessage(AutomationCore_Msg[17], di074ApplicationMachine5, TRUE )
               ;ENDFOLD (Dialog)
               di074ApplicationMachine5 = FALSE
               do024ApplClrTooling = FALSE
            DEFAULT
               do004ProcessFault=TRUE
               ;FOLD Dialog "Application %1 is invalid.  Reprogram with application 1 - 5."
                  LOOP
                     AutoCore_MsgPar[1]={par_type #value, par_int 0}
                     AutoCore_MsgPar[1].par_int=nApplication
