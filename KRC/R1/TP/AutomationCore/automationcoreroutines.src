END ; (AC_RepoCheck)

GLOBAL DEF AC_PointArrival( )
   ;FOLD Details
      ;FOLD Declaration
      ;ENDFOLD (Declaration)
      ;FOLD Implementation
         IF ((doCriticalWZ==FALSE) AND (di006RequestToEnter==TRUE)) THEN
            REPEAT
               BRAKE
               IF ((Exists_KrlMsg(nReqEnter_Handle))==FALSE) THEN
                  nReqEnter_Handle=Set_Krlmsg (#STATE, AutomationCore_Msg[25], AutoCore_MsgPar[], AutoCore_MsgOpt_NoStop)
               ENDIF
               HALT
               WAIT SEC 0.012
            UNTIL (di006RequestToEnter==FALSE)
            bAutoCore_Clear=Clear_KRLMsg(nReqEnter_Handle)
         ENDIF
      ;ENDFOLD (Implementation)
   ;ENDFOLD (Details)
END ; (AC_PointArrival)

