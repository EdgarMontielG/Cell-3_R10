GLOBAL ENUM AIR_TYPE NONE,AIR,E_SWIRL
GLOBAL ENUM QUIT_FAULT_TYPE SINGLE,ALL,SPS
GLOBAL ENUM GlueBinInOut_T eProgNo,eParamNo,eReturnValueToPLC,eErrorNoToPLC,eSystemNo,eProgRecieved,eParamRecieved,eMaterialReturnValue,eErrorNo
