&REL 4
DEFDAT  glue PUBLIC

;FOLD GLUE ENUMs AND TYPs
ENUM SYS_TYPE A,B
ENUM RELOAD_TYPE RELOAD_COMPL,RELOAD_WAIT,RELOAD_TIME
GLOBAL ENUM FLOW_TYPE_SEL TCP_SPEED,SPEED_INDEP
GLOBAL ENUM ANSWER_TYPE NO,YES
GLOBAL ENUM PURGE_TYPE STANDARD,A,B,AB
GLOBAL ENUM PURGEVARIANT_TYPE PURGE_COMPL,PURGE_TIME
