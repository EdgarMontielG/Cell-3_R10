GLOBAL STRUC SettingDataTyp APP_TYPE GlueType,AIR_TYPE BeadShaping,INT iNumberOfDoser,QUIT_FAULT_TYPE QuitFault,BOOL MirrorPgno,INT iPGNOLength,BOOL bSingleFaultToPLC,bWithMeasurementActive,bNegMatLogic,bWithPeltier
GLOBAL STRUC Glue_Sugg_Type CHAR GLUE_BeadData[24],Cont[24]
;IO-Interface: Outputs
GLOBAL STRUC GlueSysOutA_Type INT MatFlow,BeadShp,PrePressure
GLOBAL STRUC GlueSysOut_Type INT On,EnPump,EnHeating,EnHydr,EnTimerHeating,AutoExt,HandExt,FinishMeasure,PumpReset,HeatingUnitReset,HydraulicReset,CirculationReset,WithoutMaterial,StartSys,ProgNo,ProgNoLength,ParamNo,ParamNoLength,ReturnValueToPLC,ReturnValueLength,ReturnValueValid
