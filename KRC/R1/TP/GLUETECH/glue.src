;FOLD RemoteStart
DEF RemoteStart()
IF (InputState(GlueSysIn[GlueActData.SystemNo].Ready)==FALSE) THEN
  REPEAT
	  SWITCH  GlueActData.SystemNo
	    CASE 1 ; system 1 active
	      IF (diSL1MajorFault==TRUE) THEN
					GLU_MsgPar[1]={par_type #value, par_int 0}
					GLU_MsgPar[1].par_int=GlueActData.SystemNo
	        GluePULSE(GlueSysStateOut[GlueActData.SystemNo].SingleFaultAckn, TRUE, 0.150)
	        ;doSL1RemoteStart=TRUE
	        ;$TIMER_STOP[nGLUProcessTmr]=TRUE
	        ;$TIMER[nGLUProcessTmr]=-10000
	        ;$TIMER_STOP[nGLUProcessTmr]=FALSE
	        ;WHILE (($TIMER_FLAG[nGLUProcessTmr]==FALSE) AND (diSL1RmtStrtInProc==FALSE) AND (diSL1MajorFault==TRUE))
	        ;	WAIT SEC 0.024
	        ;ENDWHILE
	        ;$TIMER_STOP[nGLUProcessTmr]=TRUE
	        WAIT SEC 0.250
	        ;IF ((InputState(GlueSysIn[GlueActData.SystemNo].Ready)==FALSE) AND (diSL1RmtStrtInProc==TRUE) AND (diSL1MajorFault==TRUE)) THEN
	        ;	nGLU_Handle_RemoteStrt = Set_Krlmsg (#STATE, GlueTech_Msg[3], GLU_MsgPar[], GLU_MsgOpt_Stop) ; Remote start of system {0} in process.
	        ;	WAIT FOR (InputState(GlueSysIn[GlueActData.SystemNo].Ready)==TRUE)
	        ;	bGLU_Clear=Clear_KRLMsg(nGLU_Handle_RemoteStrt)
	        ;ELSE
	        ;	doSL1RemoteStart=FALSE
	        ;ENDIF
	        IF (diSL1MajorFault==TRUE) THEN
	        	nGLU_Handle_MajorFault = Set_KrlDlg (GlueTech_Msg[4], GLU_MsgPar[], GLU_SK_Retry[], GLU_MsgOpt_Stop) ; Major fault on system {0}.
						IF (nGLU_Handle_MajorFault > 0) THEN
							WHILE (Exists_KrlDlg(nGLU_Handle_MajorFault, nGLU_Key))
								WAIT SEC 0.024
								IF (diSL1MajorFault==TRUE) THEN
									bGLU_AutoClear=Clear_KrlMsg(nGLU_Handle_MajorFault)
								ENDIF
							ENDWHILE
							IF (bGLU_AutoClear==TRUE) THEN
								nGLU_Key = 2
								bGLU_AutoClear=FALSE
							ENDIF
							SWITCH nGLU_Key
								CASE 1 ; Diagnostic
									GLU_Diagnostic()
								CASE 2 ; Retry
									WAIT SEC 0.048 ; Slight pause, then loop around and recheck for faulted condition
							ENDSWITCH
						ENDIF
	      	ENDIF
	      ENDIF
	    CASE 2 ; system 2 active
	      IF (diSL2MajorFault==TRUE) THEN
					GLU_MsgPar[1]={par_type #value, par_int 0}
					GLU_MsgPar[1].par_int=GlueActData.SystemNo
	        GluePULSE(GlueSysStateOut[GlueActData.SystemNo].SingleFaultAckn, TRUE, 0.150)
	        ;doSL2RemoteStart=TRUE
	        ;$TIMER_STOP[nGLUProcessTmr]=TRUE
	        ;$TIMER[nGLUProcessTmr]=-10000
	        ;$TIMER_STOP[nGLUProcessTmr]=FALSE
	        ;WHILE (($TIMER_FLAG[nGLUProcessTmr]==FALSE) AND (diSL2RmtStrtInProc==FALSE) AND (diSL2MajorFault==TRUE))
	        ;	WAIT SEC 0.024
	        ;ENDWHILE
	        ;$TIMER_STOP[nGLUProcessTmr]=TRUE
	        WAIT SEC 0.250
	        ;IF ((InputState(GlueSysIn[GlueActData.SystemNo].Ready)==FALSE) AND (diSL2RmtStrtInProc==TRUE) AND (diSL1MajorFault==TRUE)) THEN
	        ;	nGLU_Handle_RemoteStrt = Set_Krlmsg (#STATE, GlueTech_Msg[3], GLU_MsgPar[], GLU_MsgOpt_Stop) ; Remote start in process
	        ;	WAIT FOR (InputState(GlueSysIn[GlueActData.SystemNo].Ready)==TRUE)
	        ;ELSE
	        ;	doSL2RemoteStart=FALSE
	        ;ENDIF
	        IF (diSL2MajorFault==TRUE) THEN
	        	nGLU_Handle_MajorFault = Set_KrlDlg (GlueTech_Msg[4], GLU_MsgPar[], GLU_SK_Retry[], GLU_MsgOpt_Stop)
						IF (nGLU_Handle > 0) THEN
							WHILE (Exists_KrlDlg(nGLU_Handle_MajorFault, nGLU_Key))
								WAIT SEC 0.024
								IF (diSL2MajorFault==TRUE) THEN
									bGLU_AutoClear=Clear_KrlMsg(nGLU_Handle_MajorFault)
								ENDIF
							ENDWHILE
							IF (bGLU_AutoClear==TRUE) THEN
								nGLU_Key = 2
								bGLU_AutoClear=FALSE
							ENDIF
							SWITCH nGLU_Key
								CASE 1 ; Diagnostic
									GLU_Diagnostic()
								CASE 2 ; Retry
									WAIT SEC 0.048 ; Slight pause, then loop around and recheck for faulted condition
							ENDSWITCH
						ENDIF
	      	ENDIF
	      ENDIF
	    DEFAULT
	      MsgQuitGlue("InternalError", ,99 )
	  ENDSWITCH
	UNTIL (InputState(GlueSysIn[GlueActData.SystemNo].Ready)==TRUE)
ENDIF
END
;ENDFOLD (RemoteStart)
;FOLD Routines used in Calibrate_Equipment
GLOBAL DEF AoMatFlowTrigger(iSystemNo :IN, iPath :IN, iDelay :IN, dValue :IN)
  INT iSystemNo, iPath, iDelay
  REAL dValue
  
  TRIGGER WHEN PATH = iPath DELAY = iDelay DO $ANOUT[GlueSysOutA[iSystemNo].MatFlow] = dValue
END
GLOBAL DEF AoBeadShpTrigger(iSystemNo :IN, iPath :IN, iDelay :IN, dValue :IN)
  INT iSystemNo, iPath, iDelay
  REAL dValue
  
  TRIGGER WHEN PATH = iPath DELAY = iDelay DO $ANOUT[GlueSysOutA[iSystemNo].BeadShp] = dValue
END
GLOBAL DEF SysGunTriggerUp(iSystemNo :IN, iGunNo :IN, iPath :IN, iDelay :IN, bValue :IN)
  INT iSystemNo, iGunNo, iPath, iDelay
  BOOL bValue
  
  iActualSystemNo = iSystemNo
  iActualGunNo = iGunNo
  bGunOpen=bValue
  SWITCH iSystemNo
    CASE 1,2,3,4
      SWITCH iGunNo
        CASE 1,2,3,4
          TRIGGER WHEN PATH = iPath DELAY = iDelay DO OpenSysGun(iActualSystemNo, iActualGunNo, bGunOpen) PRIO=-1
        DEFAULT
          MsgQuitGlue("InternalError", ,99 )
      ENDSWITCH
    DEFAULT
      MsgQuitGlue("InternalError", ,99 )
  ENDSWITCH
END
GLOBAL DEF AirTriggerUp(iSystemNo :IN, iPath :IN, iDelay :IN, bValue :IN)
  INT iSystemNo, iPath, iDelay
  BOOL bValue
  
  ;Save runtime variables for Trigger
  SWITCH iSystemNo
    CASE 1,2,3,4
      AirTriggerUpVal[iSystemNo].SystemNo=iSystemNo
      AirTriggerUpVal[iSystemNo].bValue=bValue
    DEFAULT
      MsgQuitGlue("InternalError", ,99 )
  ENDSWITCH
  ;Set Trigger conditions
  SWITCH iSystemNo
    CASE 1
      TRIGGER WHEN PATH = iPath DELAY = iDelay DO OutputSet(GlueSysDoserOut[1].AirOn, AirTriggerUpVal[1].bValue) PRIO=-1
    CASE 2
      TRIGGER WHEN PATH = iPath DELAY = iDelay DO OutputSet(GlueSysDoserOut[2].AirOn, AirTriggerUpVal[2].bValue) PRIO=-1
    CASE 3
      TRIGGER WHEN PATH = iPath DELAY = iDelay DO OutputSet(GlueSysDoserOut[3].AirOn, AirTriggerUpVal[3].bValue) PRIO=-1
    CASE 4
      TRIGGER WHEN PATH = iPath DELAY = iDelay DO OutputSet(GlueSysDoserOut[4].AirOn, AirTriggerUpVal[4].bValue) PRIO=-1
    DEFAULT
      MsgQuitGlue("InternalError", ,99 )
  ENDSWITCH
END
GLOBAL DEF StartSysTriggerUp(iSystemNo :IN, iPath :IN, iDelay :IN, bValue :IN)
  INT iSystemNo, iPath, iDelay
  BOOL bValue
  
  ;Save runtime variables for Trigger
  SWITCH iSystemNo
    CASE 1,2,3,4
      StartSysTriggerUpVal[iSystemNo].SystemNo=iSystemNo
      StartSysTriggerUpVal[iSystemNo].bValue=bValue
    DEFAULT
      MsgQuitGlue("InternalError", ,99 )
  ENDSWITCH
  ;Set Trigger conditions
  SWITCH iSystemNo
    CASE 1
      TRIGGER WHEN PATH = iPath DELAY = iDelay DO OutputSet(GlueSysOut[1].StartSys, StartSysTriggerUpVal[1].bValue) PRIO=-1
    CASE 2
      TRIGGER WHEN PATH = iPath DELAY = iDelay DO OutputSet(GlueSysOut[2].StartSys, StartSysTriggerUpVal[2].bValue) PRIO=-1
    CASE 3
      TRIGGER WHEN PATH = iPath DELAY = iDelay DO OutputSet(GlueSysOut[3].StartSys, StartSysTriggerUpVal[3].bValue) PRIO=-1
    CASE 4
      TRIGGER WHEN PATH = iPath DELAY = iDelay DO OutputSet(GlueSysOut[4].StartSys, StartSysTriggerUpVal[4].bValue) PRIO=-1
    DEFAULT
      MsgQuitGlue("InternalError", ,99 )
  ENDSWITCH
END
GLOBAL DEF DoProgNoUp(iSystemNo :IN, iProgNo :IN)
  INT iSystemNo, iProgNo
  
  OutputBSet(iSystemNo, #eProgNo, iProgNo)
END
GLOBAL DEF DoStartSysUp(iSystemNo :IN, bValue :IN)
  INT iSystemNo
  BOOL bValue
  
  OutputSet(GlueSysOut[iSystemNo].StartSys, bValue)
END 
GLOBAL DEF DoAirOnUp(iSystemNo :IN, bValue :IN)
  INT iSystemNo
  BOOL bValue
  
  OutputSet(GlueSysDoserOut[iSystemNo].AirOn, bValue)
END 

GLOBAL DEF CloseAllGuns()
INT iCnt
  FOR iCnt=1 TO 4
    CloseGunsSystem(iCnt)
  ENDFOR
END
GLOBAL DEF AllAnoutOff()
  ANOUT OFF aoSL1MatFlow
  ANOUT OFF aoSL1BeadShp
  ANOUT OFF aoSL2MatFlow
  ANOUT OFF aoSL2BeadShp
  ANOUT OFF aoSL3MatFlow
  ANOUT OFF aoSL3BeadShp
  ANOUT OFF aoSL4MatFlow
  ANOUT OFF aoSL4BeadShp
END
GLOBAL DEF ResetAllAnout()
INT iCnt
  FOR iCnt=1 TO 4
    $ANOUT[GlueSysOutA[iCnt].MatFlow] = 0.0
    $ANOUT[GlueSysOutA[iCnt].BeadShp] = 0.0
  ENDFOR
END
GLOBAL DEF FillDoser()
  SWITCH GlueActData.SystemNo
    CASE 1,2,3,4
      OutputSet(GlueSysOut[GlueActData.SystemNo].StartSys, FALSE)
      OutputSet(GlueSysOut[GlueActData.SystemNo].FinishMeasure, TRUE)
      WAIT FOR InputState(GlueSysIn[GlueActData.SystemNo].MeasurePassed)
      OutputSet(GlueSysOut[GlueActData.SystemNo].FinishMeasure, FALSE)
      OutputSet(GlueSysDoserOut[GlueActData.SystemNo].Fill, TRUE)
      WAIT FOR InputState(GlueSysDoserSepIn[GlueActData.SystemNo,1].Full)
      OutputSet(GlueSysDoserOut[GlueActData.SystemNo].Fill, FALSE)
    DEFAULT
      MsgQuitGlue("InternalError", ,99 )
  ENDSWITCH
END
;ENDFOLD (Routines used in Calibrate_Equipment)

;FOLD Helper
DEF OutputSet(iOutputNo :IN, bValue :IN)
  INT iOutputNo
  BOOL bValue
  
  IF iOutputNo>0 THEN
    $OUT[iOutputNo]=bValue
  ELSE
    ;Output not configured
  ENDIF
END
DEF OutputBSet(iSystemNo :IN, eBinOutParam :IN, iValue :IN)
  INT iSystemNo, iValue
  DECL GlueBinInOut_T eBinOutParam
;GlueBinOutMap[1]={ProgNo 1, ParamNo 5, ReturnValueToPLC 9, ErrorNoToPLC 13}
  
  SWITCH eBinOutParam
    CASE #eProgNo  ;GlueBinOutMap[].ProgNo: Index of $BIN_OUT[]
      $B_OUT[GlueBinOutMap[iSystemNo].ProgNo]=iValue
    CASE #eParamNo  ;GlueBinOutMap[].ParamNo: Index of $BIN_OUT[]
      $B_OUT[GlueBinOutMap[iSystemNo].ParamNo]=iValue
    CASE #eReturnValueToPLC  ;GlueBinOutMap[].ReturnValueToPLC: Index of $BIN_OUT[]
      $B_OUT[GlueBinOutMap[iSystemNo].ReturnValueToPLC]=iValue
    CASE #eErrorNoToPLC  ;GlueBinOutMap[].FaultToPLC: Index of $BIN_OUT[]
      $B_OUT[GlueBinOutMap[iSystemNo].ErrorNoToPLC]=iValue
    DEFAULT
  ENDSWITCH
END
GLOBAL DEFFCT BOOL OutputState(iOutputNo :IN)
  INT iOutputNo
  BOOL bValue
  
  IF iOutputNo>0 THEN
    bValue=$OUT[iOutputNo]
  ELSE
    ;Output not configured
    bValue=FALSE
  ENDIF

  RETURN (bValue)
ENDFCT
GLOBAL DEFFCT BOOL InputState(iInputNo :IN)
  INT iInputNo
  BOOL bValue
  
  IF iInputNo>0 THEN
    bValue=$IN[iInputNo]
  ELSE
    ;Input not configured
    bValue=FALSE
  ENDIF

  RETURN (bValue)
ENDFCT
GLOBAL DEFFCT INT InputB(iSystemNo :IN, eBinInParam :IN)
  INT iSystemNo, iValue
  DECL GlueBinInOut_T eBinInParam
;GlueBinInMap[1]={SystemNo 1, ProgRecieved 5, ParamRecieved 9, MaterialReturnValue 13, ErrorNo 17}

  SWITCH eBinInParam
    CASE #eSystemNo  ;GlueBinInMap[].SystemNo: Index of $BIN_IN[]
      iValue=$B_IN[GlueBinInMap[iSystemNo].SystemNo]
    CASE #eProgRecieved  ;GlueBinInMap[].ProgRecieved: Index of $BIN_IN[]
      iValue=$B_IN[GlueBinInMap[iSystemNo].ProgRecieved]
    CASE #eParamRecieved  ;GlueBinInMap[].ParamRecieved: Index of $BIN_IN[]
      iValue=$B_IN[GlueBinInMap[iSystemNo].ParamRecieved]
    CASE #eMaterialReturnValue  ;GlueBinInMap[].MaterialReturnValue: Index of $BIN_IN[]
      iValue=$B_IN[GlueBinInMap[iSystemNo].MaterialReturnValue]
    CASE #eErrorNo  ;GlueBinInMap[].ErrorNo: Index of $BIN_IN[]
      iValue=$B_IN[GlueBinInMap[iSystemNo].ErrorNo]
    DEFAULT
  ENDSWITCH
  
  RETURN (iValue)
ENDFCT
GLOBAL DEF GluePULSE(iOutputNo :IN, bState :IN, nPulseTime :IN)
  INT iOutputNo
  BOOL bState
  REAL nPulseTime
  
  IF (iOutputNo<>0) THEN
    PULSE ($OUT[iOutputNo], bState, nPulseTime)
  ELSE
    ;Output not configured
  ENDIF

END
DEF GlueDataMapping()
;Data mapping called from GLUE_PLC()
  INT iCnt
  
  ;Mapping Struct for Barrel-IOs
  FOR iCnt=1 TO 4
    ;GlueSysBarrelIn[].BarrelEmpty and .BarrelChangeActive for Systems 2-4 is identical with System 1
    GlueSysBarrelIn[iCnt,2].BarrelEmpty=GlueSysBarrelIn[iCnt,1].BarrelEmpty
    GlueSysBarrelIn[iCnt,2].BarrelChangeActive=GlueSysBarrelIn[iCnt,1].BarrelChangeActive
    GlueSysBarrelIn[iCnt,3].BarrelEmpty=GlueSysBarrelIn[iCnt,1].BarrelEmpty
    GlueSysBarrelIn[iCnt,3].BarrelChangeActive=GlueSysBarrelIn[iCnt,1].BarrelChangeActive
    GlueSysBarrelIn[iCnt,4].BarrelEmpty=GlueSysBarrelIn[iCnt,1].BarrelEmpty
    GlueSysBarrelIn[iCnt,4].BarrelChangeActive=GlueSysBarrelIn[iCnt,1].BarrelChangeActive
  ENDFOR
END
DEF GlueDataConsCheck()
;Data consistency check
  INT iCnt
  
  ;Check configured Binary Inputs/Outputs information in $BIN_OUT[]/$BIN_IN[]
  FOR iCnt=1 TO iNumberOfDispenseSystems
    ;Binary Output for ProgNo
    IF GlueSysOut[iCnt].ProgNo > 0 THEN
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ProgNo].F_BIT<>GlueSysOut[iCnt].ProgNo) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ProgNo].LEN<>GlueSysOut[iCnt].ProgNoLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ProgNo].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
    
    ;Binary Output for ParamNo
    IF GlueSysOut[iCnt].ParamNo > 0 THEN
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ParamNo].F_BIT<>GlueSysOut[iCnt].ParamNo) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ParamNo].LEN<>GlueSysOut[iCnt].ParamNoLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ParamNo].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
    
    ;Binary Output for ReturnValueToPLC
    IF GlueSysOut[iCnt].ReturnValueToPLC > 0 THEN
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ReturnValueToPLC].F_BIT<>GlueSysOut[iCnt].ReturnValueToPLC) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ReturnValueToPLC].LEN<>GlueSysOut[iCnt].ReturnValueLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ReturnValueToPLC].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
    
    ;Binary Output for ErrorNoToPLC
    IF GlueSysStateOut[iCnt].ErrorNoToPLC > 0 THEN
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ErrorNoToPLC].F_BIT<>GlueSysStateOut[iCnt].ErrorNoToPLC) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ErrorNoToPLC].LEN<>GlueSysStateOut[iCnt].ErrorNoLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_OUT[GlueBinOutMap[iCnt].ErrorNoToPLC].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
   
    ;Binary Input for SystemNo
    IF GlueSysIn[iCnt].SystemNo > 0 THEN
      IF ($BIN_IN[GlueBinInMap[iCnt].SystemNo].F_BIT<>GlueSysIn[iCnt].SystemNo) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].SystemNo].LEN<>GlueSysIn[iCnt].SystemNoLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].SystemNo].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
    
    ;Binary Input for ProgRecieved
    IF GlueSysIn[iCnt].ProgRecieved > 0 THEN
      IF ($BIN_IN[GlueBinInMap[iCnt].ProgRecieved].F_BIT<>GlueSysIn[iCnt].ProgRecieved) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].ProgRecieved].LEN<>GlueSysIn[iCnt].ProgRecievedLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].ProgRecieved].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
    
    ;Binary Input for ParamRecieved
    IF GlueSysIn[iCnt].ParamRecieved > 0 THEN
      IF ($BIN_IN[GlueBinInMap[iCnt].ParamRecieved].F_BIT<>GlueSysIn[iCnt].ParamRecieved) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].ParamRecieved].LEN<>GlueSysIn[iCnt].ParamRecievedLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].ParamRecieved].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
    
    ;Binary Input for MaterialReturnValue
    IF GlueSysIn[iCnt].MaterialReturnValue > 0 THEN
      IF ($BIN_IN[GlueBinInMap[iCnt].MaterialReturnValue].F_BIT<>GlueSysIn[iCnt].MaterialReturnValue) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].MaterialReturnValue].LEN<>GlueSysIn[iCnt].ReturnValueLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].MaterialReturnValue].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
    
    ;Binary Input for ErrorNo
    IF GlueSysStateIn[iCnt].ErrorNo > 0 THEN
      IF ($BIN_IN[GlueBinInMap[iCnt].ErrorNo].F_BIT<>GlueSysStateIn[iCnt].ErrorNo) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].ErrorNo].LEN<>GlueSysStateIn[iCnt].ErrorNoLength) THEN
        GlueDataInconsistent=TRUE
      ENDIF
      IF ($BIN_IN[GlueBinInMap[iCnt].ErrorNo].PARITY<>#NONE) THEN
        GlueDataInconsistent=TRUE
      ENDIF
    ENDIF
  ENDFOR
  
  IF GlueDataInconsistent THEN
    MsgQuitGlue("MsgGlueDataInconsistent",,99)
    WAIT FOR NOT GlueDataInconsistent
  ENDIF

END

;ENDFOLD (Helper)

DEF GLU_Diagnostic( )
;FOLD Details
;FOLD Declaration
;ENDFOLD (Declaration)
;FOLD Implementation
nGLU_Handle = Set_Krlmsg (#QUIT, GlueTech_Msg[2], GLU_MsgPar[], GLU_MsgOpt_Stop)
WHILE (Exists_KrlMsg(nGLU_Handle))
	WAIT SEC 0.024
ENDWHILE
;ENDFOLD (Implementation)
;ENDFOLD (Details)
END ; (GLU_Diagnostic)
