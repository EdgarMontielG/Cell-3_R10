;FOLD AoBeadShpInit
GLOBAL DEF AoBeadShpInit(iSystemNo :IN, dValue :IN)
  INT iSystemNo
  REAL dValue
  
  $ANOUT[GlueSysOutA[iSystemNo].BeadShp] = dValue
END
;ENDFOLD (AoBeadShpInit)
;FOLD AoBeadShpOn
GLOBAL DEF AoBeadShpOn(iSystemNo :IN, dFactor :IN, dOffset :IN, dDelay :IN)
  INT iSystemNo
  REAL dFactor, dOffset, dDelay
  
  AirFactor = dFactor
  AirOffset = AirOffset
  AirDelay = dDelay
  SWITCH iSystemNo
    CASE 1
      IF bAnalogWithoutOffset THEN
        ANOUT ON aoSL1BeadShp = AirFactor * $VEL_ACT + 0.0  DELAY = AirDelay
      ELSE
        ANOUT ON aoSL1BeadShp = AirFactor * $VEL_ACT + AirOffset  DELAY = AirDelay
      ENDIF
    CASE 2
      IF bAnalogWithoutOffset THEN
        ANOUT ON aoSL2BeadShp = AirFactor * $VEL_ACT + 0.0  DELAY = AirDelay
      ELSE
        ANOUT ON aoSL2BeadShp = AirFactor * $VEL_ACT + AirOffset  DELAY = AirDelay
      ENDIF
    CASE 3
      IF bAnalogWithoutOffset THEN
        ANOUT ON aoSL3BeadShp = AirFactor * $VEL_ACT + 0.0  DELAY = AirDelay
      ELSE
        ANOUT ON aoSL3BeadShp = AirFactor * $VEL_ACT + AirOffset  DELAY = AirDelay
      ENDIF
    CASE 4
      IF bAnalogWithoutOffset THEN
        ANOUT ON aoSL4BeadShp = AirFactor * $VEL_ACT + 0.0  DELAY = AirDelay
      ELSE
        ANOUT ON aoSL4BeadShp = AirFactor * $VEL_ACT + AirOffset  DELAY = AirDelay
      ENDIF
    DEFAULT
      MsgQuitGlue("InternalError", ,99 )
  ENDSWITCH
END
;ENDFOLD (AoBeadShpOn)
;FOLD AoBeadShpOff
GLOBAL DEF AoBeadShpOff(iSystemNo :IN)
  INT iSystemNo
  
  SWITCH iSystemNo
    CASE 1
      ANOUT OFF aoSL1BeadShp
    CASE 2
      ANOUT OFF aoSL2BeadShp
    CASE 3
      ANOUT OFF aoSL3BeadShp
    CASE 4
      ANOUT OFF aoSL4BeadShp
    DEFAULT
      MsgQuitGlue("InternalError", ,99 )
  ENDSWITCH
END
;ENDFOLD (AoBeadShpOff)
;FOLD AoPrePressureInit
GLOBAL DEF AoPrePressureInit(iSystemNo :IN, dValue :IN)
  INT iSystemNo
  REAL dValue
  $ANOUT[GlueSysOutA[iSystemNo].PrePressure] = dValue
END
