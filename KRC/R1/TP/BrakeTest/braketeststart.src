&ACCESS RVO7
&REL 6
&COMMENT path to test
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\TP\BrakeTest
DEF BrakeTestStart( )
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
;do829BrakeTestInProcess=TRUE
do931BrakeTestInProcess=TRUE
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;FOLD PTP m Vel=100 % PDAT2 Tool[3]:Tool 3 Base[1]:3-30-R1 03-20B;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:m, 3:, 5:100, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=Fm
BAS(#PTP_PARAMS,100)
PTP Xm 
;ENDFOLD
;FOLD PTP h Vel=100 % PDAT1 Tool[3]:Tool 3 Base[1]:3-30-R1 03-20B;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:h, 3:, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=Fh
BAS(#PTP_PARAMS,100)
PTP Xh 
;ENDFOLD
END