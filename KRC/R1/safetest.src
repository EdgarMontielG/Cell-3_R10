loop
;FOLD PTP safetest Vel=100 % PDAT1 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:safetest, 3:, 5:100, 7:PDAT1
