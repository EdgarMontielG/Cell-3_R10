&ACCESS RVP
&REL 2
&COMMENT 03-10-R1 TEST LOOP
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1
DEF safetest( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - MANUAL TEST ONLY - ENDLESS PTP TO ONE POINT
;********************************
; NOT CALLED BY ANY PROGRAM. MOVES PTP TO THE POINT "safetest" (TOOL 1, WORLD) IN AN ENDLESS
; LOOP - PRESUMABLY USED TO TEST A SAFEOPERATION ZONE OR SPEED LIMIT. THE ONLY WAY OUT IS TO
; STOP AND CANCEL THE PROGRAM. KEEP OR DELETE: GESTAMP REVIEW POINT 5 (UNUSED PROGRAMS)
;********************************

loop
;FOLD PTP safetest Vel=100 % PDAT1 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:safetest, 3:, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=Fsafetest
BAS(#PTP_PARAMS,100)
PTP Xsafetest 
;ENDFOLD
endloop

END
