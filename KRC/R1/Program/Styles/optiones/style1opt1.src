&ACCESS RVO1
&REL 40
&COMMENT 03-10-R1 PRODUCTION CYCLE
DEF Style1Opt1 ( )
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - STYLE 1 PRODUCTION CYCLE (OPTIONS 1/2/7/8)
;********************************
;NOTE: EXACTLY ONE OF $IN[65] di065PickupMachine1 / $IN[66] di066PickupMachine2 MUST BE ON.
;NOTE: WITH BOTH ON OR BOTH OFF NOTHING RUNS AND THE CYCLE ENDS AS IF COMPLETE (EMPTY CYCLE) (F06)
;NOTE: PARTPRESENT1..3 AND bscrapGE4 ARE NOT RESET AT THE START OF THE CYCLE (F03); bscrapGE4 IS
;NOTE: WRITTEN BY THE OPTION 1 NUT SENSOR RESULT, THE CAMERA RESULT AND RejectGE4 (FALSE)
   
    ;STATION 1 - SIGNALS $IN[65] di065PickupMachine1 ON AND $IN[66] di066PickupMachine2 OFF
    IF di065PickupMachine1 AND NOT di066PickupMachine2 THEN
      ;PICK THE PART AT PICKUP 1 (STATION 1)
      style1pick1opt1()
  
   ;WELD NUT 1 (PN1) AT THE CENTERLINE PEDESTAL
   style1app1opt1()
  
   ;WELD NUT 2 (PN2) AT THE CENTERLINE PEDESTAL
   Style1App1Opt2()
   
   ;WELD NUT 3 (PN3) AT THE CENTERLINE PEDESTAL
   Style1App1Opt3()
  
   ;NUT PRESENCE CHECK OF THE 3 NUTS - SIGNAL $IN[227] NUT_PRESENT1;
   ;SETS bscrapGE4 FOR OPTION 1 ONLY - OPTIONS 2/7/8 LEAVE IT UNCHANGED (F02)
   style1app2opt1()
      ;SCRAP: REJECT THE PART (RejectGE4) AND JUMP TO THE COMMON EXIT (F30)
      ;NOTE: THIS PATH SKIPS THE APPLICATION 1 RELEASE AT THE END OF THE CAMERA CHECK (F20)
      IF bScrapGE4==true THEN
      RejectGE4()
      goto label10
      ENDIF 
    
   ;NUT CAMERA CHECK - SIGNALS $IN[100] di100CameraJudmentOK, $IN[101] di101CameraJudmentNG;
   ;SETS bscrapGE4 (ALL OPTIONS), THEN RELEASES APPLICATION 1
   style1app2opt2()
      ;SCRAP: REJECT THE PART (RejectGE4) AND JUMP TO THE COMMON EXIT (F30)
      IF bScrapGE4==true THEN
      RejectGE4()
      goto label11
      ENDIF
   
  ;GOOD PART: DROP OFF AT DROPOFF 1 (Style1Drop1Opt1), THEN JUMP TO THE COMMON EXIT -
  ;THE STATION 2 BRANCH BELOW IS SKIPPED (F30)
  Style1Drop1Opt1()
      GOTO LABEL12
      ENDIF 
    
    
   ;STATION 2 - SIGNALS $IN[66] di066PickupMachine2 ON AND $IN[65] di065PickupMachine1 OFF
   IF di066PickupMachine2 AND NOT di065PickupMachine1 THEN
    ;PICK THE PART AT PICKUP 2 (STATION 2)
    style1pick1opt2()
  ;WELD NUT 1 (PN1) AT THE CENTERLINE PEDESTAL
  style1app1opt1()
  
   ;WELD NUT 2 (PN2) AT THE CENTERLINE PEDESTAL
   Style1App1Opt2()
   
   ;WELD NUT 3 (PN3) AT THE CENTERLINE PEDESTAL
   Style1App1Opt3()
  
   ;NUT PRESENCE CHECK OF THE 3 NUTS - SIGNAL $IN[227] NUT_PRESENT1;
   ;SETS bscrapGE4 FOR OPTION 1 ONLY - OPTIONS 2/7/8 LEAVE IT UNCHANGED (F02)
   style1app2opt1()
      ;SCRAP: REJECT THE PART (RejectGE4) AND JUMP TO THE COMMON EXIT (F30)
      ;NOTE: THIS PATH SKIPS THE APPLICATION 1 RELEASE AT THE END OF THE CAMERA CHECK (F20)
      IF bScrapGE4 THEN
      RejectGE4()
      goto label10
      ENDIF 
    
   ;NUT CAMERA CHECK - SIGNALS $IN[100] di100CameraJudmentOK, $IN[101] di101CameraJudmentNG;
   ;SETS bscrapGE4 (ALL OPTIONS), THEN RELEASES APPLICATION 1
   style1app2opt2()
      ;SCRAP: REJECT THE PART (RejectGE4) AND JUMP TO THE COMMON EXIT (F30)
      IF bScrapGE4 THEN
      RejectGE4()
      goto label11
      ENDIF
   
  ;GOOD PART: DROP OFF AT DROPOFF 1 (Style1Drop1Opt1)
  Style1Drop1Opt1()
  ENDIF 
  
   ;FOLD COMMON EXIT - CLEAR PARTPRESENT1..3
   ;NOTE: LABEL10, LABEL11 AND LABEL12 ARE ONE PLACE, THE SINGLE EXIT OF THE CYCLE. THE GOTOS
   ;NOTE: ARE LOAD-BEARING: A REJECT ENDS THE CYCLE, A STATION 1 CYCLE SKIPS STATION 2 (F30)
   LABEL10:
   LABEL11:
   LABEL12:
   ;CLEAR THE NUT PRESENCE FLAGS PARTPRESENT1..3 (bscrapGE4 IS NOT CHANGED HERE)
   PARTPRESENT1=FALSE
   PARTPRESENT2=FALSE  
   PARTPRESENT3=FALSE
   
   ;ENDFOLD (COMMON EXIT - CLEAR PARTPRESENT1..3)
   
END