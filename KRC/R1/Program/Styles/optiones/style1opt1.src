&ACCESS RVP1
&REL 40
&COMMENT 03-10-R1 PRODUCTION CYCLE
DEF Style1Opt1 ( )
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - STYLE 1 PRODUCTION CYCLE (OPTIONS 1/2/7/8)
;********************************
DECL INT nPickStation

;PICK STATION: 1 OR 2
nPickStation=0
;STATION 1
IF di065PickupMachine1 AND NOT di066PickupMachine2 THEN
   nPickStation=1
ELSE
   ;STATION 2
   IF di066PickupMachine2 AND NOT di065PickupMachine1 THEN
      nPickStation=2
   ENDIF
ENDIF

IF nPickStation<>0 THEN
   ;PICK THE PART AT PICKUP 1 (STATION 1) OR PICKUP 2 (STATION 2)
   IF nPickStation==1 THEN
      style1pick1opt1()
   ELSE
      style1pick1opt2()
   ENDIF
   ;WELD NUTS 1-3: A = PICKUP 1, B = PICKUP 2 (WELD POSITIONS TAUGHT PER PICK STATION)
   IF nPickStation==1 THEN
      style1app1opt1A()
      Style1App1Opt2A()
      Style1App1Opt3A()
   ELSE
      style1app1opt1B()
      Style1App1Opt2B()
      Style1App1Opt3B()
   ENDIF
   ;NUT CHECK - SENSOR
   style1app2opt1()
   IF bScrapGE4==TRUE THEN
      ;NG PART: REJECT
      RejectGE4()
   ELSE
      ;NUT CHECK - CAMERA
      style1app2opt2()
      IF bScrapGE4==TRUE THEN
         ;SCRAP: REJECT THE PART (RejectGE4) - END OF THE CYCLE
         RejectGE4()
      ELSE
         ;GOOD PART: DROP OFF AT DROPOFF 1 (Style1Drop1Opt1)
         Style1Drop1Opt1()
      ENDIF
   ENDIF
ENDIF

;END OF THE CYCLE - CLEAR NUT FLAGS
PARTPRESENT1=FALSE
PARTPRESENT2=FALSE
PARTPRESENT3=FALSE

END