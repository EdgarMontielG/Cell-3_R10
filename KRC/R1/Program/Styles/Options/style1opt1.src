&ACCESS RVO1
&REL 40
&COMMENT 03-10-R1 PRODUCTION CYCLE
DEF Style1Opt1 ( )
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - STYLE 1 PRODUCTION CYCLE (OPTIONS 1/2/7/8)
;********************************
DECL INT nPickStation
;NOTE: EXACTLY ONE OF $IN[65] di065PickupMachine1 / $IN[66] di066PickupMachine2 MUST BE ON.
;NOTE: WITH BOTH ON OR BOTH OFF NOTHING RUNS AND THE CYCLE ENDS AS IF COMPLETE (EMPTY CYCLE) (F06)
;NOTE: bscrapGE4 IS NOT RESET AT THE START OF THE CYCLE (F03); IT IS WRITTEN BY THE OPTION 1
;NOTE: NUT SENSOR RESULT, THE CAMERA RESULT AND RejectGE4 (FALSE)
;NOTE: ONE PATH PER CYCLE (F30): A REJECT ENDS THE CYCLE (NO CAMERA, NO DROP), A STATION 1
;NOTE: CYCLE NEVER RUNS STATION 2, AND EVERY PATH ENDS AT THE CLEAR OF PARTPRESENT1..3

;PICK STATION, READ ONCE AT THE START OF THE CYCLE: 1 OR 2, 0 - NO PICK, EMPTY CYCLE (F06)
nPickStation=0
;STATION 1 - SIGNALS $IN[65] di065PickupMachine1 ON AND $IN[66] di066PickupMachine2 OFF
IF di065PickupMachine1 AND NOT di066PickupMachine2 THEN
   nPickStation=1
ELSE
   ;STATION 2 - SIGNALS $IN[66] di066PickupMachine2 ON AND $IN[65] di065PickupMachine1 OFF
   IF di066PickupMachine2 AND NOT di065PickupMachine1 THEN
      nPickStation=2
   ENDIF
ENDIF

IF nPickStation<>0 THEN
   ;PICK THE PART AT PICKUP 1 (STATION 1) OR PICKUP 2 (STATION 2)
   IF nPickStation==1 THEN
      style1pick1opt1()
   ELSE
      style1pick1opt2()
   ENDIF
   ;WELD NUT 1 (PN1) AT THE CENTERLINE PEDESTAL
   style1app1opt1()
   ;WELD NUT 2 (PN2) AT THE CENTERLINE PEDESTAL
   Style1App1Opt2()
   ;WELD NUT 3 (PN3) AT THE CENTERLINE PEDESTAL
   Style1App1Opt3()
   ;NUT PRESENCE CHECK OF THE 3 NUTS - SIGNAL $IN[227] di227NutPresent1;
   ;SETS bscrapGE4 FOR OPTION 1 ONLY - OPTIONS 2/7/8 LEAVE IT UNCHANGED (F02)
   style1app2opt1()
   IF bScrapGE4==TRUE THEN
      ;SCRAP: REJECT THE PART (RejectGE4) - END OF THE CYCLE
      ;NOTE: THIS PATH SKIPS THE APPLICATION 1 RELEASE AT THE END OF THE CAMERA CHECK (F20)
      RejectGE4()
   ELSE
      ;NUT CAMERA CHECK - SIGNALS $IN[100] di100CameraJudgmentOK, $IN[101] di101CameraJudgmentNG;
      ;SETS bscrapGE4 (ALL OPTIONS), THEN RELEASES APPLICATION 1
      style1app2opt2()
      IF bScrapGE4==TRUE THEN
         ;SCRAP: REJECT THE PART (RejectGE4) - END OF THE CYCLE
         RejectGE4()
      ELSE
         ;GOOD PART: DROP OFF AT DROPOFF 1 (Style1Drop1Opt1)
         Style1Drop1Opt1()
      ENDIF
   ENDIF
ENDIF

;END OF THE CYCLE - CLEAR THE NUT PRESENCE FLAGS PARTPRESENT1..3 (bscrapGE4 IS NOT CHANGED HERE)
PARTPRESENT1=FALSE
PARTPRESENT2=FALSE
PARTPRESENT3=FALSE

END