&ACCESS RVO1
&REL 101
&COMMENT 03-10-R1 STYLE 1
DEF Style_1( )
   ;FOLD INI;%{PE}
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - STYLE 1: SELECT THE OPTION PROGRAM
;********************************
;OPTION PROGRAM BY nOption (FROM THE PLC)
   SWITCH nOption
      CASE 1,2,7,8
         ;OPTION 1: PRODUCTION CYCLE (PICK, WELD 3 NUTS, NUT CHECKS, DROP OR REJECT)
         Style1Opt1 ( )

      CASE 12
         ;OPTION 12: RED RABBIT TEST CYCLE
         Style1Opt10AutoRR ( )
      DEFAULT
         ;WRONG OPTION: THE ROBOT WAITS HERE
         WAIT FOR FALSE
   ENDSWITCH
   

   
END
