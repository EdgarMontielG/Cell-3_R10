&ACCESS RVO1
&REL 101
&COMMENT GE4_002
DEF Style_1( )
;FOLD PROGRAM INFO
;**********************************************************
;* Customer : Gestamp
;* Cell     : BMW-03-10 / Robot R1
;* Part     : GE4-002
;* Program  : Style_1
;* Function : Style 1 entry program (called from CELL).
;*            Runs the cycle selected by nOption:
;*            1,2,7,8 = production, 12 = Red Rabbit.
;**********************************************************
;ENDFOLD
   ;FOLD INI;%{PE}
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
         
         ; (USER INI)
      ;ENDFOLD (INI)
   ;ENDFOLD INI
   SWITCH nOption              ; Cycle selected by PLC
      CASE 1                   ; GE4-002 production cycle
         Style1Opt1 ( )
      CASE 2                   ; GE4-002 production cycle
         Style1Opt1 ( )
      CASE 7                   ; GE4-002 production cycle
         Style1Opt1 ( )
      CASE 8                   ; GE4-002 production cycle
         Style1Opt1 ( )
      CASE 12                  ; Red Rabbit verification cycle
         Style1Opt10AutoRR ( )
      DEFAULT
         WAIT FOR FALSE        ; Invalid nOption - program halts here
   ENDSWITCH
   

   
END
