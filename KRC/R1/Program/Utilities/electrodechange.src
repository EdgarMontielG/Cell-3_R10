&ACCESS RVO1
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
DEF ElectrodeChange( )
;FOLD DECL
DECL BOOL bMsgRelease
DECL BOOL bCapsChanged
;ENDFOLD
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
	;FOLD NutWeld
	;ENDFOLD (NutWeld)
  ;FOLD USER INI
    ;Make your modifications here
    bMsgRelease=FALSE
    bCapsChanged=FALSE
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

;FOLD Turn Water Off
dopw1_StartWater=FALSE
;ENDFOLD

;FOLD Have Electrodes been changed?
		REPEAT
			do091RobotReadyCapChange=TRUE
			nAutoCore_Handle = Set_KrlDlg (AutomationCore_Msg[28], AutoCore_MsgPar[], AC_SK_YesNoNav[], AutoCore_MsgOpt_Stop)
			IF (nAutoCore_Handle > 0) THEN
				WHILE (Exists_KrlDlg(nAutoCore_Handle, nAutoCore_Key))
					WAIT SEC 0.024
					IF (di092CapsareChanged==TRUE) THEN
						bCapsChanged=TRUE
						bAutoCore_Clear=Clear_KRLMsg(nAutoCore_Handle)
					ENDIF
				ENDWHILE
				IF (bCapsChanged==TRUE) THEN
					nAutoCore_Key=2
				ENDIF
				SWITCH nAutoCore_Key
					CASE 1 ; Diagnostic
						nAutoCore_Handle = Set_Krlmsg (#QUIT, AutomationCore_Msg[2], AutoCore_MsgPar[], AutoCore_MsgOpt_Stop)
						WHILE (Exists_KrlMsg(nAutoCore_Handle))
							WAIT SEC 0.024
						ENDWHILE
						bMsgRelease = FALSE
					CASE 2 ; Yes
						bMsgRelease = TRUE
						bCapsChanged=TRUE
						do092RobotCapChgComplete=TRUE
						PULSE(dopw1_StepperReset,TRUE,0.1)
					CASE 3 ; No
						bMsgRelease = FALSE
						bCapsChanged=FALSE
				ENDSWITCH
			ENDIF
		UNTIL (bMsgRelease==TRUE)
		do091RobotReadyCapChange=FALSE
;ENDFOLD (Have Electrodes been changed?)

;FOLD Reset Cap Change to PLC
IF (bCapsChanged==TRUE) THEN
	do092RobotCapChgComplete=False
ENDIF
;ENDFOLD

;FOLD Start Water
dopw1_StartWater=TRUE
;ENDFOLD Start Water

END