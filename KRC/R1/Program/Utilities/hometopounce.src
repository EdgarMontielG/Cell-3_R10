&ACCESS RVP3
&REL 1
&COMMENT 03-10-R1 NOT CALLED POUNCE
&PARAM DISKPATH = Program/Utilities
DEF  HomeToPounce ( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - NOT CALLED - AUTOMATIONCORE POUNCE SKELETON
;********************************
; AUTOMATIONCORE STANDARD PATH HOME TO POUNCE: PTP HOME, PTP POUNCE (GLOBAL XPOUNCE).
; NO PROGRAM CALLS IT - IT IS ONLY DECLARED (EXT) IN automationcoredata.dat (C12)
;NOTE: NO INTERFERENCE ZONE IS REQUESTED (C11, C13)
;********************************

;PTP HOME (XHOME), THEN PTP POUNCE (GLOBAL XPOUNCE)
;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

;FOLD PTP POUNCE  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:POUNCE, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PPOUNCE
FDAT_ACT=FPOUNCE
BAS (#PTP_PARAMS,100 )
PTP  XPOUNCE
;ENDFOLD

END
