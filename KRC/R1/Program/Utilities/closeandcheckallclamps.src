&ACCESS RVO1
&REL 3
&COMMENT 03-10-R1 CLOSE GRIPPER 1
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
DEF CloseAndCheckAllClamps( )
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
	;FOLD NutWeld
	;ENDFOLD (NutWeld)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - CLOSE AND CHECK THE EOAT 1 GRIPPER (MASTERING REFERENCE)
;********************************
;CALLED BY MASREFSTARTG1 (masref_user) BEFORE THE MASTERING REFERENCE PATH
;NOTE: ONLY GRIPPER 1 IS ACTIVE IN grp_data.dat ($OUT[249]/[250], $IN[257]/[258]). THE SET AND
;  CHECK FOLDS OF GRIPPERS 2-4 WERE ALREADY DISABLED (CALLS COMMENTED OUT, MARKED SL) AND WERE
;  REMOVED BY THE CLEANUP: THIS ROUTINE CLOSES AND CHECKS GRIPPER 1 ONLY (F45)

;GRIPPER 1 CLOSE, THEN CHECK GRIPPER 1 CLOSED

;FOLD Gripper SET [1]Gripper1 State=[2]CLOSE Wait 0.2[s] Check with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperSet;setgripper=1;setstate=2;setcont=nocont;waittime=0.2;errorstrategy=1
;ENDFOLD
GRPg_SetStateAndCheck(1, 2, 0.2, 1)
;ENDFOLD
;FOLD Gripper CHECK [1]Gripper1 State=[2]CLOSE with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperCheck;setgripper=1;setstate=2;setcont=nocont;checkstrategy=1
;ENDFOLD
GRPg_Check(1, 2, FALSE, 1)
;ENDFOLD

END
