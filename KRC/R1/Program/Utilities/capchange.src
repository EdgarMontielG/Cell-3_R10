&ACCESS RVP
&REL 4
&PARAM DISKPATH = Program/Utilities
DEF  CapChange ( )
;FOLD DECL;%{PE}
DECL BOOL bMsgRelease
DECL BOOL bCapsChanged
;ENDFOLD (DECL)
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
    bMsgRelease=FALSE
    bCapsChanged=FALSE
    do465WaterOnSV=FALSE
;ENDFOLD (USER INI)
;ENDFOLD (INI)
;FOLD TORQMON SetLimits Axis1: 40 % Axis2: 30 % Axis3: 30 % Axis4: 30 % Axis5: 30 % Axis6: 30 %;%{PE}%R 8.3.43,%MKUKATPBASIS,%CTQ_MON,%VTQ_LIMITS,%P 2:TQ_LIMITS, 4:40, 7:30, 10:30, 13:30, 16:30, 19:30
SET_TQ_VALUES (40,30,30,30,30,30)
;ENDFOLD

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

HomeToRepair()

;FOLD Have caps been changed?
		REPEAT
			do091RobotReadyCapChange=TRUE
			nAutoCore_Handle = Set_KrlDlg (AutomationCore_Msg[26], AutoCore_MsgPar[], AC_SK_YesNoNav[], AutoCore_MsgOpt_Stop)
			IF (nAutoCore_Handle > 0) THEN
				WHILE (Exists_KrlDlg(nAutoCore_Handle, nAutoCore_Key))
					WAIT SEC 0.024
					IF (di092CapsareChanged==TRUE) THEN
						bCapsChanged=TRUE
						bAutoCore_Clear=Clear_KRLMsg(nAutoCore_Handle)
					ENDIF
				ENDWHILE
				IF (bCapsChanged==TRUE) THEN
					nAutoCore_Key=2
				ENDIF
				SWITCH nAutoCore_Key
					CASE 1 ; Diagnostic
						nAutoCore_Handle = Set_Krlmsg (#QUIT, AutomationCore_Msg[2], AutoCore_MsgPar[], AutoCore_MsgOpt_Stop)
						WHILE (Exists_KrlMsg(nAutoCore_Handle))
							WAIT SEC 0.024
						ENDWHILE
						bMsgRelease = FALSE
					CASE 2 ; Yes
						bMsgRelease = TRUE
						bCapsChanged=TRUE
						do092RobotCapChgComplete=TRUE
						PULSE(do308ElectrodesReplaced,TRUE,0.1)
					CASE 3 ; No
						bMsgRelease = TRUE
						bCapsChanged=FALSE
				ENDSWITCH
			ENDIF
		UNTIL (bMsgRelease==TRUE)
		do091RobotReadyCapChange=FALSE
;ENDFOLD (Have caps been changed?)

RepairToHome()

IF (bCapsChanged==TRUE) THEN
	do092RobotCapChgComplete=False
ENDIF
;FOLD TORQMON SetDefault;%{PE}%R 8.3.43,%MKUKATPBASIS,%CTQ_MON,%VTQ_DEFAULT,%P 2:TQ_DEFAULT
SET_TQ_VALUES ( )
;ENDFOLD

;FOLD {H} TERMINATE
do465WaterOnSV=TRUE
;ENDFOLD (TERMINATE)
END
