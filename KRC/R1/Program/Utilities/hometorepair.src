&ACCESS RVP3
&REL 12
&COMMENT 03-10-R1 HOME TO REPAIR
DEF  HomeToRepair ( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - SERVICE PATH HOME TO REPAIR
;********************************
; CALLED BY CELL (AFTER HomeCheck) WHEN THE PLC SETS $IN[9] di009GoToRepair:
; PTP HOME, PTP REPAIR (GLOBAL XREPAIR). CELL THEN WAITS FOR $IN[8] di008ReturnFromRepair
; AND CALLS RepairToHome
;NOTE: NO INTERFERENCE ZONE IS REQUESTED ON THE WAY TO REPAIR (C11, C13)
;********************************

;PTP HOME (XHOME), THEN PTP REPAIR (GLOBAL XREPAIR)
;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

;FOLD PTP P0 Vel=100 % PDAT1 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 
;ENDFOLD
;FOLD PTP P1 Vel=100 % PDAT2 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P1, 3:, 5:100, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP1
BAS(#PTP_PARAMS,100)
PTP XP1 
;ENDFOLD
;FOLD PTP P2 CONT Vel=80 % PDAT3 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P2, 3:C_DIS, 5:80, 7:PDAT3
$BWDSTART=FALSE
PDAT_ACT=PPDAT3
FDAT_ACT=FP2
BAS(#PTP_PARAMS,80)
PTP XP2 C_DIS
;ENDFOLD
;FOLD PTP REPAIR  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:Repair, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PREPAIR
FDAT_ACT=FREPAIR
BAS (#PTP_PARAMS,100 )
PTP  XREPAIR
;ENDFOLD

END
