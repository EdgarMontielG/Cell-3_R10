&ACCESS RVP15
&REL 3
&COMMENT 03-10-R1 REPAIR TO HOME
DEF  RepairToHome ( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - SERVICE PATH REPAIR TO HOME
;********************************
; CALLED BY CELL AFTER $IN[8] di008ReturnFromRepair: PTP REPAIR (GLOBAL XREPAIR), PTP HOME
;********************************

;PTP REPAIR (GLOBAL XREPAIR), THEN PTP HOME (XHOME)
;FOLD PTP REPAIR  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:REPAIR, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PREPAIR
FDAT_ACT=FREPAIR
BAS (#PTP_PARAMS,100 )
PTP  XREPAIR
;ENDFOLD

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

END
