&ACCESS RVO2
&REL 41
&COMMENT 03-10-R1 REJECT
&PARAM DISKPATH = KRC:\R1\Program\Utilities
DEF RejectGE4( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - REJECT THE PART (SCRAP) AFTER A FAILED NUT CHECK
;********************************
; CALLED BY Style1Opt1 WHEN bscrapGE4 IS TRUE AFTER THE SENSOR OR THE CAMERA CHECK.
; SETS THE REJECT OUTPUT, PLACES THE PART AT THE REJECT LOCATION (P23), OPENS GRIPPER 1, GOES
; HOME, CLEARS THE REJECT OUTPUT AND THE SCRAP AND NUT FLAGS.
;NOTE: NO AutomationCore DROP-OFF REQUEST: NOTHING INTERLOCKS THE REJECT LOCATION WITH THE
;  PLC, AND APPLICATION 1 IS NOT RELEASED WHEN THE SENSOR CHECK DECIDED SCRAP (F20)
;PART REJECTED - SIGNAL $OUT[106] do106PartRejeted ON
;FOLD OUT 106 'do106PartRejeted' State=TRUE ;%{PE}%R 8.3.43,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:106, 3:do106RemoveScrapParts, 5:TRUE, 6:
$OUT[106]=TRUE
;ENDFOLD
;MOVE TO THE REJECT LOCATION - P10, P23
;FOLD PTP P10 Vel=100 % L Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P10, 3:, 5:100, 7:L
$BWDSTART=FALSE
PDAT_ACT=PL
FDAT_ACT=FP10
BAS(#PTP_PARAMS,100)
PTP XP10 
;ENDFOLD

;FOLD LIN P23 Vel=2 m/s CPDAT0 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P23, 3:, 5:2, 7:CPDAT0
$BWDSTART=FALSE
LDAT_ACT=LCPDAT0
FDAT_ACT=FP23
BAS(#CP_PARAMS,2)
LIN XP23 
;ENDFOLD

;GRIPPER 1 OPEN - SIGNALS $OUT[249] do249Group1Home ON, $OUT[250] do250Group1Work OFF, WAIT 0.2 S,
;THEN CHECK $IN[257] di257Cylinder1Home ON, $IN[258] di258Cylinder1Work OFF (STRATEGY 1)
;NOTE: THE PART IN THE GRIPPER ($IN[253]/$IN[254]) IS NOT CONFIRMED BEFORE OPENING (F40)
;FOLD Gripper SET [1]Gripper 1 State=[1]OPEN Wait 0.2[s] Check with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperSet;setgripper=1;setstate=1;setcont=nocont;waittime=0.2;errorstrategy=1
;ENDFOLD
GRPg_SetStateAndCheck(1, 1, 0.2, 1)
;ENDFOLD
;CHECK GRIPPER 1 OPEN AGAIN (REPEATS THE CHECK ABOVE)
;FOLD Gripper CHECK [1]Gripper 1 State=[1]OPEN with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperCheck;setgripper=1;setstate=1;setcont=nocont;checkstrategy=1
;ENDFOLD
GRPg_Check(1, 1, FALSE, 1)
;ENDFOLD
;WAIT GRIPPER EMPTY - SIGNALS $IN[253] di253PartPresent1 OFF, $IN[254] di254PartPresent2 OFF (NO TIMEOUT)
;FOLD WAIT FOR ( NOT IN 253 'di253PartPresent1' ) AND ( NOT IN 254 'di254PartPresent2' );%{PE}%R 8.3.43,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:253, 7:di253PartPresent1, 9:AND, 10:, 12:NOT, 13:$IN, 14:254, 15:di254PartPresent2, 17:
WAIT FOR  (  NOT $IN[253] ) AND (  NOT $IN[254] ) 
;ENDFOLD

;LEAVE THE REJECT LOCATION - P24 (TAUGHT IN BASE 3 "NUT WELDER")
;FOLD PTP P24 Vel=100 % PDAT29 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P24, 3:, 5:100, 7:PDAT29
$BWDSTART=FALSE
PDAT_ACT=PPDAT29
FDAT_ACT=FP24
BAS(#PTP_PARAMS,100)
PTP XP24 
;ENDFOLD
;PART NOT IN GRIPPER - SIGNAL $OUT[18] do018Part1InGripper OFF
;FOLD OUT 18 'do018PartInGripper1' State=FALSE ;%{PE}%R 8.3.43,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:18, 3:do018PartInGripper1, 5:FALSE, 6:
$OUT[18]=FALSE
;ENDFOLD

;RETURN HOME - P27, P25, HOME
;FOLD PTP P27 CONT Vel=100 % PDAT32 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P27, 3:C_DIS, 5:100, 7:PDAT32
$BWDSTART=FALSE
PDAT_ACT=PPDAT32
FDAT_ACT=FP27
BAS(#PTP_PARAMS,100)
PTP XP27 C_DIS
;ENDFOLD
;FOLD PTP P25 CONT Vel=100 % PDAT30 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P25, 3:C_DIS, 5:100, 7:PDAT30
$BWDSTART=FALSE
PDAT_ACT=PPDAT30
FDAT_ACT=FP25
BAS(#PTP_PARAMS,100)
PTP XP25 C_DIS
;ENDFOLD

;FOLD PTP HOME Vel=100 % DEFAULT;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART=FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD

;REJECT DONE - SIGNAL $OUT[106] do106PartRejeted OFF
;NOTE: THIS FORM USED TO CARRY THE HIDDEN VALUE 5:TRUE (RE-OPENING IT WOULD HAVE SWITCHED
;NOTE: $OUT[106] ON) AND ENCLOSED THE FLAG RESETS. THE CLEANUP SET THE FORM VALUE TO 5:FALSE AND
;NOTE: ENDED THE FOLD AFTER $OUT[106]=FALSE, SO THE RESETS BELOW ARE NOT PART OF THE FORM (F20)
;FOLD OUT 106 'do106PartRejeted' State=FALSE ;%{PE}%R 8.3.43,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:106, 3:do106RemoveScrapParts, 5:FALSE, 6:
$OUT[106]=FALSE
;ENDFOLD
;CLEAR THE SCRAP AND NUT PRESENCE FLAGS: bScrapCantrail, bscrapGE4, PARTPRESENT1..3 = FALSE
;NOTE: bScrapCantrail IS A LEFTOVER FLAG FROM ANOTHER PROJECT - WRITTEN HERE, NEVER READ
   bScrapCantrail=FALSE 
   bscrapGE4=FALSE
   PARTPRESENT1=FALSE
   PARTPRESENT2=FALSE  
   PARTPRESENT3=FALSE



   
END
