;FOLD OUT 106 'do106PartRejeted' State=FALSE ;%{PE}%R 8.3.43,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:106, 3:do106RemoveScrapParts, 5:TRUE, 6:
