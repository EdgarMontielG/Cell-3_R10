&ACCESS RVO1
&REL 246
&COMMENT 03-10-R1 PNW1 NUT 2 ST1
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app1opt2A( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD NutWeld
      ;ENDFOLD (NutWeld)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - WELD NUT 2 (PN2) AT THE CENTERLINE PEDESTAL - PART FROM PICKUP 1 (A)
;********************************
; CALLED BY Style1Opt1. APPROACH THE PEDESTAL (BASE 3 "NUT WELDER"), WAIT FOR THE NUT PRELOAD
; (NEXT_NUT_READY), MOVE THE PART TO THE WELD POSITION P16, WELD WITH CENTERLINE_WELD (NOT IN DRY
; CYCLE), LEAVE THE PEDESTAL.
;WARNING: BEFORE THE ROBOT MOVES IN, GUN OPEN, SUBMIT AND WATER ARE CHECKED (GUN_OPEN_CHECK) -
;  NOT CLAMP OPEN OR QFP RETURNED (F01)
;NOTE: THE PEDESTAL MOVES MIX BASE MODE AND EXTERNAL-TCP MODE (extTCP); THE WELD POSITION
;  P16 IS TAUGHT IN BASE MODE (F22)
;APPROACH THE PEDESTAL - P0, P5
;FOLD PTP P0 CONT Vel=100 % PDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_DIS, 5:100, 7:PDAT0
$BWDSTART=FALSE
PDAT_ACT=PPDAT0
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 C_DIS
;ENDFOLD
;FOLD LIN P5 Vel=2 m/s CPDAT11 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P5, 3:, 5:2, 7:CPDAT11
$BWDSTART=FALSE
LDAT_ACT=LCPDAT11
FDAT_ACT=FP5
BAS(#CP_PARAMS,2)
LIN XP5 
;ENDFOLD
;GUN MONITORING - INTERRUPTS 20-22 CALL GUN_OPEN_LOST (BRAKE F, QUIT MESSAGE) WHEN THE GUN LEAVES THE
;OPEN RANGE (CL_GunStrokePositionLPT 137000..142000) OR THE SUBMIT STOPS WHILE THE ROBOT MOVES INTO
;OR OUT OF THE PEDESTAL. EDGE TRIGGERED: GUN_OPEN_CHECK CONFIRMS THE GUN OPEN AFTER EVERY ON (F01)
;WARNING: THE RANGE IS WRITTEN HERE AS LITERALS; KEEP IT EQUAL TO nGunOpenMin/nGunOpenMax IN
;  GUN_OPEN_CHECK.dat (F01)
INTERRUPT DECL 20 WHEN CL_GunStrokePositionLPT<137000 DO GUN_OPEN_LOST()
INTERRUPT DECL 21 WHEN CL_GunStrokePositionLPT>142000 DO GUN_OPEN_LOST()
INTERRUPT DECL 22 WHEN $PRO_STATE0<>#P_ACTIVE DO GUN_OPEN_LOST()
;CYCLE-TIME MEASUREMENT (NO EFFECT ON THE SEQUENCE): ROBOT STOPPED AT THE WAIT POINT (WAIT SEC 0),
;$TIMER[20] FROM HERE FOR NUT 2 (CL_CYCLE_TIME, F52)
WAIT SEC 0
CL_CYCLE_START(2)
;WAIT NUT PRELOADED - NEXT_NUT_READY (SET WHEN THE PRELOAD ENDS, QFP SEEN RETURNED; NO NUT SENSOR,
;  F13)
;NOTE: NO TIMEOUT, NO MESSAGE (F15). IN DRY CYCLE NOTHING SETS IT: THE CYCLE HANGS HERE (F04)
WAIT FOR NEXT_NUT_READY==TRUE
;CYCLE-TIME MARK - STEP 1 NUT READY (CL_CYCLE_TIME, F52)
CL_CYCLE_TIME(1)
;FEED NUT 3 INTO THE SHUTTLE NOW, WHILE THE ROBOT MOVES IN AND WELDS: THE SHUTTLE IS RETURNED
;AND EMPTY, NUT 2 IS ON THE PIN. PRELOAD ONLY FEEDS; IT LOADS NUT 3 ONTO THE PIN WHEN
;Request_next_nut IS CALLED AT P05 ON THE WAY OUT. ONLY WITH NO PRELOAD RUNNING AND OUTSIDE DRY CYCLE
;(SIGNAL $IN[4] di004UseDryCycle OFF) - ELSE Request_next_nut FEEDS AND LOADS AS BEFORE (F52)
IF NUT_READY AND NOT NUTCYCLE_ACTIVE AND NOT di004UseDryCycle THEN
   NUT_FEED_START=TRUE
ENDIF
;GUN MONITORING ON FIRST (THE INTERRUPTS FIRE ONLY ON A CHANGE), THEN THE INTERLOCK: GUN OPEN,
;SUBMIT RUNNING, WATER OK (GUN_OPEN_CHECK); THE MONITORING STAYS ON WHILE THE ROBOT MOVES IN (F01)
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
GUN_OPEN_CHECK()
;MOVE IN - P6 (2 M/S), THEN THE WELD POSITION P16 OUTSIDE DRY CYCLE
;FOLD LIN P6 Vel=2 m/s CPDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P6, 3:, 5:2, 7:CPDAT0
$BWDSTART=FALSE
LDAT_ACT=LCPDAT0
FDAT_ACT=FP6
BAS(#CP_PARAMS,2)
LIN XP6 
;ENDFOLD

;OUTSIDE DRY CYCLE ONLY (SIGNAL $IN[4] di004UseDryCycle OFF): WELD POSITION P16 AND CENTERLINE_WELD()
;NOTE: $IN[4] IS RE-READ AT EVERY STEP; SWITCHED ON MID-CYCLE, THIS NUT IS NOT WELDED AND
;  THE PART CAN STILL REACH THE GOOD DROP (F05)
IF NOT di004UseDryCycle THEN
;FOLD LIN P16 Vel=2 m/s CPDAT15 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P16, 3:, 5:2, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP16
BAS(#CP_PARAMS,2)
LIN XP16 
;ENDFOLD
;ROBOT AT THE WELD POSITION (WAIT SEC 0 STOPS THE ADVANCE RUN): GUN MONITORING OFF, THE GUN
;CLOSES ON PURPOSE IN CENTERLINE_WELD
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
;NUT WELD AT THE PEDESTAL (CENTERLINE_WELD: CLAMP, GUN, INTENSIFY, BOSCH WELD, GUN OPEN)
CENTERLINE_WELD()
;GUN MONITORING ON WHILE LEAVING, THEN THE GUN OPEN IS CONFIRMED AGAIN (GUN_OPEN_CHECK): A GUN THAT
;LEFT THE OPEN RANGE AFTER THE CHECK INSIDE CENTERLINE_WELD WOULD NOT TRIGGER THE INTERRUPTS (F01)
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
GUN_OPEN_CHECK()
ENDIF
;LEAVE THE PEDESTAL - P06, P05, P0 (THE DRY CYCLE CONTINUES HERE)
;FOLD LIN P06 CONT Vel=2 m/s CPDAT6 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P06, 3:C_DIS C_DIS, 5:2, 7:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP06
BAS(#CP_PARAMS,2)
LIN XP06 C_DIS C_DIS
;ENDFOLD
;ROBOT OUT OF THE PEDESTAL (WAIT SEC 0 STOPS THE ADVANCE RUN, NO APPROXIMATION HERE): GUN
;MONITORING OFF
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
;FOLD LIN P05 Vel=2 m/s CPDAT14 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P05, 3:, 5:2, 7:CPDAT14
$BWDSTART=FALSE
LDAT_ACT=LCPDAT14
FDAT_ACT=FP05
BAS(#CP_PARAMS,2)
LIN XP05 
;ENDFOLD
;NEXT NUT - TRIGGER ON THE MOTION TO P0 (DISTANCE = 0: FIRES WHEN THE MOTION STARTS, AT P05 - EXACT
;STOP - PRIO -1). P05 IS 4 MM FROM P5, WHERE THE ROBOT ALREADY WAITS WHILE THE QFP LOADS NUT 2
;(WAS DISTANCE = 1, AT P0). Request_next_nut() CLEARS NEXT_NUT_READY AND SETS NUT_START: PRELOAD
;LOADS NUT 3 (FED DURING THE WELD) ONTO THE PIN, OR FEEDS AND LOADS IT IF NOTHING WAS FED (F52)
;NOTE: THE TRIGGER STANDS BEFORE THE INLINE FORM, SO A TOUCH UP OF P0 CANNOT DELETE IT; IT ACTS ON
;  THE NEXT MOTION. A BLOCK SELECTION ONTO THE MOTION FOLD SKIPS IT (SELECT THE TRIGGER LINE),
;  AND SO DOES A PROGRAM RESET: NEXT_NUT_READY IS STILL TRUE FROM NUT 2, NUT 3 GOES IN WITH NO NUT
;  LOADED AND THE GUN-CLOSED CHECK STOPS THE CYCLE (F14, F38)
TRIGGER WHEN DISTANCE = 0 DELAY = 0 DO Request_next_nut() PRIO= -1
;FOLD PTP P0 Vel=100 % PDAT26 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:, 5:100, 7:PDAT26
$BWDSTART=FALSE
PDAT_ACT=PPDAT26
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 
;ENDFOLD

   
END