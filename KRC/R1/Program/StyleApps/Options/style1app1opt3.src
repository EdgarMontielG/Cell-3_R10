&ACCESS RVO1
&REL 227
&COMMENT GE4_003_GUN1
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app1opt3( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD NutWeld
      ;ENDFOLD (NutWeld)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)

;FOLD LIN P20 CONT Vel=2 m/s CPDAT6 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P20, 3:C_DIS C_DIS, 5:2, 7:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP20
BAS(#CP_PARAMS,2)
LIN XP20 C_DIS C_DIS
;ENDFOLD
RETRY_NUT1:
WAIT FOR NEXT_NUT_READY==TRUE
;FOLD LIN P13 CONT Vel=2 m/s CPDAT4 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P13, 3:C_DIS C_DIS, 5:2, 7:CPDAT4
$BWDSTART=FALSE
LDAT_ACT=LCPDAT4
FDAT_ACT=FP13
BAS(#CP_PARAMS,2)
LIN XP13 C_DIS C_DIS
;ENDFOLD

IF di004UseDryCycle==TRUE THEN

GOTO DRY1
ELSE

;FOLD LIN P16 Vel=2 m/s CPDAT11 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P16, 3:, 5:2, 7:CPDAT11
$BWDSTART=FALSE
LDAT_ACT=LCPDAT11
FDAT_ACT=FP16
BAS(#CP_PARAMS,2)
LIN XP16 
;ENDFOLD
CENTERLINE_WELD()

ENDIF
DRY1:
;FOLD LIN P17 Vel=2 m/s CPDAT12 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P17, 3:, 5:2, 7:CPDAT12
$BWDSTART=FALSE
LDAT_ACT=LCPDAT12
FDAT_ACT=FP17
BAS(#CP_PARAMS,2)
LIN XP17 
;ENDFOLD
IF NUT_WELD_RETRY THEN
   NUT_WELD_RETRY=FALSE
   
   GOTO RETRY_NUT1
ENDIF
;FOLD LIN P20 Vel=2 m/s CPDAT10 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P20, 3:, 5:2, 7:CPDAT10
$BWDSTART=FALSE
LDAT_ACT=LCPDAT10
FDAT_ACT=FP20
BAS(#CP_PARAMS,2)
LIN XP20 
;ENDFOLD
;FOLD PTP P7 Vel=60 % PDAT25 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P7, 3:, 5:60, 7:PDAT25
$BWDSTART=FALSE
PDAT_ACT=PPDAT25
FDAT_ACT=FP7
BAS(#PTP_PARAMS,60)
PTP XP7 
;ENDFOLD

   
END