&ACCESS RVO1
&REL 252
&COMMENT 03-10-R1 PNW1 NUT 2 ST2
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app1opt2A( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD NutWeld
      ;ENDFOLD (NutWeld)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - WELD NUT 2 (PN2) AT THE CENTERLINE PEDESTAL - PART FROM PICKUP 2 (B)
;********************************
; CALLED BY Style1Opt1. APPROACH THE PEDESTAL (BASE 3 "NUT WELDER"), WAIT FOR THE NUT PRELOAD
; (NEXT_NUT_READY), MOVE THE PART TO THE WELD POSITION P16, WELD WITH CENTERLINE_WELD (NOT IN DRY
; CYCLE), LEAVE THE PEDESTAL.
;WARNING: BEFORE THE ROBOT MOVES IN AND OUT: SUBMIT, GUN OPEN, WATER, THEN PART CLAMP OPEN AND UPPER
;  PIN RETRACT (PEDESTAL_CLEAR_CHECK, 2026-10-06) - QFP RETURNED IS NOT CHECKED (F01)
;NOTE: THE PEDESTAL MOVES MIX BASE MODE AND EXTERNAL-TCP MODE (extTCP); THE WELD POSITION
;  P16 IS TAUGHT IN BASE MODE (F22)
;APPROACH THE PEDESTAL - P0, P5
;FOLD PTP P0 CONT Vel=100 % PDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_DIS, 5:100, 7:PDAT0
$BWDSTART=FALSE
PDAT_ACT=PPDAT0
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 C_DIS
;ENDFOLD
;GUN MONITORING - INTERRUPTS 20-22 CALL GUN_OPEN_LOST (BRAKE F, QUIT MESSAGE) WHEN THE GUN LEAVES THE
;OPEN RANGE (CL_GunStrokePositionLPT 137000..142000) OR THE SUBMIT STOPS WHILE THE ROBOT MOVES INTO
;OR OUT OF THE PEDESTAL. EDGE TRIGGERED: GUN_OPEN_CHECK CONFIRMS THE GUN OPEN AFTER EVERY ON (F01)
;WARNING: THE RANGE IS WRITTEN HERE AS LITERALS; KEEP IT EQUAL TO nGunOpenMin/nGunOpenMax IN
;  GUN_OPEN_CHECK.dat (F01)
INTERRUPT DECL 20 WHEN CL_GunStrokePositionLPT<137000 DO GUN_OPEN_LOST()
INTERRUPT DECL 21 WHEN CL_GunStrokePositionLPT>142000 DO GUN_OPEN_LOST()
INTERRUPT DECL 22 WHEN $PRO_STATE0<>#P_ACTIVE DO GUN_OPEN_LOST()
;PEDESTAL MONITORING (2026-10-06): 23 PART CLAMP NOT OPEN, 24 UPPER PIN NOT RETRACTED -
;CL_ClampOpen / CL_PinRetracted ARE SET BY SPS.SUB; PEDESTAL_CLEAR_CHECK CONFIRMS THEM
INTERRUPT DECL 23 WHEN CL_ClampOpen==FALSE DO GUN_OPEN_LOST()
INTERRUPT DECL 24 WHEN CL_PinRetracted==FALSE DO GUN_OPEN_LOST()
;WAIT NUT PRELOADED - NEXT_NUT_READY (SET WHEN THE PRELOAD SEQUENCE ENDS: TIMED, NO NUT SENSOR, F13)
;NOTE: NO TIMEOUT, NO MESSAGE (F15). IN DRY CYCLE NOTHING SETS IT: THE CYCLE HANGS HERE (F04)
CT_NUT_WAIT(2)   ;SAME WAIT + WAIT TIME MEASUREMENT (GUN_OPEN_CHECK.SRC, 2026-10-09)
;GUN MONITORING ON FIRST (THE INTERRUPTS FIRE ONLY ON A CHANGE), THEN THE INTERLOCK: GUN OPEN,
;SUBMIT RUNNING, WATER OK (GUN_OPEN_CHECK); THE MONITORING STAYS ON WHILE THE ROBOT MOVES IN (F01)
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
INTERRUPT ON 23
INTERRUPT ON 24
;PEDESTAL INTERLOCK (2026-10-06): GUN OPEN (GUN_OPEN_CHECK), THEN PART CLAMP OPEN AND UPPER PIN RETRACT
PEDESTAL_CLEAR_CHECK()
;MOVE IN - P6 (2 M/S), THEN THE WELD POSITION P16 OUTSIDE DRY CYCLE
;FOLD LIN P6 Vel=2 m/s CPDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P6, 3:, 5:2, 7:CPDAT0
$BWDSTART=FALSE
LDAT_ACT=LCPDAT0
FDAT_ACT=FP6
BAS(#CP_PARAMS,2)
LIN XP6 
;ENDFOLD

;OUTSIDE DRY CYCLE ONLY (SIGNAL $IN[4] di004UseDryCycle OFF): WELD POSITION P16 AND CENTERLINE_WELD()
;NOTE: $IN[4] IS RE-READ AT EVERY STEP; SWITCHED ON MID-CYCLE, THIS NUT IS NOT WELDED AND
;  THE PART CAN STILL REACH THE GOOD DROP (F05)
IF NOT di004UseDryCycle THEN
;FOLD LIN P16 Vel=2 m/s CPDAT15 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P16, 3:, 5:2, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP16
BAS(#CP_PARAMS,2)
LIN XP16 
;ENDFOLD
;ROBOT AT THE WELD POSITION (WAIT SEC 0 STOPS THE ADVANCE RUN): GUN MONITORING OFF, THE GUN
;CLOSES ON PURPOSE IN CENTERLINE_WELD
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
INTERRUPT OFF 23
INTERRUPT OFF 24
;NUT WELD AT THE PEDESTAL (CENTERLINE_WELD: CLAMP, GUN, INTENSIFY, BOSCH WELD, GUN OPEN)
CENTERLINE_WELD()
;NUT RETRY IN THE WELD POSITION (2026-10-10, USER: THE NUT CAN BE FED WITH THE PART HERE): CENTERLINE_WELD FOUND
;  NO NUT AND DID NOT WELD (GUN, PINS AND CLAMP OPEN) - THE ROBOT STAYS, A NEW NUT IS FED AND THE NUT IS WELDED
;  AGAIN. NO RETRY LEFT: CENTERLINE_WELD STOPS WITH THE NO NUT FAULT AS BEFORE. SETTINGS IN GUN_OPEN_CHECK.DAT
WHILE NUT_WELD_RETRY
   NUT_WELD_RETRY=FALSE
   Request_next_nut()
   WAIT FOR NUT_READY==TRUE
   CENTERLINE_WELD()
ENDWHILE
;NEXT NUT REQUESTED RIGHT AFTER THE WELD (2026-10-10 CYCLE TIME, AS 20R1 - USER: SAFE ON 10R1): THE PRELOAD
;  LOWERS THE LOWER PIN AND MOVES THE QFP WHILE THE PART IS STILL LEAVING. WAS A TRIGGER AT THE MOTION TO P0;
;  P0 WAS DELETED 2026-10-10 AND THE TRIGGER WAS LEFT WITH NO MOTION AFTER IT (PRELOAD OUT OF SEQUENCE)
Request_next_nut()
;GUN MONITORING ON WHILE LEAVING, THEN THE GUN OPEN IS CONFIRMED AGAIN (GUN_OPEN_CHECK): A GUN THAT
;LEFT THE OPEN RANGE AFTER THE CHECK INSIDE CENTERLINE_WELD WOULD NOT TRIGGER THE INTERRUPTS (F01)
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
INTERRUPT ON 23
INTERRUPT ON 24
;PEDESTAL INTERLOCK (2026-10-06): GUN OPEN (GUN_OPEN_CHECK), THEN PART CLAMP OPEN AND UPPER PIN RETRACT
PEDESTAL_CLEAR_CHECK()
ENDIF
;LEAVE THE PEDESTAL - P06, P05, P0 (THE DRY CYCLE CONTINUES HERE)
;FOLD LIN P06 CONT Vel=2 m/s CPDAT6 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P06, 3:C_DIS C_DIS, 5:2, 7:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP06
BAS(#CP_PARAMS,2)
LIN XP06 C_DIS C_DIS
;ENDFOLD
;ROBOT OUT OF THE PEDESTAL (WAIT SEC 0 STOPS THE ADVANCE RUN, NO APPROXIMATION HERE): GUN
;MONITORING OFF
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
INTERRUPT OFF 23
INTERRUPT OFF 24
;FOLD PTP P05 CONT Vel=100 % PDAT1 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P05, 3:C_DIS, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP05
BAS(#PTP_PARAMS,100)
PTP XP05 C_DIS
;ENDFOLD
;NEXT NUT - TRIGGER ON THE MOTION TO P0 (DISTANCE = 1: FIRES WHEN THE MOTION ENDS, PRIO -1):
;Request_next_nut() CLEARS NEXT_NUT_READY AND STARTS THE PRELOAD OF NUT 3 (NUT_START=TRUE)
;NOTE: THE TRIGGER STANDS BEFORE THE INLINE FORM, SO A TOUCH UP OF P0 CANNOT DELETE IT; IT ACTS ON
;  THE NEXT MOTION. A BLOCK SELECTION ONTO THE MOTION FOLD SKIPS IT (SELECT THE TRIGGER LINE),
;  AND SO DOES A PROGRAM RESET: NUT 3 THEN WAITS FOR EVER FOR NEXT_NUT_READY (F14, F38)
;TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO Request_next_nut() PRIO= -1   ;2026-10-10: MOVED TO RIGHT AFTER CENTERLINE_WELD

   
END
