&ACCESS RVO1
&REL 16
&COMMENT 03-10-R1 NUT CHECK CAMERA
&PARAM EDITMASK = *
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF Style1App2Opt2( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - NUT CHECK WITH THE CAMERA
;********************************
; CALLED BY Style1Opt1 AND Style1Opt10AutoRR AFTER THE SENSOR CHECK (style1app2opt1).
; PRESENTS THE PART TO THE CAMERA (P3), ASKS THE PLC FOR THE INSPECTION ($OUT[80]) AND SETS
; bscrapGE4 FROM THE RESULT. APPLICATION 1 IS RELEASED BY THE NEXT PROGRAM, AWAY FROM THE CAMERA.
;NOTE: THE CAMERA RESULT IS EVALUATED BY OPTION (PRODUCTION 1, 2, 7, 8; RED RABBIT 12), ALSO IN
;  DRY CYCLE (F02, F05, F19)
;APPROACH THE CAMERA - P6 (TAUGHT IN BASE 3 "NUT WELDER")
;FOLD PTP P6 Vel=100 % PDAT10 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P6, 3:, 5:100, 7:PDAT10
$BWDSTART=FALSE
PDAT_ACT=PPDAT10
FDAT_ACT=FP6
BAS(#PTP_PARAMS,100)
PTP XP6 
;ENDFOLD

;PART AT THE CAMERA - LIN P3 (1 M/S, EXACT STOP)
;FOLD LIN P3 Vel=1 m/s CPDAT0 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P3, 3:, 5:1, 7:CPDAT0
$BWDSTART=FALSE
LDAT_ACT=LCPDAT0
FDAT_ACT=FP3
BAS(#CP_PARAMS,1)
LIN XP3 
;ENDFOLD

;CAMERA INSPECTION REQUEST - SIGNAL $OUT[80] do080RepositionTooling1 ON
;NOTE: NOTHING IN THE PROGRAM SWITCHES $OUT[80] OFF AGAIN (ONLY MaintainSystem AT THE NEXT CYCLE
;  START): THE PLC MAY SEE A STANDING REQUEST WHILE THE ROBOT LEAVES (F15)
do080RepositionTooling1=TRUE

;WAIT INSPECTION DONE - SIGNAL $IN[80] di080ToolRepositioned1 ON (NO TIMEOUT, F15)
   WAIT FOR di080ToolRepositioned1

;AFTER 0.2 S, BY OPTION nOption (F02, F19):
;PRODUCTION OPTIONS 1, 2, 7, 8: GOOD (bscrapGE4 = FALSE) ONLY WITH $IN[100] di100CameraJudgmentOK ON
;AND $IN[101] di101CameraJudgmentNG OFF; NG OR NO VALID RESULT -> bscrapGE4 = TRUE (SCRAP)
;RED RABBIT OPTION 12: CAMERA OK -> $OUT[141] do141RedRabbitFailed ON; CAMERA NG ->
;$OUT[142] do142RedRabbitPassed ON
            WAIT SEC 0.2
     SWITCH nOption
          CASE 1,2,7,8
         ;GOOD - SIGNALS $IN[100] di100CameraJudgmentOK ON, $IN[101] di101CameraJudgmentNG OFF
         IF (di100CameraJudgmentOK==TRUE) AND (di101CameraJudgmentNG==FALSE) THEN
            bscrapGE4 = FALSE
         ELSE
            bscrapGE4 = TRUE
         ENDIF
          CASE 12
         ;RED RABBIT FAILED - $IN[100] di100CameraJudgmentOK ON, $IN[101] di101CameraJudgmentNG OFF:
         ;SIGNAL $OUT[141] do141RedRabbitFailed ON
         IF (di100CameraJudgmentOK==TRUE) AND (di101CameraJudgmentNG==FALSE) THEN
            do141RedRabbitFailed=TRUE
         ENDIF
         ;RED RABBIT PASSED - $IN[100] di100CameraJudgmentOK OFF, $IN[101] di101CameraJudgmentNG ON:
         ;SIGNAL $OUT[142] do142RedRabbitPassed ON
         IF (di100CameraJudgmentOK==FALSE) AND (di101CameraJudgmentNG==TRUE) THEN
            do142RedRabbitPassed=TRUE
         ENDIF
     ENDSWITCH
            

;NOTE: APPLICATION 1 IS NOT RELEASED HERE: THE ROBOT IS STILL AT THE CAMERA. THE NEXT PROGRAM
;  (Style1Drop1Opt1, RejectGE4 OR style1drop1opt2AutoRR) SETS $OUT[70] do070ApplicationClear1 ON
;  BY TRIGGER ON ITS FIRST MOTION AWAY FROM THE CAMERA (INDEPENDENT REVIEW 2026-10-05, F48, F20)
END
