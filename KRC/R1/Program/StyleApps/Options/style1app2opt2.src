&ACCESS RVO1
&REL 17
&COMMENT 03-10-R1 NUT CHECK CAMERA
&PARAM EDITMASK = *
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF Style1App2Opt2( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - NUT CHECK WITH THE CAMERA
;********************************
;APPROACH THE CAMERA
;FOLD PTP P6 CONT Vel=100 % PDAT10 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P6, 3:C_DIS, 5:100, 7:PDAT10
$BWDSTART=FALSE
PDAT_ACT=PPDAT10
FDAT_ACT=FP6
BAS(#PTP_PARAMS,100)
PTP XP6 C_DIS
;ENDFOLD

;PART AT THE CAMERA - LIN P3 (1 M/S, EXACT STOP)
;FOLD LIN P3 Vel=1 m/s CPDAT0 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P3, 3:, 5:1, 7:CPDAT0
$BWDSTART=FALSE
LDAT_ACT=LCPDAT0
FDAT_ACT=FP3
BAS(#CP_PARAMS,1)
LIN XP3 
;ENDFOLD

;CAMERA INSPECTION REQUEST
do080RepositionTooling1=TRUE

;WAIT INSPECTION DONE
   WAIT FOR di080ToolRepositioned1

;WAIT CAMERA RESULT (MAX 5 S). NO RESULT = SCRAP
$TIMER_STOP[17]=TRUE
$TIMER[17]=0
$TIMER_STOP[17]=FALSE
WAIT FOR (di100CameraJudgmentOK EXOR di101CameraJudgmentNG) OR ($TIMER[17]>=5000)
WAIT SEC 0.1
$TIMER_STOP[17]=TRUE
     SWITCH nOption
          CASE 1,2,7,8
         ;CAMERA OK
         IF (di100CameraJudgmentOK==TRUE) AND (di101CameraJudgmentNG==FALSE) THEN
            bscrapGE4 = FALSE
         ELSE
            bscrapGE4 = TRUE
         ENDIF
          CASE 12
         ;RED RABBIT FAILED
         IF (di100CameraJudgmentOK==TRUE) AND (di101CameraJudgmentNG==FALSE) THEN
            do141RedRabbitFailed=TRUE
         ENDIF
         ;RED RABBIT PASSED
         IF (di100CameraJudgmentOK==FALSE) AND (di101CameraJudgmentNG==TRUE) THEN
            do142RedRabbitPassed=TRUE
         ENDIF
     ENDSWITCH
            

END
