&ACCESS RVO1
&REL 234
&COMMENT 03-10-R1 PNW1 NUT 3 ST2
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app1opt3B( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD NutWeld
      ;ENDFOLD (NutWeld)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - WELD NUT 3 (PN3) AT THE CENTERLINE PEDESTAL
;********************************

;APPROACH THE PEDESTAL - P20
;FOLD PTP P20 CONT Vel=100 % PDAT1 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P20, 3:C_DIS, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_DIS
;ENDFOLD
;GUN MONITORING: THE ROBOT STOPS IF THE GUN LEAVES THE OPEN RANGE WHILE IT MOVES IN / OUT
;(SAME VALUES AS nGunOpenMin / nGunOpenMax IN GUN_OPEN_CHECK.dat)
INTERRUPT DECL 20 WHEN CL_GunStrokePositionLPT<137000 DO GUN_OPEN_LOST()
INTERRUPT DECL 21 WHEN CL_GunStrokePositionLPT>142000 DO GUN_OPEN_LOST()
INTERRUPT DECL 22 WHEN $PRO_STATE0<>#P_ACTIVE DO GUN_OPEN_LOST()
;PEDESTAL MONITORING: 23 PART CLAMP NOT OPEN, 24 UPPER PIN NOT RETRACTED
INTERRUPT DECL 23 WHEN CL_ClampOpen==FALSE DO GUN_OPEN_LOST()
INTERRUPT DECL 24 WHEN CL_PinRetracted==FALSE DO GUN_OPEN_LOST()
;WAIT NUT READY
CT_NUT_WAIT(3)
;GUN MONITORING ON, THEN GUN OPEN CHECK
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
INTERRUPT ON 23
INTERRUPT ON 24
;PEDESTAL CHECK: GUN OPEN, PART CLAMP OPEN, UPPER PIN RETRACTED
PEDESTAL_CLEAR_CHECK()
;MOVE IN - P13 (2 M/S), THEN THE WELD POSITION P16 OUTSIDE DRY CYCLE
;FOLD LIN P13 CONT Vel=2 m/s CPDAT4 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P13, 3:C_DIS C_DIS, 5:2, 7:CPDAT4
$BWDSTART=FALSE
LDAT_ACT=LCPDAT4
FDAT_ACT=FP13
BAS(#CP_PARAMS,2)
LIN XP13 C_DIS C_DIS
;ENDFOLD

;WELD (NOT IN DRY CYCLE)
IF NOT di004UseDryCycle THEN
;FOLD LIN P16 Vel=2 m/s CPDAT11 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P16, 3:, 5:2, 7:CPDAT11
$BWDSTART=FALSE
LDAT_ACT=LCPDAT11
FDAT_ACT=FP16
BAS(#CP_PARAMS,2)
LIN XP16 
;ENDFOLD
;ROBOT AT THE WELD POSITION: GUN MONITORING OFF (THE GUN CLOSES IN CENTERLINE_WELD)
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
INTERRUPT OFF 23
INTERRUPT OFF 24
;NUT WELD AT THE PEDESTAL (CENTERLINE_WELD: CLAMP, GUN, INTENSIFY, BOSCH WELD, GUN OPEN)
CENTERLINE_WELD()
;NUT RETRY: NO NUT FOUND -> NEW NUT AND WELD AGAIN
WHILE NUT_WELD_RETRY
   NUT_WELD_RETRY=FALSE
   Request_next_nut()
   WAIT FOR NUT_READY==TRUE
   CENTERLINE_WELD()
ENDWHILE
;GUN MONITORING ON WHILE LEAVING
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
INTERRUPT ON 23
INTERRUPT ON 24
;PEDESTAL CHECK: GUN OPEN, PART CLAMP OPEN, UPPER PIN RETRACTED
PEDESTAL_CLEAR_CHECK()
ENDIF
;LEAVE THE PEDESTAL - P17, P20, P7 (60 %) (THE DRY CYCLE CONTINUES HERE)
;FOLD LIN P17 Vel=2 m/s CPDAT12 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P17, 3:, 5:2, 7:CPDAT12
$BWDSTART=FALSE
LDAT_ACT=LCPDAT12
FDAT_ACT=FP17
BAS(#CP_PARAMS,2)
LIN XP17 
;ENDFOLD
;ROBOT OUT OF THE PEDESTAL: GUN MONITORING OFF
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
INTERRUPT OFF 23
INTERRUPT OFF 24
;FOLD PTP P20 CONT Vel=100 % PDAT2 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P20, 3:C_DIS, 5:100, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP20
BAS(#PTP_PARAMS,100)
PTP XP20 C_DIS
;ENDFOLD
;LAST NUT OF THE PART: NO NEXT NUT IS REQUESTED HERE (THE NEXT PICK STARTS THE PRELOAD)
;FOLD PTP P7 CONT Vel=100 % PDAT25 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P7, 3:C_DIS, 5:100, 7:PDAT25
$BWDSTART=FALSE
PDAT_ACT=PPDAT25
FDAT_ACT=FP7
BAS(#PTP_PARAMS,100)
PTP XP7 C_DIS
;ENDFOLD

   
END
