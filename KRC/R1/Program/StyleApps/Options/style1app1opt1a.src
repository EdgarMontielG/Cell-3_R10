&ACCESS RVO1
&REL 343
&COMMENT 03-10-R1 PNW1 NUT 1 ST2
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app1opt1A( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD NutWeld
      ;ENDFOLD (NutWeld)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - WELD NUT 1 (PN1) AT THE CENTERLINE PEDESTAL
;********************************
   
;APPROACH THE PEDESTAL - P0, P8
;FOLD PTP P0 CONT Vel=100 % PDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_DIS, 5:100, 7:PDAT0
$BWDSTART=FALSE
PDAT_ACT=PPDAT0
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 C_DIS
;ENDFOLD
;FOLD LIN P8 CONT Vel=2 m/s CPDAT12 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P8, 3:C_DIS C_DIS, 5:2, 7:CPDAT12
$BWDSTART=FALSE
LDAT_ACT=LCPDAT12
FDAT_ACT=FP8
BAS(#CP_PARAMS,2)
LIN XP8 C_DIS C_DIS
;ENDFOLD
;GUN MONITORING: THE ROBOT STOPS IF THE GUN LEAVES THE OPEN RANGE WHILE IT MOVES IN / OUT
;(SAME VALUES AS nGunOpenMin / nGunOpenMax IN GUN_OPEN_CHECK.dat)
INTERRUPT DECL 20 WHEN CL_GunStrokePositionLPT<137000 DO GUN_OPEN_LOST()
INTERRUPT DECL 21 WHEN CL_GunStrokePositionLPT>142000 DO GUN_OPEN_LOST()
INTERRUPT DECL 22 WHEN $PRO_STATE0<>#P_ACTIVE DO GUN_OPEN_LOST()
;PEDESTAL MONITORING: 23 PART CLAMP NOT OPEN, 24 UPPER PIN NOT RETRACTED
INTERRUPT DECL 23 WHEN CL_ClampOpen==FALSE DO GUN_OPEN_LOST()
INTERRUPT DECL 24 WHEN CL_PinRetracted==FALSE DO GUN_OPEN_LOST()
;WAIT NUT READY
CT_NUT_WAIT(1)
;GUN MONITORING ON, THEN GUN OPEN CHECK
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
INTERRUPT ON 23
INTERRUPT ON 24
;PEDESTAL CHECK: GUN OPEN, PART CLAMP OPEN, UPPER PIN RETRACTED
PEDESTAL_CLEAR_CHECK()

;MOVE IN - P20 (2 M/S), THEN THE WELD POSITION P19 OUTSIDE DRY CYCLE
;FOLD LIN P20 CONT Vel=2 m/s CPDAT8 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P20, 3:C_DIS C_DIS, 5:2, 7:CPDAT8
$BWDSTART=FALSE
LDAT_ACT=LCPDAT8
FDAT_ACT=FP20
BAS(#CP_PARAMS,2)
LIN XP20 C_DIS C_DIS
;ENDFOLD

;WELD (NOT IN DRY CYCLE)
IF NOT di004UseDryCycle THEN
;FOLD LIN P19 Vel=2 m/s CPDAT18 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P19, 3:, 5:2, 7:CPDAT18
$BWDSTART=FALSE
LDAT_ACT=LCPDAT18
FDAT_ACT=FP19
BAS(#CP_PARAMS,2)
LIN XP19 
;ENDFOLD
;ROBOT AT THE WELD POSITION: GUN MONITORING OFF (THE GUN CLOSES IN CENTERLINE_WELD)
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
INTERRUPT OFF 23
INTERRUPT OFF 24
;NUT WELD AT THE PEDESTAL (CENTERLINE_WELD: CLAMP, GUN, INTENSIFY, BOSCH WELD, GUN OPEN)
CENTERLINE_WELD()
;NUT RETRY: NO NUT FOUND -> NEW NUT AND WELD AGAIN
WHILE NUT_WELD_RETRY
   NUT_WELD_RETRY=FALSE
   Request_next_nut()
   WAIT FOR NUT_READY==TRUE
   CENTERLINE_WELD()
ENDWHILE
;REQUEST THE NEXT NUT
Request_next_nut()
;GUN MONITORING ON WHILE LEAVING
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
INTERRUPT ON 23
INTERRUPT ON 24
;PEDESTAL CHECK: GUN OPEN, PART CLAMP OPEN, UPPER PIN RETRACTED
PEDESTAL_CLEAR_CHECK()
ENDIF
;LEAVE THE PEDESTAL - P20, P8, P0 (THE DRY CYCLE CONTINUES HERE)

;FOLD LIN P20 CONT Vel=2 m/s CPDAT16 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P20, 3:C_DIS C_DIS, 5:2, 7:CPDAT16
$BWDSTART=FALSE
LDAT_ACT=LCPDAT16
FDAT_ACT=FP20
BAS(#CP_PARAMS,2)
LIN XP20 C_DIS C_DIS
;ENDFOLD
;ROBOT OUT OF THE PEDESTAL: GUN MONITORING OFF
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
INTERRUPT OFF 23
INTERRUPT OFF 24

;FOLD PTP P8 CONT Vel=100 % PDAT1 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P8, 3:C_DIS, 5:100, 7:PDAT1
$BWDSTART=FALSE
PDAT_ACT=PPDAT1
FDAT_ACT=FP8
BAS(#PTP_PARAMS,100)
PTP XP8 C_DIS
;ENDFOLD
END
