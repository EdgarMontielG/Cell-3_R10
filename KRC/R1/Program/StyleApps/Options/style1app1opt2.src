&ACCESS RVO1
&REL 246
&COMMENT 03-10-R1 PNW1 NUT 2
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app1opt2( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD NutWeld
      ;ENDFOLD (NutWeld)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - WELD NUT 2 (PN2) AT THE CENTERLINE PEDESTAL
;********************************
; CALLED BY Style1Opt1. APPROACH THE PEDESTAL (BASE 3 "NUT WELDER"), WAIT FOR THE NUT PRELOAD
; (NEXT_NUT_READY), MOVE THE PART TO THE WELD POSITION P16, WELD WITH CENTERLINE_WELD (NOT IN DRY
; CYCLE), LEAVE THE PEDESTAL.
;WARNING: BEFORE THE ROBOT MOVES IN, ONLY NEXT_NUT_READY IS CHECKED - NOT GUN OPEN, CLAMP OPEN OR
;  QFP RETURNED (F01)
;NOTE: THE PEDESTAL MOVES MIX BASE MODE AND EXTERNAL-TCP MODE (extTCP); THE WELD POSITION
;  P16 IS TAUGHT IN BASE MODE (F22)
;APPROACH THE PEDESTAL - P0, P5
;FOLD PTP P0 CONT Vel=100 % PDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_DIS, 5:100, 7:PDAT0
$BWDSTART=FALSE
PDAT_ACT=PPDAT0
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 C_DIS
;ENDFOLD
;FOLD LIN P5 Vel=2 m/s CPDAT11 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P5, 3:, 5:2, 7:CPDAT11
$BWDSTART=FALSE
LDAT_ACT=LCPDAT11
FDAT_ACT=FP5
BAS(#CP_PARAMS,2)
LIN XP5 
;ENDFOLD
;NOTE: RETRY_NUT1 IS THE TARGET OF THE NUT_WELD_RETRY BRANCH BELOW, WHICH NEVER RUNS (F24)
RETRY_NUT1:
;WAIT NUT PRELOADED - NEXT_NUT_READY (SET BY PRELOAD WHEN THE NUT IS ON THE LOWER PIN)
;NOTE: NO TIMEOUT, NO MESSAGE (F15). IN DRY CYCLE NOTHING SETS IT: THE CYCLE HANGS HERE (F04)
WAIT FOR NEXT_NUT_READY==TRUE
;MOVE IN - P6 (2 M/S), THEN THE WELD POSITION P16 OUTSIDE DRY CYCLE
;FOLD LIN P6 Vel=2 m/s CPDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P6, 3:, 5:2, 7:CPDAT0
$BWDSTART=FALSE
LDAT_ACT=LCPDAT0
FDAT_ACT=FP6
BAS(#CP_PARAMS,2)
LIN XP6 
;ENDFOLD

;DRY CYCLE (SIGNAL $IN[4] di004UseDryCycle ON): NO WELD POSITION, NO WELD - JUMP TO DRY1 (F05)
IF di004UseDryCycle==TRUE THEN

GOTO DRY1
ELSE

;FOLD LIN P16 Vel=2 m/s CPDAT15 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P16, 3:, 5:2, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP16
BAS(#CP_PARAMS,2)
LIN XP16 
;ENDFOLD
;NUT WELD AT THE PEDESTAL (CENTERLINE_WELD: CLAMP, GUN, INTENSIFY, BOSCH WELD, GUN OPEN)
CENTERLINE_WELD()



ENDIF
DRY1:
;LEAVE THE PEDESTAL - P06, P05, P0
;FOLD LIN P06 CONT Vel=2 m/s CPDAT6 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P06, 3:C_DIS C_DIS, 5:2, 7:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP06
BAS(#CP_PARAMS,2)
LIN XP06 C_DIS C_DIS
;ENDFOLD
;NOTE: NUT_WELD_RETRY IS NEVER SET TRUE - THIS RETRY BRANCH IS DEAD CODE (F24, GESTAMP POINT 17)
IF NUT_WELD_RETRY THEN
   NUT_WELD_RETRY=FALSE
   
   GOTO RETRY_NUT1
ENDIF
;FOLD LIN P05 Vel=2 m/s CPDAT14 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P05, 3:, 5:2, 7:CPDAT14
$BWDSTART=FALSE
LDAT_ACT=LCPDAT14
FDAT_ACT=FP05
BAS(#CP_PARAMS,2)
LIN XP05 
;ENDFOLD
;NEXT NUT - TRIGGER IN THE P0 FOLD (DISTANCE = 1: FIRES WHEN THE MOTION ENDS, PRIO -1):
;Request_next_nut() CLEARS NEXT_NUT_READY AND STARTS THE PRELOAD OF NUT 3 (NUT_STAR=TRUE)
;WARNING: THE TRIGGER WAS TYPED BY HAND INSIDE THE INLINE FORM: A TOUCH UP OF P0 DELETES IT
;  AND NUT 3 WAITS FOREVER FOR NEXT_NUT_READY (F32, GESTAMP POINT 20)
;FOLD PTP P0 Vel=100 % PDAT26 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:, 5:100, 7:PDAT26
$BWDSTART=FALSE
PDAT_ACT=PPDAT26
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO Request_next_nut() PRIO= -1
PTP XP0 
;ENDFOLD

   
END