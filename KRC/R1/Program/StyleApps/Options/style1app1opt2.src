&ACCESS RVO1
&REL 246
&COMMENT GE4_002_GUN1
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app1opt2( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD NutWeld
      ;ENDFOLD (NutWeld)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;FOLD PTP P0 CONT Vel=100 % PDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_DIS, 5:100, 7:PDAT0
$BWDSTART=FALSE
PDAT_ACT=PPDAT0
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 C_DIS
;ENDFOLD
;FOLD LIN P5 Vel=2 m/s CPDAT11 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P5, 3:, 5:2, 7:CPDAT11
$BWDSTART=FALSE
LDAT_ACT=LCPDAT11
FDAT_ACT=FP5
BAS(#CP_PARAMS,2)
LIN XP5 
;ENDFOLD
RETRY_NUT1:
WAIT FOR NEXT_NUT_READY==TRUE
;FOLD LIN P6 Vel=2 m/s CPDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P6, 3:, 5:2, 7:CPDAT0
$BWDSTART=FALSE
LDAT_ACT=LCPDAT0
FDAT_ACT=FP6
BAS(#CP_PARAMS,2)
LIN XP6 
;ENDFOLD

IF di004UseDryCycle==TRUE THEN

GOTO DRY1
ELSE

;FOLD LIN P16 Vel=2 m/s CPDAT15 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P16, 3:, 5:2, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP16
BAS(#CP_PARAMS,2)
LIN XP16 
;ENDFOLD
CENTERLINE_WELD()



ENDIF
DRY1:
;FOLD LIN P06 CONT Vel=2 m/s CPDAT6 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P06, 3:C_DIS C_DIS, 5:2, 7:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP06
BAS(#CP_PARAMS,2)
LIN XP06 C_DIS C_DIS
;ENDFOLD
IF NUT_WELD_RETRY THEN
   NUT_WELD_RETRY=FALSE
   
   GOTO RETRY_NUT1
ENDIF
;FOLD LIN P05 Vel=2 m/s CPDAT14 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P05, 3:, 5:2, 7:CPDAT14
$BWDSTART=FALSE
LDAT_ACT=LCPDAT14
FDAT_ACT=FP05
BAS(#CP_PARAMS,2)
LIN XP05 
;ENDFOLD
;FOLD PTP P0 Vel=100 % PDAT26 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:, 5:100, 7:PDAT26
$BWDSTART=FALSE
PDAT_ACT=PPDAT26
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO Request_next_nut() PRIO= -1
PTP XP0 
;ENDFOLD

   
END