&ACCESS RVO1
&REL 29
&COMMENT 03-10-R1 NUT CHECK SENSOR
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app2opt1( )
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
	;FOLD NutWeld
	;ENDFOLD (NutWeld)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - NUT PRESENCE CHECK OF THE 3 NUTS (SENSOR)
;********************************
; CALLED BY Style1Opt1 AND Style1Opt10AutoRR. PRESENTS EACH WELDED NUT TO THE NUT-PRESENT
; SENSOR $IN[227] di227NutPresent1 (P28, P32, P36) AND SETS PARTPRESENT1..3; THEN DECIDES:
; OPTIONS 1, 2, 7, 8 -> bscrapGE4, OPTION 12 -> RED RABBIT RESULT ($OUT[141] / $OUT[142]).
;2026-10-09: bscrapGE4 IS RESET TO FALSE AT THE START OF EVERY PART (AS 20R1 / 30R1) - BEFORE, IN DRY CYCLE
;  OR WITH ANOTHER OPTION IT KEPT THE VALUE OF THE PREVIOUS PART. NOTIFY MESSAGE FOR EVERY MISSING NUT
;  (NUT_MISSING_MSG, MODULE NutCheck NR 31..33 = PN1..PN3) SO THE FAILING POSITION IS KNOWN
;NOTE: APPLICATION 1 IS REQUESTED HERE AND RELEASED BY TRIGGER ON THE FIRST MOTION AWAY FROM THE
;  CAMERA (Style1Drop1Opt1 P5, RejectGE4 P23, style1drop1opt2AutoRR P28)


;RESET THE SCRAP FLAG FOR THIS PART (2026-10-09) - SET AGAIN BY THE DECISION BELOW
bscrapGE4=FALSE

;APPROACH THE NUT CHECK SENSOR - P22
;FOLD PTP P22 CONT Vel=100 % PDAT16 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P22, 3:C_DIS, 5:100, 7:PDAT16
$BWDSTART=FALSE
PDAT_ACT=PPDAT16
FDAT_ACT=FP22
BAS(#PTP_PARAMS,100)
PTP XP22 C_DIS
;ENDFOLD

;APPLICATION 1 REQUEST - AC_ApplicationCheck(1): WAIT SIGNAL $IN[70] di070ApplicationMachine1 ON
;(WAITING MESSAGE, NO TIMEOUT), THEN SIGNALS $OUT[70] do070ApplicationClear1 OFF,
;$OUT[24] do024ApplClrTooling OFF
   ;FOLD Application[1] Request
      ;FOLD ;%{h}
         ;Params IlfProvider=ac_zoneilf; AC_CmdZones=Application; AC_CmdParam=1; AC_ZoneRepo=False; AC_Blending=False
      ;ENDFOLD
      AC_ApplicationCheck (1)
   ;ENDFOLD

;NUT 1 AT THE SENSOR - LIN P28 (EXACT STOP)
;FOLD LIN P28 Vel=2 m/s CPDAT15 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P28, 3:, 5:2, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP28
BAS(#CP_PARAMS,2)
LIN XP28 
;ENDFOLD
;FOLD NUT CHECK1
;NUT 1 CHECK - OUTSIDE DRY CYCLE (SIGNAL $IN[4] di004UseDryCycle OFF), AFTER 0.2 S AT THE POINT
;NOTE: THE WAIT SEC ALSO STOPS THE ADVANCE RUN: THE SENSOR IS READ WITH THE ROBOT STANDING
;  AT THE POINT, F28. A MISSING NUT WRITES FALSE (F03)
IF NOT di004UseDryCycle THEN
   WAIT SEC 0.2
   ;PARTPRESENT1 = SIGNAL $IN[227] di227NutPresent1 (TRUE OR FALSE)
   PARTPRESENT1=di227NutPresent1
ENDIF
;ENDFOLD
;FOLD PTP P31 CONT Vel=100 % PDAT35 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P31, 3:C_DIS, 5:100, 7:PDAT35
$BWDSTART=FALSE
PDAT_ACT=PPDAT35
FDAT_ACT=FP31
BAS(#PTP_PARAMS,100)
PTP XP31 C_DIS
;ENDFOLD

;NUT 2 AT THE SENSOR - LIN P32 (EXACT STOP)
;FOLD LIN P32 Vel=2 m/s CPDAT16 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P32, 3:, 5:2, 7:CPDAT16
$BWDSTART=FALSE
LDAT_ACT=LCPDAT16
FDAT_ACT=FP32
BAS(#CP_PARAMS,2)
LIN XP32 
;ENDFOLD
;FOLD NUT CHECK2
;NUT 2 CHECK - OUTSIDE DRY CYCLE (SIGNAL $IN[4] di004UseDryCycle OFF), AFTER 0.2 S AT THE POINT
;NOTE: THE WAIT SEC ALSO STOPS THE ADVANCE RUN: THE SENSOR IS READ WITH THE ROBOT STANDING
;  AT THE POINT, F28. A MISSING NUT WRITES FALSE (F03)
IF NOT di004UseDryCycle THEN
   WAIT SEC 0.2
   ;PARTPRESENT2 = SIGNAL $IN[227] di227NutPresent1 (TRUE OR FALSE)
   PARTPRESENT2=di227NutPresent1
ENDIF
;ENDFOLD
;FOLD PTP P38 CONT Vel=100 % PDAT36 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P38, 3:C_DIS, 5:100, 7:PDAT36
$BWDSTART=FALSE
PDAT_ACT=PPDAT36
FDAT_ACT=FP38
BAS(#PTP_PARAMS,100)
PTP XP38 C_DIS
;ENDFOLD

;NUT 3 AT THE SENSOR - LIN P36 (EXACT STOP)
;FOLD LIN P36 Vel=2 m/s CPDAT17 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P36, 3:, 5:2, 7:CPDAT17
$BWDSTART=FALSE
LDAT_ACT=LCPDAT17
FDAT_ACT=FP36
BAS(#CP_PARAMS,2)
LIN XP36 
;ENDFOLD
;FOLD NUT CHECK3
;NUT 3 CHECK - OUTSIDE DRY CYCLE (SIGNAL $IN[4] di004UseDryCycle OFF), AFTER 0.2 S AT THE POINT
;NOTE: THE WAIT SEC ALSO STOPS THE ADVANCE RUN: THE SENSOR IS READ WITH THE ROBOT STANDING
;  AT THE POINT, F28. A MISSING NUT WRITES FALSE (F03)
IF NOT di004UseDryCycle THEN
   WAIT SEC 0.2
   ;PARTPRESENT3 = SIGNAL $IN[227] di227NutPresent1 (TRUE OR FALSE)
   PARTPRESENT3=di227NutPresent1
ENDIF
;ENDFOLD
;FOLD PTP P37 CONT Vel=100 % PDAT37 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P37, 3:C_DIS, 5:100, 7:PDAT37
$BWDSTART=FALSE
PDAT_ACT=PPDAT37
FDAT_ACT=FP37
BAS(#PTP_PARAMS,100)
PTP XP37 C_DIS
;ENDFOLD
;DECISION - OUTSIDE DRY CYCLE, AFTER 0.2 S, BY OPTION nOption:
;PRODUCTION OPTIONS 1, 2, 7, 8: ALL 3 NUTS PRESENT -> bscrapGE4 = FALSE (GOOD), ELSE TRUE (SCRAP) (F02)
;RED RABBIT OPTION 12: ALL 3 PRESENT -> SIGNAL $OUT[141] do141RedRabbitFailed ON;
;           NONE PRESENT -> SIGNAL $OUT[142] do142RedRabbitPassed ON
;CHECK: THE CAMERA CHECK ALSO SETS $OUT[141]/$OUT[142]: BOTH CAN BE ON TOGETHER, AND THE RED RABBIT
;CHECK: DROP CLEARS THEM BEFORE THE END OF THE CYCLE (F19)
;FOLD NUT CHECK
;OUTSIDE DRY CYCLE ONLY - SIGNAL $IN[4] di004UseDryCycle OFF
IF NOT di004UseDryCycle THEN
WAIT SEC 0.2
     SWITCH nOption
          CASE 1,2,7,8
         IF (PARTPRESENT1==TRUE ) AND (PARTPRESENT2==TRUE) AND (PARTPRESENT3==TRUE) THEN
            bscrapGE4 = FALSE
         ELSE
            bscrapGE4=TRUE
            ;MESSAGE FOR EVERY MISSING NUT (2026-10-09)
            IF NOT PARTPRESENT1 THEN
               NUT_MISSING_MSG(1)
            ENDIF
            IF NOT PARTPRESENT2 THEN
               NUT_MISSING_MSG(2)
            ENDIF
            IF NOT PARTPRESENT3 THEN
               NUT_MISSING_MSG(3)
            ENDIF
         ENDIF
          CASE 12
            IF (PARTPRESENT1==TRUE ) AND (PARTPRESENT2==TRUE) AND (PARTPRESENT3==TRUE) THEN
do141RedRabbitFailed=TRUE
ENDIF

IF (PARTPRESENT1==FALSE ) AND (PARTPRESENT2==FALSE) AND (PARTPRESENT3==FALSE) THEN 

do142RedRabbitPassed=TRUE
ENDIF
     ENDSWITCH 

ENDIF


;ENDFOLD


END

DEF NUT_MISSING_MSG(nNut:IN)
;NOTIFY MESSAGE (NO ROBOT STOP) FOR A MISSING NUT IN THE PRODUCTION NUT CHECK (2026-10-09):
;"Nut check: PN<n> missing (sensor $IN[227] at P28/P32/P36) - part to scrap". MODULE NutCheck, NR 30+n
DECL INT nNut
DECL KrlMsg_T Msg
DECL KrlMsgPar_T Par[3]
DECL KrlMsgOpt_T Opt
DECL INT nHandle

   Msg.Modul[]="NutCheck"
   Msg.Nr=30+nNut
   Msg.Msg_txt[]="Nut check: PN%1 missing (sensor $IN[227] at P%2) - part to scrap"
   Par[1].Par_Type=#VALUE
   Par[1].Par_Int=nNut
   Par[2].Par_Type=#VALUE
   SWITCH nNut
      CASE 1
         Par[2].Par_Int=28
      CASE 2
         Par[2].Par_Int=32
      DEFAULT
         Par[2].Par_Int=36
   ENDSWITCH
   Par[3].Par_Type=#EMPTY
   Opt.VL_Stop=TRUE
   Opt.Clear_P_Reset=TRUE
   Opt.Clear_P_SAW=FALSE
   Opt.Log_To_DB=TRUE
   nHandle=Set_KrlMsg(#NOTIFY, Msg, Par[], Opt)

END