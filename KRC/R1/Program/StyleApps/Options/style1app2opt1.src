&ACCESS RVO1
&REL 19
&COMMENT 03-10-R1 NUT CHECK SENSOR
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app2opt1( )
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
	;FOLD NutWeld
	;ENDFOLD (NutWeld)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - NUT PRESENCE CHECK OF THE 3 NUTS (SENSOR)
;********************************
; CALLED BY Style1Opt1 AND Style1Opt10AutoRR. PRESENTS EACH WELDED NUT TO THE NUT-PRESENT
; SENSOR $IN[227] NUT_PRESENT1 (P28, P32, P36) AND SETS PARTPRESENT1..3; THEN DECIDES:
; OPTION 1 -> bscrapGE4, OPTION 10 -> RED RABBIT RESULT ($OUT[141] / $OUT[142]).
;NOTE: OPTIONS 2, 7 AND 8 (PRODUCTION) AND 12 (RED RABBIT) HAVE NO CASE: NOTHING IS DECIDED
;  AND bscrapGE4 KEEPS ITS LAST VALUE (F02, F19)
;NOTE: APPLICATION 1 IS REQUESTED HERE AND RELEASED AT THE END OF style1app2opt2 (CAMERA)

;APPLICATION 1 REQUEST - AC_ApplicationCheck(1): WAIT SIGNAL $IN[70] di070ApplicationMachine1 ON
;(WAITING MESSAGE, NO TIMEOUT), THEN SIGNALS $OUT[70] do070ApplicationClear1 OFF,
;$OUT[24] do024ApplClrTooling OFF
   ;FOLD Application[1] Request
      ;FOLD ;%{h}
         ;Params IlfProvider=ac_zoneilf; AC_CmdZones=Application; AC_CmdParam=1; AC_ZoneRepo=False; AC_Blending=False
      ;ENDFOLD
      AC_ApplicationCheck (1)
   ;ENDFOLD

;APPROACH THE NUT CHECK SENSOR - P22
;FOLD PTP P22 Vel=100 % PDAT16 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P22, 3:, 5:100, 7:PDAT16
$BWDSTART=FALSE
PDAT_ACT=PPDAT16
FDAT_ACT=FP22
BAS(#PTP_PARAMS,100)
PTP XP22 
;ENDFOLD

;NUT 1 AT THE SENSOR - LIN P28 (EXACT STOP)
;FOLD LIN P28 Vel=2 m/s CPDAT15 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P28, 3:, 5:2, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP28
BAS(#CP_PARAMS,2)
LIN XP28 
;ENDFOLD
;FOLD NUT CHECK1
;NUT 1 CHECK - OUTSIDE DRY CYCLE: WHEN SIGNAL $IN[227] NUT_PRESENT1 IS ON, PARTPRESENT1 = TRUE;
;IN DRY CYCLE (SIGNAL $IN[4] di004UseDryCycle ON) JUMP TO DRY1
;NOTE: THE SENSOR IS READ ON ARRIVAL AND THE 0.2 S DWELL COMES AFTER IT (F28); A MISSING NUT
;  DOES NOT SET PARTPRESENT1 FALSE - IT KEEPS ITS VALUE (F03)

IF di004UseDryCycle==TRUE THEN

GOTO DRY1
ELSE
IF ($IN[227]==TRUE) THEN
         PARTPRESENT1=TRUE 
         ENDIF
         WAIT SEC 0.2 
       
         ENDIF

         DRY1:
 ;ENDFOLD      
;FOLD PTP P31 Vel=100 % PDAT35 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P31, 3:, 5:100, 7:PDAT35
$BWDSTART=FALSE
PDAT_ACT=PPDAT35
FDAT_ACT=FP31
BAS(#PTP_PARAMS,100)
PTP XP31 
;ENDFOLD

;NUT 2 AT THE SENSOR - LIN P32 (EXACT STOP)
;FOLD LIN P32 Vel=2 m/s CPDAT16 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P32, 3:, 5:2, 7:CPDAT16
$BWDSTART=FALSE
LDAT_ACT=LCPDAT16
FDAT_ACT=FP32
BAS(#CP_PARAMS,2)
LIN XP32 
;ENDFOLD
;FOLD NUT CHECK2
;NUT 2 CHECK - OUTSIDE DRY CYCLE: WHEN SIGNAL $IN[227] NUT_PRESENT1 IS ON, PARTPRESENT2 = TRUE;
;IN DRY CYCLE (SIGNAL $IN[4] di004UseDryCycle ON) JUMP TO DRY2
;NOTE: THE SENSOR IS READ ON ARRIVAL AND THE 0.2 S DWELL COMES AFTER IT (F28); A MISSING NUT
;  DOES NOT SET PARTPRESENT2 FALSE - IT KEEPS ITS VALUE (F03)

IF di004UseDryCycle==TRUE THEN

GOTO DRY2
ELSE
IF ($IN[227]==TRUE) THEN
         PARTPRESENT2=TRUE 
         ENDIF
         WAIT SEC 0.2 
       
         ENDIF

         DRY2:
 ;ENDFOLD 
;FOLD PTP P38 Vel=100 % PDAT36 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P38, 3:, 5:100, 7:PDAT36
$BWDSTART=FALSE
PDAT_ACT=PPDAT36
FDAT_ACT=FP38
BAS(#PTP_PARAMS,100)
PTP XP38 
;ENDFOLD

;NUT 3 AT THE SENSOR - LIN P36 (EXACT STOP)
;FOLD LIN P36 Vel=2 m/s CPDAT17 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P36, 3:, 5:2, 7:CPDAT17
$BWDSTART=FALSE
LDAT_ACT=LCPDAT17
FDAT_ACT=FP36
BAS(#CP_PARAMS,2)
LIN XP36 
;ENDFOLD
;FOLD NUT CHECK3
;NUT 3 CHECK - OUTSIDE DRY CYCLE: WHEN SIGNAL $IN[227] NUT_PRESENT1 IS ON, PARTPRESENT3 = TRUE;
;IN DRY CYCLE (SIGNAL $IN[4] di004UseDryCycle ON) JUMP TO DRY3
;NOTE: THE SENSOR IS READ ON ARRIVAL AND THE 0.2 S DWELL COMES AFTER IT (F28); A MISSING NUT
;  DOES NOT SET PARTPRESENT3 FALSE - IT KEEPS ITS VALUE (F03)

IF di004UseDryCycle==TRUE THEN

GOTO DRY3
ELSE
IF ($IN[227]==TRUE) THEN
         PARTPRESENT3=TRUE 
         ENDIF
         WAIT SEC 0.2 
       
         ENDIF

         DRY3:
 ;ENDFOLD 
;FOLD PTP P37 Vel=100 % PDAT37 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P37, 3:, 5:100, 7:PDAT37
$BWDSTART=FALSE
PDAT_ACT=PPDAT37
FDAT_ACT=FP37
BAS(#PTP_PARAMS,100)
PTP XP37 
;ENDFOLD
;DECISION - OUTSIDE DRY CYCLE, AFTER 0.2 S, BY OPTION nOption:
;OPTION 1: ALL 3 NUTS PRESENT -> bscrapGE4 = FALSE (GOOD), ELSE bscrapGE4 = TRUE (SCRAP)
;OPTION 10: ALL 3 PRESENT -> SIGNAL $OUT[141] do141RedRabbitFailed ON;
;           NONE PRESENT -> SIGNAL $OUT[142] do142RedRabbitPassed ON
;NOTE: THE RED RABBIT CYCLE RUNS AS OPTION 12 (Style_1), SO THE OPTION 10 CASE NEVER RUNS (F19)
;FOLD NUT CHECK
IF di004UseDryCycle==TRUE THEN

GOTO DRY6
ELSE

WAIT SEC 0.2
     SWITCH nOption
          CASE 1
         IF (PARTPRESENT1==TRUE ) AND (PARTPRESENT2==TRUE) AND (PARTPRESENT3==TRUE) THEN
            bscrapGE4 = FALSE
         ELSE
            bscrapGE4=TRUE
         ENDIF
          CASE 10
            IF (PARTPRESENT1==TRUE ) AND (PARTPRESENT2==TRUE) AND (PARTPRESENT3==TRUE) THEN
do141RedRabbitFailed=TRUE
ENDIF

IF (PARTPRESENT1==FALSE ) AND (PARTPRESENT2==FALSE) AND (PARTPRESENT3==FALSE) THEN 

do142RedRabbitPassed=TRUE
ENDIF
     ENDSWITCH 

ENDIF
DRY6:


;ENDFOLD


END