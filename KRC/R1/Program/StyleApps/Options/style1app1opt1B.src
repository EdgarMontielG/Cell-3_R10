&ACCESS RVO1
&REL 339
&COMMENT 03-10-R1 PNW1 NUT 1 ST2
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
DEF style1app1opt1B( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD NutWeld
      ;ENDFOLD (NutWeld)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - WELD NUT 1 (PN1) AT THE CENTERLINE PEDESTAL - PART FROM PICKUP 2 (B)
;********************************
; CALLED BY Style1Opt1. APPROACH THE PEDESTAL (BASE 3 "NUT WELDER"), WAIT FOR THE NUT PRELOAD
; (NUT_READY), MOVE THE PART TO THE WELD POSITION P19, WELD WITH CENTERLINE_WELD (NOT IN DRY
; CYCLE), LEAVE THE PEDESTAL.
;WARNING: BEFORE THE ROBOT MOVES IN, GUN OPEN, SUBMIT AND WATER ARE CHECKED (GUN_OPEN_CHECK) -
;  NOT CLAMP OPEN OR QFP RETURNED (F01)
;NOTE: THE PEDESTAL MOVES MIX BASE MODE AND EXTERNAL-TCP MODE (extTCP); THE WELD POSITION
;  P19 IS TAUGHT IN BASE MODE (F22)
   
;APPROACH THE PEDESTAL - P0, P8
;FOLD PTP P0 CONT Vel=100 % PDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_DIS, 5:100, 7:PDAT0
$BWDSTART=FALSE
PDAT_ACT=PPDAT0
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 C_DIS
;ENDFOLD
;FOLD LIN P8 CONT Vel=2 m/s CPDAT12 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P8, 3:C_DIS C_DIS, 5:2, 7:CPDAT12
$BWDSTART=FALSE
LDAT_ACT=LCPDAT12
FDAT_ACT=FP8
BAS(#CP_PARAMS,2)
LIN XP8 C_DIS C_DIS
;ENDFOLD
;GUN MONITORING - INTERRUPTS 20-22 CALL GUN_OPEN_LOST (BRAKE F, QUIT MESSAGE) WHEN THE GUN LEAVES THE
;OPEN RANGE (CL_GunStrokePositionLPT 137000..142000) OR THE SUBMIT STOPS WHILE THE ROBOT MOVES INTO
;OR OUT OF THE PEDESTAL. EDGE TRIGGERED: GUN_OPEN_CHECK CONFIRMS THE GUN OPEN AFTER EVERY ON (F01)
;WARNING: THE RANGE IS WRITTEN HERE AS LITERALS; KEEP IT EQUAL TO nGunOpenMin/nGunOpenMax IN
;  GUN_OPEN_CHECK.dat (F01)
INTERRUPT DECL 20 WHEN CL_GunStrokePositionLPT<137000 DO GUN_OPEN_LOST()
INTERRUPT DECL 21 WHEN CL_GunStrokePositionLPT>142000 DO GUN_OPEN_LOST()
INTERRUPT DECL 22 WHEN $PRO_STATE0<>#P_ACTIVE DO GUN_OPEN_LOST()
;CYCLE-TIME MEASUREMENT (NO EFFECT ON THE SEQUENCE): ROBOT STOPPED AT THE WAIT POINT (WAIT SEC 0),
;$TIMER[20] FROM HERE FOR NUT 1 (CL_CYCLE_TIME, F52)
WAIT SEC 0
CL_CYCLE_START(1)
;WAIT NUT PRELOADED - NUT_READY (SET WHEN THE PRELOAD ENDS, QFP SEEN RETURNED; NO NUT SENSOR, F13)
;NOTE: NO TIMEOUT, NO MESSAGE (F15). IN DRY CYCLE NOTHING SETS IT: THE CYCLE HANGS HERE (F04)
;NOTE: NUT_READY IS NOT CLEARED AFTER A WELD: IF THE PICK TRIGGER WAS SKIPPED, THE TRUE OF THE
;  LAST CYCLE LETS THE ROBOT IN WITH NO NUT FED (F14)
WAIT FOR NUT_READY== TRUE
;CYCLE-TIME MARK - STEP 1 NUT READY (CL_CYCLE_TIME, F52)
CL_CYCLE_TIME(1)
;FEED NUT 2 INTO THE SHUTTLE NOW, WHILE THE ROBOT MOVES IN AND WELDS: THE SHUTTLE IS RETURNED
;AND EMPTY, NUT 1 IS ON THE PIN. PRELOAD ONLY FEEDS; IT LOADS NUT 2 ONTO THE PIN WHEN
;Request_next_nut IS CALLED AT P8 ON THE WAY OUT. ONLY WITH NO PRELOAD RUNNING AND OUTSIDE DRY CYCLE
;(SIGNAL $IN[4] di004UseDryCycle OFF) - ELSE Request_next_nut FEEDS AND LOADS AS BEFORE (F52)
IF NUT_READY AND NOT NUTCYCLE_ACTIVE AND NOT di004UseDryCycle THEN
   NUT_FEED_START=TRUE
ENDIF
;GUN MONITORING ON FIRST (THE INTERRUPTS FIRE ONLY ON A CHANGE), THEN THE INTERLOCK: GUN OPEN,
;SUBMIT RUNNING, WATER OK (GUN_OPEN_CHECK); THE MONITORING STAYS ON WHILE THE ROBOT MOVES IN (F01)
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
GUN_OPEN_CHECK()

;MOVE IN - P20 (2 M/S), THEN THE WELD POSITION P19 OUTSIDE DRY CYCLE
;FOLD LIN P20 CONT Vel=2 m/s CPDAT8 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P20, 3:C_DIS C_DIS, 5:2, 7:CPDAT8
$BWDSTART=FALSE
LDAT_ACT=LCPDAT8
FDAT_ACT=FP20
BAS(#CP_PARAMS,2)
LIN XP20 C_DIS C_DIS
;ENDFOLD

;OUTSIDE DRY CYCLE ONLY (SIGNAL $IN[4] di004UseDryCycle OFF): WELD POSITION P19 AND CENTERLINE_WELD()
;NOTE: $IN[4] IS RE-READ AT EVERY STEP; SWITCHED ON MID-CYCLE, THIS NUT IS NOT WELDED AND
;  THE PART CAN STILL REACH THE GOOD DROP (F05)
IF NOT di004UseDryCycle THEN
;FOLD LIN P19 Vel=2 m/s CPDAT18 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P19, 3:, 5:2, 7:CPDAT18
$BWDSTART=FALSE
LDAT_ACT=LCPDAT18
FDAT_ACT=FP19
BAS(#CP_PARAMS,2)
LIN XP19 
;ENDFOLD
;ROBOT AT THE WELD POSITION (WAIT SEC 0 STOPS THE ADVANCE RUN): GUN MONITORING OFF, THE GUN
;CLOSES ON PURPOSE IN CENTERLINE_WELD
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22
;NUT WELD AT THE PEDESTAL (CENTERLINE_WELD: CLAMP, GUN, INTENSIFY, BOSCH WELD, GUN OPEN)
CENTERLINE_WELD()
;GUN MONITORING ON WHILE LEAVING, THEN THE GUN OPEN IS CONFIRMED AGAIN (GUN_OPEN_CHECK): A GUN THAT
;LEFT THE OPEN RANGE AFTER THE CHECK INSIDE CENTERLINE_WELD WOULD NOT TRIGGER THE INTERRUPTS (F01)
INTERRUPT ON 20
INTERRUPT ON 21
INTERRUPT ON 22
GUN_OPEN_CHECK()
ENDIF
;LEAVE THE PEDESTAL - P20, P8, P0 (THE DRY CYCLE CONTINUES HERE)

;FOLD LIN P20 CONT Vel=2 m/s CPDAT16 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P20, 3:C_DIS C_DIS, 5:2, 7:CPDAT16
$BWDSTART=FALSE
LDAT_ACT=LCPDAT16
FDAT_ACT=FP20
BAS(#CP_PARAMS,2)
LIN XP20 C_DIS C_DIS
;ENDFOLD
;ROBOT OUT OF THE PEDESTAL (WAIT SEC 0 STOPS THE ADVANCE RUN, NO APPROXIMATION HERE): GUN
;MONITORING OFF
WAIT SEC 0
INTERRUPT OFF 20
INTERRUPT OFF 21
INTERRUPT OFF 22

;FOLD LIN P8 CONT Vel=2 m/s CPDAT17 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P8, 3:C_DIS C_DIS, 5:2, 7:CPDAT17
$BWDSTART=FALSE
LDAT_ACT=LCPDAT17
FDAT_ACT=FP8
BAS(#CP_PARAMS,2)
LIN XP8 C_DIS C_DIS
;ENDFOLD
;NEXT NUT - TRIGGER ON THE MOTION TO P0 (DISTANCE = 0: FIRES WHEN THE MOTION STARTS, PRIO -1):
;Request_next_nut() CLEARS NEXT_NUT_READY AND SETS NUT_START: PRELOAD LOADS NUT 2 (FED DURING THE
;WELD) ONTO THE PIN, OR FEEDS AND LOADS IT IF NOTHING WAS FED (F52)
;NOTE: THE TRIGGER STANDS BEFORE THE INLINE FORM, SO A TOUCH UP OF P0 CANNOT DELETE IT; IT ACTS ON
;  THE NEXT MOTION. A BLOCK SELECTION ONTO THE MOTION FOLD SKIPS IT (SELECT THE TRIGGER LINE),
;  AND SO DOES A PROGRAM RESET: NUT 2 THEN WAITS FOR EVER FOR NEXT_NUT_READY (F14, F38)
TRIGGER WHEN DISTANCE = 0 DELAY = 0 DO Request_next_nut() PRIO= -1
;FOLD PTP P0 Vel=100 % PDAT18 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:, 5:100, 7:PDAT18
$BWDSTART=FALSE
PDAT_ACT=PPDAT18
FDAT_ACT=FP0
BAS(#PTP_PARAMS,100)
PTP XP0 
;ENDFOLD
END