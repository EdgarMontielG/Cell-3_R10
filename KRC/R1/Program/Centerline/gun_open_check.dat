&ACCESS  RV
&COMMENT 03-10-R1 PNW1 GUN OPEN CHECK
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&REL 2
DEFDAT  GUN_OPEN_CHECK PUBLIC
;FOLD GUN OPEN SETTINGS
;OPEN (RETRACT) RANGE OF THE NUT WELDER GUN ON 03-10-R1, CL_GunStrokePositionLPT (SPS.SUB):
;NOMINAL RETRACT 139815; WELD RANGE CL_GUN_WELD_MIN..CL_GUN_WELD_MAX (69000..73000, GUN CLOSED)
;WARNING: INTERRUPTS 20/21 IN style1app1opt1..3 REPEAT THIS RANGE AS LITERALS - CHANGE BOTH TOGETHER
;NOTE: REPLACES THE OLDER, WIDER CHECK CL_GunStrokePositionLPT > 120000 AT THE END OF CENTERLINE_WELD
DECL GLOBAL INT nGunOpenMin=137000
DECL GLOBAL INT nGunOpenMax=142000
;TIME FOR THE GUN TO OPEN BEFORE THE "GUN NOT OPEN" MESSAGE [MS]
DECL INT nGunOpenWaitMs=2000
;AIR PRESSURE CHECK - SIGNAL $IN[3132] dipw1_AirOK (TBEN BIT 3.4). TRUE = ACTIVE
;CHECK: DISABLED UNTIL TESTED: WITH THE AIR CLOSED $IN[3132] MUST GO OFF, THEN SET TRUE (F01)
DECL BOOL bGunAirCheck=FALSE
;COOLING WATER FLOW (PARKER 5097335, SPS.SUB) IN 0.1 L/MIN: 150 = 15.0 L/MIN (4.0 GPM)
;WATER OK AT OR ABOVE nWaterFlowMin, NOT OK BELOW nWaterFlowMin - nWaterFlowHyst
;CHECK: NORMAL FLOW 23-26 L/MIN WAS MEASURED ON 03-20-R1; CONFIRM THE MINIMUM ON THIS ROBOT (F09)
DECL GLOBAL INT nWaterFlow=226
DECL GLOBAL INT nWaterFlowMin=150
DECL GLOBAL INT nWaterFlowHyst=10
;COOLING WATER CHECK BEFORE ENTERING / LEAVING THE PEDESTAL. TRUE = ACTIVE
DECL BOOL bGunWaterCheck=TRUE
;ENDFOLD
ENDDAT
