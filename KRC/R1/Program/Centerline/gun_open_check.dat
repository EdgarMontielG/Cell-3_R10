&ACCESS RVO2
&REL 49
&COMMENT 03-10-R1 PNW1 GUN OPEN CHECK
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Centerline
DEFDAT  gun_open_check PUBLIC
;FOLD GUN OPEN SETTINGS
;GUN OPEN RANGE (CL_GunStrokePositionLPT) - SAME VALUES AS INTERRUPTS 20/21 IN THE WELD PROGRAMS
DECL GLOBAL INT nGunOpenMin=137000
DECL GLOBAL INT nGunOpenMax=142000
;TIME FOR THE GUN TO OPEN BEFORE THE "GUN NOT OPEN" MESSAGE [MS]
DECL GLOBAL INT nGunOpenWaitMs=2000
;AIR PRESSURE CHECK (dipw1_AirOK). TRUE = ACTIVE
DECL GLOBAL BOOL bGunAirCheck=TRUE
;COOLING WATER FLOW IN 0.1 L/MIN (150 = 15.0 L/MIN)
DECL GLOBAL INT nWaterFlow=265
DECL GLOBAL INT nWaterFlowMin=150
DECL GLOBAL INT nWaterFlowHyst=10
;COOLING WATER CHECK BEFORE ENTERING / LEAVING THE PEDESTAL. TRUE = ACTIVE
DECL GLOBAL BOOL bGunWaterCheck=TRUE
;TIME FOR PART CLAMP / UPPER PIN BEFORE THE MESSAGE [MS]
DECL GLOBAL INT nPedestalWaitMs=3000
;UPPER PIN RETRACTED RANGE. bPinCheck TRUE = CHECKED
DECL GLOBAL BOOL bPinCheck=TRUE
DECL GLOBAL INT nPinRetractMin=26000
DECL GLOBAL INT nPinRetractMax=28000
;UPPER PIN WELD POSITION CHECK BEFORE THE WELD (PIN_WELD_CHECK IN CENTERLINE_WELD): CL_WeldPinPosition
;IN CL_PIN_WELD_MIN..CL_PIN_WELD_MAX ($config.dat, 11000..12200) - PART SEATED ON THE PIN. TRUE = ACTIVE
DECL GLOBAL BOOL bPinWeldCheck=TRUE
;UPPER PIN SEATED WAIT BEFORE THE PART CLAMP CLOSES
DECL GLOBAL INT nPinStableMs=60
DECL GLOBAL INT nPinStableCnt=30
DECL GLOBAL INT nPinSettleMaxMs=1000
;NUT RETRY: NO NUT IN THE WELD POSITION -> NEW NUT AND WELD AGAIN. nNutRetryMax RETRIES PER NUT (0 = OFF)
DECL GLOBAL BOOL NUT_WELD_RETRY=FALSE
DECL GLOBAL INT nNutRetryMax=1
DECL GLOBAL INT nNutRetryCnt=0
DECL GLOBAL INT nNutRetryTotal=8
DECL GLOBAL INT nNutRetryLast=3
;CYCLE TIME MEASUREMENT [MS], LAST PART, INDEX = NUT (READ ONLY):
;  nCtNutToNut = WELD POSITION TO WELD POSITION, nCtNutWait = WAIT FOR THE NUT,
;  nCtInWelder = TIME IN THE WELDER, nCtPart = PART, nCtCycle = ROBOT CYCLE
DECL GLOBAL INT nCtNut=3
DECL GLOBAL INT nCtNutToNut[3]
nCtNutToNut[1]=88656
nCtNutToNut[2]=6936
nCtNutToNut[3]=6888
DECL GLOBAL INT nCtNutWait[3]
nCtNutWait[1]=0
nCtNutWait[2]=444
nCtNutWait[3]=516
DECL GLOBAL INT nCtInWelder[3]
nCtInWelder[1]=4104
nCtInWelder[2]=4008
nCtInWelder[3]=3996
DECL GLOBAL INT nCtPart=17820
DECL GLOBAL INT nCtWaitSum=960
DECL GLOBAL INT nCtCycle=102432
;PEDESTAL STATES FOR INTERRUPTS 23/24 OF THE WELD APPS, SET BY SPS.SUB EVERY CYCLE
DECL GLOBAL BOOL CL_ClampOpen=FALSE
DECL GLOBAL BOOL CL_PinRetracted=TRUE
;ENDFOLD
ENDDAT
