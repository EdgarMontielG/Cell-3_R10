&ACCESS RVP1
DEF  PRELOAD ( )
 				   
	
IF NUT_STAR AND NOT NUTCYCLE_ACTIVE THEN

   NUT_STAR=FALSE
   NUTCYCLE_ACTIVE=TRUE
   NUT_READY=FALSE
   NUT_PRELOAD_STEP=0
   STEP0DONE=FALSE
   STEP10DONE=FALSE
   STEP20DONE=FALSE
   NUT_PRELOAD_FAULT=FALSE
   $TIMER_STOP[10]=TRUE
   $TIMER[10]=0
   $TIMER_STOP[11]=TRUE
   $TIMER[11]=0
   $TIMER_STOP[12]=TRUE
   $TIMER[12]=0
   $TIMER_STOP[13]=TRUE
   $TIMER[13]=0
   
ENDIF

IF NUTCYCLE_ACTIVE AND NOT di004UseDryCycle THEN
   
   SWITCH NUT_PRELOAD_STEP
   
   CASE 0
   
   ;QFP RETURNED
   $OUT[503]=FALSE
   $OUT[504]=TRUE

   ;CL_QFPReturned / QFP ADV
IF ($IN[482]==TRUE) AND ($IN[470]==FALSE) THEN 
   ;FEED NUT
   $OUT[476]=TRUE
   $OUT[494]=FALSE
   
IF $TIMER_STOP[10] THEN
   $TIMER[10]=0 
   $TIMER_STOP[10]=FALSE   
ENDIF

IF  $TIMER[10]>=2000 THEN
    $TIMER_STOP[10]=TRUE

    STEP0DONE=TRUE
ENDIF   

ENDIF

IF STEP0DONE THEN
   NUT_PRELOAD_STEP = 10
ENDIF

   CASE 10
   
IF STEP0DONE THEN
  
   ;HOME
   ;dopw1_GUNHOME/VALVE2 OPEN 
   $OUT[472]=FALSE 
   $OUT[471]=TRUE
   ;CL_WeldPinRetract / UPPER PIN RETRACT
   $OUT[498]=FALSE
   $OUT[499]=TRUE
   ;CL_PartClampOpen
   $OUT[501]=FALSE
   $OUT[502]=TRUE
   
IF NOT STEP10_ADV_STARTED THEN
   $OUT[494]=TRUE  
   ;QFP RETURNED
   $OUT[503]=FALSE
   $OUT[504]=TRUE
   
IF ($IN[482]==TRUE) AND ($IN[470]==FALSE) THEN 
   STEP10_ADV_STARTED=TRUE
   
ENDIF
ELSE
   
;CL_QFPAdvanced / QFP ADV
$OUT[504]=FALSE
$OUT[503]=TRUE
$OUT[476]=FALSE
 
IF ($IN[470]==TRUE) AND ($IN[482]==FALSE) THEN 
   ;CL_QFPBlowOff / NUT FEED BLOW-OFF ACTIVATE
   $OUT[505]=TRUE
   $OUT[494]=FALSE
IF $TIMER_STOP[13] THEN
   $TIMER[13]=0 
   $TIMER_STOP[13]=FALSE   
ENDIF 
   ;CL_LowerPinRetreated
   $OUT[496]=FALSE
   $OUT[495]=TRUE
  
IF $TIMER_STOP[11] THEN
   $TIMER[11]=0 
   $TIMER_STOP[11]=FALSE   
ENDIF

IF $TIMER[11]>=500 THEN
   $TIMER_STOP[11]=TRUE

    STEP10DONE=TRUE
ENDIF
ENDIF
ENDIF
ENDIF

IF STEP0DONE AND STEP10DONE THEN
   NUT_PRELOAD_STEP = 20 
   $TIMER_STOP[12]=TRUE
   $TIMER[12]=0 
   
ENDIF   
 
   CASE 20

IF STEP0DONE AND STEP10DONE AND ($TIMER[13]>=800)THEN

   ;CL_LowerPinRetreated
   $OUT[496]=FALSE
   $OUT[495]=TRUE
   
 
   ;CL_QFPReturn / NUT FEED SLIDE RETURN
   $OUT[503]=FALSE
   $OUT[504]=TRUE
     ;CL_QFPBlowOff / NUT FEED BLOW-OFF ACTIVATE
   $OUT[505]=FALSE
   
   
IF $TIMER_STOP[12] THEN
   $TIMER[12]=0 
   $TIMER_STOP[12]=FALSE   
ENDIF

IF $TIMER[12]>=800 THEN
   $TIMER_STOP[12]=TRUE
    STEP20DONE=TRUE
ENDIF 
ENDIF

IF STEP0DONE AND STEP10DONE AND STEP20DONE THEN
   NUT_PRELOAD_STEP =0
   NUT_READY=TRUE  
   
IF NEXT_NUT_REQUEST THEN
   NEXT_NUT_READY=TRUE
   NEXT_NUT_REQUEST=FALSE
ENDIF
   NUTCYCLE_ACTIVE=FALSE
   STEP10_ADV_STARTED=FALSE
   
   $TIMER_STOP[10]=TRUE
   $TIMER[10]=0
   $TIMER_STOP[11]=TRUE
   $TIMER[11]=0
   $TIMER_STOP[12]=TRUE
   $TIMER[12]=0
   
ENDIF

ENDSWITCH

   
ENDIF
END