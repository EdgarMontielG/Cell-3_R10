&ACCESS RVP1
&COMMENT 03-10-R1 PNW1 NUT PRELOAD
DEF  PRELOAD ( )
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - NUT PRELOAD AT CENTERLINE PEDESTAL
;********************************
; CALLED BY sps.sub IN EVERY SUBMIT CYCLE: RUNS IN THE SUBMIT INTERPRETER IN EVERY
; OPERATING MODE (T1, T2, AUT, EXT), ALSO WHEN NO ROBOT PROGRAM IS RUNNING.
; TWO WAYS TO START (CYCLE TIME, F52):
;  NUT_START (TRIGGER ON THE MOVE TO P12 / P10 OF THE PICKS, ROBOT AWAY FROM THE PEDESTAL):
;    FEED AND LOAD - STEPS 0, 10, 20 ONE AFTER THE OTHER.
;  NUT_FEED_START (WELD APPS 1-2, style1app1opt1A/B, 2A/B, AT THE WAIT POINT WHEN THEIR NUT IS
;    READY): FEED ONLY - STEP 0 FEEDS THE NEXT NUT INTO THE SHUTTLE WHILE THE ROBOT MOVES IN AND
;    WELDS, THEN WAITS. THE LOAD (STEPS 10, 20) STARTS WHEN Request_next_nut SETS NUT_START WITH
;    THE ROBOT CLEAR OF THE PEDESTAL (APP 1 AT P8, APP 2 AT P05) - NUT_LOAD_OK.
;  STEP 0  - QFP RETURN; WHEN RETURNED, NUT FEED FOR 2000 MS, THEN FEED OFF
;  STEP 10 - GUN OPEN, UPPER PIN RETRACT, CLAMP OPEN; QFP RETURN UNTIL SEEN RETURNED, THEN
;            QFP ADVANCE; WHEN ADVANCED, NUT BLOW-OFF ONTO THE LOWER PIN, LOWER PIN ADVANCE
;  STEP 20 - AFTER 800 MS BLOW-OFF: QFP RETURN, BLOW-OFF OFF; QFP SEEN RETURNED: NUT_READY=TRUE
;NOTE: DURING A WELD (FEED ONLY) THIS PROGRAM WRITES ONLY QFP RETURN (ALREADY RETURNED) AND THE
;  FEED $OUT[476]; CENTERLINE_WELD LEAVES THE FEED OUTPUT ALONE WHILE NUTCYCLE_ACTIVE IS TRUE (F52)
;WARNING: DRIVES THE PEDESTAL VALVES ON ITS OWN, WITH NO ROBOT, MODE OR ENABLING-SWITCH
;  INTERLOCK, AND SHARES THEM WITH CENTERLINE_WELD AND CENTERLINE_HOME WITHOUT OWNERSHIP (F11)
;NOTE: USES $TIMER[10] FEED 2000 MS, $TIMER[11] ADVANCE 500 MS, $TIMER[13] BLOW-OFF 800 MS -
;  KEEP THESE TIMERS FREE FOR THIS PROGRAM (F26). $TIMER[12] IS NO LONGER USED (F52)
;NOTE: NO STEP TIMEOUTS; NUT_PRELOAD_FAULT IS NEVER SET TRUE; NUT_READY IS SET WITHOUT FEED
;  COMPLETE CONFIRMATION (F13)
;NOTE: THE STEPS RUN ONLY WITH $IN[4] di004UseDryCycle OFF. IN DRY CYCLE A START STILL
;  CLEARS NUT_READY AND NOTHING SETS IT WHILE DRY CYCLE IS ON - THE WELD APPS WAIT FOR IT (F04)
;********************************

;START A PRELOAD WHEN NUT_START OR NUT_FEED_START IS SET AND NONE IS ACTIVE: BOTH CLEARED,
;NUT_LOAD_OK=NUT_START (FEED ONLY WAITS FOR THE LOAD REQUEST), NUT_READY=FALSE ONLY FOR NUT_START
;(ON A FEED-ONLY START THE NUT OF THE CURRENT WELD IS STILL ON THE PIN), STEP 0, STEP0/10/20DONE
;AND THE FAULT FLAG CLEARED, $TIMER[10..13] STOPPED AND ZEROED
;(STEP10_ADV_STARTED IS NOT CLEARED HERE - ONLY WHEN A PRELOAD COMPLETES)
;NOTE: A NUT_START SET WHILE A FULL PRELOAD IS ACTIVE STAYS SET AND STARTS ANOTHER PRELOAD (A NEW
;  NUT FEED) AS SOON AS THIS ONE ENDS; NUT_READY IS THEN TRUE FOR ONLY ONE SUBMIT CYCLE (F11)
IF (NUT_START OR NUT_FEED_START) AND NOT NUTCYCLE_ACTIVE THEN

   NUT_LOAD_OK=NUT_START
   IF NUT_START THEN
      NUT_READY=FALSE
   ENDIF
   NUT_START=FALSE
   NUT_FEED_START=FALSE
   NUTCYCLE_ACTIVE=TRUE
   NUT_PRELOAD_STEP=0
   STEP0DONE=FALSE
   STEP10DONE=FALSE
   STEP20DONE=FALSE
   NUT_PRELOAD_FAULT=FALSE
   $TIMER_STOP[10]=TRUE
   $TIMER[10]=0
   $TIMER_STOP[11]=TRUE
   $TIMER[11]=0
   $TIMER_STOP[13]=TRUE
   $TIMER[13]=0

ENDIF

;LOAD REQUEST (NUT_START FROM Request_next_nut OR A PICK) FOR A FEED-ONLY PRELOAD: THE ROBOT IS
;CLEAR OF THE PEDESTAL AND THE NUT OF THE LAST WELD HAS LEFT THE PIN - NUT_START CLEARED,
;NUT_READY=FALSE, NUT_LOAD_OK=TRUE (STEP 10 STARTS WHEN THE FEED IS DONE)
IF NUT_START AND NUTCYCLE_ACTIVE AND NOT NUT_LOAD_OK THEN
   NUT_START=FALSE
   NUT_READY=FALSE
   NUT_LOAD_OK=TRUE
ENDIF

;RUN THE STEPS ONLY OUTSIDE DRY CYCLE - SIGNAL $IN[4] di004UseDryCycle OFF
IF NUTCYCLE_ACTIVE AND NOT di004UseDryCycle THEN

   SWITCH NUT_PRELOAD_STEP

      CASE 0
         ;STEP 0 - FEED A NUT (UNTIL STEP0DONE; A FEED-ONLY PRELOAD THEN WAITS HERE FOR NUT_LOAD_OK)

         IF NOT STEP0DONE THEN

            ;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
            do503QFPAdvance=FALSE
            do504QFPReturn=TRUE

            ;WHEN QFP RETURNED AND NOT ADVANCED - SIGNALS $IN[482] dipw1_SpearHome ON,
            ;  $IN[470] di470QFPAdvanced OFF
            IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
               ;FEED NUT - SIGNAL $OUT[476] dopw1_StartFeed ON (OFF AFTER 2000 MS, BELOW)
               dopw1_StartFeed=TRUE
               ;BLOW-OFF OFF - SIGNAL $OUT[494] dopw1_BlowOff OFF, ONLY WITH THE LOAD ALLOWED (ROBOT
               ;  CLEAR): DURING A WELD CENTERLINE_WELD SWITCHES IT ON FOR THE INTENSIFY (F52)
               IF NUT_LOAD_OK THEN
                  dopw1_BlowOff=FALSE
               ENDIF

               ;START $TIMER[10] ONCE
               IF $TIMER_STOP[10] THEN
                  $TIMER[10]=0
                  $TIMER_STOP[10]=FALSE
               ENDIF

               ;AFTER 2000 MS OF FEED: FEED OFF - SIGNAL $OUT[476] dopw1_StartFeed OFF, STEP 0 DONE
               IF  $TIMER[10]>=2000 THEN
                  $TIMER_STOP[10]=TRUE
                  dopw1_StartFeed=FALSE
                  STEP0DONE=TRUE
               ENDIF

            ENDIF

         ENDIF

         ;TO STEP 10 WHEN THE FEED IS DONE AND THE LOAD IS ALLOWED
         IF STEP0DONE AND NUT_LOAD_OK THEN
            NUT_PRELOAD_STEP = 10
         ENDIF

      CASE 10
         ;STEP 10 - QFP ADVANCE AND BLOW THE NUT ONTO THE LOWER PIN

         IF STEP0DONE THEN

            ;WRITTEN IN EVERY SUBMIT CYCLE OF STEP 10:
            ;GUN OPEN - SIGNALS $OUT[472] dopw1_GunWork OFF, $OUT[471] dopw1_GunHome ON
            dopw1_GunWork=FALSE
            dopw1_GunHome=TRUE
            ;UPPER PIN RETRACT - SIGNALS $OUT[498] do498UpperPinExtend OFF,
            ;  $OUT[499] do499UpperPinRetract ON
            do498UpperPinExtend=FALSE
            do499UpperPinRetract=TRUE
            ;PART CLAMP OPEN - SIGNALS $OUT[501] do501PartClampClose OFF,
            ;  $OUT[502] do502PartClampOpen ON
            do501PartClampClose=FALSE
            do502PartClampOpen=TRUE

            ;UNTIL THE QFP HAS BEEN SEEN RETURNED (STEP10_ADV_STARTED):
            IF NOT STEP10_ADV_STARTED THEN
               ;BLOW-OFF ON - SIGNAL $OUT[494] dopw1_BlowOff ON
               dopw1_BlowOff=TRUE
               ;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
               do503QFPAdvance=FALSE
               do504QFPReturn=TRUE

               ;WHEN QFP RETURNED AND NOT ADVANCED - SIGNALS $IN[482] dipw1_SpearHome ON,
               ;  $IN[470] di470QFPAdvanced OFF
               IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
                  STEP10_ADV_STARTED=TRUE

               ENDIF
            ELSE

               ;QFP ADVANCE AND FEED OFF - SIGNALS $OUT[504] do504QFPReturn OFF,
               ;  $OUT[503] do503QFPAdvance ON, $OUT[476] dopw1_StartFeed OFF
               do504QFPReturn=FALSE
               do503QFPAdvance=TRUE
               dopw1_StartFeed=FALSE

               ;WHEN QFP ADVANCED AND NOT RETURNED - SIGNALS $IN[470] di470QFPAdvanced ON,
               ;  $IN[482] dipw1_SpearHome OFF
               IF (di470QFPAdvanced==TRUE) AND (dipw1_SpearHome==FALSE) THEN
                  ;NUT BLOW-OFF - SIGNALS $OUT[505] do505QFPNutBlowOff ON, $OUT[494] dopw1_BlowOff OFF
                  do505QFPNutBlowOff=TRUE
                  dopw1_BlowOff=FALSE
                  ;START $TIMER[13] (BLOW-OFF TIME, CHECKED IN STEP 20) ONCE
                  IF $TIMER_STOP[13] THEN
                     $TIMER[13]=0
                     $TIMER_STOP[13]=FALSE
                  ENDIF
                  ;LOWER PIN ADVANCE - SIGNALS $OUT[496] dopw1_ReturnPin OFF, $OUT[495] dopw1_AdvancePin ON
                  ;CHECK: OLD COMMENT SAID LOWER PIN RETREATED; THE CODE ADVANCES THE PIN (F27)
                  dopw1_ReturnPin=FALSE
                  dopw1_AdvancePin=TRUE

                  ;START $TIMER[11] ONCE
                  IF $TIMER_STOP[11] THEN
                     $TIMER[11]=0
                     $TIMER_STOP[11]=FALSE
                  ENDIF

                  ;500 MS AFTER THE QFP ADVANCED: STEP 10 DONE
                  IF $TIMER[11]>=500 THEN
                     $TIMER_STOP[11]=TRUE

                     STEP10DONE=TRUE
                  ENDIF
               ENDIF
            ENDIF
         ENDIF

         ;GO TO STEP 20
         IF STEP0DONE AND STEP10DONE THEN
            NUT_PRELOAD_STEP = 20

         ENDIF

      CASE 20
         ;STEP 20 - AFTER 800 MS OF NUT BLOW-OFF ($TIMER[13]): QFP RETURN

         IF STEP0DONE AND STEP10DONE AND ($TIMER[13]>=800)THEN

            ;LOWER PIN ADVANCE - SIGNALS $OUT[496] dopw1_ReturnPin OFF, $OUT[495] dopw1_AdvancePin ON
            ;CHECK: OLD COMMENT SAID LOWER PIN RETREATED; THE CODE ADVANCES THE PIN (F27)
            dopw1_ReturnPin=FALSE
            dopw1_AdvancePin=TRUE

            ;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
            do503QFPAdvance=FALSE
            do504QFPReturn=TRUE
            ;NUT BLOW-OFF OFF - SIGNAL $OUT[505] do505QFPNutBlowOff OFF
            do505QFPNutBlowOff=FALSE

            ;QFP SEEN RETURNED: STEP 20 DONE - SIGNALS $IN[482] dipw1_SpearHome ON,
            ;  $IN[470] di470QFPAdvanced OFF (WAS: 800 MS AFTER THE RETURN COMMAND, $TIMER[12], F52)
            IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
               STEP20DONE=TRUE
            ENDIF
         ENDIF

         ;PRELOAD COMPLETE: CYCLE INACTIVE AND NUT_LOAD_OK CLEARED FIRST (A WELD APP THAT SEES THE
         ;READY FLAG ALSO SEES THE PRELOAD ENDED), STEP 0, NUT_READY=TRUE, NEXT_NUT_READY=TRUE IF
         ;REQUESTED, $TIMER[10..11] STOPPED AND ZEROED ($TIMER[13] IS LEFT RUNNING UNTIL THE NEXT START)
         ;NOTE: NOTHING CLEARS NUT_READY WHEN THE NUT IS WELDED (F14); NEXT_NUT_READY IS WAITED FOR BY
         ;  NUTS 2 AND 3 (style1app1opt2A/B, 3A/B)
         IF STEP0DONE AND STEP10DONE AND STEP20DONE THEN
            NUTCYCLE_ACTIVE=FALSE
            NUT_LOAD_OK=FALSE
            NUT_PRELOAD_STEP =0
            NUT_READY=TRUE

            IF NEXT_NUT_REQUEST THEN
               NEXT_NUT_READY=TRUE
               NEXT_NUT_REQUEST=FALSE
            ENDIF
            STEP10_ADV_STARTED=FALSE

            $TIMER_STOP[10]=TRUE
            $TIMER[10]=0
            $TIMER_STOP[11]=TRUE
            $TIMER[11]=0

         ENDIF

   ENDSWITCH


ENDIF
END