&ACCESS RVO
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CENTERLINE_WELD1()



;UPPER PIN RETRACT =  27252      RANGE 26000 - 28000
;UPPER PIN EXTENDED = 6602       RANGE 6500- 7000
;UPPER PIN WELD POSITION = 11674 RANGE 10000 - 13500


;GUN RETRACT = 139815            RANGE 137000 - 142000
;GUN EXTENDED = 61450            RANGE 60000 - 63000
;GUN WELD POSITION = 70915       RANGE 65000 - 76000


;FORMULA CMD = (MPa / 0.9) * 4095

;PRESSURE 455   0.10MPa    14.50 PSI
;PRESSURE 910   0.20MPa    29.01 PSI
;PRESSURE 1365  0.30MPa    43.51 PSI
;PRESSURE 1820  0.40MPa    58.02 PSI
;PRESSURE 2275  0.50MPa    72.52 PSI      
;PRESSURE 2503  0.55MPa    79.77 PSI     
;PRESSURE 2730  0.60MPa    87.02 PSI 



;PRESSURE GENERAL
CL_GunPressureCmd=405

$OUT[476]=FALSE

do305Start1=FALSE
do307WeldContactorEnable=FALSE
do309FaultReset=FALSE
do312WeldOnExternal=FALSE
gdo313SpotNumber=0

;HOME MECANICO
$OUT[472]=FALSE
$OUT[471]=TRUE

$OUT[498]=FALSE
$OUT[499]=TRUE

$OUT[501]=FALSE
$OUT[502]=TRUE

$OUT[495]=FALSE
$OUT[496]=TRUE

$OUT[503]=FALSE
$OUT[504]=TRUE

$OUT[494]=FALSE
$OUT[500]=FALSE
$OUT[505]=FALSE
$OUT[473]=FALSE

WAIT FOR $IN[482]
WAIT SEC 1.0

;HABILITAR BOSCH
do307WeldContactorEnable=TRUE
do312WeldOnExternal=TRUE

;QFP FORWARD
$OUT[504]=FALSE
WAIT SEC 0.2
$OUT[503]=TRUE

WAIT FOR $IN[470]
WAIT SEC 0.5

;LOWER PIN FORWARD
$OUT[496]=FALSE
WAIT SEC 0.2
$OUT[495]=TRUE
WAIT SEC 0.5

;ALIMENTAR TUERCA
$OUT[476]=TRUE
WAIT FOR $IN[481]
$OUT[476]=FALSE
WAIT SEC 0.5

;QFP HOME
$OUT[503]=FALSE
WAIT SEC 0.2
$OUT[504]=TRUE

WAIT FOR $IN[482]
WAIT SEC 0.5

;UPPER PIN FORWARD
$OUT[499]=FALSE
WAIT SEC 0.2
$OUT[498]=TRUE
WAIT SEC 0.5

;PART CLAMP CLOSE
$OUT[502]=FALSE
WAIT SEC 0.2
$OUT[501]=TRUE
WAIT SEC 0.5

;GUN CLOSE
$OUT[471]=FALSE
WAIT SEC 0.2
$OUT[472]=TRUE
WAIT SEC 1.0

;LOWER PIN RETURN
$OUT[495]=FALSE
WAIT SEC 0.2
$OUT[496]=TRUE
WAIT SEC 0.5

;CLOSE GUN
WAIT FOR (CL_GunStrokePositionLPT >=51000) and (CL_GunStrokePositionLPT<=53000)



;PRESION DE SOLDADURA
CL_GunPressureCmd=1820

WAIT FOR $IN[479]

;SCHEDULE 7
gdo313SpotNumber=7

;BOSCH READY
WAIT FOR di309TimerReady

;INICIAR SOLDADURA
do305Start1=TRUE

WAIT FOR (di305WeldComplete OR di310WeldFault)

IF di310WeldFault THEN
   do305Start1=FALSE
   CL_GunPressureCmd=39425
   HALT
ENDIF

;WELD COMPLETE
do305Start1=FALSE

WAIT FOR NOT di305WeldComplete

;QUITAR PRESION ALTA
CL_GunPressureCmd=405

;GUN OPEN
$OUT[472]=FALSE
WAIT SEC 0.2
$OUT[471]=TRUE
WAIT SEC 1.0

;PART CLAMP OPEN
$OUT[501]=FALSE
WAIT SEC 0.2
$OUT[502]=TRUE
WAIT SEC 0.5

;UPPER PIN RETURN
$OUT[498]=FALSE
WAIT SEC 0.2
$OUT[499]=TRUE
WAIT SEC 1.0

;HOME FINAL
$OUT[504]=TRUE
$OUT[496]=TRUE

WAIT FOR $IN[482]
WAIT SEC 1.0

;RESET BOSCH
do305Start1=FALSE
gdo313SpotNumber=0
do307WeldContactorEnable=FALSE
do312WeldOnExternal=FALSE

$OUT[476]=FALSE
CL_GunPressureCmd=39425

END