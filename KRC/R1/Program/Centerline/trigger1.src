&ACCESS RVP
DEF  trigger1 ( )

IF di004UseDryCycle==TRUE THEN

GOTO DRY
ELSE

IF  NUT_PRELOAD_STEP == 0 THEN
;QFP RETURNED
$OUT[503]=FALSE
$OUT[504]=TRUE

;CL_QFPReturned / QFP ADV
IF ($IN[482]==TRUE) AND ($IN[470]==FALSE) THEN 
;FEED NUT
$OUT[476]=TRUE
$OUT[494]=FALSE
NUT_PRELOAD_STEP = 10
ELSE
  
ENDIF
ENDIF

ENDIF

   DRY:

END