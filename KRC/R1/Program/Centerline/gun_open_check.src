&ACCESS RVO5
&REL 25
&COMMENT 03-10-R1 PNW1 GUN OPEN CHECK
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\Centerline
DEF GUN_OPEN_CHECK( )
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - NUT WELDER GUN OPEN INTERLOCK BEFORE THE ROBOT MOVES INTO OR OUT OF THE PEDESTAL
;********************************
; CALLED BY style1app1opt1A..3B BEFORE ENTERING THE PEDESTAL AND AGAIN AFTER THE WELD, AND BY
; CENTERLINE_WELD AFTER THE GUN OPENS. CHECKS IN THIS ORDER, EACH WITH A STATE MESSAGE AND A WAIT (THE ROBOT DOES NOT MOVE):
; 1. SUBMIT RUNNING ($PRO_STATE0): CL_GunStrokePositionLPT IS ONLY UPDATED BY SPS.SUB
; 2. AIR PRESSURE - SIGNAL $IN[3132] dipw1_AirOK ON (ONLY WITH bGunAirCheck TRUE)
; 3. COOLING WATER - dipw1_WaterOk (SET BY SPS.SUB FROM THE SV0500 FLOW, ONLY WITH bGunWaterCheck)
; 4. GUN OPEN - CL_GunStrokePositionLPT IN nGunOpenMin..nGunOpenMax, nGunOpenWaitMs WITHOUT MESSAGE
; GUN_OPEN_LOST (BELOW) IS THE ROUTINE OF THE GUN MONITORING INTERRUPTS 20-22 OF THE WELD APPS
; (style1app1opt1A..3B); THE APPS SWITCH THE INTERRUPTS ON BEFORE CALLING THIS CHECK.
; SETTINGS IN GUN_OPEN_CHECK.dat. WRITTEN BY THE PROGRAMMER ON 2026-10-05 (F01)
;PART CLAMP OPEN AND UPPER PIN RETRACT ARE CHECKED BY PEDESTAL_CLEAR_CHECK (BELOW), AFTER THIS
;GUN CHECK (2026-10-06). CHECK: QFP RETURNED $IN[482] IS STILL NOT CHECKED BEFORE ENTERING (F01)
DECL KrlMsg_T Msg
DECL KrlMsg_T MsgW
DECL KrlMsgPar_T Par[3]
DECL KrlMsgOpt_T Opt
DECL INT nHandle, nWaitMs
DECL BOOL bRes

   ;STOP THE ADVANCE RUN: THE GUN POSITION IS READ WITH THE ROBOT STOPPED, NOT AHEAD OF THE MOTION
   WAIT SEC 0

   ;FOLD MESSAGE SETUP
   Msg.Modul[]="GunOpenCheck"
   MsgW.Modul[]="GunOpenCheck"
   Par[1].Par_Type=#EMPTY
   Par[2].Par_Type=#EMPTY
   Par[3].Par_Type=#EMPTY
   Opt.VL_Stop=TRUE
   Opt.Clear_P_Reset=TRUE
   Opt.Clear_P_SAW=FALSE
   Opt.Log_To_DB=TRUE
   ;ENDFOLD

   ;1. SUBMIT RUNNING - OTHERWISE CL_GunStrokePositionLPT IS FROZEN (NO TIMEOUT, STATE MESSAGE)
   IF $PRO_STATE0<>#P_ACTIVE THEN
      Msg.Nr=1
      Msg.Msg_txt[]="Submit (SPS) not running - gun position not valid - robot waiting"
      Par[1].Par_Type=#EMPTY
      nHandle=Set_KrlMsg(#STATE, Msg, Par[], Opt)
      WAIT FOR $PRO_STATE0==#P_ACTIVE
      bRes=Clear_KrlMsg(nHandle)
      ;LET THE SUBMIT REFRESH THE GUN POSITION
      WAIT SEC 0.5
   ENDIF

   ;2. AIR PRESSURE - WITHOUT AIR THE GUN CANNOT BE HELD OPEN (ONLY WITH bGunAirCheck TRUE)
   IF bGunAirCheck THEN
      ;AIR PRESSURE SWITCH - SIGNAL $IN[3132] dipw1_AirOK ON, ELSE MESSAGE AND WAIT (NO TIMEOUT)
      IF NOT dipw1_AirOK THEN
         Msg.Nr=3
         Msg.Msg_txt[]="Nut welder air pressure not OK (dipw1_AirOK) - robot waiting"
         Par[1].Par_Type=#EMPTY
         nHandle=Set_KrlMsg(#STATE, Msg, Par[], Opt)
         ;WAIT AIR PRESSURE - SIGNAL $IN[3132] dipw1_AirOK ON (NO TIMEOUT, STATE MESSAGE)
         WAIT FOR dipw1_AirOK
         bRes=Clear_KrlMsg(nHandle)
      ENDIF
   ENDIF

   ;3. COOLING WATER - dipw1_WaterOk FROM THE SV0500 FLOW (SPS.SUB); MESSAGE WITH THE FLOW, WAIT
   IF bGunWaterCheck THEN
      IF NOT dipw1_WaterOk THEN
         MsgW.Nr=6
         MsgW.Msg_txt[]="Nut welder cooling water flow too low (%1 x0.1 l/min) - robot waiting"
         Par[1].Par_Type=#VALUE
         Par[1].Par_Int=nWaterFlow
         nHandle=Set_KrlMsg(#STATE, MsgW, Par[], Opt)
         WAIT FOR dipw1_WaterOk
         bRes=Clear_KrlMsg(nHandle)
         Par[1].Par_Type=#EMPTY
      ENDIF
   ENDIF

   ;4. GUN OPEN - UP TO nGunOpenWaitMs WITHOUT MESSAGE
   nWaitMs=0
   WHILE ((CL_GunStrokePositionLPT<nGunOpenMin) OR (CL_GunStrokePositionLPT>nGunOpenMax)) AND (nWaitMs<nGunOpenWaitMs)
      WAIT SEC 0.05
      nWaitMs=nWaitMs+50
   ENDWHILE

   ;GUN STILL NOT OPEN - STATE MESSAGE WITH THE POSITION, WAIT (NO TIMEOUT)
   IF (CL_GunStrokePositionLPT<nGunOpenMin) OR (CL_GunStrokePositionLPT>nGunOpenMax) THEN
      Msg.Nr=2
      Msg.Msg_txt[]="Nut welder gun not open (position %1) - robot waiting"
      Par[1].Par_Type=#VALUE
      Par[1].Par_Int=CL_GunStrokePositionLPT
      nHandle=Set_KrlMsg(#STATE, Msg, Par[], Opt)
      WAIT FOR (CL_GunStrokePositionLPT>=nGunOpenMin) AND (CL_GunStrokePositionLPT<=nGunOpenMax)
      bRes=Clear_KrlMsg(nHandle)
   ENDIF

END

GLOBAL DEF GUN_OPEN_LOST( )
;INTERRUPT ROUTINE OF THE PEDESTAL MONITORING (INTERRUPTS 20-24 IN style1app1opt1A..3B): THE GUN LEFT THE
;OPEN RANGE, THE SUBMIT STOPPED, THE PART CLAMP IS NOT OPEN (23) OR THE UPPER PIN IS NOT RETRACTED (24)
;WHILE THE ROBOT MOVES INTO OR OUT OF THE PEDESTAL. BRAKE F STOPS THE ROBOT ON ITS PATH; IT CONTINUES
;WHEN THE QUIT MESSAGE IS ACKNOWLEDGED AND SUBMIT, GUN, CLAMP AND PIN ARE OK AGAIN (2026-10-06)
DECL KrlMsg_T Msg
DECL KrlMsgPar_T Par[3]
DECL KrlMsgOpt_T Opt
DECL INT nHandle
DECL BOOL bRes

   BRAKE F

   ;FOLD MESSAGE SETUP
   Msg.Modul[]="GunOpenCheck"
   Par[1].Par_Type=#EMPTY
   Par[2].Par_Type=#EMPTY
   Par[3].Par_Type=#EMPTY
   Opt.VL_Stop=TRUE
   Opt.Clear_P_Reset=TRUE
   Opt.Clear_P_SAW=FALSE
   Opt.Log_To_DB=TRUE
   ;ENDFOLD

   IF $PRO_STATE0<>#P_ACTIVE THEN
      Msg.Nr=5
      Msg.Msg_txt[]="Submit (SPS) stopped while robot in welder - robot stopped, acknowledge"
   ELSE
      IF (CL_GunStrokePositionLPT<nGunOpenMin) OR (CL_GunStrokePositionLPT>nGunOpenMax) THEN
         Msg.Nr=4
         Msg.Msg_txt[]="Gun not open while robot in welder (pos. %1) - robot stopped, acknowledge"
         Par[1].Par_Type=#VALUE
         Par[1].Par_Int=CL_GunStrokePositionLPT
      ELSE
         IF NOT CL_ClampOpen THEN
            Msg.Nr=10
            Msg.Msg_txt[]="Part clamp not open while robot in welder - robot stopped, acknowledge"
         ELSE
            Msg.Nr=11
            Msg.Msg_txt[]="Upper pin not retracted in welder (pos. %1) - robot stopped, acknowledge"
            Par[1].Par_Type=#VALUE
            Par[1].Par_Int=CL_WeldPinPosition
         ENDIF
      ENDIF
   ENDIF
   nHandle=Set_KrlMsg(#QUIT, Msg, Par[], Opt)

   ;CONTINUE ONLY WHEN THE MESSAGE IS ACKNOWLEDGED, THE SUBMIT RUNS AND THE GUN IS OPEN AGAIN:
   ;FIRST WAIT FOR THE ACKNOWLEDGEMENT
   WHILE Exists_KrlMsg(nHandle)
      WAIT SEC 0.1
   ENDWHILE
   ;STILL NOT READY AFTER THE ACKNOWLEDGEMENT - STATE MESSAGE WHILE THE ROBOT WAITS, SO IT NEVER
   ;STANDS IN THE PEDESTAL WITHOUT A MESSAGE (INDEPENDENT REVIEW 2026-10-05, F01)
   IF ($PRO_STATE0<>#P_ACTIVE) OR (CL_GunStrokePositionLPT<nGunOpenMin) OR (CL_GunStrokePositionLPT>nGunOpenMax) OR (NOT CL_ClampOpen) OR (NOT CL_PinRetracted) THEN
      Msg.Nr=7
      Msg.Msg_txt[]="Robot in welder waiting: Submit, gun open, clamp open, pin retracted"
      Par[1].Par_Type=#EMPTY
      nHandle=Set_KrlMsg(#STATE, Msg, Par[], Opt)
      WHILE ($PRO_STATE0<>#P_ACTIVE) OR (CL_GunStrokePositionLPT<nGunOpenMin) OR (CL_GunStrokePositionLPT>nGunOpenMax) OR (NOT CL_ClampOpen) OR (NOT CL_PinRetracted)
         WAIT SEC 0.1
      ENDWHILE
      bRes=Clear_KrlMsg(nHandle)
   ENDIF

END

GLOBAL DEF PEDESTAL_CLEAR_CHECK( )
;ROBOT MOTION INTERLOCK OF THE PEDESTAL, CALLED BY style1app1opt1A..3B BEFORE THE ROBOT MOVES INTO THE
;PEDESTAL AND AGAIN AFTER THE WELD, BEFORE IT LEAVES (CENTERLINE_WELD STILL CALLS GUN_OPEN_CHECK ONLY,
;BEFORE IT OPENS THE CLAMP). IN THIS ORDER - THE ROBOT DOES NOT MOVE UNTIL ALL ARE OK:
;1-4. GUN_OPEN_CHECK - SUBMIT RUNNING, AIR, WATER, GUN OPEN
;5. PART CLAMP OPEN, ONLY AFTER THE GUN IS CONFIRMED OPEN (THE CLAMP WORKS TOGETHER WITH THE GUN) -
;   SIGNALS $OUT[501] do501PartClampClose OFF, $OUT[502] do502PartClampOpen ON, THEN WAIT
;   $IN[466] di466PartClampOpen ON AND $IN[467] di467PartClampClosed OFF
;6. UPPER PIN RETRACT (THE ROBOT PASSES VERY CLOSE TO THE PIN) - SIGNALS $OUT[498] do498UpperPinExtend
;   OFF, $OUT[499] do499UpperPinRetract ON (AS AT THE END OF CENTERLINE_WELD); POSITION CHECKED ONLY
;   WITH bPinCheck TRUE: CL_WeldPinPosition IN nPinRetractMin..nPinRetractMax
;nPedestalWaitMs WITHOUT MESSAGE, THEN STATE MESSAGE AND WAIT (NO TIMEOUT). SETTINGS IN GUN_OPEN_CHECK.dat
;WRITTEN BY THE PROGRAMMER ON 2026-10-06 (USER REQUEST: PIN RETRACTED AND CLAMP OPEN BEFORE MOTION)
DECL KrlMsg_T Msg
DECL KrlMsgPar_T Par[3]
DECL KrlMsgOpt_T Opt
DECL INT nHandle, nWaitMs
DECL BOOL bRes

   ;1-4. GUN OPEN FIRST: SUBMIT, AIR, WATER, GUN OPEN (GUN_OPEN_CHECK ALSO STOPS THE ADVANCE RUN)
   GUN_OPEN_CHECK()

   ;FOLD MESSAGE SETUP
   Msg.Modul[]="GunOpenCheck"
   Par[1].Par_Type=#EMPTY
   Par[2].Par_Type=#EMPTY
   Par[3].Par_Type=#EMPTY
   Opt.VL_Stop=TRUE
   Opt.Clear_P_Reset=TRUE
   Opt.Clear_P_SAW=FALSE
   Opt.Log_To_DB=TRUE
   ;ENDFOLD

   ;5. PART CLAMP OPEN ($IN[466] ONLY - 2026-10-09, AS 20R1: $IN[467] CAN STAY ON A WHILE) - ONLY AFTER THE GUN IS CONFIRMED OPEN (CLAMP AND GUN WORK TOGETHER)
   do501PartClampClose=FALSE
   do502PartClampOpen=TRUE
   nWaitMs=0
   WHILE (NOT di466PartClampOpen) AND (nWaitMs<nPedestalWaitMs)
      WAIT SEC 0.05
      nWaitMs=nWaitMs+50
   ENDWHILE
   IF NOT di466PartClampOpen THEN
      Msg.Nr=8
      Msg.Msg_txt[]="Part clamp not open ($IN[466] / $IN[467]) - robot waiting"
      Par[1].Par_Type=#EMPTY
      nHandle=Set_KrlMsg(#STATE, Msg, Par[], Opt)
      WAIT FOR di466PartClampOpen
      bRes=Clear_KrlMsg(nHandle)
   ENDIF

   ;6. UPPER PIN RETRACT - THE ROBOT PASSES VERY CLOSE TO THE PIN; POSITION ONLY WITH bPinCheck TRUE
   do498UpperPinExtend=FALSE
   do499UpperPinRetract=TRUE
   IF bPinCheck THEN
      nWaitMs=0
      WHILE ((CL_WeldPinPosition<nPinRetractMin) OR (CL_WeldPinPosition>nPinRetractMax)) AND (nWaitMs<nPedestalWaitMs)
         WAIT SEC 0.05
         nWaitMs=nWaitMs+50
      ENDWHILE
      IF (CL_WeldPinPosition<nPinRetractMin) OR (CL_WeldPinPosition>nPinRetractMax) THEN
         Msg.Nr=9
         Msg.Msg_txt[]="Upper pin not retracted (position %1) - robot waiting"
         Par[1].Par_Type=#VALUE
         Par[1].Par_Int=CL_WeldPinPosition
         nHandle=Set_KrlMsg(#STATE, Msg, Par[], Opt)
         WAIT FOR (CL_WeldPinPosition>=nPinRetractMin) AND (CL_WeldPinPosition<=nPinRetractMax)
         bRes=Clear_KrlMsg(nHandle)
         Par[1].Par_Type=#EMPTY
      ENDIF
   ENDIF

END

GLOBAL DEF PIN_WELD_CHECK( )
;UPPER PIN IN WELD POSITION, CALLED BY CENTERLINE_WELD WITH THE GUN CLOSED, JUST BEFORE THE WELD
;START: THE PART IS SEATED ON THE UPPER PIN - CL_WeldPinPosition IN CL_PIN_WELD_MIN..CL_PIN_WELD_MAX
;($config.dat). ONLY WITH bPinWeldCheck TRUE. nPedestalWaitMs WITHOUT MESSAGE, THEN STATE MESSAGE
;AND WAIT (NO TIMEOUT): THE ROBOT DOES NOT WELD UNTIL THE PIN IS IN THE WINDOW
;MEASURED ON 03-10-R1 2026-10-05: 11542 WITHOUT NUT, 11624 / 11648 WITH NUT - THE PIN CONFIRMS THE
;PART POSITION, NOT THE NUT. WRITTEN BY THE PROGRAMMER ON 2026-10-06 (USER REQUEST, F16)
DECL KrlMsg_T Msg
DECL KrlMsgPar_T Par[3]
DECL KrlMsgOpt_T Opt
DECL INT nHandle, nWaitMs
DECL BOOL bRes

   IF bPinWeldCheck THEN
      ;STOP THE ADVANCE RUN: THE PIN POSITION IS READ NOW, NOT AHEAD
      WAIT SEC 0

      ;FOLD MESSAGE SETUP
      Msg.Modul[]="GunOpenCheck"
      Par[1].Par_Type=#EMPTY
      Par[2].Par_Type=#EMPTY
      Par[3].Par_Type=#EMPTY
      Opt.VL_Stop=TRUE
      Opt.Clear_P_Reset=TRUE
      Opt.Clear_P_SAW=FALSE
      Opt.Log_To_DB=TRUE
      ;ENDFOLD

      nWaitMs=0
      WHILE ((CL_WeldPinPosition<CL_PIN_WELD_MIN) OR (CL_WeldPinPosition>CL_PIN_WELD_MAX)) AND (nWaitMs<nPedestalWaitMs)
         WAIT SEC 0.05
         nWaitMs=nWaitMs+50
      ENDWHILE
      IF (CL_WeldPinPosition<CL_PIN_WELD_MIN) OR (CL_WeldPinPosition>CL_PIN_WELD_MAX) THEN
         Msg.Nr=12
         Msg.Msg_txt[]="Upper pin not in weld position (pos. %1) - part not seated, no weld"
         Par[1].Par_Type=#VALUE
         Par[1].Par_Int=CL_WeldPinPosition
         nHandle=Set_KrlMsg(#STATE, Msg, Par[], Opt)
         WAIT FOR (CL_WeldPinPosition>=CL_PIN_WELD_MIN) AND (CL_WeldPinPosition<=CL_PIN_WELD_MAX)
         bRes=Clear_KrlMsg(nHandle)
      ENDIF
   ENDIF

END

GLOBAL DEF WELD_COMPLETE_WAIT( )
;WELD COMPLETE WAIT OF CENTERLINE_WELD, CALLED RIGHT AFTER dopw1_WeldInit ON. WELD STATUS LIGHTS
;(SPS.SUB): GREEN $OUT[477] dopw1_LevelOk, RED $OUT[478] dopw1_LowLevel WHILE CL_WeldFault ($config.dat)
;OR THE BOSCH FAULT $IN[485] dipw1_Fault IS ON.
;1. WAIT $IN[483] dipw1_WeldComplete UP TO CL_WELD_COMPLETE_TIMEOUT MS, STOP AT A BOSCH FAULT
;2. BOSCH FAULT OR NO WELD COMPLETE IN TIME: CL_WeldFault TRUE (RED), NOTIFY MESSAGE, THEN WAIT FOR
;   THE WELD COMPLETE AS BEFORE (NO TIMEOUT, STATE MESSAGE)
;3. GOOD WELD (WELD COMPLETE IN TIME, NO BOSCH FAULT): CL_WeldFault FALSE (GREEN)
;WRITTEN BY THE PROGRAMMER ON 2026-10-06 (USER REQUEST: GREEN LIGHT ALWAYS ON, RED ON A WELD FAULT)
DECL KrlMsg_T Msg
DECL KrlMsgPar_T Par[3]
DECL KrlMsgOpt_T Opt
DECL INT nHandle, nWaitMs
DECL BOOL bRes, bFault

   ;FOLD MESSAGE SETUP
   Msg.Modul[]="WeldCheck"
   Par[1].Par_Type=#EMPTY
   Par[2].Par_Type=#EMPTY
   Par[3].Par_Type=#EMPTY
   Opt.VL_Stop=TRUE
   Opt.Clear_P_Reset=TRUE
   Opt.Clear_P_SAW=FALSE
   Opt.Log_To_DB=TRUE
   ;ENDFOLD

   ;1. WELD COMPLETE WITHIN CL_WELD_COMPLETE_TIMEOUT MS, STOP AT A BOSCH FAULT
   bFault=FALSE
   nWaitMs=0
   WHILE (NOT dipw1_WeldComplete) AND (NOT dipw1_Fault) AND (nWaitMs<CL_WELD_COMPLETE_TIMEOUT)
      WAIT SEC 0.05
      nWaitMs=nWaitMs+50
   ENDWHILE

   ;2. BOSCH FAULT OR NO WELD COMPLETE IN TIME: RED LIGHT AND NOTIFY MESSAGE (ACKNOWLEDGE WITH OK)
   IF dipw1_Fault OR (NOT dipw1_WeldComplete) THEN
      bFault=TRUE
      CL_WeldFault=TRUE
      IF dipw1_Fault THEN
         Msg.Nr=21
         Msg.Msg_txt[]="Bosch weld fault ($IN[485]) - nut weld NOT OK, red light ON"
         Par[1].Par_Type=#EMPTY
      ELSE
         Msg.Nr=22
         Msg.Msg_txt[]="Weld complete ($IN[483]) not received in %1 ms - red light ON"
         Par[1].Par_Type=#VALUE
         Par[1].Par_Int=CL_WELD_COMPLETE_TIMEOUT
      ENDIF
      nHandle=Set_KrlMsg(#NOTIFY, Msg, Par[], Opt)
      Par[1].Par_Type=#EMPTY

      ;STILL NO WELD COMPLETE: STATE MESSAGE WHILE THE ROBOT WAITS FOR IT (AS BEFORE, NO TIMEOUT)
      IF NOT dipw1_WeldComplete THEN
         Msg.Nr=23
         Msg.Msg_txt[]="Robot waiting for weld complete $IN[483] from the Bosch"
         nHandle=Set_KrlMsg(#STATE, Msg, Par[], Opt)
         WAIT FOR dipw1_WeldComplete
         bRes=Clear_KrlMsg(nHandle)
      ENDIF
   ENDIF

   ;3. GOOD WELD: WELD COMPLETE IN TIME AND NO BOSCH FAULT - RED OFF, GREEN ON
   IF NOT bFault THEN
      CL_WeldFault=FALSE
   ENDIF

END

GLOBAL DEF GUN_CLOSE_FAULT( )
;GUN NOT CLOSED ON THE NUT: CALLED BY CENTERLINE_WELD WHEN CL_GunStrokePositionLPT IS NOT IN
;CL_GUN_WELD_MIN..CL_GUN_WELD_MAX WITHIN CL_GUN_CLOSE_TIMEOUT MS, JUST BEFORE ITS HALT.
;CL_WeldFault TRUE (RED LIGHT $OUT[478]) AND NOTIFY MESSAGE WITH THE GUN POSITION:
;BELOW CL_GUN_WELD_MIN = THE GUN CLOSED FURTHER = NO NUT; ABOVE CL_GUN_WELD_MAX = DOUBLE NUT OR GUN NOT
;CLOSED. BACK TO GREEN AT THE NEXT GOOD WELD (WELD_COMPLETE_WAIT)
;WRITTEN BY THE PROGRAMMER ON 2026-10-06 (USER REQUEST: RED LIGHT WHEN THE GUN CLOSES WITH NO NUT)
DECL KrlMsg_T Msg
DECL KrlMsgPar_T Par[3]
DECL KrlMsgOpt_T Opt
DECL INT nHandle

   ;FOLD MESSAGE SETUP
   Msg.Modul[]="WeldCheck"
   Par[1].Par_Type=#VALUE
   Par[1].Par_Int=CL_GunStrokePositionLPT
   Par[2].Par_Type=#EMPTY
   Par[3].Par_Type=#EMPTY
   Opt.VL_Stop=TRUE
   Opt.Clear_P_Reset=TRUE
   Opt.Clear_P_SAW=FALSE
   Opt.Log_To_DB=TRUE
   ;ENDFOLD

   CL_WeldFault=TRUE
   IF CL_GunStrokePositionLPT<CL_GUN_WELD_MIN THEN
      Msg.Nr=24
      Msg.Msg_txt[]="NO NUT: gun closed too far (pos. %1) - red light ON, robot stopped"
   ELSE
      Msg.Nr=25
      Msg.Msg_txt[]="Double nut or gun not closed (pos. %1) - red light ON, robot stopped"
   ENDIF
   nHandle=Set_KrlMsg(#NOTIFY, Msg, Par[], Opt)

END

GLOBAL DEF PIN_SETTLE_WAIT( )
;UPPER PIN SEATED BEFORE THE PART CLAMP CLOSES, CALLED BY CENTERLINE_WELD RIGHT AFTER THE UPPER PIN EXTEND
;(2026-10-09, USER REQUEST: SOMETIMES THE PIN DID NOT DROP INTO THE PART HOLE BECAUSE THE CLAMP CLOSED AT
;THE SAME TIME, AND THE PIN READING WAS WRONG). MINIMUM WAIT: CONTINUES AS SOON AS CL_WeldPinPosition IS OUT
;OF THE RETRACTED ZONE (< nPinRetractMin) AND STABLE (CHANGE <= nPinStableCnt FOR nPinStableMs MS).
;AFTER nPinSettleMaxMs WITHOUT THAT IT CONTINUES ANYWAY (AS BEFORE) - PIN_WELD_CHECK STILL CHECKS THE PIN
;BEFORE THE WELD. NO MESSAGE, NO STOP. SETTINGS IN GUN_OPEN_CHECK.dat
DECL INT nWaitMs, nStableMs, nLast

   nWaitMs=0
   nStableMs=0
   nLast=CL_WeldPinPosition
   WHILE (nWaitMs<nPinSettleMaxMs) AND (nStableMs<nPinStableMs)
      WAIT SEC 0.02
      nWaitMs=nWaitMs+20
      IF (CL_WeldPinPosition<nPinRetractMin) AND (ABS(CL_WeldPinPosition-nLast)<=nPinStableCnt) THEN
         nStableMs=nStableMs+20
      ELSE
         nStableMs=0
      ENDIF
      nLast=CL_WeldPinPosition
   ENDWHILE

END

GLOBAL DEF CT_NUT_WAIT(nNut:IN)
;FOLD ROUTINE INFO
;**********************************************************
;* CYCLE TIME MEASUREMENT (2026-10-09, AS 20R1). REPLACES THE
;* NUT WAIT IN style1app1opt1A - style1app1opt3B WITH THE SAME
;* WAIT: NUT 1 WAIT FOR NUT_READY, NUTS 2 AND 3 WAIT FOR
;* NEXT_NUT_READY; PLUS THE TIME THE ROBOT STOOD AT THE
;* APPROACH POINT WAITING -> nCtNutWait[nNut] (MS).
;* WAIT SEC 0 = THE SAME ADVANCE RUN STOP THE WAIT FOR MADE.
;**********************************************************
;ENDFOLD
DECL INT nNut
   WAIT SEC 0
   nCtNut=nNut
   $TIMER[21]=0
   $TIMER_STOP[21]=FALSE
   ;ALL NUTS WAIT NUT_READY AS ON 20R1 (2026-10-10, USER: SAME AS THE FIRST 3 NUTS OF 20R1) - WAS NEXT_NUT_READY FOR NUTS 2-3
   WAIT FOR NUT_READY==TRUE
   IF (nNut>=1) AND (nNut<=3) THEN
      nCtNutWait[nNut]=$TIMER[21]
   ENDIF
END

GLOBAL DEF CT_WELD_START( )
;FOLD ROUTINE INFO
;**********************************************************
;* CYCLE TIME MEASUREMENT (2026-10-09), FIRST LINE OF
;* CENTERLINE_WELD: THE ROBOT IS AT THE WELD POSITION
;* (WAIT SEC 0 IN THE STYLE PROGRAM BEFORE THE CALL).
;**********************************************************
;ENDFOLD
   IF (nCtNut>=1) AND (nCtNut<=3) THEN
      nCtNutToNut[nCtNut]=$TIMER[20]
   ENDIF
   $TIMER[20]=0
   $TIMER_STOP[20]=FALSE
   IF nCtNut==1 THEN
      nCtCycle=$TIMER[23]
      $TIMER[23]=0
      $TIMER_STOP[23]=FALSE
   ENDIF
   $TIMER[22]=0
   $TIMER_STOP[22]=FALSE
END

GLOBAL DEF CT_WELD_END( )
;FOLD ROUTINE INFO
;**********************************************************
;* CYCLE TIME MEASUREMENT (2026-10-09), LAST LINE OF
;* CENTERLINE_WELD. AFTER NUT 3: PART TIME AND TOTAL WAIT.
;**********************************************************
;ENDFOLD
DECL INT i
   IF (nCtNut>=1) AND (nCtNut<=3) THEN
      nCtInWelder[nCtNut]=$TIMER[22]
   ENDIF
   IF nCtNut==3 THEN
      nCtPart=nCtInWelder[3]
      nCtWaitSum=nCtNutWait[1]
      FOR i=2 TO 3
         nCtPart=nCtPart+nCtNutToNut[i]
         nCtWaitSum=nCtWaitSum+nCtNutWait[i]
      ENDFOR
   ENDIF
END

GLOBAL DEF NUT_RETRY_MSG( )
;NUT RETRY (2026-10-10, AS 20R1), CALLED BY CENTERLINE_WELD WHEN THE GUN CLOSED BELOW CL_GUN_WELD_MIN (NO NUT) AND
;A RETRY IS LEFT: NOTIFY MESSAGE ONLY (NO RED LIGHT, NO STOP) - THE NUT PROGRAM FEEDS A NEW NUT AND WELDS AGAIN
DECL KrlMsg_T Msg
DECL KrlMsgPar_T Par[3]
DECL KrlMsgOpt_T Opt
DECL INT nHandle

   ;FOLD MESSAGE SETUP
   Msg.Modul[]="WeldCheck"
   Msg.Nr=26
   Msg.Msg_txt[]="No nut (gun pos. %1) - new nut fed, nut welded again (retry %2 of %3)"
   Par[1].Par_Type=#VALUE
   Par[1].Par_Int=CL_GunStrokePositionLPT
   Par[2].Par_Type=#VALUE
   Par[2].Par_Int=nNutRetryCnt
   Par[3].Par_Type=#VALUE
   Par[3].Par_Int=nNutRetryMax
   Opt.VL_Stop=TRUE
   Opt.Clear_P_Reset=TRUE
   Opt.Clear_P_SAW=FALSE
   Opt.Log_To_DB=TRUE
   ;ENDFOLD

   nHandle=Set_KrlMsg(#NOTIFY, Msg, Par[], Opt)

END
