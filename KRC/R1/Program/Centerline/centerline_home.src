&ACCESS RVO
&REL 1
&COMMENT 03-10-R1 PNW1 MANUAL HOME
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CENTERLINE_HOME()
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - CENTERLINE PEDESTAL HOME
;********************************
; MANUAL SERVICE PROGRAM - NOT CALLED BY THE CYCLE
; HOMES THE CENTERLINE PEDESTAL, NO ROBOT MOTION: OUTPUTS OFF, LOWER PIN RETURN, QFP RETURN,
; UPPER PIN RETRACT, GUN OPEN, PART CLAMP OPEN. TIMED STEPS - ONLY THE QFP RETURN IS
; CONFIRMED BY A SWITCH. NO INTERLOCKS: RUN IT ONLY WITH ROBOT AND PEOPLE CLEAR OF THE PEDESTAL.
;NOTE: PEDESTAL REFERENCE VALUES AND PRESSURE TABLE: SEE CENTERLINE_WELD (centerline_weld.src)
;CHECK: $OUT[473] dopw1_Nut1Intensify_Home IS SWITCHED OFF HERE BUT IS ON AT REST IN
;  CENTERLINE_WELD (POLARITY TO CONFIRM); THE BOSCH HANDSHAKE ($OUT[481..483]) AND THE
;  WELD PROGRAM NUMBER ARE NOT RESET HERE (F34)
;NOTE: $OUT[475] dopw1_StartWater IS SWITCHED BACK ON BY sps.sub IN THE NEXT SUBMIT CYCLE
;  OUTSIDE DRY CYCLE (F09)
;WARNING: WHILE A PRELOAD IS ACTIVE (NUTCYCLE_ACTIVE), PRELOAD() IN THE SUBMIT INTERPRETER
;  REWRITES THE SAME OUTPUTS EVERY CYCLE - THIS PROGRAM DOES NOT CHECK IT (F11)
;********************************

;GUN GENERAL PRESSURE - SIGNALS $OUT[506..521] CL_GunPressureCmd = CL_GUN_PRESS_BASE (F44)
CL_GunPressureCmd=CL_GUN_PRESS_BASE


;OUTPUTS OFF - SIGNALS $OUT[473] dopw1_Nut1Intensify_Home OFF, $OUT[475] dopw1_StartWater OFF,
;  $OUT[476] dopw1_StartFeed OFF
dopw1_Nut1Intensify_Home=FALSE
dopw1_StartWater=FALSE
dopw1_StartFeed=FALSE
;OUTPUTS OFF - SIGNALS $OUT[494] dopw1_BlowOff OFF, $OUT[505] do505QFPNutBlowOff OFF,
;  $OUT[500] do500Reserved (UNKNOWN - ONLY EVER SWITCHED OFF) OFF
dopw1_BlowOff=FALSE
do500Reserved=FALSE
do505QFPNutBlowOff=FALSE

;LOWER PIN RETURN (DOWN) - SIGNALS $OUT[495] dopw1_AdvancePin OFF, WAIT 0.2 S,
;  $OUT[496] dopw1_ReturnPin ON, WAIT 1 S
dopw1_AdvancePin=FALSE
WAIT SEC 0.2
dopw1_ReturnPin=TRUE
WAIT SEC 1.0

;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, WAIT 0.2 S,
;  $OUT[504] do504QFPReturn ON
do503QFPAdvance=FALSE
WAIT SEC 0.2
do504QFPReturn=TRUE
;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON, THEN 0.5 S
WAIT FOR dipw1_SpearHome
WAIT SEC 0.5

;UPPER (WELD) PIN RETRACT - SIGNALS $OUT[498] do498UpperPinExtend OFF, WAIT 0.2 S,
;  $OUT[499] do499UpperPinRetract ON, WAIT 1 S
do498UpperPinExtend=FALSE
WAIT SEC 0.2
do499UpperPinRetract=TRUE
WAIT SEC 1.0

;GUN OPEN - SIGNALS $OUT[472] dopw1_GunWork OFF, WAIT 0.2 S, $OUT[471] dopw1_GunHome ON,
;  WAIT 1.5 S (GUN STROKE LPT NOT CHECKED)
dopw1_GunWork=FALSE
WAIT SEC 0.2
dopw1_GunHome=TRUE
WAIT SEC 1.5

;PART CLAMP OPEN - SIGNALS $OUT[501] do501PartClampClose OFF, WAIT 0.2 S,
;  $OUT[502] do502PartClampOpen ON, WAIT 1 S - $IN[466] di466PartClampOpen NOT CHECKED
do501PartClampClose=FALSE
WAIT SEC 0.2
do502PartClampOpen=TRUE
WAIT SEC 1.0

END