&ACCESS RVO
&REL 1
&COMMENT 03-10-R1 PNW1 MANUAL HOME
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CENTERLINE_HOME()
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - CENTERLINE PEDESTAL HOME
;********************************
; MANUAL SERVICE PROGRAM (NOT USED IN THE CYCLE): PEDESTAL TO HOME POSITION.
; RUN ONLY WITH THE ROBOT AND PEOPLE CLEAR OF THE PEDESTAL.
;********************************

;GUN GENERAL PRESSURE
CL_GunPressureCmd=CL_GUN_PRESS_BASE


;OUTPUTS OFF
dopw1_Nut1Intensify_Home=FALSE
dopw1_StartWater=FALSE
dopw1_StartFeed=FALSE
;BLOW-OFF OUTPUTS OFF
dopw1_BlowOff=FALSE
do500Reserved=FALSE
do505QFPNutBlowOff=FALSE

;LOWER PIN DOWN
dopw1_AdvancePin=FALSE
WAIT SEC 0.2
dopw1_ReturnPin=TRUE
WAIT SEC 1.0

;QFP RETURN
do503QFPAdvance=FALSE
WAIT SEC 0.2
do504QFPReturn=TRUE
;WAIT QFP RETURNED
WAIT FOR dipw1_SpearHome
WAIT SEC 0.5

;UPPER PIN RETRACT
do498UpperPinExtend=FALSE
WAIT SEC 0.2
do499UpperPinRetract=TRUE
WAIT SEC 1.0

;GUN OPEN
dopw1_GunWork=FALSE
WAIT SEC 0.2
dopw1_GunHome=TRUE
WAIT SEC 1.5

;PART CLAMP OPEN
do501PartClampClose=FALSE
WAIT SEC 0.2
do502PartClampOpen=TRUE
WAIT SEC 1.0

END