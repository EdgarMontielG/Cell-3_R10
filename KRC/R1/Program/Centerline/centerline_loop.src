&ACCESS RVP
&REL 1
&COMMENT 03-10-R1 PNW1 TEST LOOP
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CENTERLINE_LOOP()
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - MANUAL TEST ONLY - ENDLESS PEDESTAL VALVE CYCLE, NO EXIT, NO INTERLOCKS
;********************************
; NOT CALLED BY ANY PROGRAM. CYCLES THE CENTERLINE PEDESTAL VALVES IN AN ENDLESS LOOP
; (NO NUT FEED, NO WELD). THE ONLY WAY OUT IS TO STOP AND CANCEL THE PROGRAM.
;WARNING: CLOSES THE GUN AND THE PART CLAMP WITH NO PART OR ROBOT INTERLOCK -
;  NEVER RUN IT WITH A PART OR A PERSON AT THE PEDESTAL
;NOTE: WHEN CANCELLED, THE PEDESTAL STAYS AS LAST WRITTEN (GUN OR CLAMP MAY BE LEFT CLOSED);
;  THE PRODUCTION CYCLE DOES NOT CHECK IT BEFORE THE ROBOT ENTERS THE PEDESTAL (F01, F10)
;NOTE: PRELOAD() IN THE SUBMIT INTERPRETER MAY REWRITE THE SAME OUTPUTS (F11)
;NOTE: PEDESTAL REFERENCE VALUES AND PRESSURE TABLE: SEE CENTERLINE_WELD (centerline_weld.src)
;********************************

;GUN GENERAL PRESSURE - SIGNALS $OUT[506..521] CL_GunPressureCmd = 405 (BYTE ORDER: F44)
CL_GunPressureCmd=405


;ENDLESS LOOP - NO EXIT
LOOP

;START POSITION
;GUN OPEN - SIGNALS $OUT[472] dopw1_GunWork OFF, $OUT[471] dopw1_GunHome ON
$OUT[472]=FALSE
$OUT[471]=TRUE
;UPPER PIN RETRACT - SIGNALS $OUT[498] (UPPER PIN EXTEND VALVE) OFF,
;  $OUT[499] (UPPER PIN RETRACT VALVE) ON
$OUT[498]=FALSE
$OUT[499]=TRUE
;PART CLAMP OPEN - SIGNALS $OUT[501] (PART CLAMP CLOSE VALVE) OFF,
;  $OUT[502] (PART CLAMP OPEN VALVE) ON
$OUT[501]=FALSE
$OUT[502]=TRUE
;LOWER PIN RETURN - SIGNALS $OUT[495] dopw1_AdvancePin OFF, $OUT[496] dopw1_ReturnPin ON
$OUT[495]=FALSE
$OUT[496]=TRUE
;QFP RETURN - SIGNALS $OUT[503] (QFP ADVANCE VALVE) OFF, $OUT[504] (QFP RETURN VALVE) ON
$OUT[503]=FALSE
$OUT[504]=TRUE
;OUTPUTS OFF - SIGNALS $OUT[494] dopw1_BlowOff OFF,
;  $OUT[500] (UNKNOWN - ONLY EVER SWITCHED OFF) OFF, $OUT[505] (QFP NUT BLOW-OFF VALVE) OFF,
;  $OUT[473] dopw1_Nut1Intensify_Home OFF
$OUT[494]=FALSE
$OUT[500]=FALSE
$OUT[505]=FALSE
$OUT[473]=FALSE

;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON, THEN 1 S
WAIT FOR $IN[482]
WAIT SEC 1.0

;QFP ADVANCE - SIGNALS $OUT[504] (QFP RETURN VALVE) OFF, WAIT 0.2 S,
;  $OUT[503] (QFP ADVANCE VALVE) ON
$OUT[504]=FALSE
WAIT SEC 0.2
$OUT[503]=TRUE
;WAIT QFP ADVANCED - SIGNAL $IN[470] (QFP ADVANCED SWITCH) ON, THEN 0.5 S
WAIT FOR $IN[470]
WAIT SEC 0.5

;LOWER PIN ADVANCE - SIGNALS $OUT[496] dopw1_ReturnPin OFF, WAIT 0.2 S,
;  $OUT[495] dopw1_AdvancePin ON
$OUT[496]=FALSE
WAIT SEC 0.2
$OUT[495]=TRUE
WAIT SEC 0.50

;QFP RETURN - SIGNALS $OUT[503] (QFP ADVANCE VALVE) OFF, WAIT 0.2 S,
;  $OUT[504] (QFP RETURN VALVE) ON
$OUT[503]=FALSE
WAIT SEC 0.2
$OUT[504]=TRUE
;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON, THEN 0.5 S
WAIT FOR $IN[482]
WAIT SEC 0.5

;UPPER PIN EXTEND - SIGNALS $OUT[499] (UPPER PIN RETRACT VALVE) OFF, WAIT 0.2 S,
;  $OUT[498] (UPPER PIN EXTEND VALVE) ON
$OUT[499]=FALSE
WAIT SEC 0.2
$OUT[498]=TRUE
WAIT SEC 0.5

;PART CLAMP CLOSE - SIGNALS $OUT[502] (PART CLAMP OPEN VALVE) OFF, WAIT 0.2 S,
;  $OUT[501] (PART CLAMP CLOSE VALVE) ON, TIMED - $IN[467] (PART CLAMP CLOSED SWITCH) NOT CHECKED
$OUT[502]=FALSE
WAIT SEC 0.2
$OUT[501]=TRUE
WAIT SEC 0.5

;GUN CLOSE - SIGNALS $OUT[471] dopw1_GunHome OFF, WAIT 0.2 S, $OUT[472] dopw1_GunWork ON
;  (TIMED, NO PART OR ROBOT INTERLOCK)
$OUT[471]=FALSE
WAIT SEC 0.2
$OUT[472]=TRUE
WAIT SEC 1.0

;LOWER PIN RETURN - SIGNALS $OUT[495] dopw1_AdvancePin OFF, WAIT 0.2 S,
;  $OUT[496] dopw1_ReturnPin ON
$OUT[495]=FALSE
WAIT SEC 0.2
$OUT[496]=TRUE
WAIT SEC 0.5

;GUN OPEN - SIGNALS $OUT[472] dopw1_GunWork OFF, WAIT 0.2 S, $OUT[471] dopw1_GunHome ON (TIMED)
$OUT[472]=FALSE
WAIT SEC 0.2
$OUT[471]=TRUE
WAIT SEC 1.0

;PART CLAMP OPEN - SIGNALS $OUT[501] (PART CLAMP CLOSE VALVE) OFF, WAIT 0.2 S,
;  $OUT[502] (PART CLAMP OPEN VALVE) ON (TIMED)
$OUT[501]=FALSE
WAIT SEC 0.2
$OUT[502]=TRUE
WAIT SEC 0.5

;UPPER PIN RETRACT - SIGNALS $OUT[498] (UPPER PIN EXTEND VALVE) OFF, WAIT 0.2 S,
;  $OUT[499] (UPPER PIN RETRACT VALVE) ON
$OUT[498]=FALSE
WAIT SEC 0.2
$OUT[499]=TRUE
WAIT SEC 1.0

;QFP RETURN AND LOWER PIN RETURN - SIGNALS $OUT[504] (QFP RETURN VALVE) ON,
;  $OUT[496] dopw1_ReturnPin ON
$OUT[504]=TRUE
$OUT[496]=TRUE

;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON, THEN 2 S, THEN START AGAIN
WAIT FOR $IN[482]
WAIT SEC 2.0

ENDLOOP
END