&ACCESS RVO5
DEFDAT  preload PUBLIC
;FOLD EXTERNAL DECLARATIONS;%{PE}%MKUKATPBASIS,%CEXT,%VCOMMON,%P
;FOLD BASISTECH EXT;%{PE}%MKUKATPBASIS,%CEXT,%VEXT,%P
EXT  BAS (BAS_COMMAND  :IN,REAL  :IN )
;ENDFOLD (BASISTECH EXT)
;FOLD USER EXT;%{E}%MKUKATPUSER,%CEXT,%VEXT,%P
;Make your modifications here

;ENDFOLD (USER EXT)
;ENDFOLD (EXTERNAL DECLARATIONS)

;2026-10-07 - PRE-FEED: TRUE = THE NEXT NUT IS ALREADY FED INTO THE QFP (PRELOAD STEP 30);
;THE NEXT PRELOAD SKIPS THE 2000 MS FEED OF STEP 0. FALSE WHEN THE QFP ADVANCES (NUT LEFT IT)
DECL GLOBAL BOOL QFP_NUT_LOADED=TRUE
;LOWER PIN DOWN BEFORE THE QFP ADVANCES (STEP 10) - 2026-10-09, WAS FIXED 1000 MS:
;  bPinDownSensor=FALSE: QFP ADVANCES AFTER nPinDownMs
;  bPinDownSensor=TRUE : QFP ADVANCES WHEN dipw1_PinReturn $IN[478] CONFIRMS PIN DOWN,
;                        AT MOST nPinDownMaxMs (THEN CONTINUES AS BEFORE)
DECL GLOBAL INT nPinDownMs=200
DECL GLOBAL INT nPinDownMaxMs=1000
DECL GLOBAL BOOL bPinDownSensor=FALSE
;QFP HELD ADVANCED WHILE THE LOWER PIN GOES UP THROUGH THE NUT (STEPS 10/20) - 2026-10-09, WAS 800 MS.
;  IF THE NUT DOES NOT STAY ON THE PIN / COMES BACK WITH THE QFP: RAISE IT (800 = ORIGINAL)
DECL GLOBAL INT nPinUpMs=300
;QFP HELD RETURNED AFTER EVERY NUT FEED (STEPS 0 AND 30) BEFORE IT CAN ADVANCE - 2026-10-10, USER: THE FEEDER BLOWS
;  UP TO 5 S, THE SLIDE ADVANCED BEFORE THE NUT ARRIVED. 0 = AS 20R1. RAISE IT (E.G. 3000) IF NUTS ARE STILL MISSING
DECL GLOBAL INT nFeedSettleMs=3000
ENDDAT