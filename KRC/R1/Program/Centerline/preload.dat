&ACCESS  RV
&COMMENT 03-10-R1 PNW1 NUT PRELOAD
&PARAM DISKPATH = Program/Centerline
DEFDAT  preload PUBLIC
;FOLD EXTERNAL DECLARATIONS;%{PE}%MKUKATPBASIS,%CEXT,%VCOMMON,%P
;FOLD BASISTECH EXT;%{PE}%MKUKATPBASIS,%CEXT,%VEXT,%P
EXT  BAS (BAS_COMMAND  :IN,REAL  :IN )
;ENDFOLD (BASISTECH EXT)
;FOLD USER EXT;%{E}%MKUKATPUSER,%CEXT,%VEXT,%P
;Make your modifications here

;ENDFOLD (USER EXT)
;ENDFOLD (EXTERNAL DECLARATIONS)

;TRUE = NEXT NUT ALREADY FED INTO THE QFP
DECL GLOBAL BOOL QFP_NUT_LOADED=TRUE
;LOWER PIN DOWN BEFORE THE QFP ADVANCES: BY TIME (nPinDownMs) OR BY SENSOR (bPinDownSensor)
DECL GLOBAL INT nPinDownMs=200
DECL GLOBAL INT nPinDownMaxMs=1000
DECL GLOBAL BOOL bPinDownSensor=FALSE
;QFP HELD ADVANCED WHILE THE LOWER PIN GOES UP THROUGH THE NUT. RAISE IT IF THE NUT DOES NOT STAY ON THE PIN
DECL GLOBAL INT nPinUpMs=300
ENDDAT