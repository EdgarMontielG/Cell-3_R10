&ACCESS RVO1
&REL 38
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CENTERLINE_WELD()


;UPPER PIN RETRACT =  27252      RANGE 26000 - 28000
;UPPER PIN EXTENDED = 6602       RANGE 6500- 7000
;UPPER PIN WELD POSITION = 11674 RANGE 10000 - 13500


;GUN RETRACT = 139815            RANGE 137000 - 142000
;GUN EXTENDED = 61450            RANGE 60000 - 63000
;GUN WELD POSITION = 70915       RANGE 65000 - 76000


;FORMULA CMD = (MPa / 0.9) * 4095

;PRESSURE 455   0.10MPa    14.50 PSI
;PRESSURE 910   0.20MPa    29.01 PSI
;PRESSURE 1365  0.30MPa    43.51 PSI
;PRESSURE 1820  0.40MPa    58.02 PSI
;PRESSURE 2275  0.50MPa    72.52 PSI      
;PRESSURE 2503  0.55MPa    79.77 PSI     
;PRESSURE 2730  0.60MPa    87.02 PSI     

;HOME

;dopw1_GUNHOME/VALVE2 OPEN 
$OUT[472]=FALSE 
$OUT[471]=TRUE

;CL_WeldPinExtend / UPPER PIN EXTEND
$OUT[498]=FALSE
$OUT[499]=TRUE

;CL_PartClampOpen
$OUT[501]=FALSE
$OUT[502]=TRUE
;CL_PartClampOpen/CLMP OPEN
WAIT FOR $IN[466]

;CL_LowerPinExtend
$OUT[496]=FALSE
$OUT[495]=TRUE

;CL_QFPReturn / NUT FEED SLIDE RETURN
$OUT[503]=FALSE
$OUT[504]=TRUE
;CL_QFPReturned/QFP RET
WAIT FOR $IN[482]

 IF NUT_READY THEN
      GOTO NUT_READY
   ENDIF

;LOWER PIN FORWARD
$OUT[496]=FALSE
$OUT[495]=TRUE
$OUT[494]=TRUE

;QFP ADVANCE
$OUT[504]=FALSE
$OUT[503]=TRUE
;CL_QFPAdvanced / QFP ADV
WAIT FOR $IN[470]

;FEED NUT
dopw1_StartFeed=TRUE
;WAIT FOR dipw1_FeedComplt
dopw1_StartFeed=FALSE
WAIT SEC 1.5
$OUT[494]=FALSE

;QFP HOME
$OUT[503]=FALSE
$OUT[504]=TRUE
;CL_QFPReturned/QFP RET
WAIT FOR $IN[482]

;UPPER PIN FORWARD
$OUT[499]=FALSE
$OUT[498]=TRUE

NUT_READY:

;UPPER PIN FORWARD
$OUT[499]=FALSE
$OUT[498]=TRUE

;PRESSURE GENERAL
CL_GunPressureCmd=405

;RESET
dopw1_WeldInit=FALSE
dopw1_WeldContactEnable=FALSE
dopw1_WeldOnExternal=FALSE
gdopw1_SpotNumber=0
dopw1_StartFeed=FALSE
dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE
CL_GunPressureCmd=405
;ENABLE BOSCH
dopw1_WeldContactEnable=TRUE
dopw1_WeldOnExternal=TRUE

WAIT FOR dipw1_Ready


;CL_PartClampClose
$OUT[502]=FALSE
$OUT[501]=TRUE
;CL_PartClampClosed/CLMP CLOSE
WAIT FOR $IN[467]

;GUN CLOSE
$OUT[471]=FALSE
WAIT SEC 0.2
$OUT[472]=TRUE

;QUITAR AIRE LOWER PIN
$OUT[495]=FALSE
$OUT[496]=FALSE

   $TIMER_STOP[14]=TRUE
   $TIMER[14]=0
   $TIMER_STOP[14]=FALSE
   
   $TIMER_STOP[15]=TRUE
   $TIMER[15]=0
   $TIMER_STOP[15]=FALSE
   
   CHECK_GUN_CLOSED:

;CONFIRMAR GUN CERRADA
IF (CL_GunStrokePositionLPT>=69000) AND (CL_GunStrokePositionLPT<=73000) THEN
IF $TIMER[15]>=300 THEN
   $TIMER_STOP[14]=TRUE
   $TIMER[14]=0
   $TIMER_STOP[15]=TRUE
   $TIMER[15]=0
   
   GOTO GUN_CLOSED_OK  
ELSE
   GOTO CHECK_GUN_CLOSED
ENDIF
   
ELSE
   $TIMER_STOP[15]=TRUE
   $TIMER[15]=0
   $TIMER_STOP[15]=FALSE


IF $TIMER[14]>=1000 THEN
   $TIMER_STOP[14]=TRUE
   $TIMER[14]=0
   $TIMER_STOP[15]=TRUE
   $TIMER[15]=0
   NUT_READY=FALSE
   
   HALT
   
   GOTO CHECK_GUN_CLOSED

ELSE

   GOTO CHECK_GUN_CLOSED
   
ENDIF
ENDIF

   GUN_CLOSED_OK:

;dopw1_WeldOnExternal
dopw1_WeldOnExternal=TRUE

;SCHEDULE 7
gdopw1_SpotNumber=2

;BOSCH READY
WAIT FOR dipw1_Ready

;INTENSIFICADO
CL_GunPressureCmd=1820

dopw1_BlowOff=TRUE
dopw1_Nut1Intensify_Home=FALSE
dopw1_Nut1Intensify=TRUE

WAIT FOR dipw1_IntensfPresOk

;CONFIRMAR GUN ANTES DE SOLDAR
WAIT FOR (CL_GunStrokePositionLPT>=69000) AND (CL_GunStrokePositionLPT<=73000)

;WELD
dopw1_WeldInit=TRUE

WAIT FOR dipw1_WeldComplete

dopw1_WeldInit=FALSE
WAIT FOR NOT dipw1_WeldComplete

;QUITAR INTENSIFICADO
dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE

;PRESSURE GENERAL
CL_GunPressureCmd=405

;QUITAR SCHEDULE
gdopw1_SpotNumber=0

WELD_END:

$TIMER_STOP[14]=TRUE
$TIMER[14]=0

;GUN OPEN
$OUT[472]=FALSE
WAIT SEC 0.2
$OUT[471]=TRUE

WAIT FOR (CL_GunStrokePositionLPT>120000)
WAIT SEC 0.2

;UPPER PIN RETURN
$OUT[498]=FALSE
$OUT[499]=TRUE

;CL_PartClampOpen
$OUT[501]=FALSE
$OUT[502]=TRUE
;CL_PartClampOpen/CLMP OPEN
WAIT FOR $IN[466]

;LOWER PIN RETURN
$OUT[496]=FALSE
$OUT[495]=TRUE

;CL_QFPReturn / NUT FEED SLIDE RETURN
$OUT[503]=FALSE
$OUT[504]=TRUE
;CL_QFPReturned/QFP RET
WAIT FOR $IN[482]

;RESET FINAL
dopw1_StartFeed=FALSE
dopw1_WeldInit=FALSE
gdopw1_SpotNumber=0

dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE
CL_GunPressureCmd=39425

dopw1_WeldContactEnable=FALSE
dopw1_WeldOnExternal=FALSE

END