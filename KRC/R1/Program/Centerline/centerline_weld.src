&ACCESS RVO1
&REL 38
&COMMENT 03-10-R1 PNW1 NUT WELD
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CENTERLINE_WELD()
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - NUT WELD AT CENTERLINE PEDESTAL (ALL 3 NUTS)
;********************************
; NUT WELD WITH THE PART AT THE WELD POSITION: UPPER PIN, PART CLAMP, GUN CLOSE,
; INTENSIFY, WELD, GUN OPEN, CLAMP OPEN. SETTINGS IN $config.dat (CENTERLINE CONTROL)
;********************************

;PEDESTAL REFERENCE VALUES (INFORMATION ONLY)
;UPPER PIN CL_WeldPinPosition:
;  RETRACT        27332   RANGE 26000 - 28000
;  EXTENDED        6694   RANGE  6500 -  7000
;  WELD POSITION  11624   RANGE 11000 - 12200

;GUN STROKE CL_GunStrokePositionLPT:
;  RETRACT       139815   RANGE 137000 - 142000
;  EXTENDED       61450   RANGE  60000 -  63000
;  WELD POSITION  70915   RANGE  69000 -  73000

;ITV PRESSURE CL_GunPressureCmd: CMD = (MPa / 0.9) * 4095
;PRESSURE 455   0.10MPa    14.50 PSI
;PRESSURE 910   0.20MPa    29.01 PSI
;PRESSURE 1365  0.30MPa    43.51 PSI
;PRESSURE 1820  0.40MPa    58.02 PSI  (CL_GUN_PRESS_WELD)
;PRESSURE 2275  0.50MPa    72.52 PSI
;PRESSURE 2503  0.55MPa    79.77 PSI
;PRESSURE 2730  0.60MPa    87.02 PSI

;CYCLE TIME MEASUREMENT
CT_WELD_START()
;CLEAR NUT RETRY FLAG
NUT_WELD_RETRY=FALSE

;PEDESTAL START POSITION (NOT A FULL HOME: THE LOWER PIN IS ADVANCED)

;GUN OPEN
dopw1_GunWork=FALSE
dopw1_GunHome=TRUE

;UPPER PIN RETRACT
do498UpperPinExtend=FALSE
do499UpperPinRetract=TRUE

;PART CLAMP OPEN
do501PartClampClose=FALSE
do502PartClampOpen=TRUE
;WAIT PART CLAMP OPEN
WAIT FOR di466PartClampOpen

;LOWER PIN: UP WITH A PRELOADED NUT, ELSE DOWN FOR THE QFP
IF NUT_READY THEN
   ;NUT ON THE PIN: BLOW-OFF OFF
   dopw1_BlowOff=FALSE
   dopw1_ReturnPin=FALSE
   dopw1_AdvancePin=TRUE
ELSE
   ;LOWER PIN DOWN
   dopw1_AdvancePin=FALSE
   dopw1_ReturnPin=TRUE
   dopw1_BlowOff=TRUE
ENDIF

;QFP RETURN
do503QFPAdvance=FALSE
do504QFPReturn=TRUE
;WAIT QFP RETURNED
WAIT FOR dipw1_SpearHome

;NUT FEED (ONLY IF NO NUT WAS PRELOADED)
IF NOT NUT_READY THEN
   ;QFP ADVANCE
   WAIT SEC 1.0
   do504QFPReturn=FALSE
   do503QFPAdvance=TRUE
   ;WAIT QFP ADVANCED
   WAIT FOR di470QFPAdvanced
   ;NUT LEFT THE QFP
   QFP_NUT_LOADED=FALSE

   ;LOWER PIN UP (HIGH PRESSURE)
   dopw1_Nut1Intensify_Home=FALSE
   dopw1_BlowOff=FALSE
   dopw1_ReturnPin=FALSE
   dopw1_AdvancePin=TRUE

   ;FEED NUT
   dopw1_StartFeed=TRUE
   dopw1_StartFeed=FALSE
   WAIT SEC 1.5
   ;BLOW-OFF OFF
   dopw1_BlowOff=FALSE

   ;QFP RETURN
   do503QFPAdvance=FALSE
   do504QFPReturn=TRUE
   ;WAIT QFP RETURNED
   WAIT FOR dipw1_SpearHome
   dopw1_Nut1Intensify_Home=TRUE   ;LOW PRESSURE AGAIN
ENDIF

;UPPER PIN EXTEND
do499UpperPinRetract=FALSE
do498UpperPinExtend=TRUE

;GUN GENERAL PRESSURE
CL_GunPressureCmd=CL_GUN_PRESS_BASE

;RESET WELD CONTROLLER HANDSHAKE
dopw1_WeldInit=FALSE
gdopw1_SpotNumber=0
;RESET PEDESTAL OUTPUTS
IF NOT NUTCYCLE_ACTIVE THEN
   dopw1_StartFeed=FALSE
ENDIF
dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE
;GUN GENERAL PRESSURE
CL_GunPressureCmd=CL_GUN_PRESS_BASE

;WAIT UPPER PIN SEATED IN THE PART BEFORE THE CLAMP CLOSES
PIN_SETTLE_WAIT()

;PART CLAMP CLOSE
do502PartClampOpen=FALSE
do501PartClampClose=TRUE
;WAIT PART CLAMP CLOSED
WAIT FOR di467PartClampClosed

;GUN CLOSE
dopw1_GunHome=FALSE
dopw1_GunWork=TRUE

;LOWER PIN VALVES OFF
dopw1_AdvancePin=FALSE
dopw1_ReturnPin=FALSE

;CONFIRM GUN CLOSED IN THE WELD RANGE ($TIMER[14] TIMEOUT, $TIMER[15] TIME IN RANGE)
$TIMER_STOP[14]=TRUE
$TIMER[14]=0
$TIMER_STOP[14]=FALSE
$TIMER_STOP[15]=TRUE
$TIMER[15]=0
$TIMER_STOP[15]=FALSE

LOOP
   IF (CL_GunStrokePositionLPT>=CL_GUN_WELD_MIN) AND (CL_GunStrokePositionLPT<=CL_GUN_WELD_MAX) THEN
      ;IN THE WINDOW LONG ENOUGH: GUN CLOSED ON THE NUT
      IF $TIMER[15]>=CL_GUN_IN_WINDOW_TIME THEN
         EXIT
      ENDIF
   ELSE
      ;OUT OF THE WINDOW: RESTART THE TIME IN THE WINDOW
      $TIMER_STOP[15]=TRUE
      $TIMER[15]=0
      $TIMER_STOP[15]=FALSE

      ;TIMEOUT: NUT_READY=FALSE AND HALT
      IF $TIMER[14]>=CL_GUN_CLOSE_TIMEOUT THEN
         $TIMER_STOP[14]=TRUE
         $TIMER[14]=0
         $TIMER_STOP[15]=TRUE
         $TIMER[15]=0
         NUT_READY=FALSE
         ;NO NUT (GUN CLOSED TOO FAR): NO WELD, FEED A NEW NUT AND TRY AGAIN
         IF (CL_GunStrokePositionLPT<CL_GUN_WELD_MIN) AND (nNutRetryCnt<nNutRetryMax) THEN
            nNutRetryCnt=nNutRetryCnt+1
            nNutRetryTotal=nNutRetryTotal+1
            nNutRetryLast=nCtNut
            NUT_WELD_RETRY=TRUE
            NUT_RETRY_MSG()
            EXIT
         ENDIF
         ;GUN NOT CLOSED OK: RED LIGHT AND MESSAGE
         GUN_CLOSE_FAULT()
         HALT
         ;AFTER RESTART: CHECK THE GUN AGAIN
         $TIMER_STOP[14]=FALSE
         $TIMER_STOP[15]=FALSE
      ENDIF
   ENDIF
ENDLOOP

;GUN CLOSED: STOP AND CLEAR BOTH TIMERS
$TIMER_STOP[14]=TRUE
$TIMER[14]=0
$TIMER_STOP[15]=TRUE
$TIMER[15]=0

;WELD (SKIPPED ON A NUT RETRY)
IF NOT NUT_WELD_RETRY THEN
nNutRetryCnt=0   ;NUT FOUND (GUN IN THE WELD WINDOW): RETRY COUNTER BACK TO 0

;SELECT WELD PROGRAM
gdopw1_SpotNumber=CL_WELD_PROGRAM

;WAIT WELD CONTROLLER READY
WAIT FOR dipw1_Ready

;WELD PRESSURE
CL_GunPressureCmd=CL_GUN_PRESS_WELD

;INTENSIFY
dopw1_BlowOff=TRUE
dopw1_Nut1Intensify_Home=FALSE
dopw1_Nut1Intensify=TRUE

;WAIT INTENSIFY PRESSURE OK
WAIT FOR dipw1_IntensfPresOk

;CONFIRM GUN POSITION BEFORE WELDING - WAIT CL_GunStrokePositionLPT IN CL_GUN_WELD_MIN..MAX
WAIT FOR (CL_GunStrokePositionLPT>=CL_GUN_WELD_MIN) AND (CL_GunStrokePositionLPT<=CL_GUN_WELD_MAX)

;CHECK UPPER PIN IN WELD POSITION (PART SEATED)
PIN_WELD_CHECK()

;WELD
dopw1_WeldInit=TRUE

;WAIT WELD COMPLETE (WELD FAULT = RED LIGHT AND MESSAGE)
WELD_COMPLETE_WAIT()

;WELD START OFF
dopw1_WeldInit=FALSE
WAIT FOR NOT dipw1_WeldComplete

;RELEASE INTENSIFY
dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE

;GUN GENERAL PRESSURE
CL_GunPressureCmd=CL_GUN_PRESS_BASE

;CLEAR WELD PROGRAM
gdopw1_SpotNumber=0

;STOP THE GUN-CLOSED TIMER $TIMER[14]
$TIMER_STOP[14]=TRUE
$TIMER[14]=0

ENDIF   ;NOT NUT_WELD_RETRY

;GUN OPEN
dopw1_GunWork=FALSE
;UPPER PIN RETRACT
do498UpperPinExtend=FALSE
do499UpperPinRetract=TRUE
;GUN HOME
WAIT SEC 0.2
dopw1_GunHome=TRUE

;CHECK GUN OPEN BEFORE THE ROBOT LEAVES
GUN_OPEN_CHECK()


;PART CLAMP OPEN
do501PartClampClose=FALSE
do502PartClampOpen=TRUE
;WAIT PART CLAMP OPEN
WAIT FOR di466PartClampOpen

;LOWER PIN UP
dopw1_ReturnPin=FALSE
dopw1_AdvancePin=TRUE

;QFP RETURN
do503QFPAdvance=FALSE
do504QFPReturn=TRUE
;WAIT QFP RETURNED
WAIT FOR dipw1_SpearHome

;FINAL RESET
IF NOT NUTCYCLE_ACTIVE THEN
   dopw1_StartFeed=FALSE
ENDIF
dopw1_WeldInit=FALSE
gdopw1_SpotNumber=0

;INTENSIFY OFF
dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE
;REST PRESSURE
CL_GunPressureCmd=CL_GUN_PRESS_REST


;CYCLE TIME MEASUREMENT
CT_WELD_END()

END