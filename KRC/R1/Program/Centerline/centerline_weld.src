&ACCESS RVO1
&REL 38
&COMMENT 03-10-R1 PNW1 NUT WELD
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CENTERLINE_WELD()
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - NUT WELD AT CENTERLINE PEDESTAL (ALL 3 NUTS)
;********************************
; PRODUCTION NUT WELD, CALLED BY style1app1opt1A..3B OUTSIDE DRY CYCLE WITH THE PART ALREADY
; AT THE WELD POSITION (NO ROBOT MOTION HERE): PEDESTAL START POSITION, UPPER PIN EXTEND,
; PART CLAMP CLOSE, GUN CLOSE, GUN STROKE CHECK (LPT), INTENSIFY, BOSCH WELD; THEN GUN
; OPEN, UPPER PIN RETRACT, PART CLAMP OPEN, LOWER PIN ADVANCE, QFP RETURN.
;2026-10-07: WITH NO PRELOADED NUT, LOWER PIN DOWN (494 BLOW-OFF + 496 RETURN ON, 495 OFF) 1 S BEFORE THE
;  QFP ADVANCES, UP ONLY WITH THE QFP ADVANCED (AS THE OLD PROGRAM). PRELOAD LOWERS THE PIN THE SAME WAY
;  BEFORE ITS QFP ADVANCE; THE PIN STAYS UP AT THE END OF THE WELD AS BEFORE (F27 COMMENT CORRECTED).
;  WITH THE NUT ON THE PIN: 495 ON, 494 OFF (THE 494 AIR CAN PUSH THE NUT OUT OF POSITION).
;2026-10-08 CYCLE TIME: THE BOSCH ENABLE IS NO LONGER SWITCHED OFF/ON AT EVERY NUT (SPS.SUB KEEPS IT ON
;  OUTSIDE DRY CYCLE), ONE dipw1_Ready WAIT PER NUT, WAIT SEC 0.2 REMOVED AT GUN CLOSE, GUN OPEN AND
;  AFTER GUN_OPEN_CHECK.
;WARNING: PEDESTAL ENTRY IS ONLY PARTLY CONFIRMED. THE CALLER CHECKS GUN OPEN (GUN_OPEN_CHECK) AND
;  MONITORS IT WITH INTERRUPTS 20-22; CLAMP OPEN AND QFP RETURNED ARE CHECKED BELOW ONLY AFTER THE
;  ROBOT IS ALREADY AT THE WELD POSITION (F01)
;NOTE: THE NUT IS NORMALLY PRELOADED BY PRELOAD() IN THE SUBMIT INTERPRETER (NUT_READY TRUE);
;  PRELOAD DRIVES THE SAME PEDESTAL VALVES, WITH NO OWNERSHIP BETWEEN THE TWO (F11)
;NOTE: NO WATER FLOW CHECK BEFORE THE WELD (F09), NO FAULT CHECK AFTER THE WELD (F08),
;  NO TIMEOUT OR MESSAGE ON THE WAITS (F15), PIN POSITIONS NOT VERIFIED (F16)
;NOTE: NUT_READY IS NOT CLEARED WHEN THE NUT IS WELDED (F14)
;NOTE: NOTHING PUTS THE PEDESTAL IN A SAFE STATE IF THIS PROGRAM IS CANCELLED (F10)
;NOTE: USES $TIMER[14] (GUN-CLOSED TIMEOUT) AND $TIMER[15] (TIME IN THE WINDOW) (F26)
;NOTE: LIMITS, PRESSURE WORDS AND WELD PROGRAM ARE CONSTANTS IN $config.dat (FOLD CENTERLINE CONTROL)
;********************************

;PEDESTAL REFERENCE VALUES - INFORMATION ONLY
;UPPER PIN POSITION CL_WeldPinPosition ($IN[591..606]) - READ ON THE PENDANT 2026-10-05:
;UPPER PIN RETRACT =  27332      RANGE 26000 - 28000  (CHECKED: PEDESTAL_CLEAR_CHECK, bPinCheck)
;UPPER PIN EXTENDED = 6694       RANGE 6500 - 7000    (NO PART)
;UPPER PIN WELD POSITION = 11542 NO NUT, 11624 / 11648 WITH NUT
;                                RANGE 11000 - 12200  (CHECKED: PIN_WELD_CHECK, bPinWeldCheck)

;GUN STROKE CL_GunStrokePositionLPT ($IN[559..590], LPT):
;GUN RETRACT = 139815            RANGE 137000 - 142000  (CHECKED: GUN_OPEN_CHECK, nGunOpenMin..MAX)
;GUN EXTENDED = 61450            RANGE 60000 - 63000
;GUN WELD POSITION = 70915       RANGE 65000 - 76000    (CHECKED: CL_GUN_WELD_MIN..MAX = 69000..73000)

;ITV PRESSURE SET-POINT CL_GunPressureCmd ($OUT[506..521]):
;FORMULA CMD = (MPa / 0.9) * 4095
;CHECK: THIS TABLE IS NOT BYTE-SWAPPED. KRC_IO.xml SENDS THE WORD TO THE REGULATOR BYTE-SWAPPED,
;CHECK: AS ON R20 (THERE 0.30 MPa IS WRITTEN 21765). THIS PROGRAM WRITES CL_GUN_PRESS_BASE = 405 AND
;CHECK: CL_GUN_PRESS_WELD = 1820 (NOT SWAPPED) AND CL_GUN_PRESS_REST = 39425 AT THE END (SWAPPED
;CHECK: 0.09 MPa) - CONFIRM WHICH IS RIGHT ON THE ITV (F44)
;PRESSURE 455   0.10MPa    14.50 PSI
;PRESSURE 910   0.20MPa    29.01 PSI
;PRESSURE 1365  0.30MPa    43.51 PSI
;PRESSURE 1820  0.40MPa    58.02 PSI  (CL_GUN_PRESS_WELD)
;PRESSURE 2275  0.50MPa    72.52 PSI
;PRESSURE 2503  0.55MPa    79.77 PSI
;PRESSURE 2730  0.60MPa    87.02 PSI
;CL_GUN_PRESS_BASE = 405 = 0.089 MPa IF NOT SWAPPED

;CYCLE TIME MEASUREMENT: ROBOT AT THE WELD POSITION (GUN_OPEN_CHECK.SRC, 2026-10-09)
CT_WELD_START()
;NUT RETRY FLAG CLEARED AT EVERY CALL (2026-10-10): SET AGAIN ONLY BY A NO NUT FOUND BELOW - A FLAG LEFT TRUE BY A
;  CANCELLED PROGRAM CAN NEVER SKIP A WELD
NUT_WELD_RETRY=FALSE

;PEDESTAL START POSITION (NOT A FULL HOME: THE LOWER PIN IS ADVANCED)

;GUN OPEN - SIGNALS $OUT[472] dopw1_GunWork OFF, $OUT[471] dopw1_GunHome ON
dopw1_GunWork=FALSE
dopw1_GunHome=TRUE

;UPPER PIN RETRACT - SIGNALS $OUT[498] do498UpperPinExtend OFF, $OUT[499] do499UpperPinRetract ON
;CHECK: OLD COMMENT SAID UPPER PIN EXTEND; THE CODE RETRACTS THE UPPER PIN HERE (F27)
do498UpperPinExtend=FALSE
do499UpperPinRetract=TRUE

;PART CLAMP OPEN - SIGNALS $OUT[501] do501PartClampClose OFF, $OUT[502] do502PartClampOpen ON
do501PartClampClose=FALSE
do502PartClampOpen=TRUE
;WAIT PART CLAMP OPEN - SIGNAL $IN[466] di466PartClampOpen ON
WAIT FOR di466PartClampOpen

;LOWER PIN - UP ONLY WITH A PRELOADED NUT ON IT (NUT_READY), ELSE DOWN SO THE QFP CAN ADVANCE
;  (2026-10-07) - SIGNALS $OUT[495] dopw1_AdvancePin / $OUT[496] dopw1_ReturnPin
IF NUT_READY THEN
   ;NUT ON THE PIN: $OUT[495] ON, $OUT[494] dopw1_BlowOff OFF (THE AIR CAN PUSH THE NUT OUT)
   dopw1_BlowOff=FALSE
   dopw1_ReturnPin=FALSE
   dopw1_AdvancePin=TRUE
ELSE
   ;LOWER PIN DOWN = $OUT[494] dopw1_BlowOff + $OUT[496] dopw1_ReturnPin ON (496 ALONE DOES NOT LOWER IT)
   dopw1_AdvancePin=FALSE
   dopw1_ReturnPin=TRUE
   dopw1_BlowOff=TRUE
ENDIF

;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
do503QFPAdvance=FALSE
do504QFPReturn=TRUE
;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON
WAIT FOR dipw1_SpearHome

;LOCAL NUT FEED - ONLY WHEN NO NUT WAS PRELOADED BY PRELOAD() (NUT_READY FALSE). NORMALLY
;  SKIPPED: PRELOAD SETS NUT_READY FOR EVERY NUT BEFORE THE CALLER MOVES IN
IF NOT NUT_READY THEN
   ;QFP ADVANCE (LOWER PIN DOWN, SET ABOVE, 1 S TO GO DOWN) - SIGNALS $OUT[504] do504QFPReturn OFF,
   ;  $OUT[503] do503QFPAdvance ON
   WAIT SEC 1.0
   do504QFPReturn=FALSE
   do503QFPAdvance=TRUE
   ;WAIT QFP ADVANCED - SIGNAL $IN[470] di470QFPAdvanced ON
   WAIT FOR di470QFPAdvanced
   ;A PRE-FED NUT (IF ANY) LEFT THE QFP (2026-10-07)
   QFP_NUT_LOADED=FALSE

   ;LOWER PIN ADVANCE (ONLY WITH THE QFP ADVANCED, 2026-10-07) - SIGNALS $OUT[494] dopw1_BlowOff OFF
   ;  (THE 494 AIR CAN PUSH THE NUT OUT OF POSITION), $OUT[496] dopw1_ReturnPin OFF, $OUT[495] dopw1_AdvancePin ON
   ;HIGH PRESSURE FOR THE PIN UP - $OUT[473] dopw1_Nut1Intensify_Home (CL_LowPressureSelect) OFF (2026-10-08)
   dopw1_Nut1Intensify_Home=FALSE
   dopw1_BlowOff=FALSE
   dopw1_ReturnPin=FALSE
   dopw1_AdvancePin=TRUE

   ;FEED NUT - SIGNAL $OUT[476] dopw1_StartFeed ON, THEN OFF, THEN WAIT 1.5 S
   ;NOTE: FEED COMPLETE CHECK $IN[481] dipw1_FeedComplt IS DISABLED (F25)
   ;CHECK: ON AND OFF BACK TO BACK IS A ZERO-LENGTH FEED PULSE; THE FEEDER MAY NEVER SEE IT (F25)
   dopw1_StartFeed=TRUE
   dopw1_StartFeed=FALSE
   WAIT SEC 1.5
   ;BLOW-OFF OFF - SIGNAL $OUT[494] dopw1_BlowOff OFF
   dopw1_BlowOff=FALSE

   ;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
   do503QFPAdvance=FALSE
   do504QFPReturn=TRUE
   ;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON
   WAIT FOR dipw1_SpearHome
   dopw1_Nut1Intensify_Home=TRUE   ;$OUT[473] LOW PRESSURE AGAIN (2026-10-08)
ENDIF

;UPPER PIN EXTEND - SIGNALS $OUT[499] do499UpperPinRetract OFF, $OUT[498] do498UpperPinExtend ON
do499UpperPinRetract=FALSE
do498UpperPinExtend=TRUE

;GUN GENERAL PRESSURE - SIGNALS $OUT[506..521] CL_GunPressureCmd = CL_GUN_PRESS_BASE (F44)
CL_GunPressureCmd=CL_GUN_PRESS_BASE

;RESET BOSCH HANDSHAKE - SIGNALS $OUT[483] dopw1_WeldInit OFF, $OUT[486..493] gdopw1_SpotNumber = 0
;2026-10-08: THE BOSCH ENABLE $OUT[481] dopw1_WeldContactEnable / $OUT[482] dopw1_WeldOnExternal IS NO
;  LONGER SWITCHED HERE - SPS.SUB KEEPS IT ON OUTSIDE DRY CYCLE (OFF AND ON AT EVERY NUT MADE THE ROBOT
;  WAIT FOR dipw1_Ready AGAIN AT EVERY NUT)
dopw1_WeldInit=FALSE
gdopw1_SpotNumber=0
;RESET PEDESTAL OUTPUTS - SIGNALS $OUT[476] dopw1_StartFeed OFF, $OUT[494] dopw1_BlowOff OFF,
;  $OUT[474] dopw1_Nut1Intensify OFF (NOT ON THE BUS), $OUT[473] dopw1_Nut1Intensify_Home ON
;  (FEED OFF NOT WHILE PRELOAD PRE-FEEDS THE NEXT NUT - NUTCYCLE_ACTIVE, 2026-10-07)
IF NOT NUTCYCLE_ACTIVE THEN
   dopw1_StartFeed=FALSE
ENDIF
dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE
;GUN GENERAL PRESSURE AGAIN - SIGNALS $OUT[506..521] CL_GunPressureCmd = CL_GUN_PRESS_BASE
CL_GunPressureCmd=CL_GUN_PRESS_BASE

;UPPER PIN SEATED IN THE PART HOLE BEFORE THE CLAMP CLOSES - PIN_SETTLE_WAIT (GUN_OPEN_CHECK.src): MINIMUM WAIT,
;  CONTINUES AS SOON AS CL_WeldPinPosition IS OUT OF THE RETRACTED ZONE AND STABLE (MAX 1 S). 2026-10-09, USER
;  REQUEST: SOMETIMES THE PIN DID NOT DROP INTO POSITION (CLAMP CLOSED AT THE SAME TIME), WRONG PIN READING
PIN_SETTLE_WAIT()

;PART CLAMP CLOSE - SIGNALS $OUT[502] do502PartClampOpen OFF, $OUT[501] do501PartClampClose ON
do502PartClampOpen=FALSE
do501PartClampClose=TRUE
;WAIT PART CLAMP CLOSED - SIGNAL $IN[467] di467PartClampClosed ON
WAIT FOR di467PartClampClosed

;GUN CLOSE - SIGNALS $OUT[471] dopw1_GunHome OFF, $OUT[472] dopw1_GunWork ON
;  (WAIT SEC 0.2 BETWEEN THE TWO VALVES REMOVED 2026-10-08)
dopw1_GunHome=FALSE
dopw1_GunWork=TRUE

;LOWER PIN BOTH VALVES OFF (OLD COMMENT: REMOVE AIR FROM THE LOWER PIN) -
;  SIGNALS $OUT[495] dopw1_AdvancePin OFF, $OUT[496] dopw1_ReturnPin OFF
dopw1_AdvancePin=FALSE
dopw1_ReturnPin=FALSE

;CONFIRM GUN CLOSED: CL_GunStrokePositionLPT IN CL_GUN_WELD_MIN..CL_GUN_WELD_MAX WITHOUT A BREAK
;  FOR CL_GUN_IN_WINDOW_TIME MS ($TIMER[15]), WITHIN CL_GUN_CLOSE_TIMEOUT MS ($TIMER[14])
;START BOTH TIMERS
$TIMER_STOP[14]=TRUE
$TIMER[14]=0
$TIMER_STOP[14]=FALSE
$TIMER_STOP[15]=TRUE
$TIMER[15]=0
$TIMER_STOP[15]=FALSE

LOOP
   IF (CL_GunStrokePositionLPT>=CL_GUN_WELD_MIN) AND (CL_GunStrokePositionLPT<=CL_GUN_WELD_MAX) THEN
      ;IN THE WINDOW LONG ENOUGH: GUN CLOSED ON THE NUT
      IF $TIMER[15]>=CL_GUN_IN_WINDOW_TIME THEN
         EXIT
      ENDIF
   ELSE
      ;OUT OF THE WINDOW: RESTART THE TIME IN THE WINDOW
      $TIMER_STOP[15]=TRUE
      $TIMER[15]=0
      $TIMER_STOP[15]=FALSE

      ;TIMEOUT: NUT_READY=FALSE AND HALT
      IF $TIMER[14]>=CL_GUN_CLOSE_TIMEOUT THEN
         $TIMER_STOP[14]=TRUE
         $TIMER[14]=0
         $TIMER_STOP[15]=TRUE
         $TIMER[15]=0
         NUT_READY=FALSE
         ;NUT RETRY (2026-10-10, AS 20R1): GUN BELOW CL_GUN_WELD_MIN = NO NUT ON THE PIN. WHILE nNutRetryCnt <
         ;  nNutRetryMax (GUN_OPEN_CHECK.DAT): NO WELD, THE GUN OPENS AS AFTER A WELD AND THE NUT PROGRAM FEEDS A
         ;  NEW NUT WITH THE ROBOT STILL IN THE WELD POSITION AND WELDS THIS NUT AGAIN (NUT_WELD_RETRY). DOUBLE NUT / GUN
         ;  NOT CLOSED, OR NO RETRY LEFT: RED LIGHT, MESSAGE AND HALT AS BEFORE
         IF (CL_GunStrokePositionLPT<CL_GUN_WELD_MIN) AND (nNutRetryCnt<nNutRetryMax) THEN
            nNutRetryCnt=nNutRetryCnt+1
            nNutRetryTotal=nNutRetryTotal+1
            nNutRetryLast=nCtNut
            NUT_WELD_RETRY=TRUE
            NUT_RETRY_MSG()
            EXIT
         ENDIF
         ;RED LIGHT $OUT[478] AND MESSAGE: GUN BELOW THE WINDOW = NO NUT, ABOVE = DOUBLE NUT OR GUN NOT
         ;  CLOSED (GUN_CLOSE_FAULT IN GUN_OPEN_CHECK.src, 2026-10-06). BACK TO GREEN AT THE NEXT GOOD WELD
         GUN_CLOSE_FAULT()
         ;WARNING: HALT IS STILL THE ONLY FAULT HANDLING - A DIALOG WITH RETRY AND ABORT IS STILL TO DO (F07)
         HALT
         ;AFTER THE RESUME: RESTART BOTH TIMERS, SO THE CHECK TIMES OUT AGAIN IF THE GUN IS STILL
         ;  NOT CLOSED (F07)
         $TIMER_STOP[14]=FALSE
         $TIMER_STOP[15]=FALSE
      ENDIF
   ENDIF
ENDLOOP

;GUN CLOSED: STOP AND CLEAR BOTH TIMERS
$TIMER_STOP[14]=TRUE
$TIMER[14]=0
$TIMER_STOP[15]=TRUE
$TIMER[15]=0

;WELD - SKIPPED ON A NUT RETRY (2026-10-10)
IF NOT NUT_WELD_RETRY THEN
nNutRetryCnt=0   ;NUT FOUND (GUN IN THE WELD WINDOW): RETRY COUNTER BACK TO 0

;SELECT THE WELD PROGRAM - SIGNALS $OUT[486..493] gdopw1_SpotNumber = CL_WELD_PROGRAM (2)
;CHECK: OLD COMMENT SAID SCHEDULE 7; THE CODE SELECTS PROGRAM 2 - CONFIRM ON THE BOSCH TIMER (F27)
gdopw1_SpotNumber=CL_WELD_PROGRAM

;WAIT BOSCH READY - SIGNAL $IN[484] dipw1_Ready ON (ONLY READY WAIT OF THE NUT SINCE 2026-10-08)
WAIT FOR dipw1_Ready

;INTENSIFY - GUN PRESSURE - SIGNALS $OUT[506..521] CL_GunPressureCmd = CL_GUN_PRESS_WELD (F44)
CL_GunPressureCmd=CL_GUN_PRESS_WELD

;INTENSIFY - SIGNALS $OUT[494] dopw1_BlowOff ON, $OUT[473] dopw1_Nut1Intensify_Home OFF,
;  $OUT[474] dopw1_Nut1Intensify ON (NOT MAPPED TO THE BUS, NO EFFECT)
dopw1_BlowOff=TRUE
dopw1_Nut1Intensify_Home=FALSE
dopw1_Nut1Intensify=TRUE

;WAIT INTENSIFY PRESSURE OK - SIGNAL $IN[479] dipw1_IntensfPresOk ON (NO TIMEOUT, F15)
WAIT FOR dipw1_IntensfPresOk

;CONFIRM GUN POSITION BEFORE WELDING - WAIT CL_GunStrokePositionLPT IN CL_GUN_WELD_MIN..MAX
WAIT FOR (CL_GunStrokePositionLPT>=CL_GUN_WELD_MIN) AND (CL_GunStrokePositionLPT<=CL_GUN_WELD_MAX)

;CONFIRM UPPER PIN IN WELD POSITION (PART SEATED) - CL_WeldPinPosition IN CL_PIN_WELD_MIN..MAX,
;ONLY WITH bPinWeldCheck TRUE (PIN_WELD_CHECK IN GUN_OPEN_CHECK.src, 2026-10-06)
PIN_WELD_CHECK()

;WELD - SIGNAL $OUT[483] dopw1_WeldInit ON, WAIT $IN[483] dipw1_WeldComplete ON
dopw1_WeldInit=TRUE

;WAIT WELD COMPLETE (WELD_COMPLETE_WAIT IN GUN_OPEN_CHECK.src, 2026-10-06): NO WELD COMPLETE IN
;  CL_WELD_COMPLETE_TIMEOUT MS OR BOSCH FAULT $IN[485] dipw1_Fault = RED LIGHT $OUT[478] AND MESSAGE,
;  THE ROBOT STILL WAITS FOR THE WELD COMPLETE AS BEFORE; A GOOD WELD SWITCHES BACK TO GREEN $OUT[477]
WELD_COMPLETE_WAIT()

;WELD START OFF - SIGNAL $OUT[483] dopw1_WeldInit OFF, WAIT $IN[483] dipw1_WeldComplete OFF
dopw1_WeldInit=FALSE
WAIT FOR NOT dipw1_WeldComplete
;NOTE: A BOSCH FAULT OR A LATE WELD COMPLETE ONLY SWITCHES THE RED LIGHT AND SHOWS A MESSAGE - THE
;  PART IS NOT SCRAPPED AND THE CYCLE CONTINUES (F08)

;RELEASE INTENSIFY - SIGNALS $OUT[474] dopw1_Nut1Intensify OFF,
;  $OUT[473] dopw1_Nut1Intensify_Home ON, $OUT[494] dopw1_BlowOff OFF
dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE

;GUN GENERAL PRESSURE - SIGNALS $OUT[506..521] CL_GunPressureCmd = CL_GUN_PRESS_BASE (F44)
CL_GunPressureCmd=CL_GUN_PRESS_BASE

;CLEAR WELD PROGRAM NUMBER - SIGNALS $OUT[486..493] gdopw1_SpotNumber = 0
gdopw1_SpotNumber=0

;STOP THE GUN-CLOSED TIMER $TIMER[14]
$TIMER_STOP[14]=TRUE
$TIMER[14]=0

ENDIF   ;NOT NUT_WELD_RETRY

;GUN OPEN - SIGNALS $OUT[472] dopw1_GunWork OFF, $OUT[471] dopw1_GunHome ON
;  (WAIT SEC 0.2 BETWEEN THE TWO VALVES REMOVED 2026-10-08)
dopw1_GunWork=FALSE
dopw1_GunHome=TRUE
;UPPER PIN RETRACT TOGETHER WITH THE GUN OPEN - SIGNALS $OUT[498] do498UpperPinExtend OFF, $OUT[499] do499UpperPinRetract ON
;  (2026-10-09 CYCLE TIME, USER OK: THE PIN CAN RETRACT WHILE THE GUN OPENS; PEDESTAL_CLEAR_CHECK STILL CONFIRMS IT)
do498UpperPinExtend=FALSE
do499UpperPinRetract=TRUE

;GUN OPEN INTERLOCK BEFORE THE PART IS RELEASED AND THE ROBOT LEAVES - GUN_OPEN_CHECK: SUBMIT RUNNING,
;WATER OK, CL_GunStrokePositionLPT IN 137000..142000 (MESSAGE AFTER 2 S, WAITS) (F01)
;  (WAIT SEC 0.2 AFTER THE CHECK REMOVED 2026-10-08 - THE GUN IS ALREADY CONFIRMED OPEN)
GUN_OPEN_CHECK()

;UPPER PIN RETRACT: MOVED UP TO THE GUN OPEN COMMAND (2026-10-09)

;PART CLAMP OPEN - SIGNALS $OUT[501] do501PartClampClose OFF, $OUT[502] do502PartClampOpen ON
do501PartClampClose=FALSE
do502PartClampOpen=TRUE
;WAIT PART CLAMP OPEN - SIGNAL $IN[466] di466PartClampOpen ON
WAIT FOR di466PartClampOpen

;LOWER PIN ADVANCE - SIGNALS $OUT[496] dopw1_ReturnPin OFF, $OUT[495] dopw1_AdvancePin ON
;2026-10-07: THE PIN STAYS UP HERE AS BEFORE (THE OLD COMMENT SAID RETURN, F27); PRELOAD LOWERS IT
;  (494 + 496) BEFORE ITS QFP ADVANCE
dopw1_ReturnPin=FALSE
dopw1_AdvancePin=TRUE

;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
do503QFPAdvance=FALSE
do504QFPReturn=TRUE
;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON
WAIT FOR dipw1_SpearHome

;FINAL RESET - SIGNALS $OUT[476] dopw1_StartFeed OFF, $OUT[483] dopw1_WeldInit OFF,
;  $OUT[486..493] gdopw1_SpotNumber = 0
;  (FEED OFF NOT WHILE PRELOAD PRE-FEEDS THE NEXT NUT - NUTCYCLE_ACTIVE, 2026-10-07)
IF NOT NUTCYCLE_ACTIVE THEN
   dopw1_StartFeed=FALSE
ENDIF
dopw1_WeldInit=FALSE
gdopw1_SpotNumber=0

;CHECK: CL_GUN_PRESS_REST (39425) BELOW IS THE R20 BYTE-SWAPPED 0.09 MPa, NOT THE CL_GUN_PRESS_BASE
;CHECK: USED ABOVE; NOT SWAPPED IT IS OUT OF THE ITV RANGE (0..4095). THE GUN RESTS AT THIS VALUE
;CHECK: UNTIL THE NEXT WELD (F44)
;INTENSIFY OFF - SIGNALS $OUT[474] dopw1_Nut1Intensify OFF,
;  $OUT[473] dopw1_Nut1Intensify_Home ON, $OUT[494] dopw1_BlowOff OFF
dopw1_Nut1Intensify=FALSE
dopw1_Nut1Intensify_Home=TRUE
dopw1_BlowOff=FALSE
;REST PRESSURE - SIGNALS $OUT[506..521] CL_GunPressureCmd = CL_GUN_PRESS_REST (39425)
CL_GunPressureCmd=CL_GUN_PRESS_REST

;BOSCH STAYS ENABLED FOR THE NEXT NUT (SPS.SUB, 2026-10-08)

;CYCLE TIME MEASUREMENT: END OF THE NUT (2026-10-09)
CT_WELD_END()

END