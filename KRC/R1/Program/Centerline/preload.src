&ACCESS RVP1
&COMMENT 03-10-R1 PNW1 NUT PRELOAD
DEF  PRELOAD ( )
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - NUT PRELOAD AT CENTERLINE PEDESTAL
;********************************
; RUNS IN THE SUBMIT (sps.sub). LOADS THE NEXT NUT ON THE LOWER PIN WHILE THE ROBOT WORKS:
;  STEP 0  - NUT FEED INTO THE QFP
;  STEP 10 - GUN OPEN, UPPER PIN RETRACT, CLAMP OPEN, LOWER PIN DOWN, QFP ADVANCE, NUT BLOW-OFF, LOWER PIN UP
;  STEP 20 - QFP RETURN -> NUT_READY
;  STEP 30 - FEED THE NEXT NUT INTO THE QFP
;  STEP 40 - END
;********************************

;START THE PRELOAD (NUT_START)
IF NUT_START AND NOT NUTCYCLE_ACTIVE THEN

   NUT_START=FALSE
   NUTCYCLE_ACTIVE=TRUE
   NUT_READY=FALSE
   NUT_PRELOAD_STEP=0
   STEP0DONE=FALSE
   STEP10DONE=FALSE
   STEP20DONE=FALSE
   STEP10_ADV_STARTED=FALSE
   NUT_PRELOAD_FAULT=FALSE
   $TIMER_STOP[10]=TRUE
   $TIMER[10]=0
   $TIMER_STOP[11]=TRUE
   $TIMER[11]=0
   $TIMER_STOP[12]=TRUE
   $TIMER[12]=0
   $TIMER_STOP[13]=TRUE
   $TIMER[13]=0

ENDIF

;STEPS RUN ONLY OUTSIDE DRY CYCLE
IF NUTCYCLE_ACTIVE AND NOT di004UseDryCycle THEN

   SWITCH NUT_PRELOAD_STEP

      CASE 0
         ;STEP 0 - FEED A NUT

         ;QFP RETURN
         do503QFPAdvance=FALSE
         do504QFPReturn=TRUE

         ;NUT ALREADY IN THE QFP: NO FEED
         IF QFP_NUT_LOADED AND (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
            STEP0DONE=TRUE
         ENDIF

         ;QFP RETURNED
         IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) AND (NOT QFP_NUT_LOADED) THEN
            ;FEED NUT
            dopw1_StartFeed=TRUE
            dopw1_BlowOff=FALSE

            ;START $TIMER[10] ONCE
            IF $TIMER_STOP[10] THEN
               $TIMER[10]=0
               $TIMER_STOP[10]=FALSE
            ENDIF

            ;AFTER 2000 MS OF FEED: STEP 0 DONE
            IF  $TIMER[10]>=2000 THEN
               $TIMER_STOP[10]=TRUE

               STEP0DONE=TRUE
            ENDIF

         ENDIF

         IF STEP0DONE THEN
            NUT_PRELOAD_STEP = 10
         ENDIF

      CASE 10
         ;STEP 10 - QFP ADVANCE AND BLOW THE NUT ONTO THE LOWER PIN

         IF STEP0DONE THEN

            ;GUN OPEN
            dopw1_GunWork=FALSE
            dopw1_GunHome=TRUE
            ;UPPER PIN RETRACT
            do498UpperPinExtend=FALSE
            do499UpperPinRetract=TRUE
            ;PART CLAMP OPEN
            do501PartClampClose=FALSE
            do502PartClampOpen=TRUE

            ;UNTIL THE QFP HAS BEEN SEEN RETURNED (STEP10_ADV_STARTED):
            IF NOT STEP10_ADV_STARTED THEN
               ;BLOW-OFF ON
               dopw1_BlowOff=TRUE
               ;LOWER PIN DOWN
               dopw1_AdvancePin=FALSE
               dopw1_ReturnPin=TRUE
               ;PIN DOWN TIME
               IF $TIMER_STOP[11] THEN
                  $TIMER[11]=0
                  $TIMER_STOP[11]=FALSE
               ENDIF
               ;QFP RETURN
               do503QFPAdvance=FALSE
               do504QFPReturn=TRUE

               ;QFP RETURNED AND LOWER PIN DOWN
               IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) AND (((NOT bPinDownSensor) AND ($TIMER[11]>=nPinDownMs)) OR (bPinDownSensor AND ((dipw1_PinReturn==TRUE) OR ($TIMER[11]>=nPinDownMaxMs)))) THEN
                  STEP10_ADV_STARTED=TRUE
                  $TIMER_STOP[11]=TRUE
                  $TIMER[11]=0

               ENDIF
            ELSE

               ;QFP ADVANCE, FEED OFF
               do504QFPReturn=FALSE
               do503QFPAdvance=TRUE
               dopw1_StartFeed=FALSE

               ;QFP ADVANCED
               IF (di470QFPAdvanced==TRUE) AND (dipw1_SpearHome==FALSE) THEN
                  ;NUT BLOW-OFF
                  do505QFPNutBlowOff=TRUE
                  dopw1_BlowOff=FALSE
                  ;NUT LEFT THE QFP
                  QFP_NUT_LOADED=FALSE
                  ;START $TIMER[13] (BLOW-OFF TIME, CHECKED IN STEP 20) ONCE
                  IF $TIMER_STOP[13] THEN
                     $TIMER[13]=0
                     $TIMER_STOP[13]=FALSE
                  ENDIF
                  ;LOWER PIN UP (HIGH PRESSURE)
                  dopw1_Nut1Intensify_Home=FALSE
                  dopw1_ReturnPin=FALSE
                  dopw1_AdvancePin=TRUE

                  ;START $TIMER[11] ONCE
                  IF $TIMER_STOP[11] THEN
                     $TIMER[11]=0
                     $TIMER_STOP[11]=FALSE
                  ENDIF

                  ;LOWER PIN UP TIME: STEP 10 DONE
                  IF $TIMER[11]>=nPinUpMs THEN
                     $TIMER_STOP[11]=TRUE

                     STEP10DONE=TRUE
                  ENDIF
               ENDIF
            ENDIF
         ENDIF

         ;GO TO STEP 20 WITH $TIMER[12] STOPPED AND ZEROED
         IF STEP0DONE AND STEP10DONE THEN
            NUT_PRELOAD_STEP = 20
            $TIMER_STOP[12]=TRUE
            $TIMER[12]=0

         ENDIF

      CASE 20
         ;STEP 20 - QFP RETURN

         IF STEP0DONE AND STEP10DONE AND ($TIMER[13]>=nPinUpMs) THEN

            ;LOWER PIN UP
            dopw1_ReturnPin=FALSE
            dopw1_AdvancePin=TRUE

            ;QFP RETURN
            do503QFPAdvance=FALSE
            do504QFPReturn=TRUE
            ;NUT BLOW-OFF OFF
            do505QFPNutBlowOff=FALSE

            ;QFP RETURNED: STEP 20 DONE
            IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
               STEP20DONE=TRUE
               dopw1_Nut1Intensify_Home=TRUE   ;LOW PRESSURE AGAIN, PIN STAYS UP
            ENDIF
         ENDIF

         ;PRELOAD COMPLETE
         IF STEP0DONE AND STEP10DONE AND STEP20DONE THEN
            ;NUT READY FOR THE ROBOT
            NUT_READY=TRUE

            IF NEXT_NUT_REQUEST THEN
               NEXT_NUT_READY=TRUE
               NEXT_NUT_REQUEST=FALSE
            ENDIF
            ;NEXT: STEP 30
            NUT_PRELOAD_STEP = 30
            $TIMER_STOP[10]=TRUE
            $TIMER[10]=0
            $TIMER_STOP[12]=TRUE
            $TIMER[12]=0

         ENDIF

      CASE 30
         ;STEP 30 - FEED THE NEXT NUT INTO THE QFP
         IF $TIMER_STOP[12] THEN
            $TIMER[12]=0
            $TIMER_STOP[12]=FALSE
         ENDIF

         ;QFP RETURNED
         IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
            ;FEED NUT
            dopw1_StartFeed=TRUE
            IF $TIMER_STOP[10] THEN
               $TIMER[10]=0
               $TIMER_STOP[10]=FALSE
            ENDIF
            IF $TIMER[10]>=2000 THEN
               dopw1_StartFeed=FALSE
               QFP_NUT_LOADED=TRUE
               NUT_PRELOAD_STEP = 40
            ENDIF
         ELSE
            IF ($TIMER[12]>=3000) AND $TIMER_STOP[10] THEN
               NUT_PRELOAD_STEP = 40
            ENDIF
         ENDIF

      CASE 40
         ;STEP 40 - PRELOAD CYCLE COMPLETE: CYCLE INACTIVE, $TIMER[10..12] STOPPED AND ZEROED
         NUT_PRELOAD_STEP =0
         NUTCYCLE_ACTIVE=FALSE
         STEP10_ADV_STARTED=FALSE

         $TIMER_STOP[10]=TRUE
         $TIMER[10]=0
         $TIMER_STOP[11]=TRUE
         $TIMER[11]=0
         $TIMER_STOP[12]=TRUE
         $TIMER[12]=0

   ENDSWITCH


ENDIF
END