&ACCESS RVO1
&REL 1
&COMMENT 03-10-R1 PNW1 CYCLE TIME MEASUREMENT
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CL_CYCLE_TIME(nStep:IN)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
; Application - CYCLE-TIME MEASUREMENT OF THE NUT WELD AT CENTERLINE PEDESTAL
;********************************
; CL_CYCLE_TIME(STEP): WRITES $TIMER[20] (MS) INTO CL_T_LOG[NUT,ROW,STEP] OF THE CYCLE STARTED BY
; CL_CYCLE_START; CALLED BY THE WELD APPS (STEP 1, NUT READY) AND CENTERLINE_WELD (STEPS 2-13).
; STEP 13 ENDS THE CYCLE: LATER CALLS WRITE NOTHING UNTIL THE NEXT CL_CYCLE_START.
; CL_CYCLE_START(NUT) (BELOW): CALLED BY THE WELD APPS AT THE WAIT POINT, ROBOT STOPPED: RESTARTS
; $TIMER[20], TAKES THE NEXT ROW OF THAT NUT (1..10, THEN 1 AGAIN) AND SETS ITS STEPS TO -1.
; ONLY WRITES ITS OWN DATA (CL_CYCLE_TIME.dat, STEP LIST THERE) AND $TIMER[20]: NO SIGNALS, NO
; WAITS, NO MOTION. REMOVE WITH ITS CALLS WHEN THE CYCLE-TIME WORK IS CLOSED (F52)
;********************************
INT nStep

;ONLY FOR A STARTED CYCLE (NUT 1..3) AND A VALID STEP; THE ROW IS CHECKED BEFORE IT IS USED
IF (CL_T_NUT>=1) AND (CL_T_NUT<=3) AND (nStep>=1) AND (nStep<=13) THEN
   IF (CL_T_ROW[CL_T_NUT]>=1) AND (CL_T_ROW[CL_T_NUT]<=10) THEN
      CL_T_LOG[CL_T_NUT,CL_T_ROW[CL_T_NUT],nStep]=$TIMER[20]
   ENDIF
   ;STEP 13: CYCLE ENDED
   IF nStep==13 THEN
      CL_T_NUT=0
   ENDIF
ENDIF
END

GLOBAL DEF CL_CYCLE_START(nNut:IN)
;START A MEASURED CYCLE OF NUT nNut (1..3) - CALLED BY THE WELD APPS WITH THE ROBOT STOPPED AT THE
;WAIT POINT, BEFORE THE NUT WAIT (F52)
INT nNut, nStep

CL_T_NUT=0
IF (nNut>=1) AND (nNut<=3) THEN
   ;NEXT ROW OF THIS NUT: 1..10, THEN 1 AGAIN
   IF (CL_T_ROW[nNut]>=1) AND (CL_T_ROW[nNut]<10) THEN
      CL_T_ROW[nNut]=CL_T_ROW[nNut]+1
   ELSE
      CL_T_ROW[nNut]=1
   ENDIF
   ;ALL STEPS OF THE ROW TO -1 (NOT REACHED YET)
   FOR nStep=1 TO 13
      CL_T_LOG[nNut,CL_T_ROW[nNut],nStep]=-1
   ENDFOR
   CL_T_NUT=nNut
   ;$TIMER[20] FROM 0
   $TIMER_STOP[20]=TRUE
   $TIMER[20]=0
   $TIMER_STOP[20]=FALSE
ENDIF
END
