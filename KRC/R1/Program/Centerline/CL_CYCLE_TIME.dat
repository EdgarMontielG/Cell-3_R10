&ACCESS  RV
&COMMENT 03-10-R1 PNW1 CYCLE TIME MEASUREMENT
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&REL 1
DEFDAT  CL_CYCLE_TIME PUBLIC
;FOLD CYCLE-TIME MEASUREMENT OF THE NUT WELD (F52)
;CL_T_LOG[NUT,ROW,STEP] = MS OF $TIMER[20] FROM THE ROBOT STOPPED AT THE WAIT POINT OF THE WELD APP
;(CL_CYCLE_START) TO EACH STEP; NUT 1..3, THE LAST 10 CYCLES OF EACH NUT (ROW 1..10; CL_T_ROW[NUT] =
;ROW OF THE LATEST CYCLE), -1 = STEP NOT REACHED IN THAT CYCLE. STEPS:
;  1 NUT READY (END OF THE NUT WAIT)          2 AT THE WELD POSITION (CENTERLINE_WELD STARTS)
;  3 PEDESTAL READY (GUN, PINS, CLAMP, QFP)   4 BOSCH READY
;  5 PART CLAMP CLOSED                        6 GUN CLOSED ON THE NUT (IN THE WINDOW)
;  7 BOSCH READY AGAIN                        8 INTENSIFY PRESSURE OK
;  9 WELD COMPLETE ON                        10 WELD COMPLETE OFF
; 11 GUN OPEN CONFIRMED (GUN_OPEN_CHECK)     12 PART CLAMP OPEN
; 13 CENTERLINE_WELD ENDS (QFP RETURNED, OUTPUTS RESET)
;STEP 2 MINUS STEP 1 IS THE ROBOT MOVING IN. READ THE VALUES FROM A BACKUP (tools/cycle_times.py)
;OR ON THE SMARTPAD (DISPLAY > VARIABLE > SINGLE, MODULE CL_CYCLE_TIME)
DECL INT CL_T_NUT=0
DECL INT CL_T_ROW[3]
CL_T_ROW[1]=0
CL_T_ROW[2]=0
CL_T_ROW[3]=0
DECL INT CL_T_LOG[3,10,13]
;ENDFOLD
ENDDAT
