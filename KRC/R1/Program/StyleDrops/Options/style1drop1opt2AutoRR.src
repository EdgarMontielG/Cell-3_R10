&ACCESS RVO1
&REL 269
&COMMENT 03-10-R1 RED RABBIT DROP
&PARAM EDITMASK = *
&PARAM DISKPATH = KRC:\R1\Program\StyleDrops\Options
DEF style1drop1opt2AutoRR( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - RED RABBIT DROP AT DROPOFF 2
;********************************
; CALLED BY Style1Opt10AutoRR (OPTION 12). TAKES THE RED RABBIT PART TO AtPick3 OF THIS MODULE
; AND RELEASES IT, THEN CLEARS THE RED RABBIT OUTPUTS AND THE NUT FLAGS AND RETURNS HOME.
;WARNING: GRIPPER 1 IS DRIVEN TO CLOSE AT THE START ($OUT[250] ON) AND THE RELEASE COMMAND
;  OPENS GRIPPER 3, WHICH IS INACTIVE IN grp_data.dat: GRIPPER 1 DOES NOT OPEN, THE CHECK OF
;  GRIPPER 1 OPEN THAT FOLLOWS FAILS (F19, F31)
;NOTE: THE ROBOT MOVES AWAY (LIN P23) BEFORE THE GRIPPER-EMPTY WAIT (F40)
;DROPOFF 2 REQUEST - AC_DropOffCheck(2): WAIT SIGNAL $IN[76] di076DropOffMachine2 ON
;(WAITING MESSAGE, NO TIMEOUT), THEN SIGNALS $OUT[76] do076DropOffClear2 OFF,
;$OUT[25] do025DropClearTooling OFF
;FOLD DropOff[2] Request
;FOLD ;%{h}
;Params IlfProvider=ac_zoneilf; AC_CmdZones=DropOff; AC_CmdParam=2; AC_ZoneRepo=False; AC_Blending=False
;ENDFOLD
AC_DropOffCheck (2)
;ENDFOLD

;GRIPPER 1 CLOSE (HAND-WRITTEN OUTPUTS, NO CHECK) - SIGNALS $OUT[249] do249Group1Home OFF,
;$OUT[250] do250Group1Work ON (CONTINUE: SET IN THE ADVANCE RUN)
;FOLD OUT 249 'do249Group1Home' State=FALSE CONT;%{PE}%R 8.3.43,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:249, 3:do249Group1Home, 5:FALSE, 6:CONTINUE
CONTINUE
$OUT[249]=FALSE
;ENDFOLD
;FOLD OUT 250 'do250Group1Work' State=TRUE CONT;%{PE}%R 8.3.43,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:250, 3:do250Group1Work, 5:TRUE, 6:CONTINUE
CONTINUE
$OUT[250]=TRUE
;ENDFOLD

;APPROACH THE RED RABBIT DROP - P27, P28, P32, P33, P34, P35, P36, P37, AtPick3
;FOLD PTP P27 Vel=100 % PDAT25 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P27, 3:, 5:100, 7:PDAT25
$BWDSTART=FALSE
PDAT_ACT=PPDAT25
FDAT_ACT=FP27
BAS(#PTP_PARAMS,100)
PTP XP27 
;ENDFOLD
;FOLD PTP P28 Vel=100 % PDAT26 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P28, 3:, 5:100, 7:PDAT26
$BWDSTART=FALSE
PDAT_ACT=PPDAT26
FDAT_ACT=FP28
BAS(#PTP_PARAMS,100)
PTP XP28 
;ENDFOLD


;FOLD PTP P32 CONT Vel=100 % PDAT30 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P32, 3:C_DIS, 5:100, 7:PDAT30
$BWDSTART=FALSE
PDAT_ACT=PPDAT30
FDAT_ACT=FP32
BAS(#PTP_PARAMS,100)
PTP XP32 C_DIS
;ENDFOLD
;FOLD PTP P33 Vel=100 % PDAT31 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P33, 3:, 5:100, 7:PDAT31
$BWDSTART=FALSE
PDAT_ACT=PPDAT31
FDAT_ACT=FP33
BAS(#PTP_PARAMS,100)
PTP XP33 
;ENDFOLD


;FOLD PTP P34 Vel=100 % PDAT32 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P34, 3:, 5:100, 7:PDAT32
$BWDSTART=FALSE
PDAT_ACT=PPDAT32
FDAT_ACT=FP34
BAS(#PTP_PARAMS,100)
PTP XP34 
;ENDFOLD
;FOLD LIN P35 CONT Vel=2 m/s CPDAT5 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P35, 3:C_DIS C_DIS, 5:2, 7:CPDAT5
$BWDSTART=FALSE
LDAT_ACT=LCPDAT5
FDAT_ACT=FP35
BAS(#CP_PARAMS,2)
LIN XP35 C_DIS C_DIS
;ENDFOLD
;FOLD PTP P36 CONT Vel=100 % PDAT33 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P36, 3:C_DIS, 5:100, 7:PDAT33
$BWDSTART=FALSE
PDAT_ACT=PPDAT33
FDAT_ACT=FP36
BAS(#PTP_PARAMS,100)
PTP XP36 C_DIS
;ENDFOLD
;FOLD PTP P37 CONT Vel=100 % PDAT34 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P37, 3:C_DIS, 5:100, 7:PDAT34
$BWDSTART=FALSE
PDAT_ACT=PPDAT34
FDAT_ACT=FP37
BAS(#PTP_PARAMS,100)
PTP XP37 C_DIS
;ENDFOLD
;FOLD LIN AtPick3 Vel=2 m/s CPDAT6 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:AtPick3, 3:, 5:2, 7:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FAtPick3
BAS(#CP_PARAMS,2)
LIN XAtPick3 
;ENDFOLD
;GRIPPER 3 OPEN - GRPg_SetStateAndCheck(3, 1, ...)
;WARNING: GRIPPER 3 IS INACTIVE IN grp_data.dat: GRIPPERTECH ONLY LOGS "GRIPPER NOT ACTIVE";
;  NO OUTPUT CHANGES AND THE PART STAYS IN THE CLOSED GRIPPER 1 (F19, F31)
;FOLD Gripper SET [3]Gripper3 State=[1]OPEN Wait 0.2[s] Check with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperSet;setgripper=3;setstate=1;setcont=nocont;waittime=0.2;errorstrategy=1
;ENDFOLD
GRPg_SetStateAndCheck(3, 1, 0.2, 1)
;ENDFOLD
;CHECK GRIPPER 1 OPEN - SIGNALS $IN[257] di257Cylinder1Home ON, $IN[258] di258Cylinder1Work OFF
;(STRATEGY 1: DIALOG IN T1/T2, STOP IN AUT/EXT - SEE THE WARNING ABOVE)
;FOLD Gripper CHECK [1]Gripper 1 State=[1]OPEN with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperCheck;setgripper=1;setstate=1;setcont=nocont;checkstrategy=1
;ENDFOLD
GRPg_Check(1, 1, FALSE, 1)
;ENDFOLD
;LEAVE THE DROP - P23 (BEFORE THE GRIPPER-EMPTY WAIT, F40)
;FOLD LIN P23 Vel=2 m/s CPDAT2 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P23, 3:, 5:2, 7:CPDAT2
$BWDSTART=FALSE
LDAT_ACT=LCPDAT2
FDAT_ACT=FP23
BAS(#CP_PARAMS,2)
LIN XP23 
;ENDFOLD
;WAIT GRIPPER EMPTY - SIGNALS $IN[253] di253PartPresent1 OFF, $IN[254] di254PartPresent2 OFF (NO TIMEOUT)
;FOLD WAIT FOR ( NOT IN 253 'di253PartPresent1' ) AND ( NOT IN 254 'di254PartPresent2' );%{PE}%R 8.3.43,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:253, 7:di253PartPresent1, 9:AND, 10:, 12:NOT, 13:$IN, 14:254, 15:di254PartPresent2, 17:
WAIT FOR  (  NOT $IN[253] ) AND (  NOT $IN[254] ) 
;ENDFOLD

;LIN P24
;FOLD LIN P24 Vel=2 m/s CPDAT4 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P24, 3:, 5:2, 7:CPDAT4
$BWDSTART=FALSE
LDAT_ACT=LCPDAT4
FDAT_ACT=FP24
BAS(#CP_PARAMS,2)
LIN XP24 
;ENDFOLD
;PART NOT IN GRIPPER - SIGNAL $OUT[18] do018Part1InGripper OFF
;FOLD OUT 18 'do018PartInGripper1' State=FALSE ;%{PE}%R 8.3.43,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:18, 3:do018PartInGripper1, 5:FALSE, 6:
$OUT[18]=FALSE
;ENDFOLD
;LEAVE - P21, P25
;FOLD LIN P21 CONT Vel=2 m/s CPDAT7 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P21, 3:C_DIS C_DIS, 5:2, 7:CPDAT7
$BWDSTART=FALSE
LDAT_ACT=LCPDAT7
FDAT_ACT=FP21
BAS(#CP_PARAMS,2)
LIN XP21 C_DIS C_DIS
;ENDFOLD
;FOLD PTP P25 Vel=100 % PDAT23 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P25, 3:, 5:100, 7:PDAT23
$BWDSTART=FALSE
PDAT_ACT=PPDAT23
FDAT_ACT=FP25
BAS(#PTP_PARAMS,100)
PTP XP25 
;ENDFOLD

;DROPOFF 2 CLEAR - AC_DropOff(2,TRUE): SIGNAL $OUT[76] do076DropOffClear2 ON
;FOLD DropOff[2] Reset
;FOLD ;%{h}
;Params IlfProvider=ac_zoneilf; AC_CmdZones=DropOff; AC_CmdParam=2; AC_ZoneRepo=True; AC_Blending=False
;ENDFOLD
AC_DropOff (2,True)
;ENDFOLD
;RED RABBIT OUTPUTS OFF - SIGNALS $OUT[141] do141RedRabbitFailed OFF, $OUT[142] do142RedRabbitPassed OFF -
;AND PARTPRESENT1..3 = FALSE
;NOTE: THESE RESETS USED TO SIT INSIDE THE INLINE FORM ABOVE, WHERE CONFIRMING THE FORM WOULD HAVE
;  DELETED THEM (F32). THE RESULT IS CLEARED BEFORE THE PLC CAN READ IT AT THE END OF THE CYCLE (F19)
do141RedRabbitFailed=FALSE
do142RedRabbitPassed=FALSE
PARTPRESENT1=FALSE
PARTPRESENT2=FALSE
PARTPRESENT3=FALSE


;PTP HOME (XHOME)
;FOLD PTP HOME Vel=100 % PDAT11;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:PDAT11
$BWDSTART=FALSE
PDAT_ACT=PPDAT11
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD

END
