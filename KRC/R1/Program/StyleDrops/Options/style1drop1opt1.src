&ACCESS RVP1
&REL 271
&COMMENT 03-10-R1 DROP CONVEYOR
&PARAM EDITMASK = *
&PARAM DISKPATH = KRC:\R1\Program\StyleDrops\Options
DEF Style1Drop1Opt1( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - DROP THE GOOD PART AT DROPOFF 1 (CONVEYOR)
;********************************

;APPROACH DROPOFF 1 - APPLICATION 1 CLEAR AT P5
TRIGGER WHEN DISTANCE=1 DELAY=0 DO do070ApplicationClear1=TRUE
;FOLD PTP P5 CONT Vel=100 % PDAT10 Tool[2]:TOOL 1 WITH PART Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P5, 3:C_DIS, 5:100, 7:PDAT10
$BWDSTART=FALSE
PDAT_ACT=PPDAT10
FDAT_ACT=FP5
BAS(#PTP_PARAMS,100)
PTP XP5 C_DIS
;ENDFOLD



;DROPOFF 1 REQUEST
;FOLD DropOff[1] Request
;FOLD ;%{h}
;Params IlfProvider=ac_zoneilf; AC_CmdZones=DropOff; AC_CmdParam=1; AC_ZoneRepo=False; AC_Blending=False
;ENDFOLD
AC_DropOffCheck (1)
;ENDFOLD

;FOLD LIN AtDrop3 Vel=2 m/s CPDAT1 Tool[2]:TOOL 1 WITH PART Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:AtDrop3, 3:, 5:2, 7:CPDAT1
$BWDSTART=FALSE
LDAT_ACT=LCPDAT1
FDAT_ACT=FAtDrop3
BAS(#CP_PARAMS,2)
LIN XAtDrop3 
;ENDFOLD




;GRIPPER 1 OPEN
;FOLD Gripper SET [1]Gripper1 State=[1]OPEN Wait 0[s] Check with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperSet;setgripper=1;setstate=1;setcont=nocont;waittime=0;errorstrategy=1
;ENDFOLD
GRPg_SetStateAndCheck(1, 1, 0, 1)
;ENDFOLD
;WAIT GRIPPER EMPTY
;FOLD WAIT FOR ( NOT IN 253 'di253PartPresent1' ) AND ( NOT IN 254 'di254PartPresent2' );%{PE}%R 8.3.43,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:253, 7:di253PartPresent1, 9:AND, 10:, 12:NOT, 13:$IN, 14:254, 15:di254PartPresent2, 17:
WAIT FOR  (  NOT di253PartPresent1 ) AND (  NOT di254PartPresent2 ) 
;ENDFOLD

;FOLD PTP P8 CONT Vel=100 % PDAT5 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P8, 3:C_DIS, 5:100, 7:PDAT5
$BWDSTART=FALSE
PDAT_ACT=PPDAT5
FDAT_ACT=FP8
BAS(#PTP_PARAMS,100)
PTP XP8 C_DIS
;ENDFOLD

 
;FOLD PTP P7 CONT Vel=100 % PDAT13 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P7, 3:C_DIS, 5:100, 7:PDAT13
$BWDSTART=FALSE
PDAT_ACT=PPDAT13
FDAT_ACT=FP7
BAS(#PTP_PARAMS,100)
PTP XP7 C_DIS
;ENDFOLD
;DROPOFF 1 CLEAR
;FOLD DropOff[1] Reset
;FOLD ;%{h}
;Params IlfProvider=ac_zoneilf; AC_CmdZones=DropOff; AC_CmdParam=1; AC_ZoneRepo=True; AC_Blending=False
;ENDFOLD
AC_DropOff (1,True)
;ENDFOLD
;FOLD PTP P3 CONT Vel=100 % PDAT2 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P3, 3:C_DIS, 5:100, 7:PDAT2
$BWDSTART=FALSE
PDAT_ACT=PPDAT2
FDAT_ACT=FP3
BAS(#PTP_PARAMS,100)
PTP XP3 C_DIS
;ENDFOLD


;PTP HOME (XHOME)
;FOLD PTP HOME Vel=100 % PDAT11;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:PDAT11
$BWDSTART=FALSE
PDAT_ACT=PPDAT11
FDAT_ACT=FHOME
BAS(#PTP_PARAMS,100)
$H_POS=XHOME
PTP XHOME 
;ENDFOLD

END
