&ACCESS RVO1
&REL 61
&COMMENT 03-10-R1 RED RABBIT PICK
&PARAM EDITMASK = *
&PARAM DISKPATH = KRC:\R1\Program\StylePicks\Options
DEF style1pick1opt1AutoRR( )
   ;FOLD INI
      ;FOLD BASISTECH INI
         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
         INTERRUPT ON 3 
         BAS (#INITMOV,0 )
      ;ENDFOLD (BASISTECH INI)
      ;FOLD USER INI
         ;Make your modifications here
         
      ;ENDFOLD (USER INI)
   ;ENDFOLD (INI)   
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1-MH1)
; Application - RED RABBIT PICK AT PICKUP 1 (STATION 1) WITH EOAT 1
;********************************
;NOTE: CALLED BY Style1Opt10AutoRR (OPTION 12, RED RABBIT); SAME PATH AS style1pick1opt1 PLUS P16
;NOTE: IT STARTS A NUT PRELOAD (NUT_STAR AT P12) ALTHOUGH NO WELDING FOLLOWS (F14)
;NOTE: THE WAIT FOR STATEMENTS BELOW HAVE NO TIMEOUT AND NO MESSAGE (F15)
;PICKUP 1 REQUEST - AC_pickUPCheck(1): WAIT SIGNAL $IN[65] di065PickupMachine1 ON,
;THEN SIGNALS $OUT[65] do065PickupClear1 OFF, $OUT[23] do023PickClearTooling OFF
   ;FOLD PickUp[1] Request
      ;FOLD ;%{h}
         ;Params IlfProvider=ac_zoneilf; AC_CmdZones=PickUp; AC_CmdParam=1; AC_ZoneRepo=False; AC_Blending=False
      ;ENDFOLD
      AC_pickUPCheck (1)
   ;ENDFOLD  
;GRIPPER 1 OPEN - SIGNALS $OUT[249] do249Group1Home ON, $OUT[250] do250Group1Work OFF, WAIT 0.2 S,
;THEN CHECK $IN[257] di257Cylinder1Home ON, $IN[258] di258Cylinder1Work OFF (STRATEGY 1)
;NOTE: THE GRIPPER IS OPENED BEFORE THE GRIPPER-EMPTY CHECK BELOW (GESTAMP REVIEW POINT 14)
;WARNING: THE HIDDEN FORM PARAMETERS SAY setgripper=4;setstate=2 - OPENING AND CONFIRMING THIS
;  FORM REGENERATES GRPg_SetStateAndCheck(4, 2, ...), AN INACTIVE GRIPPER: NOTHING OPENS (F31)
   ;FOLD Gripper SET [1]Gripper1 State=[1]OPEN Wait 0.2[s] Check with Strategy 1 ;%{PE}
      ;FOLD Parameters Parameters ;%{h}
         ;Params IlfProvider=GripperTech.GripperSet;setgripper=4;setstate=2;setcont=nocont;waittime=0.2;errorstrategy=1
      ;ENDFOLD
      GRPg_SetStateAndCheck(1, 1, 0.2, 1)
   ;ENDFOLD
;CHECK GRIPPER 1 OPEN AGAIN - SIGNALS $IN[257] di257Cylinder1Home ON, $IN[258] di258Cylinder1Work OFF
;NOTE: REPEATS THE CHECK ALREADY DONE BY GRPg_SetStateAndCheck ABOVE
;FOLD Gripper CHECK [1]Gripper 1 State=[1]OPEN with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperCheck;setgripper=1;setstate=1;setcont=nocont;checkstrategy=1
;ENDFOLD
GRPg_Check(1, 1, FALSE, 1)
;ENDFOLD
;WAIT GRIPPER EMPTY - SIGNALS $IN[253] di253PartPresent1 OFF, $IN[254] di254PartPresent2 OFF
;FOLD WAIT FOR ( NOT IN 253 'di253PartPresent1' ) AND ( NOT IN 254 'di254PartPresent2' );%{PE}%R 8.3.43,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:NOT, 5:$IN, 6:253, 7:di253PartPresent1, 9:AND, 10:, 12:NOT, 13:$IN, 14:254, 15:di254PartPresent2, 17:
WAIT FOR  (  NOT $IN[253] ) AND (  NOT $IN[254]) 
;ENDFOLD
  
;APPROACH PICKUP - P12
;NUT 1 - TRIGGER IN THE P12 FOLD (DISTANCE = 0: FIRES WHEN THE MOTION STARTS): NUT_STAR=TRUE
;STARTS THE NUT PRELOAD (PRELOAD, CALLED FROM sps.sub) FOR THE FIRST NUT
;WARNING: THE TRIGGER WAS TYPED BY HAND INSIDE THE INLINE FORM: A TOUCH UP OF P12 DELETES IT
;  AND NUT 1 GETS NO PRELOAD (F32). NUT_STAR IS SET ALSO IN DRY CYCLE AND IN T1/T2 (F04, F11)
;THEN P10, P20, P30AbovePick (ABOVE THE PART), AtPick3 (PICK POSITION)
;FOLD PTP P12 Vel=100 % PDAT15 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P12, 3:, 5:100, 7:PDAT15
$BWDSTART=FALSE
PDAT_ACT=PPDAT15
FDAT_ACT=FP12
BAS(#PTP_PARAMS,100)
TRIGGER WHEN DISTANCE = 0 DELAY = 0 DO NUT_STAR=TRUE 
PTP XP12 
;ENDFOLD
;FOLD LIN P10 CONT Vel=2 m/s CPDAT5 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P10, 3:C_DIS C_DIS, 5:2, 7:CPDAT5
$BWDSTART=FALSE
LDAT_ACT=LCPDAT5
FDAT_ACT=FP10
BAS(#CP_PARAMS,2)
LIN XP10 C_DIS C_DIS
;ENDFOLD
   ;FOLD PTP P20 CONT Vel=100 % PDAT2 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P20, 3:C_DIS, 5:100, 7:PDAT2
      $BWDSTART=FALSE
      PDAT_ACT=PPDAT2
      FDAT_ACT=FP20
      BAS(#PTP_PARAMS,100)
      PTP XP20 C_DIS
   ;ENDFOLD
   ;FOLD PTP P30AbovePick CONT Vel=100 % PDAT4 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P30AbovePick, 3:C_DIS, 5:100, 7:PDAT4
      $BWDSTART=FALSE
      PDAT_ACT=PPDAT4
      FDAT_ACT=FP30AbovePick
      BAS(#PTP_PARAMS,100)
      PTP XP30AbovePick C_DIS
   ;ENDFOLD 
;NOTE: THE FOLD TITLE SAYS AtPick1; THE FORM DATA AND THE CODE MOVE TO AtPick3
   ;FOLD LIN AtPick1 Vel=2 m/s CPDAT1 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:AtPick3, 3:, 5:2, 7:CPDAT1
      $BWDSTART=FALSE
      LDAT_ACT=LCPDAT1
      FDAT_ACT=FAtPick3
      BAS(#CP_PARAMS,2)
      LIN XAtPick3 
   ;ENDFOLD

;GRIPPER 1 CLOSE - SIGNALS $OUT[249] do249Group1Home OFF, $OUT[250] do250Group1Work ON, WAIT 0.2 S,
;THEN CHECK $IN[257] di257Cylinder1Home OFF, $IN[258] di258Cylinder1Work ON (STRATEGY 1)
;WARNING: THE HIDDEN FORM PARAMETERS SAY setgripper=4;setstate=2 - OPENING AND CONFIRMING THIS
;  FORM REGENERATES GRPg_SetStateAndCheck(4, 2, ...), AN INACTIVE GRIPPER: NOTHING CLOSES (F31)
   ;FOLD Gripper SET [1]Gripper1 State=[2]CLOSE Wait 0.2[s] Check with Strategy 1 ;%{PE}
      ;FOLD Parameters Parameters ;%{h}
         ;Params IlfProvider=GripperTech.GripperSet;setgripper=4;setstate=2;setcont=nocont;waittime=0.2;errorstrategy=1
      ;ENDFOLD
      GRPg_SetStateAndCheck(1, 2, 0.2, 1)
   ;ENDFOLD
;CHECK GRIPPER 1 CLOSED AGAIN - SIGNALS $IN[257] di257Cylinder1Home OFF, $IN[258] di258Cylinder1Work ON
;NOTE: REPEATS THE CHECK ALREADY DONE BY GRPg_SetStateAndCheck ABOVE
;FOLD Gripper CHECK [1]Gripper 1 State=[2]CLOSE with Strategy 1 ;%{PE}
;FOLD Parameters Parameters ;%{h}
;Params IlfProvider=GripperTech.GripperCheck;setgripper=1;setstate=1;setcont=nocont;checkstrategy=1
;ENDFOLD
GRPg_Check(1, 2, FALSE, 1)
;ENDFOLD

;OUTSIDE DRY CYCLE ONLY (SIGNAL $IN[4] di004UseDryCycle OFF): PART-PRESENT WAIT AND
;$OUT[18] do018Part1InGripper; IN DRY CYCLE JUMP TO DRY (F05)
IF di004UseDryCycle==TRUE THEN

GOTO DRY
ELSE
;WAIT PART IN GRIPPER - SIGNALS $IN[253] di253PartPresent1 ON, $IN[254] di254PartPresent2 ON
;FOLD WAIT FOR ( IN 253 'di253PartPresent1' ) AND ( IN 254 'di254PartPresent2' );%{PE}%R 8.3.43,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:253, 7:di253PartPresent1, 9:AND, 10:, 12:, 13:$IN, 14:254, 15:di254PartPresent2, 17:
WAIT FOR  ( $IN[253] ) AND ( $IN[254] ) 
;ENDFOLD
;PART IN GRIPPER - SIGNAL $OUT[18] do018Part1InGripper ON
;NOTE: THE FORM TEXT do018PartInGripper1 IS NOT A DECLARED NAME (DECLARED: do018Part1InGripper).
;NOTE: $OUT[18] IS SET HERE AND RESET AT THE DROP - IT DOES NOT FOLLOW THE SENSORS (GESTAMP POINT 9)
   ;FOLD OUT 18 'do018PartInGripper1' State=TRUE ;%{PE}%R 8.3.43,%MKUKATPBASIS,%COUT,%VOUTX,%P 2:18, 3:do018PartInGripper1, 5:TRUE, 6:
      $OUT[18]=TRUE
   ;ENDFOLD
ENDIF

   DRY:
;LEAVE PICKUP 1 - P40 (ABOVE AtPick3), P9, P8, P16 (60 %)
   ;FOLD LIN P40 Vel=2 m/s CPDAT2 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P40, 3:, 5:2, 7:CPDAT2
      $BWDSTART=FALSE
      LDAT_ACT=LCPDAT2
      FDAT_ACT=FP40
      BAS(#CP_PARAMS,2)
      LIN XP40 
   ;ENDFOLD
;FOLD PTP P9 Vel=100 % PDAT13 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P9, 3:, 5:100, 7:PDAT13
$BWDSTART=FALSE
PDAT_ACT=PPDAT13
FDAT_ACT=FP9
BAS(#PTP_PARAMS,100)
PTP XP9 
;ENDFOLD
;FOLD PTP P8 Vel=100 % PDAT12 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P8, 3:, 5:100, 7:PDAT12
$BWDSTART=FALSE
PDAT_ACT=PPDAT12
FDAT_ACT=FP8
BAS(#PTP_PARAMS,100)
PTP XP8 
;ENDFOLD

;FOLD PTP P16 Vel=60 % PDAT18 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P16, 3:, 5:60, 7:PDAT18
$BWDSTART=FALSE
PDAT_ACT=PPDAT18
FDAT_ACT=FP16
BAS(#PTP_PARAMS,60)
PTP XP16 
;ENDFOLD
;PICKUP 1 CLEAR - AC_pickUP(1,TRUE): SIGNAL $OUT[65] do065PickupClear1 ON
   ;FOLD PickUp[1] Reset
      ;FOLD ;%{h}
         ;Params IlfProvider=ac_zoneilf; AC_CmdZones=PickUp; AC_CmdParam=1; AC_ZoneRepo=True; AC_Blending=False
      ;ENDFOLD
      AC_pickUP (1,True)
   ;ENDFOLD
END