&ACCESS RVO1
&REL 171
&COMMENT Mastering Reference User Program
&PARAM DISKPATH = KRC:\R1\Program
DEF MasRef_USER()
END 

GLOBAL DEF MASREFSTARTG1()
;FOLD Teach path and position for reference group 1
;ENDFOLD
;do828MasterRefInProcess=TRUE
 do930MasterRefInProcess=TRUE

  CloseAndCheckAllClamps ( ) ; Close And Check

;FOLD PTP HomePos Vel=80 % PDAT4 Tool[1]:Tool 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HomePos, 3:, 5:80, 7:PDAT4
$BWDSTART=FALSE
PDAT_ACT=PPDAT4
FDAT_ACT=FHomePos
BAS(#PTP_PARAMS,80)
PTP XHomePos 
;ENDFOLD
;FOLD PTP P24 Vel=100 % PDAT16 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P24, 3:, 5:100, 7:PDAT16
$BWDSTART=FALSE
PDAT_ACT=PPDAT16
FDAT_ACT=FP24
BAS(#PTP_PARAMS,100)
PTP XP24 
;ENDFOLD
;FOLD PTP P23 Vel=100 % PDAT15 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P23, 3:, 5:100, 7:PDAT15
$BWDSTART=FALSE
PDAT_ACT=PPDAT15
FDAT_ACT=FP23
BAS(#PTP_PARAMS,100)
PTP XP23 
;ENDFOLD
;FOLD PTP P7 CONT Vel=80 % PDAT5 Tool[1]:Tool 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P7, 3:C_DIS, 5:80, 7:PDAT5
$BWDSTART=FALSE
PDAT_ACT=PPDAT5
FDAT_ACT=FP7
BAS(#PTP_PARAMS,80)
PTP XP7 C_DIS
;ENDFOLD
;FOLD LIN P10 CONT Vel=1.2 m/s CPDAT8 Tool[1]:Tool 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P10, 3:C_DIS C_DIS, 5:1.2, 7:CPDAT8
$BWDSTART=FALSE
LDAT_ACT=LCPDAT8
FDAT_ACT=FP10
BAS(#CP_PARAMS,1.2)
LIN XP10 C_DIS C_DIS
;ENDFOLD
;FOLD LIN P9 Vel=0.6 m/s CPDAT7 Tool[1]:Tool 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P9, 3:, 5:0.6, 7:CPDAT7
$BWDSTART=FALSE
LDAT_ACT=LCPDAT7
FDAT_ACT=FP9
BAS(#CP_PARAMS,0.6)
LIN XP9 
;ENDFOLD
;FOLD LIN RefSwitch Vel=0.2 m/s CPDAT6 Tool[1]:Tool 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:RefSwitch, 3:, 5:0.2, 7:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FRefSwitch
BAS(#CP_PARAMS,0.2)
LIN XRefSwitch 
;ENDFOLD
;FOLD WAIT Time=1 sec;%{PE}%R 8.3.43,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:1
WAIT SEC 1
;ENDFOLD

END

GLOBAL DEF MASREFBACKG1()
;FOLD Teach path back for reference group 1
;ENDFOLD

;FOLD LIN P29 Vel=0.6 m/s CPDAT15 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P29, 3:, 5:0.6, 7:CPDAT15
$BWDSTART=FALSE
LDAT_ACT=LCPDAT15
FDAT_ACT=FP29
BAS(#CP_PARAMS,0.6)
LIN XP29 
;ENDFOLD
;FOLD LIN P28 CONT Vel=1.2 m/s CPDAT14 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P28, 3:C_DIS C_DIS, 5:1.2, 7:CPDAT14
$BWDSTART=FALSE
LDAT_ACT=LCPDAT14
FDAT_ACT=FP28
BAS(#CP_PARAMS,1.2)
LIN XP28 C_DIS C_DIS
;ENDFOLD
;FOLD PTP P27 CONT Vel=80 % PDAT18 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P27, 3:C_DIS, 5:80, 7:PDAT18
$BWDSTART=FALSE
PDAT_ACT=PPDAT18
FDAT_ACT=FP27
BAS(#PTP_PARAMS,80)
PTP XP27 C_DIS
;ENDFOLD
;FOLD PTP P26 Vel=100 % PDAT17 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P26, 3:, 5:100, 7:PDAT17
$BWDSTART=FALSE
PDAT_ACT=PPDAT17
FDAT_ACT=FP26
BAS(#PTP_PARAMS,100)
PTP XP26 
;ENDFOLD
;FOLD PTP P25 Vel=100 % PDAT0 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P25, 3:, 5:100, 7:PDAT0
$BWDSTART=FALSE
PDAT_ACT=PPDAT0
FDAT_ACT=FP25
BAS(#PTP_PARAMS,100)
PTP XP25 
;ENDFOLD
;FOLD PTP HomePos Vel=80 % PDAT19 Tool[1]:TOOL 1 Base[0];%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HomePos, 3:, 5:80, 7:PDAT19
$BWDSTART=FALSE
PDAT_ACT=PPDAT19
FDAT_ACT=FHomePos
BAS(#PTP_PARAMS,80)
PTP XHomePos 
;ENDFOLD

  OpenAndCheckAllClamps ( ) ; Open And Check
;do828MasterRefInProcess=FALSE
 do930MasterRefInProcess=TRUE
;FOLD WAIT Time=1 sec;%{PE}%R 8.3.43,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:1
WAIT SEC 1
;ENDFOLD
END

