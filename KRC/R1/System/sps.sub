&ACCESS RVP
&REL 1
&COMMENT 03-10-R1 SUBMIT SPS
&PARAM DISKPATH = System
DEF  SPS ( )
   ;FOLD DECLARATIONS
  ;FOLD BASISTECH DECL
  ;Automatic External
  DECL STATE_T STAT
  DECL MODUS_T MODE
  ;ENDFOLD (BASISTECH DECL)
  ;FOLD USER DECL
  ; Please insert user defined declarations

  ;ENDFOLD (USER DECL)
  ;ENDFOLD (DECLARATIONS)
  ;FOLD INI
  ;FOLD AUTOEXT INIT
  INTERRUPT DECL 91 WHEN $PRO_STATE1==#P_FREE DO RESET_OUT ()
  INTERRUPT ON 91
  $LOOP_MSG[]="                                                            "
  MODE=#SYNC
  $H_POS=$H_POS
  ;Automatic External: IN EXTERNAL AUTOMATIC MODE SELECT THE MAIN PROGRAM /R1/CELL()
  IF $MODE_OP==#EX THEN
    CWRITE($CMD,STAT,MODE,"RUN /R1/CELL()")
  ENDIF
  ;ENDFOLD (AUTOEXT INIT)
  ;FOLD BACKUPMANAGER PLC INIT
  BM_ENABLED = FALSE
  BM_OUTPUTVALUE = 0
  ;ENDFOLD (BACKUPMANAGER PLC INIT)
  ;FOLD TQM_INIT
    TorqueDefinitions()
  ;ENDFOLD (TQM_INIT)
				   
				  
						
  ;FOLD USER INIT
  ; Please insert user defined initialization commands
  ;PLC STATUS OUTPUTS OFF AT START
  doCriticalWZ=FALSE
  do111Gun1ElectrodeChange=FALSE
  do006RobotBatteryAlarm=FALSE
  do007RobotAtPounce=FALSE
  do009RobotAtRepair=FALSE
  do010RobotAtTipDress=FALSE
  do013WaterIsOn=FALSE
  do021BrakeTestReqd=FALSE
  do022MstrRefRequired=FALSE
  do046WeldMode=FALSE
  do048RPWCtrlrEnetOK=FALSE
  do050TDVlvManifold=FALSE
  do051RbtAtMstrRefSwitch=FALSE
  do052EOATVlvMnfldEnetOK=FALSE
  do053MigReamerEnetOK=FALSE
  do054SRWTipDressIOEnetOK=FALSE
  do055EndEffectorIOEnetOK=FALSE
  do056WeldCntl1EnetOK=FALSE
  do057RPWSlrDArc1EnetOK=FALSE
  do058PinScribeCntlrIOOK=FALSE
  do059RPWSlrDArc2EnetOK=FALSE
  do060VlvManifoldEnetOK=FALSE
  do094AirOK=FALSE
  gdoAxis1Posn=0
  do107Hopper1LowLevel=FALSE
  do118Nut1Ready=FALSE
  do123ToolIDBit0=FALSE
  do124ToolIDBit1=FALSE
  do134Nut1Fault=FALSE
  do146SpeedNot100=FALSE
  do464WaterBeacon=FALSE

  ;ENDFOLD (USER INIT)
  ;ENDFOLD (INI)
;********************************
; Gestamp Standards
; Line - BMW G65 (cell 03)
; Robot 03-10-R1 (BMW-03-10-R1)
; Application - SUBMIT (BACKGROUND LOGIC, CENTERLINE SENSORS, NUT PRELOAD)
;********************************

  LOOP
    WAIT FOR NOT($POWER_FAIL)
    TORQUE_MONITORING()
    ;FOLD BACKUPMANAGER PLC
    IF BM_ENABLED THEN
      BM_OUTPUTSIGNAL = BM_OUTPUTVALUE
    ENDIF
    ;ENDFOLD (BACKUPMANAGER PLC)
;START AUTOGENERATED -- DO NOT CHANGE -- GripperSpotTech sps SpsSub.add InsertGripperTechGlobals
    ;FOLD GRIPPERTECH LOOP
      GRPg_ChkSetStatePLC()
   ;ENDFOLD (GRIPPERTECH LOOP)
;END AUTOGENERATED -- DO NOT CHANGE -- (GripperSpotTech sps SpsSub.add InsertGripperTechGlobals)
;FOLD NutWeld PLC
 NutWeld_BKG ( )   ; NutWeld background (client standard)
;ENDFOLD (NutWeld PLC)
;FOLD Automation Core PLC
;ENDFOLD (Automation Core PLC)
				 
			;FOLD Centerline Pedestal
   ;CENTERLINE NUT WELDER
	
	
	;GUN STROKE POSITION (LPT)
	CL_GunStrokePositionLPT=(CL_LPT_BYTE1*65536)+(CL_LPT_BYTE2*256)+CL_LPT_BYTE3

   ;UPPER PIN POSITION
   CL_WeldPinPosition=(CL_PIN_BYTE0*256)+CL_PIN_BYTE1
   ;PEDESTAL STATES: PART CLAMP OPEN, UPPER PIN RETRACTED
   CL_ClampOpen=di466PartClampOpen
   IF bPinCheck THEN
      CL_PinRetracted=(CL_WeldPinPosition>=nPinRetractMin) AND (CL_WeldPinPosition<=nPinRetractMax)
   ELSE
      CL_PinRetracted=TRUE
   ENDIF

   ;COOLING WATER FLOW SV0500
   SV0500_FLOW =( SV0500_BYTE0*256)+SV0500_BYTE1
   
   ;FLOW IN 0.1 L/MIN (250 = 25.0 L/MIN). WATER OK ABOVE nWaterFlowMin (GUN_OPEN_CHECK.dat)
   nWaterFlow = SV0500_FLOW / 4
   IF nWaterFlow >= nWaterFlowMin THEN
      dipw1_WaterOk = TRUE
   ELSE
      IF nWaterFlow < (nWaterFlowMin - nWaterFlowHyst) THEN
         dipw1_WaterOk = FALSE
      ENDIF
   ENDIF
   CL_WaterOk = dipw1_WaterOk

   ;WELD STATUS LIGHTS: WRITTEN BY NutWeld_BKG (RED = HOPPER LOW OR WELD FAULT)

   ;KL50L2 BEACON: FOLLOWS THE WELD STATUS LIGHTS
   ;RED
    IF dopw1_LowLevel THEN
     CL_BeaconBit3008 = TRUE
     CL_BeaconBit3024 = TRUE
    ENDIF
   ;GREEN
    IF  dopw1_LevelOk THEN
     CL_BeaconBit3001 = TRUE
     CL_BeaconBit3008 = TRUE
     CL_BeaconBit3024 = FALSE
    ENDIF


;ENDFOLD (Centerline Pedestal)		
					  
   ;COOLING WATER VALVE: PLC WATER ENABLE, OFF DURING ELECTRODE CHANGE
   dopw1_StartWater=di013WaterEnable AND NOT do091RobotReadyCapChange

   ;ELECTRODE CHANGE REQUEST AT THE END OF THE STEPPER
   do111Gun1ElectrodeChange=dipw1_EndOfStepper
   ;STEPPER STATUS TO PLC: WRITTEN BY NutWeld_BKG

   ;WELD CONTROLLER ENABLE (OFF IN DRY CYCLE)
   IF di004UseDryCycle THEN
      dopw1_WeldContactEnable=FALSE
      dopw1_WeldOnExternal=FALSE
   ELSE
      dopw1_WeldContactEnable=TRUE
      dopw1_WeldOnExternal=TRUE
   ENDIF

   ;WELD MODE TO THE PLC
   do046WeldMode=NOT di004UseDryCycle

   ;NUT WELDER STATUS TO THE PLC
   do107Hopper1LowLevel= NOT dipw1_HopperLowLevel
   do118Nut1Ready= (dipw1_Ready AND NOT dipw1_Fault)
   do134Nut1Fault= (dipw1_Fault OR NOT dipw1_Ready)
   do094AirOK= dipw1_AirOK
   do013WaterIsOn = dipw1_WaterOk

   ;ROBOT AT REPAIR POSITION TO THE PLC
   IF (VARSTATE("$POS_ACT")==#INITIALIZED) THEN
      ON_ERROR_PROCEED
      PosCheck = $POS_ACT
      IF ($ERR.NUMBER<>1419) THEN
         do009RobotAtRepair=AC_CheckSphWZ(xRepair,$Repair_POS_TOL)
      ENDIF
   ENDIF

   ;NUT PRELOAD SEQUENCE (PRELOAD.src)
PRELOAD()

    ;FOLD USER PLC
    ;Make your modifications here

    ;ENDFOLD (USER PLC)
  ENDLOOP
  ;FOLD ;%{H}
  ;FOLD
END
  ;ENDFOLD


DEF  RESET_OUT ( )
  INT N
  MsgLoop(" ")
  IF REFLECT_PROG_NR == 1 THEN
    FOR N = 0 TO PGNO_LENGTH - 1
      $OUT[PGNO_FBIT_REFL + N] = FALSE
    ENDFOR
  ENDIF
  IF (PGNO_REQ>0) THEN
    $OUT[PGNO_REQ]=FALSE
  ELSE
    IF (PGNO_REQ<0) THEN
      $OUT[-PGNO_REQ]=TRUE
    ENDIF
  ENDIF
END

