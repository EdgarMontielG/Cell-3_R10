			;FOLD Centerline Pedestal
   ;NOTE: INTEGRATOR CODE FOR THE CENTERLINE PEDESTAL NUT WELDER, RUN IN EVERY SUBMIT CYCLE
	
	
	;GUN STROKE POSITION (BALLUFF BTL6 LPT) - SIGNALS $IN[567..590] CL_LPT_BYTE1..3 INTO
	;CL_GunStrokePositionLPT, BYTE ORDER HIGH TO LOW: BYTE1, BYTE2, BYTE3 (BYTE0 IS NOT USED);
	;CENTERLINE_WELD CHECKS IT (GUN ON THE NUT 69000..73000); GUN OPEN 137000..142000 IS CHECKED BY
	;GUN_OPEN_CHECK AND INTERRUPTS 20-22 OF THE WELD APPS (F01)
	;CHECK: R20 BUILDS THE SAME VALUE FROM ALL FOUR BYTES IN ANOTHER ORDER - CONFIRM THE BTL6
	;CHECK: OUTPUT FORMAT ON THIS PEDESTAL (F23)
	CL_GunStrokePositionLPT=(CL_LPT_BYTE1*65536)+(CL_LPT_BYTE2*256)+CL_LPT_BYTE3

   ;UPPER PIN POSITION - SIGNALS $IN[591..606] CL_PIN_BYTE0..1 INTO CL_WeldPinPosition
   ;NOTE: NO PROGRAM READS CL_WeldPinPosition - THE PIN POSITIONS ARE NOT CHECKED (F16)
   CL_WeldPinPosition=(CL_PIN_BYTE0*256)+CL_PIN_BYTE1

   ;WATER FLOW SV0500 - SIGNALS $IN[3000..3015] SV0500_BYTE0..1 INTO SV0500_FLOW
   SV0500_FLOW =( SV0500_BYTE0*256)+SV0500_BYTE1
   
   ;SV0500 = PARKER 5097335 VORTEX FLOW SENSOR, IO-LINK ON TBEN C7: BITS 15..2 = FLOW IN 0.1 L/MIN,
   ;BIT 1 = OUT2, BIT 0 = OUT1. nWaterFlow 250 = 25.0 L/MIN
   ;WATER OK (dipw1_WaterOk, READ BY GUN_OPEN_CHECK) AT OR ABOVE nWaterFlowMin, NOT OK BELOW
   ;nWaterFlowMin - nWaterFlowHyst; LIMITS IN GUN_OPEN_CHECK.dat (F09)
   ;CHECK: nWaterFlowMin 150 (15.0 L/MIN) TO BE CONFIRMED ON THIS ROBOT (F09)
   nWaterFlow = SV0500_FLOW / 4
   IF nWaterFlow >= nWaterFlowMin THEN
      dipw1_WaterOk = TRUE
   ELSE
      IF nWaterFlow < (nWaterFlowMin - nWaterFlowHyst) THEN
         dipw1_WaterOk = FALSE
      ENDIF
   ENDIF
   ;NOTE: CL_WaterOk IS KEPT FOR COMPATIBILITY; NO PROGRAM READS IT
   CL_WaterOk = dipw1_WaterOk
   
   ;KL50L2 BEACON - SIGNALS $OUT[3008] CL_BeaconBit3008 (BYTE 589 BIT 0),
   ;$OUT[3024] CL_BeaconBit3024 (BYTE 591 BIT 0), $OUT[3001] CL_BeaconBit3001 (NOT MAPPED ON THE BUS)
   ;NOTE: NONE OF THE BITS IS EVER SWITCHED OFF EXCEPT $OUT[3024]. $OUT[478]/$OUT[477] ARE WRITTEN
   ;NOTE: ONLY BY NutWeld_Bkg, WHICH IS DISABLED: THIS BLOCK NEVER SWITCHES THE BEACON (F29)
   ;RED: WHEN SIGNAL $OUT[478] dopw1_LowLevel ON - SIGNALS $OUT[3008] CL_BeaconBit3008 ON,
   ;$OUT[3024] CL_BeaconBit3024 ON
    IF dopw1_LowLevel THEN
     CL_BeaconBit3008 = TRUE
     CL_BeaconBit3024 = TRUE
    ENDIF
   ;GREEN: WHEN SIGNAL $OUT[477] dopw1_LevelOk ON - SIGNALS $OUT[3001] CL_BeaconBit3001 ON,
   ;$OUT[3024] CL_BeaconBit3024 OFF
   ;CHECK: $OUT[3001] IS NOT MAPPED; R20 USES $OUT[3000] AND $OUT[3016] FOR THE SAME BEACON (F29)
    IF  dopw1_LevelOk THEN
     CL_BeaconBit3001 = TRUE
     CL_BeaconBit3024 = FALSE
    ENDIF


;ENDFOLD (Centerline Pedestal)		
					  
   ;COOLING WATER VALVE - SIGNAL $OUT[475] dopw1_StartWater FOLLOWS SIGNAL $IN[13] di013WaterEnable
   ;(PLC WATER ENABLE), IN EVERY SUBMIT CYCLE (F09)
   ;NOTE: IT STILL OVERRIDES THE WATER OFF OF CENTERLINE_HOME WHILE THE PLC ENABLES THE WATER
   dopw1_StartWater=di013WaterEnable

   ;NUT PRELOAD SEQUENCE (Program/Centerline/PRELOAD.src): SWITCHES THE PEDESTAL VALVES
   ;$OUT[471..505] AND SETS NUT_READY; STARTED BY NUT_START (MOTION TRIGGERS IN PICK/WELD APPS)
   ;WARNING: RUNS IN EVERY OPERATING MODE (ALSO T1/T2, NO ENABLING SWITCH) AND WRITES THE SAME
   ;WARNING: VALVES AS THE ROBOT PROGRAMS, WITH NO OWNERSHIP BETWEEN THEM (F11)
PRELOAD()

