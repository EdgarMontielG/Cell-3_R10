			;FOLD Centerline Pedestal
   ;NOTE: INTEGRATOR CODE FOR THE CENTERLINE PEDESTAL NUT WELDER, RUN IN EVERY SUBMIT CYCLE
	
	
	;GUN STROKE POSITION (BALLUFF BTL6 LPT) - SIGNALS $IN[567..590] CL_LPT_BYTE1..3 INTO
	;CL_GunStrokePositionLPT, BYTE ORDER HIGH TO LOW: BYTE1, BYTE2, BYTE3 (BYTE0 IS NOT USED);
	;CENTERLINE_WELD CHECKS IT (GUN ON THE NUT 69000..73000); GUN OPEN 137000..142000 IS CHECKED BY
	;GUN_OPEN_CHECK AND INTERRUPTS 20-22 OF THE WELD APPS (F01)
	;CHECK: R20 BUILDS THE SAME VALUE FROM ALL FOUR BYTES IN ANOTHER ORDER - CONFIRM THE BTL6
	;CHECK: OUTPUT FORMAT ON THIS PEDESTAL (F23)
	CL_GunStrokePositionLPT=(CL_LPT_BYTE1*65536)+(CL_LPT_BYTE2*256)+CL_LPT_BYTE3

   ;UPPER PIN POSITION - SIGNALS $IN[591..606] CL_PIN_BYTE0..1 INTO CL_WeldPinPosition
   ;NOTE: NO PROGRAM READS CL_WeldPinPosition - THE PIN POSITIONS ARE NOT CHECKED (F16)
   CL_WeldPinPosition=(CL_PIN_BYTE0*256)+CL_PIN_BYTE1
   ;PEDESTAL STATES FOR THE ROBOT MOTION INTERLOCK (PEDESTAL_CLEAR_CHECK, INTERRUPTS 23/24, 2026-10-06):
   ;CL_ClampOpen - PART CLAMP OPEN: SIGNALS $IN[466] di466PartClampOpen ON AND $IN[467] di467PartClampClosed OFF
   ;CL_PinRetracted - CL_WeldPinPosition IN nPinRetractMin..nPinRetractMax (ALWAYS TRUE WITH bPinCheck FALSE)
   CL_ClampOpen=di466PartClampOpen   ;$IN[466] ONLY (2026-10-09, AS 20R1)
   IF bPinCheck THEN
      CL_PinRetracted=(CL_WeldPinPosition>=nPinRetractMin) AND (CL_WeldPinPosition<=nPinRetractMax)
   ELSE
      CL_PinRetracted=TRUE
   ENDIF

   ;WATER FLOW SV0500 - SIGNALS $IN[3000..3015] SV0500_BYTE0..1 INTO SV0500_FLOW
   SV0500_FLOW =( SV0500_BYTE0*256)+SV0500_BYTE1
   
   ;SV0500 = PARKER 5097335 VORTEX FLOW SENSOR, IO-LINK ON TBEN C7: BITS 15..2 = FLOW IN 0.1 L/MIN,
   ;BIT 1 = OUT2, BIT 0 = OUT1. nWaterFlow 250 = 25.0 L/MIN
   ;WATER OK (dipw1_WaterOk, READ BY GUN_OPEN_CHECK) AT OR ABOVE nWaterFlowMin, NOT OK BELOW
   ;nWaterFlowMin - nWaterFlowHyst; LIMITS IN GUN_OPEN_CHECK.dat (F09)
   ;CHECK: nWaterFlowMin 150 (15.0 L/MIN) TO BE CONFIRMED ON THIS ROBOT (F09)
   nWaterFlow = SV0500_FLOW / 4
   IF nWaterFlow >= nWaterFlowMin THEN
      dipw1_WaterOk = TRUE
   ELSE
      IF nWaterFlow < (nWaterFlowMin - nWaterFlowHyst) THEN
         dipw1_WaterOk = FALSE
      ENDIF
   ENDIF
   ;NOTE: CL_WaterOk IS KEPT FOR COMPATIBILITY; NO PROGRAM READS IT
   CL_WaterOk = dipw1_WaterOk

   ;WELD STATUS LIGHTS (2026-10-06, USER REQUEST) - GREEN SIGNAL $OUT[477] dopw1_LevelOk ALWAYS ON,
   ;RED SIGNAL $OUT[478] dopw1_LowLevel INSTEAD WHILE CL_WeldFault ($config.dat) OR THE BOSCH FAULT
   ;$IN[485] dipw1_Fault IS ON. CL_WeldFault IS SET BY CENTERLINE_WELD: GUN NOT CLOSED ON THE NUT
   ;(NO NUT / DOUBLE NUT), NO WELD COMPLETE IN CL_WELD_COMPLETE_TIMEOUT MS, BOSCH FAULT DURING THE WELD;
   ;CLEARED BY THE NEXT GOOD WELD. NOTE: $OUT[477]/$OUT[478] WERE THE HOPPER LEVEL LIGHTS OF
   ;NutWeld_Bkg, WHICH IS DISABLED (F29) - NOTHING ELSE WRITES THEM
   ;2026-10-11: THE LIGHTS ARE NOW WRITTEN BY NutWeld_Bkg (FOLD Hopper1 Low Level, CLIENT STANDARD): RED = HOPPER LOW
   ;  OR CL_WeldFault OR dipw1_Fault, GREEN = ALL OK. ONLY ONE WRITER (TWO = FLICKER): THE TWO LINES BELOW ARE OFF
   ;dopw1_LowLevel = CL_WeldFault OR dipw1_Fault
   ;dopw1_LevelOk = NOT (CL_WeldFault OR dipw1_Fault)

   ;KL50L2 BEACON - SIGNALS $OUT[3008] CL_BeaconBit3008 (BYTE 589 BIT 0),
   ;$OUT[3024] CL_BeaconBit3024 (BYTE 591 BIT 0), $OUT[3001] CL_BeaconBit3001 (NOT MAPPED ON THE BUS)
   ;FOLLOWS THE WELD STATUS LIGHTS ABOVE: $OUT[3008] ON, $OUT[3024] ON = RED, OFF = GREEN (AS R20 WITH
   ;$OUT[3000] / $OUT[3016])
   ;RED: WHEN SIGNAL $OUT[478] dopw1_LowLevel ON - SIGNALS $OUT[3008] CL_BeaconBit3008 ON,
   ;$OUT[3024] CL_BeaconBit3024 ON
    IF dopw1_LowLevel THEN
     CL_BeaconBit3008 = TRUE
     CL_BeaconBit3024 = TRUE
    ENDIF
   ;GREEN: WHEN SIGNAL $OUT[477] dopw1_LevelOk ON - SIGNALS $OUT[3008] CL_BeaconBit3008 ON,
   ;$OUT[3024] CL_BeaconBit3024 OFF ($OUT[3008] ADDED 2026-10-06 AS R20; $OUT[3001] IS NOT MAPPED)
   ;CHECK: CONFIRM ON THE BEACON THAT $OUT[3024] SELECTS RED (F29)
    IF  dopw1_LevelOk THEN
     CL_BeaconBit3001 = TRUE
     CL_BeaconBit3008 = TRUE
     CL_BeaconBit3024 = FALSE
    ENDIF


;ENDFOLD (Centerline Pedestal)		
					  
   ;COOLING WATER VALVE - SIGNAL $OUT[475] dopw1_StartWater FOLLOWS SIGNAL $IN[13] di013WaterEnable
   ;(PLC WATER ENABLE), IN EVERY SUBMIT CYCLE (F09)
   ;NOTE: IT STILL OVERRIDES THE WATER OFF OF CENTERLINE_HOME WHILE THE PLC ENABLES THE WATER
   ;2026-10-09: WATER OFF WHILE THE ROBOT WAITS FOR THE ELECTRODE CHANGE ($OUT[91] do091RobotReadyCapChange,
   ;  GunElectrodeChange) - AS NUT07, WHERE GunElectrodeChange SWITCHES THE WATER OFF
   dopw1_StartWater=di013WaterEnable AND NOT do091RobotReadyCapChange

   ;ELECTRODE CHANGE / WELD COUNTER (2026-10-09, AS THE REFERENCE ROBOT NUT07_10R1): THE BOSCH STEPPER COUNTS THE
   ;  WELDS. END OF STEPPER $IN[487] dipw1_EndOfStepper -> $OUT[111] do111Gun1ElectrodeChange -> CELL CALLS
   ;  GunElectrodeChange (HOME, WATER OFF, PLC HANDSHAKE $OUT[91] / $IN[92] / $OUT[92], PULSE $OUT[485]
   ;  dopw1_StepperReset). IN NUT07 THIS LINE IS IN AutomationCore_Bkg, WHICH IS OFF ON THIS ROBOT
   do111Gun1ElectrodeChange=dipw1_EndOfStepper
   ;STEPPER STATUS TO PLC (AS NutWeld_Bkg OF NUT07) - $OUT[479] dopw1_StepperWarningPL, $OUT[480] dopw1_EndofStepperPL
   ;2026-10-11: STEPPER STATUS NOW WRITTEN BY NutWeld_Bkg (SAME LOGIC, CLIENT STANDARD) - THIS COPY IS OFF
;   IF ((dipw1_StepperWarning==FALSE) AND (dipw1_EndOfStepper==FALSE)) THEN
;      ;NO WARNING, ELECTRODE OK
;      dopw1_StepperWarningPL=TRUE
;      dopw1_EndofStepperPL=FALSE
;   ELSE
;      IF ((dipw1_StepperWarning==TRUE) AND (dipw1_EndOfStepper==FALSE)) THEN
;         ;WARNING ONLY (ELECTRODE CLOSE TO END OF LIFE)
;         dopw1_StepperWarningPL=TRUE
;         dopw1_EndofStepperPL=TRUE
;      ELSE
;         IF (dipw1_EndOfStepper==TRUE) THEN
;            ;END OF ELECTRODE LIFE
;            dopw1_StepperWarningPL=FALSE
;            dopw1_EndofStepperPL=TRUE
;         ENDIF
;      ENDIF
;   ENDIF

   ;BOSCH WELD TIMER ENABLE (2026-10-08, USER REQUEST: ALWAYS ENABLED, AS R20 WITH AutomationCore_Bkg) -
   ;SIGNALS $OUT[481] dopw1_WeldContactEnable AND $OUT[482] dopw1_WeldOnExternal ON OUTSIDE DRY CYCLE
   ;($IN[4] di004UseDryCycle OFF), OFF IN DRY CYCLE. CENTERLINE_WELD NO LONGER SWITCHES THEM AT EVERY NUT;
   ;THE WELD ITSELF IS STILL STARTED ONLY BY $OUT[483] dopw1_WeldInit IN CENTERLINE_WELD
   IF di004UseDryCycle THEN
      dopw1_WeldContactEnable=FALSE
      dopw1_WeldOnExternal=FALSE
   ELSE
      dopw1_WeldContactEnable=TRUE
      dopw1_WeldOnExternal=TRUE
   ENDIF

   ;WELD MODE TO THE PLC (2026-10-09, AS 20R1/30R1 IN AutomationCore_Bkg, WHICH IS OFF ON THIS ROBOT) -
   ;SIGNAL $OUT[46] do046WeldMode = NOT $IN[4] di004UseDryCycle. BEFORE, ONLY THE INIT WROTE IT (OFF) AND
   ;THE USER HAD TO SWITCH IT ON BY HAND FOR THE ROBOT TO CONTINUE
   do046WeldMode=NOT di004UseDryCycle

   ;NUT WELDER STATUS TO THE PLC EVERY CYCLE, AS 20R1 (AutomationCore_Bkg LINES 91-96; IT IS OFF ON THIS ROBOT)
   ;2026-10-10: HOPPER LEVEL, BOSCH READY / FAULT, AIR PRESSURE, WATER FLOW. BEFORE ONLY THE INIT WROTE THEM (FALSE)
   do107Hopper1LowLevel= NOT dipw1_HopperLowLevel
   do118Nut1Ready= (dipw1_Ready AND NOT dipw1_Fault)
   do134Nut1Fault= (dipw1_Fault OR NOT dipw1_Ready)
   do094AirOK= dipw1_AirOK
   do013WaterIsOn = dipw1_WaterOk

   ;ROBOT AT REPAIR POSITION TO THE PLC (2026-10-11, USER: WORKS ON 20R1 IN AUTO) - SIGNAL $OUT[9] do009RobotAtRepair =
   ;  TCP WITHIN $Repair_POS_TOL (10 MM) OF XREPAIR (AUTOMATIONGLOBALPOS.DAT). SAME CODE AS AutomationCore_Bkg
   ;  'POSITIONAL MONITORING' ON 20R1, WHICH IS OFF ON THIS ROBOT (BEFORE ONLY THE INIT WROTE IT: ALWAYS OFF)
   IF (VARSTATE("$POS_ACT")==#INITIALIZED) THEN
      ON_ERROR_PROCEED
      PosCheck = $POS_ACT
      IF ($ERR.NUMBER<>1419) THEN
         do009RobotAtRepair=AC_CheckSphWZ(xRepair,$Repair_POS_TOL)
      ENDIF
   ENDIF

   ;NUT PRELOAD SEQUENCE (Program/Centerline/PRELOAD.src): SWITCHES THE PEDESTAL VALVES
   ;$OUT[471..505] AND SETS NUT_READY; STARTED BY NUT_START (MOTION TRIGGERS IN PICK/WELD APPS)
   ;WARNING: RUNS IN EVERY OPERATING MODE (ALSO T1/T2, NO ENABLING SWITCH) AND WRITES THE SAME
   ;WARNING: VALVES AS THE ROBOT PROGRAMS, WITH NO OWNERSHIP BETWEEN THEM (F11)
PRELOAD()

