   ;========================================

   ;============SV0500 COOLING WATER FLOW=====
   ; Parker 5097335 vortex flow sensor, IO-Link on TBEN C7
   ; Process data word: bits 15..2 = flow [0.1 l/min]
   ;                    bit 1 = OUT2, bit 0 = OUT1 (sensor switches)
   ; nWaterFlow e.g. 250 = 25.0 l/min (6.6 gpm)
   ; Limits nWaterFlowMin / nWaterFlowHyst in GUN_OPEN_CHECK.dat
   ; 2026-10-05: before, water was always reported OK (also without water)
   SV0500_FLOW =( SV0500_BYTE0*256)+SV0500_BYTE1
   nWaterFlow = SV0500_FLOW / 4
   IF nWaterFlow >= nWaterFlowMin THEN
      dipw1_WaterOk = TRUE
   ELSE
      IF nWaterFlow < (nWaterFlowMin - nWaterFlowHyst) THEN
         dipw1_WaterOk = FALSE
      ENDIF
   ENDIF
   CL_WaterOk = dipw1_WaterOk   ; Kept for compatibility (not used in programs)
