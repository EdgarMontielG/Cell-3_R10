;NOTE: RESET_OUT RUNS WHEN THE ROBOT PROGRAM IS CANCELLED ($PRO_STATE1 = #P_FREE) AND ONLY RESETS
;NOTE: THE PGNO HANDSHAKE OUTPUTS - THE CENTERLINE PEDESTAL IS NOT PUT IN A SAFE STATE (F10)
DEF  RESET_OUT ( )
  INT N
  MsgLoop(" ")
  IF REFLECT_PROG_NR == 1 THEN
    FOR N = 0 TO PGNO_LENGTH - 1
      $OUT[PGNO_FBIT_REFL + N] = FALSE
    ENDFOR
  ENDIF
  IF (PGNO_REQ>0) THEN
    $OUT[PGNO_REQ]=FALSE
  ELSE
    IF (PGNO_REQ<0) THEN
      $OUT[-PGNO_REQ]=TRUE
    ENDIF
  ENDIF
END

