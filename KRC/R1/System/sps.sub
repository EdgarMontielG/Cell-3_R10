;NOTE: NutWeld_Bkg IS DISABLED IN THE FOLD BELOW: NO HOPPER LEVEL LIGHTS $OUT[477]/$OUT[478],
;NOTE: NO NUTWELD STATUS KEYS AND NO NUTWELD PROCESS RESET ON PROGRAM CANCEL (F12, F29)
;FOLD NutWeld PLC
;ENDFOLD (NutWeld PLC)
;NOTE: AutomationCore_Bkg IS DISABLED IN THE FOLD BELOW - ITS PLC STATUS BITS STAY STATIC (F12, C01)
;FOLD Automation Core PLC
;ENDFOLD (Automation Core PLC)
				 
			;FOLD Centerline Pedestal
   ;NOTE: INTEGRATOR CODE FOR THE CENTERLINE PEDESTAL NUT WELDER, RUN IN EVERY SUBMIT CYCLE
	
	
	;GUN STROKE POSITION (BALLUFF BTL6 LPT) - SIGNALS $IN[567..590] CL_LPT_BYTE1..3 INTO
	;CL_GunStrokePositionLPT, BYTE ORDER HIGH TO LOW: BYTE1, BYTE2, BYTE3 (BYTE0 IS NOT USED);
	;CENTERLINE_WELD CHECKS IT (GUN ON THE NUT 69000..73000, GUN OPEN > 120000)
	;CHECK: R20 BUILDS THE SAME VALUE FROM ALL FOUR BYTES IN ANOTHER ORDER - CONFIRM THE BTL6
	;CHECK: OUTPUT FORMAT ON THIS PEDESTAL (F23)
	CL_GunStrokePositionLPT=(CL_LPT_BYTE1*65536)+(CL_LPT_BYTE2*256)+CL_LPT_BYTE3

   ;UPPER PIN POSITION - SIGNALS $IN[591..606] CL_PIN_BYTE0..1 INTO CL_WeldPinPosition
   ;NOTE: NO PROGRAM READS CL_WeldPinPosition - THE PIN POSITIONS ARE NOT CHECKED (F16)
   CL_WeldPinPosition=(CL_PIN_BYTE0*256)+CL_PIN_BYTE1

   ;WATER FLOW SV0500 - SIGNALS $IN[3000..3015] SV0500_BYTE0..1 INTO SV0500_FLOW
   SV0500_FLOW =( SV0500_BYTE0*256)+SV0500_BYTE1
   
   ;CL_WaterOk = TRUE WHEN SV0500_FLOW > 1230, ELSE FALSE; NOTHING READS CL_WaterOk
   ;WARNING: dipw1_WaterOk (A BOOL VARIABLE, NOT A SIGNAL) IS SET TRUE IN BOTH BRANCHES - THE
   ;  WATER FLOW RESULT IS THROWN AWAY. CENTERLINE_WELD DOES NOT READ EITHER ONE (F09)
   ;CHECK: OLD COMMENT SAID "1230 = WATER OK", BUT THE CODE TREATS EXACTLY 1230 AS NOT OK (F09)
   IF SV0500_FLOW > 1230 THEN
   CL_WaterOk = TRUE
   dipw1_WaterOk = TRUE
   ELSE
   CL_WaterOk = FALSE
   dipw1_WaterOk = TRUE
   ENDIF
   
   ;KL50L2 BEACON - SIGNALS $OUT[3008] (KL50L2 BYTE 589 BIT 0), $OUT[3024] (KL50L2 BYTE 591 BIT 0),
   ;$OUT[3001] (NOT MAPPED ON THE BUS)
   ;NOTE: ALL THREE BITS ARE UNDECLARED AND NONE IS EVER SWITCHED OFF EXCEPT $OUT[3024].
   ;NOTE: $OUT[478]/$OUT[477] ARE WRITTEN ONLY BY NutWeld_Bkg, WHICH IS DISABLED: THIS BLOCK
   ;NOTE: NEVER SWITCHES THE BEACON (F29)
   ;RED: WHEN SIGNAL $OUT[478] dopw1_LowLevel ON - SIGNALS $OUT[3008] ON, $OUT[3024] ON
    IF $OUT[478] THEN
     $OUT[3008] = TRUE
     $OUT[3024] = TRUE
    ENDIF
   ;GREEN: WHEN SIGNAL $OUT[477] dopw1_LevelOk ON - SIGNALS $OUT[3001] ON, $OUT[3024] OFF
   ;CHECK: $OUT[3001] IS NOT MAPPED; R20 USES $OUT[3000] AND $OUT[3016] FOR THE SAME BEACON (F29)
    IF  $OUT[477] THEN
     $OUT[3001] = TRUE
     $OUT[3024] = FALSE
    ENDIF


;ENDFOLD (Centerline Pedestal)		
					  
   ;COOLING WATER ON - SIGNAL $OUT[475] dopw1_StartWater ON WHILE SIGNAL $IN[4] di004UseDryCycle OFF
   ;NOTE: WRITTEN IN EVERY SUBMIT CYCLE AND NEVER SWITCHED OFF HERE: IT OVERRIDES THE WATER OFF
   ;NOTE: OF CENTERLINE_HOME AND DOES NOT USE SIGNAL $IN[13] di013WaterEnable (F09)
IF di004UseDryCycle==FALSE THEN
   $OUT[475]=TRUE
   ENDIF

   ;NUT PRELOAD SEQUENCE (Program/Centerline/PRELOAD.src): SWITCHES THE PEDESTAL VALVES
   ;$OUT[471..505] AND SETS NUT_READY; STARTED BY NUT_STAR (MOTION TRIGGERS IN PICK/WELD APPS)
   ;WARNING: RUNS IN EVERY OPERATING MODE (ALSO T1/T2, NO ENABLING SWITCH) AND WRITES THE SAME
   ;WARNING: VALVES AS THE ROBOT PROGRAMS, WITH NO OWNERSHIP BETWEEN THEM (F11)
PRELOAD()

