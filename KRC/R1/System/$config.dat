;FOLD Centerline
;CENTERLINE PEDESTAL PROJECTION NUT WELDER (PNW1): BUS SIGNALS AND THE VALUES SPS.SUB BUILDS
;FROM THEM. THIS FOLD AND THE TWO BELOW LIE OUTSIDE THE USER GLOBALS FOLD.

;=============ITV-IL===================
;GUN PRESSURE SET-POINT, SMC ITV REGULATOR - SIGNALS $OUT[506..521] CL_GunPressureCmd
;THE PROGRAMS WRITE CL_GUN_PRESS_BASE (GENERAL), CL_GUN_PRESS_WELD (INTENSIFY) AND
;CL_GUN_PRESS_REST (END OF WELD) - FOLD CENTERLINE CONTROL BELOW
;CHECK: KRC_IO.xml SENDS THIS WORD BYTE-SWAPPED, AS ON R20 WHERE THE REGULATOR NEEDS SWAPPED
;CHECK: VALUES (39425 = 0.09 MPa). 405 AND 1820 ARE NOT SWAPPED, 39425 IS - ONE SET IS WRONG (F44)
;NOTE: $OUT[512..521] ALSO CARRY AutomationCore do512..do521 AND NutWeld dopw2_ NAMES (F17)
SIGNAL CL_GunPressureCmd $OUT[506]  TO $OUT[521]

;=============SV0500===================
;COOLING WATER FLOW, SV0500 SENSOR - SIGNALS $IN[3000..3015] SV0500_BYTE0..1
;SPS.SUB: SV0500_FLOW = BYTE0*256 + BYTE1, CL_WaterOK = (SV0500_FLOW > 1230)
;NOTE: NO PROGRAM CHECKS THE WATER FLOW BEFORE THE WELD (F09)

SIGNAL SV0500_BYTE0 $IN[3000]  TO $IN[3007]
SIGNAL SV0500_BYTE1 $IN[3008]  TO $IN[3015]
DECL INT SV0500_FLOW
DECL BOOL CL_WaterOK

;==========GUN POSITION========
;GUN STROKE POSITION, BALLUFF BTL6 LINEAR TRANSDUCER (LPT) - SIGNALS $IN[559..590] CL_LPT_BYTE0..3
;SPS.SUB ASSEMBLES CL_GunStrokePositionLPT FROM BYTES 1..3 (BYTE0 IS NOT USED, F23)
;NOTE: $IN[561..590] ALSO CARRY AutomationCore di561..di590 AND NutWeld dipw3_ NAMES (F17)
SIGNAL CL_LPT_BYTE0 $IN[559]  TO $IN[566]
SIGNAL CL_LPT_BYTE1 $IN[567]  TO $IN[574]
SIGNAL CL_LPT_BYTE2 $IN[575]  TO $IN[582]
SIGNAL CL_LPT_BYTE3 $IN[583]  TO $IN[590]

INT CL_GunStrokePositionLPT=139790



;==========UPPER PIN POSITION==================
;UPPER WELD PIN POSITION TRANSDUCER - SIGNALS $IN[591..606] CL_PIN_BYTE0..1
;SPS.SUB ASSEMBLES CL_WeldPinPosition = BYTE0*256 + BYTE1; NO PROGRAM READS IT (F16)
;NOTE: THESE INPUTS ALSO CARRY AutomationCore di591..di606 AND NutWeld aiNutSensorPW3 NAMES (F17)

SIGNAL CL_PIN_BYTE0 $IN[591]  TO $IN[598]
SIGNAL CL_PIN_BYTE1 $IN[599]  TO $IN[606]

INT CL_WeldPinPosition=27339

;=============KL50L2 BEACON============
;HOPPER LEVEL BEACON KL50L2, WRITTEN BY sps.sub FROM dopw1_LowLevel / dopw1_LevelOk - THOSE ARE
;WRITTEN ONLY BY NutWeld_Bkg, DISABLED (F29). BIT MEANINGS TO CONFIRM; $OUT[3001] IS NOT MAPPED
SIGNAL CL_BeaconBit3001 $OUT[3001]
SIGNAL CL_BeaconBit3008 $OUT[3008]
SIGNAL CL_BeaconBit3024 $OUT[3024]

;ENDFOLD (Centerline)

;FOLD CENTERLINE CONTROL
;LIMITS AND SETTINGS OF THE NUT WELD, USED BY CENTERLINE_WELD (centerline_weld.src)
;UPPER PIN WELD WINDOW ON CL_WeldPinPosition - NOT USED YET: NO PROGRAM CHECKS THE UPPER PIN (F16)
DECL INT CL_PIN_WELD_MIN=10000
DECL INT CL_PIN_WELD_MAX=13500
;GUN STROKE WINDOW ON CL_GunStrokePositionLPT WITH THE GUN CLOSED ON THE NUT - THE WINDOW
;CENTERLINE_WELD HAS ALWAYS CHECKED (69000..73000; THESE TWO WERE DECLARED 65000..76000, THE
;RANGE OF THE COMMENT TABLE, AND NOT USED)
DECL INT CL_GUN_WELD_MIN=69000
DECL INT CL_GUN_WELD_MAX=73000
;NOTE: THE GUN OPEN RANGE (137000..142000) IS nGunOpenMin/nGunOpenMax IN GUN_OPEN_CHECK.dat (F01)
;GUN CLOSED CHECK, IN MS: TIMEOUT ($TIMER[14]) AND TIME IN THE WINDOW ($TIMER[15])
DECL INT CL_GUN_CLOSE_TIMEOUT=1000
DECL INT CL_GUN_IN_WINDOW_TIME=300
;GUN PRESSURE WORDS FOR CL_GunPressureCmd, AS USED IN PRODUCTION:
;BASE 405 (GENERAL), WELD 1820 (INTENSIFY), REST 39425 (AFTER THE WELD)
;CHECK: BASE AND WELD ARE NOT BYTE-SWAPPED, REST IS; THE BUS SWAPS THE WORD - CONFIRM ON THE
;CHECK: REGULATOR WHICH IS RIGHT BEFORE CHANGING ANY OF THEM (F44)
DECL INT CL_GUN_PRESS_BASE=405
DECL INT CL_GUN_PRESS_WELD=1820
DECL INT CL_GUN_PRESS_REST=39425
;BOSCH WELD PROGRAM SELECTED ON gdopw1_SpotNumber ($OUT[486..493])
DECL INT CL_WELD_PROGRAM=2

;ENDFOLD

;FOLD -----------preload---------------
;STATE OF THE NUT PRELOAD (PRELOAD.src, CALLED EVERY SPS CYCLE BY SPS.SUB)
;NUT_START = PRELOAD START REQUEST (FEED AND LOAD): SET BY THE PICK TRIGGER AT P12/P10 AND BY
;Request_next_nut, CLEARED BY PRELOAD WHEN IT STARTS - OR, WHEN A FEED-ONLY PRELOAD IS WAITING,
;WHEN PRELOAD TAKES IT AS THE LOAD REQUEST (NUT_LOAD_OK)
DECL BOOL NUT_START=FALSE
;NUT_FEED_START = FEED-ONLY START: SET BY WELD APPS 1-2 (style1app1opt1A/B, 2A/B) AT THE WAIT POINT
;WHEN THEIR NUT IS READY, SO THE NEXT NUT IS FED INTO THE SHUTTLE WHILE THE ROBOT MOVES IN AND
;WELDS; CLEARED BY PRELOAD WHEN IT STARTS (F52)
DECL BOOL NUT_FEED_START=FALSE
;NUT_LOAD_OK = THE ACTIVE PRELOAD MAY LOAD THE NUT ONTO THE PIN (STEPS 10, 20): TRUE FROM THE START
;FOR NUT_START, FROM THE LOAD REQUEST FOR A FEED-ONLY PRELOAD; CLEARED WHEN THE PRELOAD ENDS (F52)
DECL BOOL NUT_LOAD_OK=FALSE
;NUT_READY = PRELOAD FINISHED (NO NUT SENSOR CONFIRMS IT, F13): SET BY PRELOAD WHEN IT ENDS.
;NUT 1 (style1app1opt1A/B) WAITS FOR IT; CENTERLINE_WELD FEEDS A NUT ITSELF WHEN IT IS FALSE (F25).
;CLEARED WHEN A FULL PRELOAD STARTS, WHEN A FEED-ONLY PRELOAD GETS ITS LOAD REQUEST (F52) AND ON
;THE GUN-CLOSED TIMEOUT IN CENTERLINE_WELD, NOT AFTER A WELD (F14). WHILE DRY CYCLE IS ON, A
;STARTED PRELOAD CLEARS IT AND NEVER SETS IT (F04)
DECL BOOL NUT_READY=TRUE
;PRELOAD RUNNING, CURRENT STEP (0 FEED NUT, 10 QFP ADVANCE AND NUT BLOW-OFF, 20 QFP RETURN)
;AND STEP-DONE FLAGS
DECL BOOL NUTCYCLE_ACTIVE=FALSE
DECL INT NUT_PRELOAD_STEP=0
DECL BOOL STEP0DONE=TRUE
DECL BOOL STEP10DONE=TRUE
DECL BOOL STEP20DONE=TRUE
;NOTE: NUT_PRELOAD_FAULT IS ONLY RESET BY PRELOAD, NEVER SET TRUE (F13)
DECL BOOL NUT_PRELOAD_FAULT=FALSE
;NEXT-NUT HANDSHAKE: Request_next_nut CLEARS NEXT_NUT_READY AND SETS NEXT_NUT_REQUEST; PRELOAD
;SETS NEXT_NUT_READY WHEN THAT PRELOAD ENDS. NUTS 2 AND 3 (style1app1opt2A/B, 3A/B) WAIT FOR IT
DECL BOOL NEXT_NUT_READY=TRUE
DECL BOOL NEXT_NUT_REQUEST=FALSE
;PRELOAD STEP 10: SET WHEN THE QFP IS CONFIRMED RETURNED; FROM THEN ON STEP 10 ADVANCES THE QFP
DECL BOOL STEP10_ADV_STARTED=FALSE
;NOTE: PRELOAD USES $TIMER[10], [11], [13], CENTERLINE_WELD $TIMER[14..15], THE CYCLE-TIME
;  MEASUREMENT (CL_CYCLE_TIME) $TIMER[20]. VENDOR CODE: TQM 7, 8, 18, AUTOMATIONCORE 55, NUTWELD
;  41, 42; GLUETECH CLAIMS 12-16 AND 35 BUT NO GLUETECH PROCESS ROUTINE RUNS ON THIS CELL (F26)
;ENDFOLD

ENDDAT
