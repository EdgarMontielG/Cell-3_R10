--- 1b28a7e:KRC/R1/Program/Centerline/centerline_weld.src
+++ backup:KRC/R1/Program/Centerline/centerline_weld.src
@@ -18,11 +18,14 @@
 ;  ROBOT IS ALREADY AT THE WELD POSITION (F01)
 ;NOTE: THE NUT IS NORMALLY PRELOADED BY PRELOAD() IN THE SUBMIT INTERPRETER (NUT_READY TRUE);
 ;  PRELOAD DRIVES THE SAME PEDESTAL VALVES, WITH NO OWNERSHIP BETWEEN THE TWO (F11)
+;NOTE: DURING THIS WELD A FEED-ONLY PRELOAD STARTED BY WELD APPS 1-2 MAY BE FEEDING THE NEXT NUT
+;  INTO THE SHUTTLE (NUTCYCLE_ACTIVE TRUE): THE FEED OUTPUT $OUT[476] IS LEFT TO IT (F52)
 ;NOTE: NO WATER FLOW CHECK BEFORE THE WELD (F09), NO FAULT CHECK AFTER THE WELD (F08),
 ;  NO TIMEOUT OR MESSAGE ON THE WAITS (F15), PIN POSITIONS NOT VERIFIED (F16)
 ;NOTE: NUT_READY IS NOT CLEARED WHEN THE NUT IS WELDED (F14)
 ;NOTE: NOTHING PUTS THE PEDESTAL IN A SAFE STATE IF THIS PROGRAM IS CANCELLED (F10)
 ;NOTE: USES $TIMER[14] (GUN-CLOSED TIMEOUT) AND $TIMER[15] (TIME IN THE WINDOW) (F26)
+;NOTE: CL_CYCLE_TIME(2..13) RECORDS THE TIME OF EACH STEP ($TIMER[20], CL_CYCLE_TIME.dat) (F52)
 ;NOTE: LIMITS, PRESSURE WORDS AND WELD PROGRAM ARE CONSTANTS IN $config.dat (FOLD CENTERLINE CONTROL)
 ;********************************
 
@@ -52,6 +55,9 @@
 ;PRESSURE 2730  0.60MPa    87.02 PSI
 ;CL_GUN_PRESS_BASE = 405 = 0.089 MPa IF NOT SWAPPED
 
+;CYCLE-TIME MARK - STEP 2 AT THE WELD POSITION (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(2)
+
 ;PEDESTAL START POSITION (NOT A FULL HOME: THE LOWER PIN IS ADVANCED)
 
 ;GUN OPEN - SIGNALS $OUT[472] dopw1_GunWork OFF, $OUT[471] dopw1_GunHome ON
@@ -81,7 +87,10 @@
 
 ;LOCAL NUT FEED - ONLY WHEN NO NUT WAS PRELOADED BY PRELOAD() (NUT_READY FALSE). NORMALLY
 ;  SKIPPED: PRELOAD SETS NUT_READY FOR EVERY NUT BEFORE THE CALLER MOVES IN
-IF NOT NUT_READY THEN
+;NOTE: NOT WHILE A PRELOAD IS RUNNING (NUTCYCLE_ACTIVE): THE NEXT NUT MAY ALREADY BE IN THE SHUTTLE
+;  (FEED-ONLY PRELOAD, F52). A RETRY AFTER THE GUN-CLOSED TIMEOUT THEN WELDS WITH WHAT IS ON THE
+;  PIN; WITH NO NUT THE GUN-CLOSED CHECK STOPS AGAIN (F07)
+IF NOT NUT_READY AND NOT NUTCYCLE_ACTIVE THEN
    ;LOWER PIN ADVANCE AND BLOW-OFF - SIGNALS $OUT[496] dopw1_ReturnPin OFF,
    ;  $OUT[495] dopw1_AdvancePin ON, $OUT[494] dopw1_BlowOff ON
    dopw1_ReturnPin=FALSE
@@ -109,6 +118,8 @@
    ;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON
    WAIT FOR dipw1_SpearHome
 ENDIF
+;CYCLE-TIME MARK - STEP 3 PEDESTAL READY (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(3)
 
 ;UPPER PIN EXTEND - SIGNALS $OUT[499] do499UpperPinRetract OFF, $OUT[498] do498UpperPinExtend ON
 do499UpperPinRetract=FALSE
@@ -123,12 +134,16 @@
 dopw1_WeldContactEnable=FALSE
 dopw1_WeldOnExternal=FALSE
 gdopw1_SpotNumber=0
-;RESET PEDESTAL OUTPUTS - SIGNALS $OUT[476] dopw1_StartFeed OFF, $OUT[494] dopw1_BlowOff OFF,
+;RESET PEDESTAL OUTPUTS - SIGNALS $OUT[494] dopw1_BlowOff OFF,
 ;  $OUT[474] dopw1_Nut1Intensify OFF (NOT ON THE BUS), $OUT[473] dopw1_Nut1Intensify_Home ON
-dopw1_StartFeed=FALSE
 dopw1_Nut1Intensify=FALSE
 dopw1_Nut1Intensify_Home=TRUE
 dopw1_BlowOff=FALSE
+;FEED OFF - SIGNAL $OUT[476] dopw1_StartFeed OFF, ONLY WHEN NO PRELOAD IS RUNNING: A PRELOAD STARTED
+;  BY THE WELD APP (NUT_FEED_START) FEEDS THE NEXT NUT INTO THE SHUTTLE DURING THIS WELD (F52)
+IF NOT NUTCYCLE_ACTIVE THEN
+   dopw1_StartFeed=FALSE
+ENDIF
 ;GUN GENERAL PRESSURE AGAIN - SIGNALS $OUT[506..521] CL_GunPressureCmd = CL_GUN_PRESS_BASE
 CL_GunPressureCmd=CL_GUN_PRESS_BASE
 ;ENABLE BOSCH WELD TIMER - SIGNALS $OUT[481] dopw1_WeldContactEnable ON,
@@ -138,12 +153,16 @@
 
 ;WAIT BOSCH READY - SIGNAL $IN[484] dipw1_Ready ON
 WAIT FOR dipw1_Ready
+;CYCLE-TIME MARK - STEP 4 BOSCH READY (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(4)
 
 ;PART CLAMP CLOSE - SIGNALS $OUT[502] do502PartClampOpen OFF, $OUT[501] do501PartClampClose ON
 do502PartClampOpen=FALSE
 do501PartClampClose=TRUE
 ;WAIT PART CLAMP CLOSED - SIGNAL $IN[467] di467PartClampClosed ON
 WAIT FOR di467PartClampClosed
+;CYCLE-TIME MARK - STEP 5 PART CLAMP CLOSED (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(5)
 
 ;GUN CLOSE - SIGNALS $OUT[471] dopw1_GunHome OFF, WAIT 0.2 S, $OUT[472] dopw1_GunWork ON
 dopw1_GunHome=FALSE
@@ -200,6 +219,8 @@
 $TIMER[14]=0
 $TIMER_STOP[15]=TRUE
 $TIMER[15]=0
+;CYCLE-TIME MARK - STEP 6 GUN CLOSED ON THE NUT (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(6)
 
 ;WELD ON EXTERNAL - SIGNAL $OUT[482] dopw1_WeldOnExternal ON (ALREADY ON SINCE THE BOSCH ENABLE)
 dopw1_WeldOnExternal=TRUE
@@ -210,6 +231,8 @@
 
 ;WAIT BOSCH READY - SIGNAL $IN[484] dipw1_Ready ON
 WAIT FOR dipw1_Ready
+;CYCLE-TIME MARK - STEP 7 BOSCH READY AGAIN (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(7)
 
 ;INTENSIFY - GUN PRESSURE - SIGNALS $OUT[506..521] CL_GunPressureCmd = CL_GUN_PRESS_WELD (F44)
 CL_GunPressureCmd=CL_GUN_PRESS_WELD
@@ -222,6 +245,8 @@
 
 ;WAIT INTENSIFY PRESSURE OK - SIGNAL $IN[479] dipw1_IntensfPresOk ON (NO TIMEOUT, F15)
 WAIT FOR dipw1_IntensfPresOk
+;CYCLE-TIME MARK - STEP 8 INTENSIFY PRESSURE OK (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(8)
 
 ;CONFIRM GUN POSITION BEFORE WELDING - WAIT CL_GunStrokePositionLPT IN CL_GUN_WELD_MIN..MAX
 WAIT FOR (CL_GunStrokePositionLPT>=CL_GUN_WELD_MIN) AND (CL_GunStrokePositionLPT<=CL_GUN_WELD_MAX)
@@ -230,10 +255,14 @@
 dopw1_WeldInit=TRUE
 
 WAIT FOR dipw1_WeldComplete
+;CYCLE-TIME MARK - STEP 9 WELD COMPLETE ON (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(9)
 
 ;WELD START OFF - SIGNAL $OUT[483] dopw1_WeldInit OFF, WAIT $IN[483] dipw1_WeldComplete OFF
 dopw1_WeldInit=FALSE
 WAIT FOR NOT dipw1_WeldComplete
+;CYCLE-TIME MARK - STEP 10 WELD COMPLETE OFF (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(10)
 ;NOTE: NO FAULT CHECK AFTER THE WELD - $IN[485] dipw1_Fault IS NOT READ BY ANY ACTIVE CODE
 ;  (ONLY BY THE UNUSED NUTWELD AND DISABLED AUTOMATIONCORE ROUTINES); WELD COMPLETE
 ;  IS TAKEN AS A GOOD WELD (F08)
@@ -262,6 +291,8 @@
 ;GUN OPEN INTERLOCK BEFORE THE PART IS RELEASED AND THE ROBOT LEAVES - GUN_OPEN_CHECK: SUBMIT RUNNING,
 ;WATER OK, CL_GunStrokePositionLPT IN 137000..142000 (MESSAGE AFTER 2 S, WAITS), THEN 0.2 S (F01)
 GUN_OPEN_CHECK()
+;CYCLE-TIME MARK - STEP 11 GUN OPEN CONFIRMED (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(11)
 WAIT SEC 0.2
 
 ;UPPER PIN RETRACT - SIGNALS $OUT[498] do498UpperPinExtend OFF, $OUT[499] do499UpperPinRetract ON
@@ -273,6 +304,8 @@
 do502PartClampOpen=TRUE
 ;WAIT PART CLAMP OPEN - SIGNAL $IN[466] di466PartClampOpen ON
 WAIT FOR di466PartClampOpen
+;CYCLE-TIME MARK - STEP 12 PART CLAMP OPEN (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(12)
 
 ;LOWER PIN ADVANCE - SIGNALS $OUT[496] dopw1_ReturnPin OFF, $OUT[495] dopw1_AdvancePin ON
 ;CHECK: OLD COMMENT SAID LOWER PIN RETURN; THE CODE ADVANCES THE PIN HERE (F27)
@@ -285,11 +318,13 @@
 ;WAIT QFP RETURNED - SIGNAL $IN[482] dipw1_SpearHome ON
 WAIT FOR dipw1_SpearHome
 
-;FINAL RESET - SIGNALS $OUT[476] dopw1_StartFeed OFF, $OUT[483] dopw1_WeldInit OFF,
-;  $OUT[486..493] gdopw1_SpotNumber = 0
-dopw1_StartFeed=FALSE
+;FINAL RESET - SIGNALS $OUT[483] dopw1_WeldInit OFF, $OUT[486..493] gdopw1_SpotNumber = 0
 dopw1_WeldInit=FALSE
 gdopw1_SpotNumber=0
+;FEED OFF - SIGNAL $OUT[476] dopw1_StartFeed OFF, ONLY WHEN NO PRELOAD IS RUNNING (AS ABOVE, F52)
+IF NOT NUTCYCLE_ACTIVE THEN
+   dopw1_StartFeed=FALSE
+ENDIF
 
 ;CHECK: CL_GUN_PRESS_REST (39425) BELOW IS THE R20 BYTE-SWAPPED 0.09 MPa, NOT THE CL_GUN_PRESS_BASE
 ;CHECK: USED ABOVE; NOT SWAPPED IT IS OUT OF THE ITV RANGE (0..4095). THE GUN RESTS AT THIS VALUE
@@ -306,4 +341,6 @@
 dopw1_WeldContactEnable=FALSE
 dopw1_WeldOnExternal=FALSE
 
+;CYCLE-TIME MARK - STEP 13 CENTERLINE_WELD ENDS (CL_CYCLE_TIME, F52)
+CL_CYCLE_TIME(13)
 END
