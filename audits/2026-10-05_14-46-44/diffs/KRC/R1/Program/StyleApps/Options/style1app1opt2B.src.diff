--- /dev/null
+++ backup:KRC/R1/Program/StyleApps/Options/style1app1opt2B.src
@@ -0,0 +1,139 @@
+&ACCESS RVO2
+&REL 1
+&COMMENT GE4_002_GUN1
+&PARAM EDITMASK = *
+&PARAM TEMPLATE = C:\KRC\TP\Nutweld\Template\NutWeld_Vorgabe
+&PARAM DISKPATH = KRC:\R1\Program\StyleApps\Options
+DEF style1app1opt2B( )
+;FOLD PROGRAM INFO
+;**********************************************************
+;* Customer : Gestamp
+;* Cell     : BMW-03-10 / Robot R1
+;* Part     : GE4-002
+;* Program  : style1app1opt2
+;* Function : Nut welding PN2. Approach the nut welder,
+;*            weld the nut (skipped in dry cycle) and
+;*            retract. The weld is repeated while
+;*            NUT_WELD_RETRY is set.
+;* Rev.     : 2026-10-05 - GOTO jumps replaced with
+;*            structured IF and LOOP logic
+;*            2026-10-05 - Gun open interlock (GUN_OPEN_CHECK)
+;*            and gun monitoring interrupts 20-22
+;**********************************************************
+;ENDFOLD
+   ;FOLD INI
+      ;FOLD BASISTECH INI
+         GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
+         INTERRUPT ON 3 
+         BAS (#INITMOV,0 )
+      ;ENDFOLD (BASISTECH INI)
+      ;FOLD NutWeld
+      ;ENDFOLD (NutWeld)
+      ;FOLD USER INI
+         ;Make your modifications here
+         
+      ;ENDFOLD (USER INI)
+   ;ENDFOLD (INI)
+;--- Approach to nut welder ---
+;FOLD PTP P0 CONT Vel=100 % PDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:C_DIS, 5:100, 7:PDAT0
+$BWDSTART=FALSE
+PDAT_ACT=PPDAT0
+FDAT_ACT=FP0
+BAS(#PTP_PARAMS,100)
+PTP XP0 C_DIS
+;ENDFOLD
+;FOLD LIN P5 Vel=2 m/s CPDAT11 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P5, 3:, 5:2, 7:CPDAT11
+$BWDSTART=FALSE
+LDAT_ACT=LCPDAT11
+FDAT_ACT=FP5
+BAS(#CP_PARAMS,2)
+LIN XP5 
+;ENDFOLD
+;FOLD GUN MONITORING INTERRUPTS 20-22
+; Stops the robot (BRAKE F, routine GUN_OPEN_LOST) if the nut
+; welder gun leaves the open range, or the Submit stops, while
+; the robot moves into / out of the welder.
+; Edge triggered: GUN_OPEN_CHECK confirms the gun open before
+; every INTERRUPT ON 20-22.
+; KRL interrupt conditions only accept simple comparisons with
+; constants: the open range 137000 - 142000 is written here as
+; constants. Keep equal to nGunOpenMin / nGunOpenMax in
+; GUN_OPEN_CHECK.dat
+INTERRUPT DECL 20 WHEN CL_GunStrokePositionLPT<137000 DO GUN_OPEN_LOST()
+INTERRUPT DECL 21 WHEN CL_GunStrokePositionLPT>142000 DO GUN_OPEN_LOST()
+INTERRUPT DECL 22 WHEN $PRO_STATE0<>#P_ACTIVE DO GUN_OPEN_LOST()
+;ENDFOLD
+;--- Weld nut (repeated if a weld retry is requested) ---
+LOOP
+WAIT FOR NEXT_NUT_READY==TRUE   ; Wait until nut is ready
+GUN_OPEN_CHECK()   ; Interlock: nut welder gun must be open before entering
+INTERRUPT ON 20    ; Monitor gun while the robot moves into the welder
+INTERRUPT ON 21
+INTERRUPT ON 22
+;FOLD LIN P6 Vel=2 m/s CPDAT0 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P6, 3:, 5:2, 7:CPDAT0
+$BWDSTART=FALSE
+LDAT_ACT=LCPDAT0
+FDAT_ACT=FP6
+BAS(#CP_PARAMS,2)
+LIN XP6 
+;ENDFOLD
+
+IF di004UseDryCycle==FALSE THEN ; Dry cycle: skip welding
+
+
+;FOLD LIN P16 Vel=2 m/s CPDAT15 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P16, 3:, 5:2, 7:CPDAT15
+$BWDSTART=FALSE
+LDAT_ACT=LCPDAT15
+FDAT_ACT=FP16
+BAS(#CP_PARAMS,2)
+LIN XP16 
+;ENDFOLD
+WAIT SEC 0          ; Robot at weld position (stop advance run)
+INTERRUPT OFF 20    ; Gun is closed on purpose in CENTERLINE_WELD
+INTERRUPT OFF 21
+INTERRUPT OFF 22
+CENTERLINE_WELD()   ; Weld nut
+INTERRUPT ON 20     ; Gun confirmed open - monitor while leaving
+INTERRUPT ON 21
+INTERRUPT ON 22
+
+
+
+ENDIF
+;FOLD LIN P06 CONT Vel=2 m/s CPDAT6 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P06, 3:C_DIS C_DIS, 5:2, 7:CPDAT6
+$BWDSTART=FALSE
+LDAT_ACT=LCPDAT6
+FDAT_ACT=FP06
+BAS(#CP_PARAMS,2)
+LIN XP06 C_DIS C_DIS
+;ENDFOLD
+WAIT SEC 0          ; Robot out of the welder (stop advance run)
+INTERRUPT OFF 20    ; End of gun monitoring
+INTERRUPT OFF 21
+INTERRUPT OFF 22
+; Exit loop unless a weld retry was requested
+IF NOT NUT_WELD_RETRY THEN
+   EXIT
+ENDIF
+NUT_WELD_RETRY=FALSE   ; Clear request and weld again
+ENDLOOP
+;--- Retract from nut welder ---
+;FOLD LIN P05 Vel=2 m/s CPDAT14 Tool[1]:TOOL 1 Base[3]:NUT WELDER;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P05, 3:, 5:2, 7:CPDAT14
+$BWDSTART=FALSE
+LDAT_ACT=LCPDAT14
+FDAT_ACT=FP05
+BAS(#CP_PARAMS,2)
+LIN XP05 
+;ENDFOLD
+;FOLD PTP P0 Vel=100 % PDAT26 Tool[1]:TOOL 1 Base[3]:NUT WELDER extTCP;%{PE}%R 8.3.43,%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:P0, 3:, 5:100, 7:PDAT26
+$BWDSTART=FALSE
+PDAT_ACT=PPDAT26
+FDAT_ACT=FP0
+BAS(#PTP_PARAMS,100)
+TRIGGER WHEN DISTANCE = 1 DELAY = 0 DO Request_next_nut() PRIO= -1
+PTP XP0 
+;ENDFOLD
+
+   
+END
+
