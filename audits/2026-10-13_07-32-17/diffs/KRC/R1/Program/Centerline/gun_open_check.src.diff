-      WHILE ($PRO_STATE0<>#P_ACTIVE) OR (CL_GunStrokePositionLPT<nGunOpenMin) OR (CL_GunStrokePositionLPT>nGunOpenMax) OR (NOT CL_ClampOpen) OR (NOT CL_PinRetracted)
+      WHILE NOT (($PRO_STATE0==#P_ACTIVE) AND (CL_GunStrokePositionLPT>=nGunOpenMin) AND (CL_GunStrokePositionLPT<=nGunOpenMax) AND CL_ClampOpen AND CL_PinRetracted)
