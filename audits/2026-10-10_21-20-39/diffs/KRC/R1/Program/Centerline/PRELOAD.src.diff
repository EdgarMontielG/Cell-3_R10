--- HEAD:KRC/R1/Program/Centerline/PRELOAD.src
+++ backup:KRC/R1/Program/Centerline/PRELOAD.src
@@ -1,16 +1,56 @@
 &ACCESS RVP1
+&COMMENT 03-10-R1 PNW1 NUT PRELOAD
 DEF  PRELOAD ( )
- 				   
-	
-IF NUT_STAR AND NOT NUTCYCLE_ACTIVE THEN
-
-   NUT_STAR=FALSE
+;********************************
+; Gestamp Standards
+; Line - BMW G65 (cell 03)
+; Robot 03-10-R1 (BMW-03-10-R1-PNW1)
+; Application - NUT PRELOAD AT CENTERLINE PEDESTAL
+;********************************
+; CALLED BY sps.sub IN EVERY SUBMIT CYCLE: RUNS IN THE SUBMIT INTERPRETER IN EVERY
+; OPERATING MODE (T1, T2, AUT, EXT), ALSO WHEN NO ROBOT PROGRAM IS RUNNING.
+; STARTED BY NUT_START (TRIGGER ON THE MOVE TO P12 / P10 OF THE PICKS, AND Request_next_nut
+; AT THE END OF WELD APPS 1-2, style1app1opt1A/B, 2A/B):
+;  STEP 0  - QFP RETURN; WHEN RETURNED, NUT FEED FOR 2000 MS
+;  STEP 10 - GUN OPEN, UPPER PIN RETRACT, CLAMP OPEN; QFP RETURN UNTIL SEEN RETURNED, THEN
+;            QFP ADVANCE; WHEN ADVANCED, NUT BLOW-OFF ONTO THE LOWER PIN, LOWER PIN ADVANCE
+;  STEP 20 - AFTER 800 MS BLOW-OFF: QFP RETURN, BLOW-OFF OFF; 800 MS LATER NUT_READY=TRUE
+;WARNING: DRIVES THE PEDESTAL VALVES ON ITS OWN, WITH NO ROBOT, MODE OR ENABLING-SWITCH
+;  INTERLOCK, AND SHARES THEM WITH CENTERLINE_WELD AND CENTERLINE_HOME WITHOUT OWNERSHIP (F11)
+;NOTE: USES $TIMER[10] FEED 2000 MS, $TIMER[11] ADVANCE 500 MS, $TIMER[12] RETURN 800 MS,
+;  $TIMER[13] BLOW-OFF 800 MS - KEEP THESE TIMERS FREE FOR THIS PROGRAM (F26)
+;NOTE: NO STEP TIMEOUTS; NUT_PRELOAD_FAULT IS NEVER SET TRUE; NUT_READY IS SET ON TIMERS,
+;  WITHOUT FEED COMPLETE OR FINAL QFP POSITION CONFIRMATION (F13)
+;NOTE: THE STEPS RUN ONLY WITH $IN[4] di004UseDryCycle OFF. IN DRY CYCLE A START STILL
+;  CLEARS NUT_READY AND NOTHING SETS IT WHILE DRY CYCLE IS ON - THE WELD APPS WAIT FOR IT (F04)
+;2026-10-07: STEP 10 LOWERS THE LOWER PIN BEFORE THE QFP ADVANCES AND HOLDS IT DOWN AT LEAST 1000 MS
+;  ($TIMER[11]): PIN DOWN = $OUT[494] dopw1_BlowOff (CL_LowerPinBlowOff) + $OUT[496] dopw1_ReturnPin
+;  (CL_LowerPinRelease) ON, $OUT[495] dopw1_AdvancePin (CL_LowerPinExtend) OFF - 496 ALONE DOES NOT LOWER
+;  THE PIN. THE PIN GOES UP ONLY WITH THE QFP ADVANCED (AS BEFORE). BEFORE, THE PIN STAYED UP FROM THE END
+;  OF THE WELD AND THE NUT ON THE QFP COULD HIT IT -> PRELOAD STUCK IN STEP 10 UNTIL CENTERLINE_HOME
+;  LOWERED THE PIN. STEP10_ADV_STARTED CLEARED AT EVERY START.
+;  WITH THE NUT ON THE PIN: $OUT[495] ON AND $OUT[494] OFF (THE 494 AIR CAN PUSH THE NUT OUT) - 494 GOES
+;  OFF IN THE SAME CYCLE THE PIN GOES UP AND STAYS OFF UNTIL THE WELD.
+;2026-10-07 PRE-FEED: NUT_READY IS SET AT THE END OF STEP 20 (NUT ON THE PIN); THEN STEP 30 FEEDS THE
+;  NEXT NUT INTO THE RETURNED QFP ($OUT[476] dopw1_StartFeed 2000 MS) -> QFP_NUT_LOADED (preload.dat)
+;  AND THE NEXT PRELOAD SKIPS THE FEED OF STEP 0. STEP 40 ENDS THE CYCLE.
+;********************************
+
+;START A PRELOAD WHEN NUT_START IS SET AND NONE IS ACTIVE: NUT_START CLEARED, NUT_READY=FALSE,
+;STEP 0, STEP0/10/20DONE AND THE FAULT FLAG CLEARED, $TIMER[10..13] STOPPED AND ZEROED
+;STEP10_ADV_STARTED IS ALSO CLEARED HERE (2026-10-07) - BEFORE ONLY WHEN A PRELOAD COMPLETED
+;NOTE: A NUT_START SET WHILE A PRELOAD IS ACTIVE STAYS SET AND STARTS ANOTHER PRELOAD (A NEW
+;  NUT FEED) AS SOON AS THIS ONE ENDS; NUT_READY IS THEN TRUE FOR ONLY ONE SUBMIT CYCLE (F11)
+IF NUT_START AND NOT NUTCYCLE_ACTIVE THEN
+
+   NUT_START=FALSE
    NUTCYCLE_ACTIVE=TRUE
    NUT_READY=FALSE
    NUT_PRELOAD_STEP=0
    STEP0DONE=FALSE
    STEP10DONE=FALSE
    STEP20DONE=FALSE
+   STEP10_ADV_STARTED=FALSE
    NUT_PRELOAD_FAULT=FALSE
    $TIMER_STOP[10]=TRUE
    $TIMER[10]=0
@@ -20,156 +60,247 @@
    $TIMER[12]=0
    $TIMER_STOP[13]=TRUE
    $TIMER[13]=0
-   
+
 ENDIF
 
+;RUN THE STEPS ONLY OUTSIDE DRY CYCLE - SIGNAL $IN[4] di004UseDryCycle OFF
 IF NUTCYCLE_ACTIVE AND NOT di004UseDryCycle THEN
-   
+
    SWITCH NUT_PRELOAD_STEP
-   
-   CASE 0
-   
-   ;QFP RETURNED
-   $OUT[503]=FALSE
-   $OUT[504]=TRUE
-
-   ;CL_QFPReturned / QFP ADV
-IF ($IN[482]==TRUE) AND ($IN[470]==FALSE) THEN 
-   ;FEED NUT
-   $OUT[476]=TRUE
-   $OUT[494]=FALSE
-   
-IF $TIMER_STOP[10] THEN
-   $TIMER[10]=0 
-   $TIMER_STOP[10]=FALSE   
-ENDIF
-
-IF  $TIMER[10]>=2000 THEN
-    $TIMER_STOP[10]=TRUE
-
-    STEP0DONE=TRUE
-ENDIF   
-
-ENDIF
-
-IF STEP0DONE THEN
-   NUT_PRELOAD_STEP = 10
-ENDIF
-
-   CASE 10
-   
-IF STEP0DONE THEN
-  
-   ;HOME
-   ;dopw1_GUNHOME/VALVE2 OPEN 
-   $OUT[472]=FALSE 
-   $OUT[471]=TRUE
-   ;CL_WeldPinRetract / UPPER PIN RETRACT
-   $OUT[498]=FALSE
-   $OUT[499]=TRUE
-   ;CL_PartClampOpen
-   $OUT[501]=FALSE
-   $OUT[502]=TRUE
-   
-IF NOT STEP10_ADV_STARTED THEN
-   $OUT[494]=TRUE  
-   ;QFP RETURNED
-   $OUT[503]=FALSE
-   $OUT[504]=TRUE
-   
-IF ($IN[482]==TRUE) AND ($IN[470]==FALSE) THEN 
-   STEP10_ADV_STARTED=TRUE
-   
-ENDIF
-ELSE
-   
-;CL_QFPAdvanced / QFP ADV
-$OUT[504]=FALSE
-$OUT[503]=TRUE
-$OUT[476]=FALSE
- 
-IF ($IN[470]==TRUE) AND ($IN[482]==FALSE) THEN 
-   ;CL_QFPBlowOff / NUT FEED BLOW-OFF ACTIVATE
-   $OUT[505]=TRUE
-   $OUT[494]=FALSE
-IF $TIMER_STOP[13] THEN
-   $TIMER[13]=0 
-   $TIMER_STOP[13]=FALSE   
-ENDIF 
-   ;CL_LowerPinRetreated
-   $OUT[496]=FALSE
-   $OUT[495]=TRUE
-  
-IF $TIMER_STOP[11] THEN
-   $TIMER[11]=0 
-   $TIMER_STOP[11]=FALSE   
-ENDIF
-
-IF $TIMER[11]>=500 THEN
-   $TIMER_STOP[11]=TRUE
-
-    STEP10DONE=TRUE
-ENDIF
-ENDIF
-ENDIF
-ENDIF
-
-IF STEP0DONE AND STEP10DONE THEN
-   NUT_PRELOAD_STEP = 20 
-   $TIMER_STOP[12]=TRUE
-   $TIMER[12]=0 
-   
-ENDIF   
- 
-   CASE 20
-
-IF STEP0DONE AND STEP10DONE AND ($TIMER[13]>=800)THEN
-
-   ;CL_LowerPinRetreated
-   $OUT[496]=FALSE
-   $OUT[495]=TRUE
-   
- 
-   ;CL_QFPReturn / NUT FEED SLIDE RETURN
-   $OUT[503]=FALSE
-   $OUT[504]=TRUE
-     ;CL_QFPBlowOff / NUT FEED BLOW-OFF ACTIVATE
-   $OUT[505]=FALSE
-   
-   
-IF $TIMER_STOP[12] THEN
-   $TIMER[12]=0 
-   $TIMER_STOP[12]=FALSE   
-ENDIF
-
-IF $TIMER[12]>=800 THEN
-   $TIMER_STOP[12]=TRUE
-    STEP20DONE=TRUE
-ENDIF 
-ENDIF
-
-IF STEP0DONE AND STEP10DONE AND STEP20DONE THEN
-   NUT_PRELOAD_STEP =0
-   NUT_READY=TRUE  
-   
-IF NEXT_NUT_REQUEST THEN
-   NEXT_NUT_READY=TRUE
-   NEXT_NUT_REQUEST=FALSE
-ENDIF
-   NUTCYCLE_ACTIVE=FALSE
-   STEP10_ADV_STARTED=FALSE
-   
-   $TIMER_STOP[10]=TRUE
-   $TIMER[10]=0
-   $TIMER_STOP[11]=TRUE
-   $TIMER[11]=0
-   $TIMER_STOP[12]=TRUE
-   $TIMER[12]=0
-   
-ENDIF
-
-ENDSWITCH
-
-   
+
+      CASE 0
+         ;STEP 0 - FEED A NUT
+
+         ;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
+         do503QFPAdvance=FALSE
+         do504QFPReturn=TRUE
+
+         ;NUT ALREADY PRE-FED INTO THE QFP AT THE END OF THE LAST PRELOAD (STEP 30): NO FEED (2026-10-07)
+         IF QFP_NUT_LOADED AND (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
+            STEP0DONE=TRUE
+         ENDIF
+
+         ;WHEN QFP RETURNED AND NOT ADVANCED (AND NO PRE-FED NUT) - SIGNALS $IN[482] dipw1_SpearHome ON,
+         ;  $IN[470] di470QFPAdvanced OFF
+         IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) AND (NOT QFP_NUT_LOADED) THEN
+            ;FEED NUT - SIGNALS $OUT[476] dopw1_StartFeed ON (OFF WHEN STEP 10 COMMANDS QFP ADVANCE),
+            ;  $OUT[494] dopw1_BlowOff OFF
+            dopw1_StartFeed=TRUE
+            dopw1_BlowOff=FALSE
+
+            ;START $TIMER[10] ONCE
+            IF $TIMER_STOP[10] THEN
+               $TIMER[10]=0
+               $TIMER_STOP[10]=FALSE
+            ENDIF
+
+            ;AFTER 2000 MS OF FEED + nFeedSettleMs (PRELOAD.DAT, 2026-10-10, USER): STEP 0 DONE - THE QFP STAYS RETURNED
+            ;  nFeedSettleMs LONGER SO THE NUT ARRIVES BEFORE IT ADVANCES (THE FEEDER BLOWS UP TO 5 S). 0 = AS 20R1
+            IF  $TIMER[10]>=(2000+nFeedSettleMs) THEN
+               $TIMER_STOP[10]=TRUE
+
+               STEP0DONE=TRUE
+            ENDIF
+
+         ENDIF
+
+         IF STEP0DONE THEN
+            NUT_PRELOAD_STEP = 10
+         ENDIF
+
+      CASE 10
+         ;STEP 10 - QFP ADVANCE AND BLOW THE NUT ONTO THE LOWER PIN
+
+         IF STEP0DONE THEN
+
+            ;WRITTEN IN EVERY SUBMIT CYCLE OF STEP 10:
+            ;GUN OPEN - SIGNALS $OUT[472] dopw1_GunWork OFF, $OUT[471] dopw1_GunHome ON
+            dopw1_GunWork=FALSE
+            dopw1_GunHome=TRUE
+            ;UPPER PIN RETRACT - SIGNALS $OUT[498] do498UpperPinExtend OFF,
+            ;  $OUT[499] do499UpperPinRetract ON
+            do498UpperPinExtend=FALSE
+            do499UpperPinRetract=TRUE
+            ;PART CLAMP OPEN - SIGNALS $OUT[501] do501PartClampClose OFF,
+            ;  $OUT[502] do502PartClampOpen ON
+            do501PartClampClose=FALSE
+            do502PartClampOpen=TRUE
+
+            ;UNTIL THE QFP HAS BEEN SEEN RETURNED (STEP10_ADV_STARTED):
+            IF NOT STEP10_ADV_STARTED THEN
+               ;BLOW-OFF ON - SIGNAL $OUT[494] dopw1_BlowOff ON
+               dopw1_BlowOff=TRUE
+               ;LOWER PIN DOWN UNTIL THE QFP IS ADVANCED (2026-10-07): BLOW-OFF ABOVE + SIGNALS
+               ;  $OUT[495] dopw1_AdvancePin OFF, $OUT[496] dopw1_ReturnPin ON (496 ALONE DOES NOT LOWER IT)
+               dopw1_AdvancePin=FALSE
+               dopw1_ReturnPin=TRUE
+               ;PIN DOWN TIME: $TIMER[11] STARTED ONCE, QFP ADVANCE ONLY AFTER nPinDownMs (PRELOAD.DAT, 2026-10-09: WAS 1000 MS)
+               IF $TIMER_STOP[11] THEN
+                  $TIMER[11]=0
+                  $TIMER_STOP[11]=FALSE
+               ENDIF
+               ;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
+               do503QFPAdvance=FALSE
+               do504QFPReturn=TRUE
+
+               ;WHEN QFP RETURNED AND NOT ADVANCED - SIGNALS $IN[482] dipw1_SpearHome ON,
+               ;  $IN[470] di470QFPAdvanced OFF
+               ;PIN DOWN: nPinDownMs, OR WITH bPinDownSensor UNTIL dipw1_PinReturn ON (MAX nPinDownMaxMs) - 2026-10-09
+               IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) AND (((NOT bPinDownSensor) AND ($TIMER[11]>=nPinDownMs)) OR (bPinDownSensor AND ((dipw1_PinReturn==TRUE) OR ($TIMER[11]>=nPinDownMaxMs)))) THEN
+                  STEP10_ADV_STARTED=TRUE
+                  $TIMER_STOP[11]=TRUE
+                  $TIMER[11]=0
+
+               ENDIF
+            ELSE
+
+               ;QFP ADVANCE AND FEED OFF - SIGNALS $OUT[504] do504QFPReturn OFF,
+               ;  $OUT[503] do503QFPAdvance ON, $OUT[476] dopw1_StartFeed OFF
+               do504QFPReturn=FALSE
+               do503QFPAdvance=TRUE
+               dopw1_StartFeed=FALSE
+
+               ;WHEN QFP ADVANCED AND NOT RETURNED - SIGNALS $IN[470] di470QFPAdvanced ON,
+               ;  $IN[482] dipw1_SpearHome OFF
+               IF (di470QFPAdvanced==TRUE) AND (dipw1_SpearHome==FALSE) THEN
+                  ;NUT BLOW-OFF - SIGNALS $OUT[505] do505QFPNutBlowOff ON, $OUT[494] dopw1_BlowOff OFF
+                  do505QFPNutBlowOff=TRUE
+                  dopw1_BlowOff=FALSE
+                  ;THE NUT LEFT THE QFP (PRE-FED OR FED IN STEP 0) - 2026-10-07
+                  QFP_NUT_LOADED=FALSE
+                  ;START $TIMER[13] (BLOW-OFF TIME, CHECKED IN STEP 20) ONCE
+                  IF $TIMER_STOP[13] THEN
+                     $TIMER[13]=0
+                     $TIMER_STOP[13]=FALSE
+                  ENDIF
+                  ;LOWER PIN ADVANCE - SIGNALS $OUT[496] dopw1_ReturnPin OFF, $OUT[495] dopw1_AdvancePin ON
+                  ;CHECK: OLD COMMENT SAID LOWER PIN RETREATED; THE CODE ADVANCES THE PIN (F27)
+                  ;HIGH PRESSURE FOR THE PIN UP - SIGNAL $OUT[473] dopw1_Nut1Intensify_Home (CL_LowPressureSelect) OFF.
+                  ;2026-10-08: WITH LOW PRESSURE (473 ON) THE PIN DID NOT RISE (CENTERLINE_HOME FIXED IT BY SWITCHING 473 OFF).
+                  ;473 BACK ON IN STEP 20 WHEN THE QFP IS RETURNED (THE PIN VALVE KEEPS ITS POSITION)
+                  dopw1_Nut1Intensify_Home=FALSE
+                  dopw1_ReturnPin=FALSE
+                  dopw1_AdvancePin=TRUE
+
+                  ;START $TIMER[11] ONCE
+                  IF $TIMER_STOP[11] THEN
+                     $TIMER[11]=0
+                     $TIMER_STOP[11]=FALSE
+                  ENDIF
+
+                  ;nPinUpMs AFTER THE QFP ADVANCED (LOWER PIN UP THROUGH THE NUT): STEP 10 DONE
+                  ;  (PRELOAD.DAT, 2026-10-09: WAS 500 MS HERE / 800 IN STEP 20)
+                  IF $TIMER[11]>=nPinUpMs THEN
+                     $TIMER_STOP[11]=TRUE
+
+                     STEP10DONE=TRUE
+                  ENDIF
+               ENDIF
+            ENDIF
+         ENDIF
+
+         ;GO TO STEP 20 WITH $TIMER[12] STOPPED AND ZEROED
+         IF STEP0DONE AND STEP10DONE THEN
+            NUT_PRELOAD_STEP = 20
+            $TIMER_STOP[12]=TRUE
+            $TIMER[12]=0
+
+         ENDIF
+
+      CASE 20
+         ;STEP 20 - AFTER nPinUpMs OF NUT BLOW-OFF ($TIMER[13]): QFP RETURN (PRELOAD.DAT, 2026-10-09: WAS 800 MS)
+
+         IF STEP0DONE AND STEP10DONE AND ($TIMER[13]>=nPinUpMs) THEN
+
+            ;LOWER PIN ADVANCE - SIGNALS $OUT[496] dopw1_ReturnPin OFF, $OUT[495] dopw1_AdvancePin ON
+            ;CHECK: OLD COMMENT SAID LOWER PIN RETREATED; THE CODE ADVANCES THE PIN (F27)
+            dopw1_ReturnPin=FALSE
+            dopw1_AdvancePin=TRUE
+
+            ;QFP RETURN - SIGNALS $OUT[503] do503QFPAdvance OFF, $OUT[504] do504QFPReturn ON
+            do503QFPAdvance=FALSE
+            do504QFPReturn=TRUE
+            ;NUT BLOW-OFF OFF - SIGNAL $OUT[505] do505QFPNutBlowOff OFF
+            do505QFPNutBlowOff=FALSE
+
+            ;QFP RETURNED - SIGNALS $IN[482] dipw1_SpearHome ON AND $IN[470] di470QFPAdvanced OFF: STEP 20 DONE.
+            ;2026-10-09 (AS 20R1): WAS A FIXED 800 MS ($TIMER[12]) AFTER THE RETURN COMMAND WITHOUT CHECKING THE QFP -
+            ;NUT_READY COMES AS SOON AS THE QFP IS BACK, AND NEVER IF IT DID NOT MOVE
+            IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
+               STEP20DONE=TRUE
+               dopw1_Nut1Intensify_Home=TRUE   ;$OUT[473] LOW PRESSURE AGAIN, PIN STAYS UP (2026-10-08)
+            ENDIF
+         ENDIF
+
+         ;PRELOAD COMPLETE: STEP 0, NUT_READY=TRUE, NEXT_NUT_READY=TRUE IF REQUESTED, CYCLE INACTIVE,
+         ;$TIMER[10..12] STOPPED AND ZEROED ($TIMER[13] IS LEFT RUNNING UNTIL THE NEXT START)
+         ;NOTE: NOTHING CLEARS NUT_READY WHEN THE NUT IS WELDED (F14); NEXT_NUT_READY IS WAITED FOR BY
+         ;  NUTS 2 AND 3 (style1app1opt2A/B, 3A/B)
+         IF STEP0DONE AND STEP10DONE AND STEP20DONE THEN
+            ;NUT ON THE PIN ($OUT[495] ON, $OUT[494] OFF): NUT READY FOR THE ROBOT NOW
+            NUT_READY=TRUE
+
+            IF NEXT_NUT_REQUEST THEN
+               NEXT_NUT_READY=TRUE
+               NEXT_NUT_REQUEST=FALSE
+            ENDIF
+            ;NEXT: STEP 30 PRE-FEED (2026-10-07) WITH $TIMER[10] AND $TIMER[12] STOPPED AND ZEROED
+            NUT_PRELOAD_STEP = 30
+            $TIMER_STOP[10]=TRUE
+            $TIMER[10]=0
+            $TIMER_STOP[12]=TRUE
+            $TIMER[12]=0
+
+         ENDIF
+
+      CASE 30
+         ;STEP 30 - PRE-FEED (2026-10-07): WITH THE QFP RETURNED, FEED THE NEXT NUT INTO THE QFP FOR
+         ;2000 MS ($TIMER[10]) -> QFP_NUT_LOADED=TRUE. QFP NOT SEEN RETURNED WITHIN 3000 MS ($TIMER[12])
+         ;-> NO PRE-FEED (THE NEXT PRELOAD FEEDS IN STEP 0 AS BEFORE). THE ROBOT IS NOT WAITING HERE.
+         IF $TIMER_STOP[12] THEN
+            $TIMER[12]=0
+            $TIMER_STOP[12]=FALSE
+         ENDIF
+
+         ;WHEN QFP RETURNED AND NOT ADVANCED - SIGNALS $IN[482] dipw1_SpearHome ON, $IN[470] di470QFPAdvanced OFF
+         IF (dipw1_SpearHome==TRUE) AND (di470QFPAdvanced==FALSE) THEN
+            ;FEED NUT - SIGNAL $OUT[476] dopw1_StartFeed ON FOR 2000 MS ($TIMER[10] STARTED ONCE)
+            ;THEN THE QFP STAYS RETURNED nFeedSettleMs MORE (PRELOAD.DAT, 2026-10-10, USER): THE FEEDER BLOWS UP TO 5 S,
+            ;  THE NUT MUST BE IN THE QFP BEFORE THE NEXT PRELOAD ADVANCES IT. A NEW REQUEST WAITS (CYCLE STILL ACTIVE).
+            ;  nFeedSettleMs=0 = AS 20R1
+            IF $TIMER_STOP[10] THEN
+               dopw1_StartFeed=TRUE
+               $TIMER[10]=0
+               $TIMER_STOP[10]=FALSE
+            ENDIF
+            IF $TIMER[10]>=2000 THEN
+               dopw1_StartFeed=FALSE
+            ENDIF
+            IF $TIMER[10]>=(2000+nFeedSettleMs) THEN
+               QFP_NUT_LOADED=TRUE
+               NUT_PRELOAD_STEP = 40
+            ENDIF
+         ELSE
+            IF ($TIMER[12]>=3000) AND $TIMER_STOP[10] THEN
+               NUT_PRELOAD_STEP = 40
+            ENDIF
+         ENDIF
+
+      CASE 40
+         ;STEP 40 - PRELOAD CYCLE COMPLETE: CYCLE INACTIVE, $TIMER[10..12] STOPPED AND ZEROED
+         NUT_PRELOAD_STEP =0
+         NUTCYCLE_ACTIVE=FALSE
+         STEP10_ADV_STARTED=FALSE
+
+         $TIMER_STOP[10]=TRUE
+         $TIMER[10]=0
+         $TIMER_STOP[11]=TRUE
+         $TIMER[11]=0
+         $TIMER_STOP[12]=TRUE
+         $TIMER[12]=0
+
+   ENDSWITCH
+
+
 ENDIF
 END
