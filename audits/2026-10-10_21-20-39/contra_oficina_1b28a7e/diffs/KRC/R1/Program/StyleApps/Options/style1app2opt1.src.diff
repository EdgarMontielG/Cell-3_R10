+DEF NUT_MISSING_MSG(nNut:IN)
+;NOTIFY MESSAGE (NO ROBOT STOP) FOR A MISSING NUT IN THE PRODUCTION NUT CHECK (2026-10-09):
+;"Nut check: PN<n> missing (sensor $IN[227] at P28/P32/P36) - part to scrap". MODULE NutCheck, NR 30+n
+DECL INT nNut
+DECL KrlMsg_T Msg
+DECL KrlMsgPar_T Par[3]
+DECL KrlMsgOpt_T Opt
+DECL INT nHandle
+
+   Msg.Modul[]="NutCheck"
+   Msg.Nr=30+nNut
+   Msg.Msg_txt[]="Nut check: PN%1 missing (sensor $IN[227] at P%2) - part to scrap"
+   Par[1].Par_Type=#VALUE
+   Par[1].Par_Int=nNut
+   Par[2].Par_Type=#VALUE
+   SWITCH nNut
+      CASE 1
+         Par[2].Par_Int=28
+      CASE 2
+         Par[2].Par_Int=32
+      DEFAULT
+         Par[2].Par_Int=36
+   ENDSWITCH
+   Par[3].Par_Type=#EMPTY
+   Opt.VL_Stop=TRUE
+   Opt.Clear_P_Reset=TRUE
+   Opt.Clear_P_SAW=FALSE
+   Opt.Log_To_DB=TRUE
+   nHandle=Set_KrlMsg(#NOTIFY, Msg, Par[], Opt)
+
+END
