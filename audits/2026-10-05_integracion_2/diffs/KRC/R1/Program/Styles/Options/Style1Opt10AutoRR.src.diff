--- /dev/null
+++ backup:KRC/R1/Program/Styles/Options/Style1Opt10AutoRR.src
@@ -0,0 +1,27 @@
+&ACCESS RVO1
+&REL 3
+&COMMENT 03-10-R1 RED RABBIT CYCLE
+DEF Style1Opt10AutoRR( )
+;********************************
+; Gestamp Standards
+; Line - BMW G65 (cell 03)
+; Robot 03-10-R1 (BMW-03-10-R1)
+; Application - RED RABBIT TEST CYCLE (OPTION 12)
+;********************************
+;WARNING: THE NUT CHECK AND THE CAMERA CHECK EACH SET $OUT[141] do141RedRabbitFailed OR $OUT[142]
+;  do142RedRabbitPassed FOR OPTION 12 - BOTH CAN BE ON TOGETHER, AND THE DROP CLEARS THEM BEFORE
+;  THE END OF THE CYCLE. THE DROP RELEASES THE PART WITH GRIPPER 3, WHICH SHARES GRIPPER 1'S I/O
+;  (F19, F31)
+
+   ;PICK THE RED RABBIT TEST PART AT PICKUP 1 (STATION 1)
+   Style1Pick1Opt1AutoRR()
+   ;NUT SENSOR CHECK OF THE 3 NUTS - SIGNAL $IN[227] di227NutPresent1 (PRODUCTION PROGRAM)
+   style1app2opt1()
+   ;NUT CAMERA CHECK - SIGNALS $IN[100] di100CameraJudgmentOK, $IN[101] di101CameraJudgmentNG
+   ;(PRODUCTION PROGRAM: WRITES bscrapGE4), THEN RELEASES APPLICATION 1
+   style1app2opt2()
+   ;DROP THE PART AT DROPOFF 2 (style1drop1opt2AutoRR), THEN SIGNALS
+   ;$OUT[141] do141RedRabbitFailed OFF, $OUT[142] do142RedRabbitPassed OFF, PARTPRESENT1..3 = FALSE
+   style1drop1opt2AutoRR()
+  
+END
